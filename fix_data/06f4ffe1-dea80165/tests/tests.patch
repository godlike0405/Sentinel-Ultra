+    def test_sparse_mutations_across_distinct_views_stay_within_memory_budget(
+        self,
+    ) -> None:
+        with tempfile.TemporaryDirectory() as tempdir:
+            configurations: list[tuple[str, bytes]] = []
+            for index in range(13):
+                contents = f"operator-passwd-{index}".encode()
+                root = Path(tempdir) / f"configuration-{index}"
+                root.mkdir()
+                configurations.append(
+                    (self._contents_directory(str(root), contents), contents)
+                )
+
+            os.environ[ENV_CONTENTS_PATH] = configurations[0][0]
+            warm = fs.HoneyPotFilesystem("arch", "/root")
+            self.assertEqual(warm.file_contents("/etc/passwd"), configurations[0][1])
+
+            gc.collect()
+            tracemalloc.start()
+            before = tracemalloc.take_snapshot()
+            sessions: list[tuple[fs.HoneyPotFilesystem, int, bytes, int]] = []
+            for index, (contents_path, contents) in enumerate(
+                configurations[1:], start=1
+            ):
+                os.environ[ENV_CONTENTS_PATH] = contents_path
+                session = fs.HoneyPotFilesystem("arch", "/root")
+                mode = 0o600 | (index % 8)
+                session.mkfile(f"/tmp/session-{index}", 0, 0, 0, 0o640)
+                session.chmod("/etc/passwd", mode)
+                session.rename("/bin/ls", f"/tmp/ls-{index}")
+                sessions.append((session, index, contents, mode))
+            after = tracemalloc.take_snapshot()
+            tracemalloc.stop()
+
+            growth = sum(
+                max(0, stat.size_diff) for stat in after.compare_to(before, "filename")
+            )
+            budget = Path("src/cowrie/data/fs.pickle").stat().st_size
+            for session, index, contents, mode in sessions:
+                other_index = 1 + (index % len(sessions))
+                self.assertEqual(session.file_contents("/etc/passwd"), contents)
+                self.assertEqual(session.stat("/etc/passwd").st_mode & 0o777, mode)
+                self.assertTrue(session.exists(f"/tmp/session-{index}"))
+                self.assertTrue(session.exists(f"/tmp/ls-{index}"))
+                self.assertFalse(session.exists("/bin/ls"))
+                self.assertFalse(session.exists(f"/tmp/session-{other_index}"))
+                self.assertFalse(session.exists(f"/tmp/ls-{other_index}"))
+            self.assertEqual(len(sessions), 12)
+            self.assertLess(growth, budget)
