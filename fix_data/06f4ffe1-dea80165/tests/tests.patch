+    def test_operator_only_paths_stay_isolated_within_memory_budget(self) -> None:
+        with tempfile.TemporaryDirectory() as tempdir:
+            configurations: list[tuple[str, list[tuple[str, bytes]]]] = []
+            for index in range(13):
+                root = Path(tempdir) / f"configuration-{index}"
+                root.mkdir()
+                configurations.append(
+                    self._contents_with_new_paths(str(root), f"view-{index}")
+                )
+
+            os.environ[ENV_CONTENTS_PATH] = configurations[0][0]
+            warm = fs.HoneyPotFilesystem("arch", "/root")
+            for virtual_path, contents in configurations[0][1]:
+                self.assertEqual(warm.file_contents(virtual_path), contents)
+
+            gc.collect()
+            tracemalloc.start()
+            before = tracemalloc.take_snapshot()
+            sessions: list[fs.HoneyPotFilesystem] = []
+            for contents_path, _virtual_files in configurations[1:]:
+                os.environ[ENV_CONTENTS_PATH] = contents_path
+                sessions.append(fs.HoneyPotFilesystem("arch", "/root"))
+            after = tracemalloc.take_snapshot()
+            tracemalloc.stop()
+
+            growth = sum(
+                max(0, stat.size_diff) for stat in after.compare_to(before, "filename")
+            )
+            budget = Path("src/cowrie/data/fs.pickle").stat().st_size
+            for index, (session, (_path, virtual_files)) in enumerate(
+                zip(sessions, configurations[1:], strict=False), start=1
+            ):
+                for virtual_path, contents in virtual_files:
+                    self.assertEqual(session.file_contents(virtual_path), contents)
+                other_path = configurations[1 + (index % len(sessions))][1][0][0]
+                self.assertFalse(session.exists(other_path))
+            self.assertEqual(len(sessions), 12)
+            self.assertLess(growth, budget)
