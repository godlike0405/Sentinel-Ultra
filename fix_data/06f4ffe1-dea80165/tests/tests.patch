+class PathWalkerBehaviorTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.filesystem = fs.HoneyPotFilesystem("arch", "/root")
+
+    def test_empty_path_refers_to_root(self) -> None:
+        self.assertTrue(stat.S_ISDIR(self.filesystem.stat("").st_mode))
+        self.assertEqual(self.filesystem.listdir(""), self.filesystem.listdir("/"))
+
+    def test_only_separators_refer_to_root(self) -> None:
+        self.assertTrue(stat.S_ISDIR(self.filesystem.stat("////").st_mode))
+        self.assertEqual(self.filesystem.listdir("////"), self.filesystem.listdir("/"))
+
+    def test_repeated_internal_separators_are_ignored(self) -> None:
+        repeated = self.filesystem.stat("/etc//passwd")
+        regular = self.filesystem.stat("/etc/passwd")
+        self.assertEqual(
+            (repeated.st_mode, repeated.st_size),
+            (regular.st_mode, regular.st_size),
+        )
+        self.assertEqual(
+            self.filesystem.file_contents("/etc//passwd"),
+            self.filesystem.file_contents("/etc/passwd"),
+        )
+
+    def test_terminal_symlink_is_followed_by_default(self) -> None:
+        self.assertEqual(
+            self.filesystem.listdir("/bin"), self.filesystem.listdir("/usr/bin")
+        )
+        self.assertTrue(stat.S_ISDIR(self.filesystem.stat("/bin").st_mode))
+
+    def test_terminal_symlink_can_be_returned_without_following(self) -> None:
+        self.assertTrue(stat.S_ISLNK(self.filesystem.lstat("/bin").st_mode))
+        self.assertFalse(stat.S_ISLNK(self.filesystem.stat("/bin").st_mode))
+
+    def test_intermediate_directory_symlink_is_followed(self) -> None:
+        through_link = self.filesystem.stat("/bin/ls")
+        direct = self.filesystem.stat("/usr/bin/ls")
+        self.assertTrue(stat.S_ISREG(through_link.st_mode))
+        self.assertEqual(
+            (through_link.st_mode, through_link.st_size),
+            (direct.st_mode, direct.st_size),
+        )
+
+    def test_broken_symlink_resolves_as_missing(self) -> None:
+        self.assertTrue(self.filesystem.lexists("/dev/stderr"))
+        self.assertFalse(self.filesystem.exists("/dev/stderr"))
+
+    def test_descent_through_file_resolves_as_missing(self) -> None:
+        self.assertFalse(self.filesystem.exists("/etc/passwd/child"))
+
+    def test_contents_lookup_returns_file_bytes(self) -> None:
+        contents = self.filesystem.get_path("/etc/passwd")
+        self.assertIsInstance(contents, bytes)
+        self.assertEqual(contents, self.filesystem.file_contents("/etc/passwd"))
+
+    def test_contents_lookup_follows_directory_symlink(self) -> None:
+        self.assertEqual(
+            self.filesystem.listdir("/var/run"), self.filesystem.listdir("/run")
+        )
+
+    def test_contents_lookup_rejects_descent_through_file(self) -> None:
+        with self.assertRaises(fs.FileNotFound):
+            self.filesystem.get_path("/etc/passwd/child")
+
+    def test_contents_lookup_rejects_missing_path(self) -> None:
+        with self.assertRaises(fs.FileNotFound):
+            self.filesystem.get_path("/missing")
+
