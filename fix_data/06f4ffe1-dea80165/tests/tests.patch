+class OperatorContentsBehaviorTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self._prior_contents_path = os.environ.get(ENV_CONTENTS_PATH)
+        self.addCleanup(self._restore_contents_path)
+
+    def _restore_contents_path(self) -> None:
+        if self._prior_contents_path is None:
+            os.environ.pop(ENV_CONTENTS_PATH, None)
+        else:
+            os.environ[ENV_CONTENTS_PATH] = self._prior_contents_path
+
+    def _contents_directory(self, root: str, contents: bytes) -> str:
+        etc = Path(root) / "etc"
+        etc.mkdir()
+        (etc / "passwd").write_bytes(contents)
+        return root
+
+    def _contents_with_new_paths(
+        self, root: str, label: str, file_count: int = 6
+    ) -> tuple[str, list[tuple[str, bytes]]]:
+        self._contents_directory(root, f"operator-passwd-{label}".encode())
+        virtual_files: list[tuple[str, bytes]] = []
+        nested = Path(root) / "operator-only" / label / "nested"
+        nested.mkdir(parents=True)
+        for index in range(file_count):
+            contents = f"{label}-file-{index}".encode()
+            (nested / f"file-{index}.txt").write_bytes(contents)
+            virtual_files.append(
+                (f"/operator-only/{label}/nested/file-{index}.txt", contents)
+            )
+        return root, virtual_files
+
+    def test_configured_read_only_sessions_stay_within_memory_budget(self) -> None:
