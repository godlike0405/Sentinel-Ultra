+    def test_operator_snapshots_merge_without_overwriting_session_changes(self) -> None:
+        with tempfile.TemporaryDirectory() as tempdir:
+            root = Path(tempdir)
+            outside = root / "outside.txt"
+            outside.write_bytes(b"outside")
+            first = root / "first"
+            second = root / "second"
+
+            (first / "etc").mkdir(parents=True)
+            (first / "etc" / "passwd").write_bytes(b"first-passwd")
+            (first / "etc" / "passwd").chmod(0o640)
+            (first / "etc" / "issue").write_bytes(b"first-issue")
+            (first / "operator-only").mkdir()
+            (first / "operator-only" / "moved.txt").write_bytes(b"move-me")
+            (first / "operator-only" / "deleted.txt").write_bytes(b"delete-me")
+            (first / "operator-only" / "replaced.txt").write_bytes(b"replace-me")
+            (first / "operator-only" / "external.txt").symlink_to(outside)
+
+            (second / "etc").mkdir(parents=True)
+            (second / "etc" / "passwd").write_bytes(b"second-passwd")
+            (second / "etc" / "passwd").chmod(0o604)
+            (second / "operator-only").mkdir()
+            (second / "operator-only" / "new.txt").write_bytes(b"operator-new")
+            (second / "operator-only" / "deleted.txt").write_bytes(b"operator-restored")
+            (second / "operator-only" / "replaced.txt").write_bytes(
+                b"operator-replacement"
+            )
+
+            os.environ.pop(ENV_CONTENTS_PATH, None)
+            bundled_issue = fs.HoneyPotFilesystem("arch", "/root").file_contents(
+                "/etc/issue"
+            )
+            os.environ[ENV_CONTENTS_PATH] = str(first)
+            changing = fs.HoneyPotFilesystem("arch", "/root")
+            unchanged = fs.HoneyPotFilesystem("arch", "/root")
+
+            self.assertFalse(changing.exists("/operator-only/external.txt"))
+            (first / "etc" / "passwd").write_bytes(b"changed-on-host")
+            (first / "etc" / "passwd").chmod(0o777)
+            (first / "operator-only" / "moved.txt").unlink()
+            self.assertEqual(changing.file_contents("/etc/passwd"), b"first-passwd")
+            self.assertEqual(unchanged.file_contents("/etc/passwd"), b"first-passwd")
+            self.assertEqual(changing.stat("/etc/passwd").st_mode & 0o777, 0o640)
+            self.assertEqual(unchanged.stat("/etc/passwd").st_mode & 0o777, 0o640)
+
+            changing.chmod("/etc/passwd", 0o600)
+            changing.rename("/operator-only/moved.txt", "/tmp/moved.txt")
+            changing.remove("/operator-only/deleted.txt")
+            changing.mkfile("/operator-only/new.txt", 0, 0, 37, 0o640)
+            changing.mkfile("/operator-only/replaced.txt", 0, 0, 41, 0o620)
+            changing.init_honeyfs(str(second))
+
+            self.assertEqual(changing.file_contents("/etc/passwd"), b"first-passwd")
+            self.assertEqual(changing.stat("/etc/passwd").st_mode & 0o777, 0o600)
+            self.assertEqual(changing.file_contents("/tmp/moved.txt"), b"move-me")
+            self.assertFalse(changing.exists("/operator-only/moved.txt"))
+            self.assertFalse(changing.exists("/operator-only/deleted.txt"))
+            self.assertEqual(changing.stat("/operator-only/new.txt").st_size, 37)
+            self.assertEqual(changing.stat("/operator-only/replaced.txt").st_size, 41)
+            self.assertEqual(changing.file_contents("/etc/issue"), bundled_issue)
+
+            changing.init_honeyfs(str(second))
+            self.assertFalse(changing.exists("/operator-only/deleted.txt"))
+            self.assertEqual(changing.file_contents("/tmp/moved.txt"), b"move-me")
+            self.assertEqual(changing.stat("/operator-only/new.txt").st_size, 37)
+            self.assertEqual(changing.stat("/operator-only/replaced.txt").st_size, 41)
+
+            self.assertEqual(unchanged.file_contents("/etc/passwd"), b"first-passwd")
+            self.assertEqual(
+                unchanged.file_contents("/operator-only/moved.txt"), b"move-me"
+            )
+            self.assertEqual(
+                unchanged.file_contents("/operator-only/deleted.txt"), b"delete-me"
+            )
+
+            os.environ[ENV_CONTENTS_PATH] = str(second)
+            later = fs.HoneyPotFilesystem("arch", "/root")
+            self.assertEqual(later.file_contents("/etc/passwd"), b"second-passwd")
+            self.assertEqual(later.stat("/etc/passwd").st_mode & 0o777, 0o604)
+            self.assertEqual(
+                later.file_contents("/operator-only/new.txt"), b"operator-new"
+            )
+            self.assertEqual(
+                later.file_contents("/operator-only/deleted.txt"),
+                b"operator-restored",
+            )
