+class FilesystemRenameBehaviorTests(unittest.TestCase):
+    def test_rename_replaces_destination_in_same_directory(self) -> None:
+        filesystem = fs.HoneyPotFilesystem("arch", "/root")
+        filesystem.mkfile("/tmp/source", 0, 0, 10, 0o644)
+        filesystem.mkfile("/tmp/destination", 0, 0, 20, 0o600)
+        filesystem.rename("/tmp/source", "/tmp/destination")
+        self.assertFalse(filesystem.exists("/tmp/source"))
+        self.assertEqual(filesystem.listdir("/tmp").count("destination"), 1)
+        self.assertEqual(filesystem.stat("/tmp/destination").st_size, 10)
+
+    def test_rename_replaces_destination_across_directories(self) -> None:
+        filesystem = fs.HoneyPotFilesystem("arch", "/root")
+        filesystem.mkfile("/tmp/source", 0, 0, 10, 0o644)
+        filesystem.mkfile("/root/destination", 0, 0, 20, 0o600)
+        filesystem.rename("/tmp/source", "/root/destination")
+        self.assertFalse(filesystem.exists("/tmp/source"))
+        self.assertEqual(filesystem.listdir("/root").count("destination"), 1)
+        self.assertEqual(filesystem.stat("/root/destination").st_size, 10)
+
