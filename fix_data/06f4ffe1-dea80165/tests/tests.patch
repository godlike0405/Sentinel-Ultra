+            gc.collect()
+            tracemalloc.start()
+            before = tracemalloc.take_snapshot()
+            sessions: list[fs.HoneyPotFilesystem] = []
+            for contents_path, _contents in configurations[1:]:
+                os.environ[ENV_CONTENTS_PATH] = contents_path
+                sessions.append(fs.HoneyPotFilesystem("arch", "/root"))
+            after = tracemalloc.take_snapshot()
+            tracemalloc.stop()
+
+            growth = sum(
+                max(0, stat.size_diff) for stat in after.compare_to(before, "filename")
+            )
+            budget = Path("src/cowrie/data/fs.pickle").stat().st_size
+            self.assertEqual(
+                [session.file_contents("/etc/passwd") for session in sessions],
