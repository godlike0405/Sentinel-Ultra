+class SessionIsolationBehaviorTests(unittest.TestCase):
+    def _sessions(
+        self,
+    ) -> tuple[fs.HoneyPotFilesystem, fs.HoneyPotFilesystem]:
+        first = fs.HoneyPotFilesystem("arch", "/root")
+        second = fs.HoneyPotFilesystem("arch", "/root")
+        return first, second
+
+    def test_read_only_session_memory_growth_stays_below_one_tree(self) -> None:
+        fs.HoneyPotFilesystem("arch", "/root")
+        gc.collect()
+        tracemalloc.start()
+        before = tracemalloc.take_snapshot()
+        sessions = [fs.HoneyPotFilesystem("arch", "/root") for _ in range(12)]
+        after = tracemalloc.take_snapshot()
+        tracemalloc.stop()
+        growth = sum(
+            max(0, stat.size_diff) for stat in after.compare_to(before, "filename")
+        )
+        budget = Path("src/cowrie/data/fs.pickle").stat().st_size
+        self.assertEqual(len(sessions), 12)
+        self.assertLess(growth, budget)
+
+    def test_repeated_file_creation_remains_isolated(self) -> None:
+        first, second = self._sessions()
+        first.mkfile("/tmp/cow-one", 0, 0, 0, 0o644)
+        self.assertTrue(first.exists("/tmp/cow-one"))
+        self.assertFalse(second.exists("/tmp/cow-one"))
+        first.mkfile("/tmp/cow-two", 0, 0, 0, 0o644)
+        self.assertTrue(first.exists("/tmp/cow-two"))
+        self.assertFalse(second.exists("/tmp/cow-two"))
+
+    def test_directory_creation_is_private(self) -> None:
+        first, second = self._sessions()
+        first.mkdir("/tmp/cow-dir", 0, 0, 4096, 0o755)
+        self.assertTrue(first.isdir("/tmp/cow-dir"))
+        self.assertFalse(second.exists("/tmp/cow-dir"))
+
+    def test_file_removal_is_private(self) -> None:
+        first, second = self._sessions()
+        first.remove("/etc/passwd")
+        self.assertFalse(first.exists("/etc/passwd"))
+        self.assertTrue(second.exists("/etc/passwd"))
+
+    def test_rename_is_private(self) -> None:
+        first, second = self._sessions()
+        first.rename("/bin/ls", "/tmp/cow-ls")
+        self.assertFalse(first.exists("/bin/ls"))
+        self.assertTrue(first.exists("/tmp/cow-ls"))
+        self.assertTrue(second.exists("/bin/ls"))
+        self.assertFalse(second.exists("/tmp/cow-ls"))
+
+    def test_chmod_is_private(self) -> None:
+        first, second = self._sessions()
+        original = second.stat("/etc/passwd").st_mode
+        first.chmod("/etc/passwd", 0o600)
+        self.assertEqual(first.stat("/etc/passwd").st_mode & 0o777, 0o600)
+        self.assertEqual(second.stat("/etc/passwd").st_mode, original)
+
+    def test_chown_is_private(self) -> None:
+        first, second = self._sessions()
+        original = second.stat("/etc/passwd")
+        first.chown("/etc/passwd", 123, 456)
+        changed = first.stat("/etc/passwd")
+        unchanged = second.stat("/etc/passwd")
+        self.assertEqual((changed.st_uid, changed.st_gid), (123, 456))
+        self.assertEqual(
+            (unchanged.st_uid, unchanged.st_gid),
+            (original.st_uid, original.st_gid),
+        )
+
+    def test_timestamp_update_is_private(self) -> None:
+        first, second = self._sessions()
+        original = second.stat("/etc/passwd").st_mtime
+        first.utime("/etc/passwd", 100.0, 123456.0)
+        self.assertEqual(first.stat("/etc/passwd").st_mtime, 123456.0)
+        self.assertEqual(second.stat("/etc/passwd").st_mtime, original)
+
+    def test_size_update_is_private(self) -> None:
+        first, second = self._sessions()
+        original = second.stat("/etc/passwd").st_size
+        first.update_size("/etc/passwd", original + 37)
+        self.assertEqual(first.stat("/etc/passwd").st_size, original + 37)
+        self.assertEqual(second.stat("/etc/passwd").st_size, original)
+
+    def test_real_file_initialization_is_private(self) -> None:
+        first, second = self._sessions()
+        with tempfile.TemporaryDirectory() as tempdir:
+            etc = Path(tempdir) / "etc"
+            etc.mkdir()
+            real_passwd = etc / "passwd"
+            real_passwd.write_bytes(b"operator override")
+            first.init_honeyfs(tempdir)
+            self.assertEqual(first.file_contents("/etc/passwd"), b"operator override")
+            self.assertNotEqual(
+                second.file_contents("/etc/passwd"), b"operator override"
+            )
+
