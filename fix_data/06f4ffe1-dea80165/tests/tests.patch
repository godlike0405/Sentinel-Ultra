+    def test_reapplying_contents_replaces_the_previous_overlay(self) -> None:
+        with tempfile.TemporaryDirectory() as tempdir:
+            os.environ.pop(ENV_CONTENTS_PATH, None)
+            bundled_passwd = fs.HoneyPotFilesystem("arch", "/root").file_contents(
+                "/etc/passwd"
+            )
+
+            first_root = Path(tempdir) / "first"
+            first_root.mkdir()
+            first_path, first_files = self._contents_with_new_paths(
+                str(first_root), "first", file_count=1
+            )
+            second_root = Path(tempdir) / "second"
+            second_root.mkdir()
+            second_nested = second_root / "operator-only" / "second" / "nested"
+            second_nested.mkdir(parents=True)
+            second_contents = b"second-only-file"
+            (second_nested / "only.txt").write_bytes(second_contents)
+            second_virtual_path = "/operator-only/second/nested/only.txt"
+
+            os.environ[ENV_CONTENTS_PATH] = first_path
+            changing = fs.HoneyPotFilesystem("arch", "/root")
+            unchanged = fs.HoneyPotFilesystem("arch", "/root")
+            changing.mkfile("/tmp/session-file", 0, 0, 0, 0o640)
+
+            changing.init_honeyfs(str(second_root))
+
+            self.assertEqual(changing.file_contents("/etc/passwd"), bundled_passwd)
+            self.assertFalse(changing.exists(first_files[0][0]))
+            self.assertEqual(
+                changing.file_contents(second_virtual_path), second_contents
+            )
+            self.assertTrue(changing.exists("/tmp/session-file"))
+            self.assertEqual(
+                unchanged.file_contents("/etc/passwd"), b"operator-passwd-first"
+            )
+            self.assertEqual(
+                unchanged.file_contents(first_files[0][0]), first_files[0][1]
+            )
+            self.assertFalse(unchanged.exists(second_virtual_path))
