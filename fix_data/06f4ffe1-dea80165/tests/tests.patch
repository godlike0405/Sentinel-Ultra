+    def test_rename_type_safety_and_failure_atomicity_contract(self) -> None:
+        filesystem = fs.HoneyPotFilesystem("arch", "/root")
+
+        filesystem.mkfile("/tmp/file-source", 0, 0, 10, 0o644)
+        filesystem.mkdir("/tmp/directory-destination", 0, 0, 4096, 0o755)
+        with self.assertRaises(OSError):
+            filesystem.rename("/tmp/file-source", "/tmp/directory-destination")
+        self.assertTrue(filesystem.isfile("/tmp/file-source"))
+        self.assertTrue(filesystem.isdir("/tmp/directory-destination"))
+
+        filesystem.mkdir("/tmp/directory-source", 0, 0, 4096, 0o755)
+        filesystem.mkfile("/tmp/file-destination", 0, 0, 20, 0o600)
+        with self.assertRaises(OSError):
+            filesystem.rename("/tmp/directory-source", "/tmp/file-destination")
+        self.assertTrue(filesystem.isdir("/tmp/directory-source"))
+        self.assertTrue(filesystem.isfile("/tmp/file-destination"))
+
+        filesystem.mkdir("/tmp/tree-source", 0, 0, 4096, 0o755)
+        filesystem.mkfile("/tmp/tree-source/child", 0, 0, 7, 0o640)
+        filesystem.mkdir("/tmp/nonempty-target", 0, 0, 4096, 0o755)
+        filesystem.mkfile("/tmp/nonempty-target/keep", 0, 0, 9, 0o640)
+        with self.assertRaises(OSError):
+            self._sftp(filesystem).renameFile(
+                "/tmp/tree-source", "/tmp/nonempty-target"
+            )
+        self.assertTrue(filesystem.exists("/tmp/tree-source/child"))
+        self.assertTrue(filesystem.exists("/tmp/nonempty-target/keep"))
+
+        filesystem.mkdir("/tmp/tree-source/descendant", 0, 0, 4096, 0o755)
+        with self.assertRaises(OSError):
+            filesystem.rename("/tmp/tree-source", "/tmp/tree-source/descendant/moved")
+        self.assertTrue(filesystem.exists("/tmp/tree-source/child"))
+        self.assertTrue(filesystem.isdir("/tmp/tree-source/descendant"))
+
+        filesystem.mkdir("/tmp/empty-target", 0, 0, 4096, 0o755)
+        filesystem.rename("/tmp/tree-source", "/tmp/empty-target")
+        self.assertFalse(filesystem.exists("/tmp/tree-source"))
+        self.assertTrue(filesystem.exists("/tmp/empty-target/child"))
+        self.assertTrue(filesystem.isdir("/tmp/empty-target/descendant"))
+
+        proto, _transport = self._shell()
+        proto.fs.mkdir("/tmp/shell-tree", 0, 0, 4096, 0o755)
+        proto.fs.mkfile("/tmp/shell-tree/child", 0, 0, 3, 0o640)
+        proto.fs.mkdir("/tmp/shell-tree/descendant", 0, 0, 4096, 0o755)
+        with self.assertRaises(OSError):
+            proto.lineReceived(b"mv /tmp/shell-tree /tmp/shell-tree/descendant/moved\n")
+        self.assertTrue(proto.fs.exists("/tmp/shell-tree/child"))
+        self.assertTrue(proto.fs.isdir("/tmp/shell-tree/descendant"))
+
