+class PublicInterfaceBehaviorTests(unittest.TestCase):
+    def _shell(
+        self, server: FakeServer | None = None
+    ) -> tuple[HoneyPotInteractiveProtocol, FakeTransport]:
+        proto = HoneyPotInteractiveProtocol(FakeAvatar(server or FakeServer()))
+        transport = FakeTransport("", "31337")
+        proto.makeConnection(transport)
+        transport.clear()
+        self.addCleanup(proto.connectionLost)
+        return proto, transport
+
+    def _sftp(self, filesystem: fs.HoneyPotFilesystem) -> SFTPServerForCowrieUser:
+        server = SFTPServerForCowrieUser.__new__(SFTPServerForCowrieUser)
+        server.fs = filesystem
+        server.avatar = SimpleNamespace(home="/root")
+        return server
+
+    def test_shell_mv_overwrites_an_existing_destination(self) -> None:
+        proto, _transport = self._shell()
+        proto.fs.mkfile("/tmp/mv-source", 0, 0, 10, 0o644)
+        proto.fs.mkfile("/tmp/mv-destination", 0, 0, 20, 0o600)
+        proto.lineReceived(b"mv /tmp/mv-source /tmp/mv-destination\n")
+        self.assertFalse(proto.fs.exists("/tmp/mv-source"))
+        self.assertEqual(proto.fs.listdir("/tmp").count("mv-destination"), 1)
+        self.assertEqual(proto.fs.stat("/tmp/mv-destination").st_size, 10)
+
+    def test_shell_mv_overwrites_across_directories(self) -> None:
+        proto, _transport = self._shell()
+        proto.fs.mkfile("/tmp/mv-source", 0, 0, 10, 0o644)
+        proto.fs.mkfile("/root/mv-destination", 0, 0, 20, 0o600)
+        proto.lineReceived(b"mv /tmp/mv-source /root/mv-destination\n")
+        self.assertFalse(proto.fs.exists("/tmp/mv-source"))
+        self.assertEqual(proto.fs.listdir("/root").count("mv-destination"), 1)
+        self.assertEqual(proto.fs.stat("/root/mv-destination").st_size, 10)
+
+    def test_shell_mv_into_directory_replaces_same_named_entry(self) -> None:
+        proto, _transport = self._shell()
+        proto.fs.mkfile("/tmp/mv-source", 0, 0, 10, 0o644)
+        proto.fs.mkdir("/tmp/mv-target", 0, 0, 4096, 0o755)
+        proto.fs.mkfile("/tmp/mv-target/mv-source", 0, 0, 20, 0o600)
+        proto.lineReceived(b"mv /tmp/mv-source /tmp/mv-target\n")
+        self.assertFalse(proto.fs.exists("/tmp/mv-source"))
+        self.assertEqual(proto.fs.listdir("/tmp/mv-target").count("mv-source"), 1)
+        self.assertEqual(proto.fs.stat("/tmp/mv-target/mv-source").st_size, 10)
+
+    def test_shell_rm_detaches_only_the_active_session(self) -> None:
+        first_server = FakeServer()
+        second_server = FakeServer()
+        proto, _transport = self._shell(first_server)
+        proto.lineReceived(b"rm /etc/passwd\n")
+        self.assertFalse(first_server.fs.exists("/etc/passwd"))
+        self.assertTrue(second_server.fs.exists("/etc/passwd"))
+
+    def test_shell_cp_detaches_only_the_active_session(self) -> None:
+        first_server = FakeServer()
+        second_server = FakeServer()
+        proto, _transport = self._shell(first_server)
+        proto.lineReceived(b"cp /etc/passwd /tmp/passwd-copy\n")
+        self.assertTrue(first_server.fs.exists("/tmp/passwd-copy"))
+        self.assertFalse(second_server.fs.exists("/tmp/passwd-copy"))
+
+    def test_shell_chmod_does_not_affect_other_session(self) -> None:
+        first_server = FakeServer()
+        second_server = FakeServer()
+        original = second_server.fs.stat("/etc/passwd").st_mode
+        proto, _transport = self._shell(first_server)
+        proto.lineReceived(b"chmod 0600 /etc/passwd\n")
+        self.assertEqual(first_server.fs.stat("/etc/passwd").st_mode & 0o777, 0o600)
+        self.assertEqual(second_server.fs.stat("/etc/passwd").st_mode, original)
+
+    def test_shell_rmdir_detaches_only_the_active_session(self) -> None:
+        first_server = FakeServer()
+        second_server = FakeServer()
+        proto, _transport = self._shell(first_server)
+        proto.lineReceived(b"rmdir /tmp\n")
+        self.assertFalse(first_server.fs.exists("/tmp"))
+        self.assertTrue(second_server.fs.isdir("/tmp"))
