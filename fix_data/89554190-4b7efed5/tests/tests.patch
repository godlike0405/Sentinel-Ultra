+			expect(result.date).toBeInstanceOf(Date);
+			expect(result.sunrise).toBeInstanceOf(Date);
+			expect(result.sunset).toBeInstanceOf(Date);
+			expect(Number.isNaN(result.date.getTime())).toBe(false);
+			expect(Number.isNaN(result.sunrise.getTime())).toBe(false);
+			expect(Number.isNaN(result.sunset.getTime())).toBe(false);
+		});
+
+		it("should report an error when no usable current record remains", async () => {
+			const provider = new BuienradarProvider({ locationId: 6275, type: "current" });
+			const onData = vi.fn();
+			const errorPromise = new Promise((resolve) => provider.setCallbacks(onData, resolve));
+			const payload = buildBuienradarResponse();
+			payload.days[0].hours = [
+				{ datetime: "invalid-one", temperature: 10 },
+				{ datetime: "", temperature: 11 }
+			];
+
+			server.use(http.get(BUIENRADAR_URL, () => HttpResponse.json(payload)));
+			provider.initialize();
+			provider.start();
+
+			const error = await errorPromise;
+			expect(onData).not.toHaveBeenCalled();
+			expect(error).toEqual(expect.objectContaining({
+				message: expect.stringMatching(/\S/),
+				translationKey: expect.stringMatching(/\S/)
+			}));
+		});
+
+		it("should strictly parse numeric strings while preserving zero and negatives", async () => {
+			const provider = new BuienradarProvider({ locationId: 6275, type: "current" });
+
+			const dataPromise = new Promise((resolve) => {
+				provider.setCallbacks(resolve, vi.fn());
+			});
+
+			const payload = buildBuienradarResponse();
+			payload.days[0].hours = [
+				{
+					datetime: "2100-01-01T12:00:00",
+					temperature: "12.5C",
+					humidity: "",
+					windspeedms: false,
+					winddirectiondegrees: "0",
+					precipitationmm: "-1.25",
+					precipitation: "Infinity",
+					iconcode: "a"
+				}
+			];
+			payload.days[0].mintemp = "-3";
+			payload.days[0].maxtemp = {};
+
+			server.use(
+				http.get(BUIENRADAR_URL, () => HttpResponse.json(payload))
+			);
+
+			provider.initialize();
+			provider.start();
+
+			const result = await dataPromise;
+
+			expect(result.temperature).toBeUndefined();
+			expect(result.humidity).toBeUndefined();
+			expect(result.windSpeed).toBeUndefined();
+			expect(result.windFromDirection).toBe(0);
+			expect(result.precipitationAmount).toBe(-1.25);
+			expect(result.precipitationProbability).toBeUndefined();
+			expect(result.minTemperature).toBe(-3);
+			expect(result.maxTemperature).toBeUndefined();
+		});
+	});
+
