+
+		it("should ignore invalid current candidates and emit valid dates", async () => {
+			const provider = new BuienradarProvider({ locationId: 6275, type: "current" });
+			const payload = buildBuienradarResponse();
+			payload.days[0].hours = [{ datetime: "not-a-date", temperature: 99, iconcode: "a" }];
+			payload.days[1].hours = [{ datetime: "2100-01-02T13:00:00", temperature: 7, iconcode: "b" }];
+
+			const dataPromise = new Promise((resolve) => {
+				provider.setCallbacks(resolve, vi.fn());
+			});
+
+			server.use(
+				http.get(BUIENRADAR_URL, () => HttpResponse.json(payload))
