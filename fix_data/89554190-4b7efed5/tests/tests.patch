+/**
+ * Buienradar Provider Tests
+ *
+ * Tests data parsing for current, forecast, and hourly weather types.
+ * Buienradar covers NL/BE only, metric system, no API key required.
+ */
+import { http, HttpResponse } from "msw";
+import { setupServer } from "msw/node";
+import { describe, it, expect, vi, beforeAll, afterAll, afterEach } from "vitest";
+
+const BUIENRADAR_URL = "https://forecast.buienradar.nl/2.0/forecast/*";
+
+/**
+ * Builds a stable Buienradar mock payload for parsing tests.
+ * @returns {object} Buienradar forecast response fixture.
+ */
+function buildBuienradarResponse () {
+	const today = "2100-01-01";
+	const tomorrow = "2100-01-02";
+
+	const makeHour = (datetime, overrides = {}) => ({
+		datetime,
+		temperature: "5",
+		feeltemperature: "3",
+		humidity: "80",
+		windspeedms: "4",
+		winddirectiondegrees: "180",
+		precipitationmm: "0.5",
+		precipitation: "60",
+		iconcode: "a",
+		...overrides
+	});
+
+	return {
+		location: {
+			name: "Rotterdam",
+			lat: 51.92,
+			lon: 4.48
+		},
+		days: [
+			{
+				date: today,
+				sunrise: `${today}T07:00:00`,
+				sunset: `${today}T17:00:00`,
+				mintemp: "1",
+				maxtemp: "8",
+				humidity: "75",
+				windspeedms: "5",
+				winddirectiondegrees: "200",
+				precipitationmm: "2.5",
+				precipitation: "70",
+				iconcode: "b",
+				hours: [
+					makeHour(`${today}T12:00:00`, { temperature: 6, iconcode: "a" }),
+					makeHour(`${today}T13:00:00`, { temperature: 7, iconcode: "b" }),
+					makeHour(`${today}T14:00:00`, { temperature: 7.5, iconcode: "c" })
+				]
+			},
+			{
+				date: tomorrow,
+				sunrise: `${tomorrow}T07:01:00`,
+				sunset: `${tomorrow}T17:02:00`,
+				mintemp: "0",
+				maxtemp: "6",
+				windspeedms: "6",
+				winddirectiondegrees: "220",
+				precipitationmm: "1.0",
+				precipitation: "40",
+				iconcode: "f",
+				hours: []
+			}
+		]
+	};
+}
+
+let server;
+
+beforeAll(() => {
+	server = setupServer();
+	server.listen({ onUnhandledRequest: "bypass" });
+});
+
+afterAll(() => {
+	server.close();
+});
+
+afterEach(() => {
+	server.resetHandlers();
+});
+
+describe("BuienradarProvider", () => {
+	let BuienradarProvider;
+
+	beforeAll(async () => {
+		const module = await import("../../../../../../defaultmodules/weather/providers/buienradar");
+		BuienradarProvider = module.default;
+	});
+
+	describe("Constructor & Configuration", () => {
+		it("should apply defaults while allowing configuration overrides", () => {
+			const defaults = new BuienradarProvider({ locationId: 6275 });
+			expect(() => defaults.start()).not.toThrow();
+			expect(() => defaults.stop()).not.toThrow();
+			expect(defaults.config.apiBase).toBe("https://forecast.buienradar.nl/2.0/forecast");
+			expect(defaults.config.type).toBe("current");
+			expect(defaults.config.maxEntries).toBe(5);
+			expect(defaults.config.updateInterval).toBe(10 * 60 * 1000);
+
+			const customized = new BuienradarProvider({
+				apiBase: "https://weather.example.test",
+				locationId: 1234,
+				type: "hourly",
+				maxEntries: 9,
+				updateInterval: 123456
+			});
+			expect(customized.config).toEqual(expect.objectContaining({
+				apiBase: "https://weather.example.test",
+				locationId: 1234,
+				type: "hourly",
+				maxEntries: 9,
+				updateInterval: 123456
+			}));
+		});
+
+		it("should use the configured endpoint and location when started", async () => {
+			const provider = new BuienradarProvider({
+				apiBase: "https://weather.example.test/forecast/",
+				locationId: 1234,
+				updateInterval: 123456
+			});
+			const requestPromise = new Promise((resolve) => {
+				server.use(http.get("https://weather.example.test/forecast/*", ({ request }) => {
+					resolve(request.url);
+					return HttpResponse.json(buildBuienradarResponse());
+				}));
+			});
+			provider.setCallbacks(vi.fn(), vi.fn());
+
+			provider.initialize();
+			provider.start();
+
+			const requestedUrl = new URL(await requestPromise);
+			expect(requestedUrl.origin).toBe("https://weather.example.test");
+			expect(requestedUrl.pathname).toBe("/forecast/1234");
+			expect(provider.config.updateInterval).toBe(123456);
+			provider.stop();
+		});
+
+		it("should fetch repeatedly after start and stop future fetches", async () => {
+			const previousTestMode = process.env.mmTestMode;
+			process.env.mmTestMode = "false";
+			const provider = new BuienradarProvider({ locationId: 6275, updateInterval: 30 });
+			let requestCount = 0;
+			const onData = vi.fn();
+			let releaseSecondResponse;
+			let markSecondRequestStarted;
+			const secondRequestStarted = new Promise((resolve) => {
+				markSecondRequestStarted = resolve;
+			});
+			const secondResponseReleased = new Promise((resolve) => {
+				releaseSecondResponse = resolve;
+			});
+			provider.setCallbacks(onData, vi.fn());
+			server.use(http.get(BUIENRADAR_URL, async () => {
+				requestCount += 1;
+				if (requestCount === 2) {
+					markSecondRequestStarted();
+					await secondResponseReleased;
+				}
+				return HttpResponse.json(buildBuienradarResponse());
+			}));
+
+			try {
+				provider.initialize();
+				provider.start();
+				await secondRequestStarted;
+				provider.stop();
+				releaseSecondResponse();
+				await new Promise((resolve) => setTimeout(resolve, 80));
+				expect(requestCount).toBe(2);
+				expect(onData).toHaveBeenCalledTimes(1);
+			} finally {
+				provider.stop();
+				if (previousTestMode === undefined) delete process.env.mmTestMode;
+				else process.env.mmTestMode = previousTestMode;
+			}
+		});
+
+		it("should call error callback when locationId is missing", () => {
+			const provider = new BuienradarProvider({});
+			const onData = vi.fn();
+			const onError = vi.fn();
+			let requestCount = 0;
+			server.use(http.get(BUIENRADAR_URL, () => {
+				requestCount += 1;
+				return HttpResponse.json(buildBuienradarResponse());
+			}));
+			provider.setCallbacks(onData, onError);
+			provider.initialize();
+			expect(onError).toHaveBeenCalledWith(expect.objectContaining({
+				translationKey: expect.stringMatching(/\S/)
+			}));
+			expect(onData).not.toHaveBeenCalled();
+			expect(requestCount).toBe(0);
+			expect(() => provider.start()).not.toThrow();
+			expect(() => provider.stop()).not.toThrow();
+		});
+	});
+
