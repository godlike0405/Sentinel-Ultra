+#!/usr/bin/env python3
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+from typing import Callable
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--workspace", required=True)
+    parser.add_argument("--build-dir", required=True)
+    parser.add_argument("--results", required=True)
+    parser.add_argument("--cmake", default="cmake")
+    parser.add_argument("--ctest", default="ctest")
+    parser.add_argument("--cc", default="cc")
+    args = parser.parse_args()
+
+    workspace = Path(args.workspace).resolve()
+    build_dir = Path(args.build_dir).resolve()
+    results: list[dict[str, str]] = []
+
+    def run(
+        command: list[str],
+        *,
+        timeout: int = 600,
+        extra_env: dict[str, str] | None = None,
+    ) -> subprocess.CompletedProcess[str]:
+        env = os.environ.copy()
+        env.update({"LC_ALL": "C", "LANG": "C"})
+        if extra_env:
+            env.update(extra_env)
+        return subprocess.run(
+            command,
+            cwd=workspace,
+            env=env,
+            text=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=timeout,
+            check=False,
+        )
+
+    def require_success(completed: subprocess.CompletedProcess[str], context: str) -> None:
+        if completed.returncode != 0:
+            output = (completed.stdout + "\n" + completed.stderr)[-6000:]
+            raise AssertionError(f"{context} failed with {completed.returncode}:\n{output}")
+
+    def record(name: str, check: Callable[[], None]) -> None:
+        try:
+            check()
+        except Exception as exc:
+            results.append({"name": name, "status": "FAILED", "detail": str(exc)[-6000:]})
+            print(f"FAILED {name}: {exc}", file=sys.stderr)
+        else:
+            results.append({"name": name, "status": "PASSED", "detail": ""})
+            print(f"PASSED {name}")
+
+    def run_ctest(
+        test_name: str,
+        *,
+        extra_env: dict[str, str] | None = None,
+    ) -> subprocess.CompletedProcess[str]:
+        return run(
+            [
+                args.ctest,
+                "--test-dir",
+                str(build_dir),
+                "--output-on-failure",
+                "-R",
+                f"^{re.escape(test_name)}$",
+            ],
+            timeout=900,
+            extra_env=extra_env,
+        )
+
+    def build_and_run_ctest(target: str, test_name: str | None = None) -> None:
+        test_name = test_name or target
+        built = run(
+            [args.cmake, "--build", str(build_dir), "--parallel", "4", "--target", target],
+            timeout=900,
+        )
+        require_success(built, f"building {target}")
+        listing = run([args.ctest, "--test-dir", str(build_dir), "-N", "-R", f"^{re.escape(test_name)}$"])
+        require_success(listing, f"listing {test_name}")
+        if not re.search(r"Total Tests:\s*1\s*$", listing.stdout, re.MULTILINE):
+            raise AssertionError(f"CTest did not register exactly one {test_name} test:\n{listing.stdout[-4000:]}")
+        for attempt in range(2):
+            executed = run_ctest(test_name)
+            require_success(executed, f"running CTest {test_name} (attempt {attempt + 1})")
+
+    record(
+        "sentinel::existing_gnuabi_sse2",
+        lambda: build_and_run_ctest("gnuabi_compatibility_SSE2"),
+    )
+    record(
+        "sentinel::existing_gnuabi_avx2",
+        lambda: build_and_run_ctest("gnuabi_compatibility_AVX2"),
+    )
+
+    def build_and_smoke_legacy_tester(
+        target: str,
+        command: list[str],
+        *,
+        progress_text: str | None = None,
+    ) -> None:
+        build_targets = [target, "iut"] if target == "tester" else [target]
+        built = run(
+            [
+                args.cmake,
+                "--build",
+                str(build_dir),
+                "--parallel",
+                "4",
+                "--target",
+                *build_targets,
+            ],
+            timeout=900,
+        )
+        require_success(built, f"building pre-existing {target}")
+        env = os.environ.copy()
+        env.update({"LC_ALL": "C", "LANG": "C"})
+        process = subprocess.Popen(
+            command,
+            cwd=workspace,
+            env=env,
+            text=True,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            start_new_session=True,
+        )
+        try:
+            stdout, stderr = process.communicate(timeout=4)
+        except subprocess.TimeoutExpired:
+            os.killpg(process.pid, signal.SIGTERM)
+            try:
+                stdout, stderr = process.communicate(timeout=5)
+            except subprocess.TimeoutExpired:
+                os.killpg(process.pid, signal.SIGKILL)
+                stdout, stderr = process.communicate(timeout=5)
+        else:
+            output = (stdout + "\n" + stderr)[-6000:]
+            raise AssertionError(
+                f"pre-existing {target} exited unexpectedly with {process.returncode}:\n{output}"
+            )
+        if progress_text is not None and progress_text not in stdout + stderr:
+            raise AssertionError(f"pre-existing {target} produced no expected test progress")
+
+    record(
+        "sentinel::existing_tester_smoke",
+        lambda: build_and_smoke_legacy_tester(
+            "tester",
+            [str(build_dir / "bin" / "tester"), str(build_dir / "bin" / "iut")],
+            progress_text="denormal/nonnumber test",
+        ),
+    )
+    record(
+        "sentinel::existing_tester2_dp_smoke",
+        lambda: build_and_smoke_legacy_tester(
+            "tester2sse2dp",
+            [str(build_dir / "bin" / "tester2sse2dp")],
+        ),
+    )
+    record(
+        "sentinel::existing_tester2_sp_smoke",
+        lambda: build_and_smoke_legacy_tester(
+            "tester2sse2sp",
+            [str(build_dir / "bin" / "tester2sse2sp")],
+        ),
+    )
+
+    tester3_targets = [
+        "tester3purec_scalar",
+        "tester3purecfma_scalar",
+        "tester3sse2",
+        "tester3sse4",
+        "tester3avx",
+        "tester3avx2128",
+        "tester3avx2",
+        "tester3avx512f",
+        "tester3avx512fnofma",
+    ]
+    tester3_target_features = {
+        "tester3purec_scalar": set(),
+        "tester3purecfma_scalar": {"fma"},
+        "tester3sse2": {"sse2"},
+        "tester3sse4": {"sse4_1"},
+        "tester3avx": {"avx"},
+        "tester3avx2128": {"avx2", "fma"},
+        "tester3avx2": {"avx2", "fma"},
+        "tester3avx512f": {"avx512f", "fma"},
+        "tester3avx512fnofma": {"avx512f"},
+    }
+
+    def host_cpu_features() -> set[str]:
+        cpuinfo = Path("/proc/cpuinfo").read_text(encoding="ascii", errors="ignore").lower()
+        return set(
+            " ".join(
+                line.split(":", 1)[1]
+                for line in cpuinfo.splitlines()
+                if ":" in line and line.split(":", 1)[0].strip() in {"flags", "features"}
+            ).split()
+        )
+
+    for target in tester3_targets:
+        record(
+            f"sentinel::target_{target}",
+            lambda target=target: build_and_run_ctest(target),
+        )
+
+    purec_binary = build_dir / "bin" / "tester3purec_scalar"
+
+    def imported_inverse_trig_contracts(binary: Path) -> dict[tuple[str, str, str], str]:
+        symbols = run(["nm", "-D", str(binary)])
+        require_success(symbols, "inspecting tester3's dynamic imports")
+        imported: set[str] = set()
+        for line in symbols.stdout.splitlines():
+            match = re.search(r"\bU\s+(Sleef_[A-Za-z0-9_]+)\s*$", line)
+            if match and ("asin" in match.group(1) or "acos" in match.group(1)):
+                imported.add(match.group(1))
+        contracts: dict[tuple[str, str, str], list[str]] = {}
+        for name in imported:
+            match = re.search(r"(asin|acos)([df])\d+_u(10|35)", name)
+            if match is None:
+                continue
+            contracts.setdefault(match.groups(), []).append(name)
+        expected = {
+            (operation, precision, accuracy)
+            for operation in ("asin", "acos")
+            for precision in ("d", "f")
+            for accuracy in ("10", "35")
+        }
+        missing = sorted(expected - set(contracts))
+        duplicates = {key: names for key, names in contracts.items() if len(names) != 1}
+        if missing or duplicates:
+            raise AssertionError(
+                "tester3 does not exercise exactly one implementation for every inverse-trig "
+                f"operation/precision/accuracy contract: missing={missing}, "
+                f"duplicates={duplicates}, imported={sorted(imported)}"
+            )
+        return {key: names[0] for key, names in contracts.items()}
+
+    def check_deterministic_acos_abi() -> None:
+        imported = set(imported_inverse_trig_contracts(purec_binary).values())
+        asin_symbols = {name for name in imported if "asin" in name}
+        expected_acos = {name.replace("asin", "acos", 1) for name in asin_symbols}
+        missing_imports = sorted(expected_acos - imported)
+        if missing_imports:
+            raise AssertionError(f"tester3 does not use deterministic acos counterparts {missing_imports}")
+        library = build_dir / "lib" / "libsleef.so"
+        exports = run(["nm", "-D", "--defined-only", str(library)])
+        require_success(exports, "inspecting libsleef's dynamic exports")
+        exported_names = {line.split()[-1] for line in exports.stdout.splitlines() if line.split()}
+        missing_exports = sorted(expected_acos - exported_names)
+        if missing_exports:
+            raise AssertionError(f"libsleef does not export deterministic acos counterparts {missing_exports}")
+
+    record("sentinel::deterministic_acos_abi", check_deterministic_acos_abi)
+
+    def check_tester3_family_rejects_drift() -> None:
+        cpu_features = host_cpu_features()
+        shapes = (
+            ("asin_d_u35", r"asind\d+_u35", "d"),
+            ("asin_d_u10", r"asind\d+_u10", "d"),
+            ("acos_d_u35", r"acosd\d+_u35", "d"),
+            ("acos_d_u10", r"acosd\d+_u10", "d"),
+            ("asin_f_u35", r"asinf\d+_u35", "f"),
+            ("asin_f_u10", r"asinf\d+_u10", "f"),
+            ("acos_f_u35", r"acosf\d+_u35", "f"),
+            ("acos_f_u10", r"acosf\d+_u10", "f"),
+        )
+        for target in tester3_targets:
+            binary = build_dir / "bin" / target
+            imported = set(imported_inverse_trig_contracts(binary).values())
+            for shape_index, (shape, pattern, precision) in enumerate(shapes):
+                selected = sorted(name for name in imported if re.search(pattern, name))
+                if not selected:
+                    raise AssertionError(f"{target} has no imported {shape} implementation")
+                with tempfile.TemporaryDirectory(
+                    prefix=f"sentinel-{target}-{shape}-interpose-"
+                ) as tmp:
+                    temp_dir = Path(tmp)
+                    source = temp_dir / "interpose.s"
+                    marker_source = temp_dir / "marker.c"
+                    marker = temp_dir / "calls"
+                    library = temp_dir / "interpose.so"
+                    assembly = [".text"]
+                    for symbol_index, name in enumerate(selected):
+                        nonnegative = f".Lnonnegative_{shape_index}_{symbol_index}"
+                        finished = f".Lfinished_{shape_index}_{symbol_index}"
+                        assembly.extend(
+                            [
+                                f".globl {name}",
+                                f".type {name}, @function",
+                                f"{name}:",
+                                "  mov sentinel_count@GOTPCREL(%rip), %rax",
+                                "  addq $1, (%rax)",
+                            ]
+                        )
+                        if precision == "d":
+                            assembly.extend(
+                                [
+                                    "  movq %xmm0, %rdx",
+                                    "  movq %rdx, %rcx",
+                                    "  btrq $63, %rcx",
+                                    "  testq %rcx, %rcx",
+                                    f"  jz {finished}",
+                                    "  movabsq $0x3ff0000000000000, %r8",
+                                    "  cmpq %r8, %rcx",
+                                    f"  ja {finished}",
+                                ]
+                            )
+                        else:
+                            assembly.extend(
+                                [
+                                    "  movd %xmm0, %edx",
+                                    "  movl %edx, %ecx",
+                                    "  andl $0x7fffffff, %ecx",
+                                    "  testl %ecx, %ecx",
+                                    f"  jz {finished}",
+                                    "  cmpl $0x3f800000, %ecx",
+                                    f"  ja {finished}",
+                                ]
+                            )
+                        assembly.extend(
+                            [
+                                "  mov sentinel_domain_count@GOTPCREL(%rip), %rax",
+                                "  addq $1, (%rax)",
+                                "  mov sentinel_domain_signs@GOTPCREL(%rip), %rax",
+                            ]
+                        )
+                        if precision == "d":
+                            assembly.append("  btq $63, %rdx")
+                        else:
+                            assembly.append("  btl $31, %edx")
+                        assembly.extend(
+                            [
+                                f"  jnc {nonnegative}",
+                                "  orl $1, (%rax)",
+                                f"  jmp {finished}",
+                                f"{nonnegative}:",
+                                "  orl $2, (%rax)",
+                                f"{finished}:",
+                                "  ret",
+                            ]
+                        )
+                    assembly.append('.section .note.GNU-stack,"",@progbits')
+                    source.write_text("\n".join(assembly) + "\n", encoding="ascii")
+                    marker_source.write_text(
+                        "#include <fcntl.h>\n"
+                        "#include <stdio.h>\n"
+                        "#include <unistd.h>\n"
+                        "volatile unsigned long long sentinel_count = 0;\n"
+                        "volatile unsigned long long sentinel_domain_count = 0;\n"
+                        "volatile unsigned sentinel_domain_signs = 0;\n"
+                        "__attribute__((destructor)) static void sentinel_done(void) {\n"
+                        "  if (sentinel_count) {\n"
+                        f"    int fd = open({json.dumps(str(marker))}, O_WRONLY | O_CREAT | O_TRUNC, 0600);\n"
+                        "    if (fd >= 0) {\n"
+                        "      dprintf(fd, \"%llu %llu %u\\n\", sentinel_count, "
+                        "sentinel_domain_count, sentinel_domain_signs);\n"
+                        "      close(fd);\n"
+                        "    }\n"
+                        "  }\n"
+                        "}\n",
+                        encoding="ascii",
+                    )
+                    compiled = run(
+                        [
+                            args.cc,
+                            "-shared",
+                            "-fPIC",
+                            str(source),
+                            str(marker_source),
+                            "-o",
+                            str(library),
+                        ]
+                    )
+                    require_success(
+                        compiled,
+                        f"building the {shape} public-ABI result interposer for {target}",
+                    )
+                    executed = run_ctest(target, extra_env={"LD_PRELOAD": str(library)})
+                    call_data = marker.read_text(encoding="ascii").split() if marker.exists() else []
+                if call_data:
+                    count, domain_count, domain_signs = (int(value) for value in call_data)
+                    if domain_count < 2 or domain_signs != 3:
+                        raise AssertionError(
+                            f"{target} exercised {shape} too narrowly over its valid domain: "
+                            f"count={count}, domain_count={domain_count}, "
+                            f"domain_signs={domain_signs}"
+                        )
+                    if executed.returncode == 0:
+                        raise AssertionError(f"{target} accepted deliberately altered {shape} results")
+                else:
+                    missing_features = sorted(tester3_target_features[target] - cpu_features)
+                    if not missing_features:
+                        raise AssertionError(
+                            f"{target} never executed {shape} on a supported CPU"
+                        )
+                    if executed.returncode != 0:
+                        raise AssertionError(
+                            f"{target} did not exit cleanly when CPU features "
+                            f"{missing_features} were unavailable:\n"
+                            f"{(executed.stdout + executed.stderr)[-4000:]}"
+                        )
+
+    record("sentinel::tester3_family_rejects_drift", check_tester3_family_rejects_drift)
+
+    def check_tester3_expectations_are_invocation_independent() -> None:
+        cpu_features = host_cpu_features()
+        with tempfile.TemporaryDirectory(prefix="sentinel-ambient-math-") as tmp:
+            temp_dir = Path(tmp)
+            source = temp_dir / "ambient_math.c"
+            library = temp_dir / "ambient_math.so"
+            probe_source = temp_dir / "probe.c"
+            probe = temp_dir / "probe"
+            source.write_text(
+                "double asin(double value) { (void)value; return 0.125; }\n"
+                "double acos(double value) { (void)value; return 1.25; }\n"
+                "float asinf(float value) { (void)value; return -0.25f; }\n"
+                "float acosf(float value) { (void)value; return 1.5f; }\n"
+                "long double asinl(long double value) { (void)value; return 0.375L; }\n"
+                "long double acosl(long double value) { (void)value; return 1.75L; }\n",
+                encoding="ascii",
+            )
+            compiled = run(
+                [args.cc, "-shared", "-fPIC", str(source), "-o", str(library)]
+            )
+            require_success(compiled, "building the ambient reference-math interposer")
+            probe_source.write_text(
+                "#include <math.h>\n"
+                "static volatile double input_d = 0.25;\n"
+                "static volatile float input_f = 0.25f;\n"
+                "int main(void) {\n"
+                "  double d = input_d; float f = input_f;\n"
+                "  return !(asin(d) == 0.125 && acos(d) == 1.25 &&\n"
+                "            asinf(f) == -0.25f && acosf(f) == 1.5f);\n"
+                "}\n",
+                encoding="ascii",
+            )
+            compiled = run(
+                [args.cc, "-O0", "-fno-builtin", str(probe_source), "-o", str(probe), "-lm"]
+            )
+            require_success(compiled, "building the ambient reference-math probe")
+            poisoned_env = {"LD_PRELOAD": str(library)}
+            activated = run([str(probe)], extra_env=poisoned_env)
+            require_success(activated, "activating the ambient reference-math interposer")
+            for target in tester3_targets:
+                if tester3_target_features[target] - cpu_features:
+                    continue
+                imported_inverse_trig_contracts(build_dir / "bin" / target)
+                executed = run_ctest(target, extra_env=poisoned_env)
+                require_success(
+                    executed,
+                    f"running {target} with altered ambient reference-math results",
+                )
+
+    record(
+        "sentinel::tester3_expectations_are_invocation_independent",
+        check_tester3_expectations_are_invocation_independent,
+    )
+
+    def check_tester3_snapshot_contract() -> None:
+        cpu_features = host_cpu_features()
+        with tempfile.TemporaryDirectory(prefix="sentinel-snapshots-") as tmp:
+            temp_dir = Path(tmp)
+            for target in tester3_targets:
+                if tester3_target_features[target] - cpu_features:
+                    continue
+                binary = build_dir / "bin" / target
+                imported_inverse_trig_contracts(binary)
+                first = run([str(binary)], timeout=900)
+                require_success(first, f"generating a snapshot with {target}")
+                second = run([str(binary)], timeout=900)
+                require_success(second, f"regenerating a snapshot with {target}")
+                if not first.stdout or first.stdout != second.stdout:
+                    raise AssertionError(
+                        f"{target} did not emit a stable non-empty expectation snapshot"
+                    )
+                snapshot = first.stdout
+                snapshot_path = temp_dir / f"{target}.snapshot"
+                snapshot_path.write_text(snapshot, encoding="utf-8")
+                snapshot_path.chmod(0o444)
+                original_bytes = snapshot_path.read_bytes()
+
+                characters = list(snapshot)
+                changed_index = next(
+                    (index for index, value in enumerate(characters) if not value.isspace()),
+                    None,
+                )
+                if changed_index is None:
+                    raise AssertionError(f"{target} snapshot contains no expectation data")
+                characters[changed_index] = "X" if characters[changed_index] != "X" else "Y"
+                invalid_snapshots = {
+                    "truncated": snapshot[: max(1, len(snapshot) // 2)],
+                    "corrupted": "".join(characters),
+                    "trailing": snapshot + "SENTINEL_UNEXPECTED_RECORD\n",
+                }
+                invalid_paths: dict[str, Path] = {}
+                for description, contents in invalid_snapshots.items():
+                    path = temp_dir / f"{target}-{description}.snapshot"
+                    path.write_text(contents, encoding="utf-8")
+                    invalid_paths[description] = path
+
+                validated = run([str(binary), str(snapshot_path)], timeout=900)
+                require_success(validated, f"validating the snapshot with {target}")
+                if snapshot_path.read_bytes() != original_bytes:
+                    raise AssertionError(f"{target} modified its read-only expectation snapshot")
+                extra_argument = run(
+                    [str(binary), str(snapshot_path), "unexpected-extra-argument"],
+                    timeout=900,
+                )
+                if extra_argument.returncode == 0:
+                    raise AssertionError(f"{target} accepted more than one snapshot argument")
+                for description, path in invalid_paths.items():
+                    rejected = run([str(binary), str(path)], timeout=900)
+                    if rejected.returncode == 0:
+                        raise AssertionError(
+                            f"{target} accepted a {description} expectation snapshot"
+                        )
+
+    record("sentinel::tester3_snapshot_contract", check_tester3_snapshot_contract)
+
+    def check_tester3_domain_coverage() -> None:
+        cpu_features = host_cpu_features()
+        target_flags = {
+            "tester3purec_scalar": [],
+            "tester3purecfma_scalar": ["-mfma"],
+            "tester3sse2": ["-msse2"],
+            "tester3sse4": ["-msse4.1"],
+            "tester3avx": ["-mavx"],
+            "tester3avx2128": ["-mavx2", "-mfma"],
+            "tester3avx2": ["-mavx2", "-mfma"],
+            "tester3avx512f": ["-mavx512f", "-mfma"],
+            "tester3avx512fnofma": ["-mavx512f"],
+        }
+        shapes = (
+            ("asin_d_u35", r"asind\d+_u35", "d"),
+            ("asin_d_u10", r"asind\d+_u10", "d"),
+            ("acos_d_u35", r"acosd\d+_u35", "d"),
+            ("acos_d_u10", r"acosd\d+_u10", "d"),
+            ("asin_f_u35", r"asinf\d+_u35", "f"),
+            ("asin_f_u10", r"asinf\d+_u10", "f"),
+            ("acos_f_u35", r"acosf\d+_u35", "f"),
+            ("acos_f_u10", r"acosf\d+_u10", "f"),
+        )
+        for target in tester3_targets:
+            required_features = tester3_target_features[target]
+            if required_features - cpu_features:
+                continue
+            binary = build_dir / "bin" / target
+            imported = set(imported_inverse_trig_contracts(binary).values())
+            for shape, pattern, precision in shapes:
+                selected = sorted(name for name in imported if re.search(pattern, name))
+                if not selected:
+                    raise AssertionError(f"{target} has no imported {shape} implementation")
+                with tempfile.TemporaryDirectory(
+                    prefix=f"sentinel-{target}-{shape}-domain-"
+                ) as tmp:
+                    temp_dir = Path(tmp)
+                    marker_source = temp_dir / "marker.c"
+                    marker = temp_dir / "calls"
+                    library = temp_dir / "interpose.so"
+                    wrappers = []
+                    for name in selected:
+                        signature = re.search(r"(?:asin|acos)([df])(\d+)_", name)
+                        if signature is None:
+                            raise AssertionError(f"could not identify the public ABI shape of {name}")
+                        symbol_precision, lane_text = signature.groups()
+                        if symbol_precision != precision:
+                            raise AssertionError(f"unexpected precision for {name}")
+                        lane_count = int(lane_text)
+                        scalar_type = "double" if precision == "d" else "float"
+                        zero = "0.0" if precision == "d" else "0.0f"
+                        if lane_count == 1:
+                            wrappers.append(
+                                f"{scalar_type} {name}({scalar_type} value) {{ "
+                                f"sentinel_observe((double)value); return {zero}; }}\n"
+                            )
+                            continue
+                        vector_bytes = lane_count * (8 if precision == "d" else 4)
+                        type_name = f"sentinel_vector_{precision}_{lane_count}_{len(wrappers)}"
+                        wrappers.append(
+                            f"typedef {scalar_type} {type_name} "
+                            f"__attribute__((vector_size({vector_bytes})));\n"
+                            f"{type_name} {name}({type_name} value) {{\n"
+                            f"  union {{ {type_name} vector; {scalar_type} lane[{lane_count}]; }} "
+                            "unpacked = { value };\n"
+                            f"  for (unsigned i = 0; i < {lane_count}; ++i) "
+                            "sentinel_observe((double)unpacked.lane[i]);\n"
+                            f"  return ({type_name}){{ 0 }};\n"
+                            "}\n"
+                        )
+                    marker_source.write_text(
+                        "#include <fcntl.h>\n"
+                        "#include <stdio.h>\n"
+                        "#include <unistd.h>\n"
+                        "static volatile unsigned long long sentinel_count = 0;\n"
+                        "static volatile unsigned sentinel_regions = 0;\n"
+                        "static volatile unsigned sentinel_bins = 0;\n"
+                        "static void sentinel_observe(double value) {\n"
+                        "  if (value < -1.0 || value > 1.0) return;\n"
+                        "  ++sentinel_count;\n"
+                        "  if (value < 0.0) sentinel_regions |= 1u;\n"
+                        "  if (value > 0.0) sentinel_regions |= 2u;\n"
+                        "  if (value < -0.9) sentinel_regions |= 4u;\n"
+                        "  if (value > 0.9) sentinel_regions |= 8u;\n"
+                        "  if (value > -0.1 && value < 0.1) sentinel_regions |= 16u;\n"
+                        "  unsigned bin = (unsigned)((value + 1.0) * 16.0);\n"
+                        "  if (bin > 31u) bin = 31u;\n"
+                        "  sentinel_bins |= 1u << bin;\n"
+                        "}\n"
+                        "__attribute__((destructor)) static void sentinel_done(void) {\n"
+                        "  if (sentinel_count) {\n"
+                        f"  int fd = open({json.dumps(str(marker))}, O_WRONLY | O_CREAT | O_TRUNC, 0600);\n"
+                        "  if (fd >= 0) {\n"
+                        "    dprintf(fd, \"%llu %u %u\\n\", sentinel_count, "
+                        "sentinel_regions, sentinel_bins);\n"
+                        "    close(fd);\n"
+                        "  }\n"
+                        "  }\n"
+                        "}\n"
+                        + "".join(wrappers),
+                        encoding="ascii",
+                    )
+                    compiled = run(
+                        [
+                            args.cc,
+                            *target_flags[target],
+                            "-shared",
+                            "-fPIC",
+                            str(marker_source),
+                            "-o",
+                            str(library),
+                        ]
+                    )
+                    require_success(compiled, f"building the {shape} domain observer for {target}")
+                    run_ctest(target, extra_env={"LD_PRELOAD": str(library)})
+                    call_data = marker.read_text(encoding="ascii").split() if marker.exists() else []
+                if len(call_data) != 3:
+                    raise AssertionError(f"{target} never exercised observable {shape} inputs")
+                count, regions, bins = (int(value) for value in call_data)
+                populated_bins = bins.bit_count()
+                if count < 1000 or regions != 31 or populated_bins < 24:
+                    raise AssertionError(
+                        f"{target} covered {shape} too sparsely across its valid domain: "
+                        f"count={count}, regions={regions:#x}, populated_bins={populated_bins}"
+                    )
+
+    record("sentinel::tester3_domain_coverage", check_tester3_domain_coverage)
+
+    def check_mpfr_free_runtime() -> None:
+        completed = run(["ldd", str(purec_binary)])
+        require_success(completed, "inspecting tester3 runtime dependencies")
+        dependency_text = (completed.stdout + completed.stderr).lower()
+        forbidden = [name for name in ("libmpfr", "libgmp") if name in dependency_text]
+        if forbidden:
+            raise AssertionError(f"tester3 has forbidden runtime dependencies {forbidden}:\n{dependency_text}")
+
+    record("sentinel::tester3_is_mpfr_free", check_mpfr_free_runtime)
+
+    def check_static_dependency_free_matrix() -> None:
+        with tempfile.TemporaryDirectory(prefix="sentinel-static-dependency-free-") as tmp:
+            temp_dir = Path(tmp)
+            static_build = temp_dir / "build"
+            blocked_include = temp_dir / "unavailable-include"
+            (blocked_include / "openssl").mkdir(parents=True)
+            for header in ("mpfr.h", "gmp.h"):
+                (blocked_include / header).write_text(
+                    '#error "dependency is unavailable in this configuration"\n',
+                    encoding="ascii",
+                )
+            for header in ("md5.h", "evp.h", "sha.h", "crypto.h", "opensslv.h"):
+                (blocked_include / "openssl" / header).write_text(
+                    '#error "OpenSSL is unavailable in this configuration"\n',
+                    encoding="ascii",
+                )
+            real_compiler = shutil.which(args.cc)
+            if real_compiler is None:
+                raise AssertionError(f"could not resolve C compiler {args.cc!r}")
+            guarded_compiler = temp_dir / "cc-without-optional-dependencies"
+            guarded_compiler.write_text(
+                "#!/bin/sh\n"
+                "for arg in \"$@\"; do\n"
+                "  case \"$arg\" in\n"
+                "    -lmpfr|-lgmp|-lssl|-lcrypto|*/libmpfr.*|*/libgmp.*|*/libssl.*|*/libcrypto.*)\n"
+                "      echo \"forbidden optional library in compiler invocation: $arg\" >&2\n"
+                "      exit 86\n"
+                "      ;;\n"
+                "  esac\n"
+                "done\n"
+                f"exec {json.dumps(real_compiler)} -I{json.dumps(str(blocked_include))} \"$@\"\n",
+                encoding="ascii",
+            )
+            guarded_compiler.chmod(0o700)
+            dependency_free_env = {
+                "CPATH": "",
+                "C_INCLUDE_PATH": "",
+                "CPLUS_INCLUDE_PATH": "",
+                "LIBRARY_PATH": "",
+                "CMAKE_INCLUDE_PATH": "",
+                "CMAKE_LIBRARY_PATH": "",
+                "OPENSSL_ROOT_DIR": "",
+            }
+            configured = run(
+                [
+                    args.cmake,
+                    "-S",
+                    str(workspace),
+                    "-B",
+                    str(static_build),
+                    "-DCMAKE_BUILD_TYPE=Release",
+                    "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
+                    "-DBUILD_SHARED_LIBS=OFF",
+                    f"-DCMAKE_C_COMPILER={guarded_compiler}",
+                    "-DCMAKE_DISABLE_FIND_PACKAGE_OpenSSL=TRUE",
+                    "-DLIB_MPFR:FILEPATH=",
+                    "-DLIBGMP:FILEPATH=",
+                    "-DMPFR_INCLUDE_DIR:PATH=",
+                ],
+                timeout=300,
+                extra_env=dependency_free_env,
+            )
+            require_success(configured, "configuring the dependency-free static build")
+            built = run(
+                [
+                    args.cmake,
+                    "--build",
+                    str(static_build),
+                    "--parallel",
+                    "4",
+                    "--target",
+                    "tester3purec_scalar",
+                    "tester3purecfma_scalar",
+                ],
+                timeout=900,
+                extra_env=dependency_free_env,
+            )
+            require_success(built, "building the dependency-free static scalar tester3 targets")
+            if not (static_build / "lib" / "libsleef.a").is_file():
+                raise AssertionError("the static configuration did not produce libsleef.a")
+            for target in ("tester3purec_scalar", "tester3purecfma_scalar"):
+                listing = run(
+                    [args.ctest, "--test-dir", str(static_build), "-N", "-R", f"^{target}$"],
+                    extra_env=dependency_free_env,
+                )
+                require_success(listing, f"listing static CTest {target}")
+                if not re.search(r"Total Tests:\s*1\s*$", listing.stdout, re.MULTILINE):
+                    raise AssertionError(f"static build did not register exactly one {target} test")
+                for attempt in range(2):
+                    executed = run(
+                        [
+                            args.ctest,
+                            "--test-dir",
+                            str(static_build),
+                            "--output-on-failure",
+                            "-R",
+                            f"^{target}$",
+                        ],
+                        timeout=900,
+                        extra_env=dependency_free_env,
+                    )
+                    require_success(executed, f"running static CTest {target} (attempt {attempt + 1})")
+                dependencies = run(["ldd", str(static_build / "bin" / target)])
+                require_success(dependencies, f"inspecting static tester dependencies for {target}")
+                dependency_text = (dependencies.stdout + dependencies.stderr).lower()
+                forbidden = [
+                    name
+                    for name in ("libsleef", "libcrypto", "libmpfr", "libgmp")
+                    if name in dependency_text
+                ]
+                if forbidden:
+                    raise AssertionError(
+                        f"dependency-free static {target} retained forbidden runtime dependencies {forbidden}:\n"
+                        f"{dependency_text}"
+                    )
+
+    record(
+        "sentinel::tester3_static_dependency_free_matrix",
+        check_static_dependency_free_matrix,
+    )
+
+    def check_cross_target_matrix(
+        toolchain_name: str,
+        expected_targets: list[str],
+        cache_overrides: list[str],
+    ) -> None:
+        compiler = shutil.which(args.cc)
+        if compiler is None:
+            raise AssertionError(f"could not resolve C compiler {args.cc!r}")
+        with tempfile.TemporaryDirectory(prefix="sentinel-cross-config-") as tmp:
+            cross_build = Path(tmp) / "build"
+            command = [
+                args.cmake,
+                "-S",
+                str(workspace),
+                "-B",
+                str(cross_build),
+                f"-DCMAKE_TOOLCHAIN_FILE={workspace / 'travis' / toolchain_name}",
+                f"-DCMAKE_C_COMPILER={compiler}",
+                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
+                f"-DNATIVE_BUILD_DIR={build_dir}",
+                *cache_overrides,
+            ]
+            configured = run(command, timeout=180)
+            require_success(configured, f"configuring with {toolchain_name}")
+            target_help = run(
+                [args.cmake, "--build", str(cross_build), "--target", "help"],
+                timeout=60,
+            )
+            require_success(target_help, f"listing targets for {toolchain_name}")
+            words = set(re.findall(r"[A-Za-z0-9_]+", target_help.stdout))
+            missing_targets = [target for target in expected_targets if target not in words]
+            if missing_targets:
+                raise AssertionError(
+                    f"{toolchain_name} did not expose tester targets {missing_targets}:\n"
+                    f"{target_help.stdout[-6000:]}"
+                )
+
+    record(
+        "sentinel::arm32_target_matrix",
+        lambda: check_cross_target_matrix(
+            "toolchain-armhf.cmake",
+            ["tester3purec_scalar", "tester3purecfma_scalar"],
+            [],
+        ),
+    )
+    record(
+        "sentinel::aarch64_target_matrix",
+        lambda: check_cross_target_matrix(
+            "toolchain-aarch64.cmake",
+            ["tester3advsimd", "tester3advsimdnofma", "tester3sve", "tester3svenofma"],
+            ["-DCOMPILER_SUPPORTS_SVE=1"],
+        ),
+    )
+    record(
+        "sentinel::ppc64_target_matrix",
+        lambda: check_cross_target_matrix(
+            "toolchain-ppc64el.cmake",
+            ["tester3vsx", "tester3vsxnofma"],
+            ["-DCOMPILER_SUPPORTS_VSX=1"],
+        ),
+    )
+
+    results_path = Path(args.results)
+    results_path.parent.mkdir(parents=True, exist_ok=True)
+    results_path.write_text(json.dumps({"tests": results}, indent=2), encoding="utf-8")
+    return 0 if all(result["status"] == "PASSED" for result in results) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
