+  }, []);
+
+  const handleClose = useCallback(() => {
+    abortRef.current?.abort();
+    setOpen(false);
+  }, [setOpen]);
+
+  const handleRun = useCallback(async () => {
+    if (inferringRef.current) return;
+    setError(null);
+    setResultMessage(null);
+    if (!imageBytes) {
