+            </div>
+            <div className="grid gap-1.5">
+              <Label htmlFor="det-size" className="text-xs">
+                {t("objectDetection.inputSizeLabel")}
+              </Label>
+              <Input
+                id="det-size"
+                type="number"
+                min={32}
+                max={4096}
+                step={32}
+                value={String(inputSize)}
+                onChange={(e) => {
