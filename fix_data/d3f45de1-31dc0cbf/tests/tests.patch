+
+function bytes(base64: string): ArrayBuffer {
+  const value = Buffer.from(base64, "base64");
+  return value.buffer.slice(value.byteOffset, value.byteOffset + value.byteLength) as ArrayBuffer;
+}
+
+const raster = (values = [0.3, 0.6, 0.9, 0.5]): RasterData => ({
+  bands: [Float32Array.from(values)],
+  width: values.length,
+  height: 1,
+  originX: 0,
+  originY: 0,
+  resX: 1,
+  resY: 1,
+  nodata: null,
+  geoKeys: {},
+});
+
+const inferenceRaster: RasterData = {
+  bands: [
