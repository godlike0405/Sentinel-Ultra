+import {
+  detectObjects,
+  ORT_VERSION,
+  segmentEverything,
+} from "../packages/processing/src/index";
+import type { RasterData } from "../packages/processing/src/raster-client";
+
+declare const raster: RasterData;
+declare const model: ArrayBuffer;
+declare const signal: AbortSignal;
+
+const detections = detectObjects(raster, model, {
+  inputSize: 640,
+  confidenceThreshold: 0.25,
+  iouThreshold: 0.45,
+});
+detections.then((items) => {
+  const box: [number, number, number, number] = items[0].bbox;
+  const classIndex: number = items[0].classIndex;
+  const score: number = items[0].score;
+  return { box, classIndex, score };
+});
+
+const masks = segmentEverything(raster, model, model, {
+  pointsPerSide: 8,
+  onProgress: (done: number, total: number) => void [done, total],
+  signal,
+});
+masks.then((items) => {
+  const polygon: [number, number][] = items[0].polygon;
+  const score: number = items[0].score;
+  const area: number = items[0].area;
+  return { polygon, score, area };
+});
+
+export const publicContract = { detections, masks, runtimeVersion: ORT_VERSION };
