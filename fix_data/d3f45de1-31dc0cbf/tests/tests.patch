+    assert.deepEqual(detections.map(({ classIndex }) => classIndex).sort(), [0, 1]);
+    assert.ok(Math.abs((detections.find(({ classIndex }) => classIndex === 0)?.score ?? 0) - 0.9) < 1e-6);
+  });
+
+  it("rejects malformed detection output", async () => {
+    await assert.rejects(
