+
+const english = JSON.parse(
+  readFileSync(
+    fileURLToPath(new URL("../apps/geolibre-desktop/src/i18n/locales/en.json", import.meta.url)),
+    "utf8",
+  ),
+) as Record<string, unknown>;
+
+function nestedStrings(value: unknown): string[] {
+  if (typeof value === "string") return [value];
+  if (Array.isArray(value)) return value.flatMap(nestedStrings);
+  if (value && typeof value === "object") return Object.values(value).flatMap(nestedStrings);
+  return [];
+}
+
+function translation(key: string): string | undefined {
+  let value: unknown = english;
+  for (const part of key.split(".")) {
+    if (!value || typeof value !== "object") return undefined;
+    value = (value as Record<string, unknown>)[part];
+  }
+  return typeof value === "string" ? value : undefined;
+}
+
+function objectContaining(
+  value: unknown,
+  target: string,
+  topics: readonly RegExp[],
+): Record<string, unknown> | undefined {
+  if (!value || typeof value !== "object") return undefined;
+  for (const child of Object.values(value)) {
+    const found = objectContaining(child, target, topics);
+    if (found) return found;
+  }
+  const copy = nestedStrings(value).join("\n");
+  if (Object.values(value).includes(target) && topics.every((topic) => topic.test(copy))) {
+    return value as Record<string, unknown>;
+  }
+  return undefined;
+}
+
+let browserBuild: Promise<import("esbuild").BuildResult> | undefined;
+async function buildBrowserApplication() {
+  browserBuild ??= import("esbuild").then(({ build }) => {
+    const root = fileURLToPath(new URL("..", import.meta.url));
+    return build({
+      entryPoints: [join(root, "apps/geolibre-desktop/src/main.tsx")],
+      bundle: true,
+      platform: "browser",
+      packages: "external",
+      format: "esm",
+      splitting: true,
+      outdir: "out",
+      plugins: [
+        {
+          name: "external-vite-assets",
+          setup(buildApi) {
+            buildApi.onResolve({ filter: /\?(?:raw|url)$/ }, (args) => ({
+              path: args.path,
+              external: true,
+            }));
+          },
+        },
+      ],
+      write: false,
+      logLevel: "silent",
+    });
+  });
+  return browserBuild;
+}
+
+  it("returns every qualifying YOLOv8/v11 prediction", async () => {
+    const detections = await detectObjects(squareRaster, bytes(V8_MULTI_MODEL_BASE64), {
+      inputSize: INPUT,
+      confidenceThreshold: 0.5,
+    });
+    assert.equal(detections.length, 2);
+    assert.deepEqual(detections.map(({ classIndex }) => classIndex), [0, 1]);
+    assert.deepEqual(detections.map(({ bbox }) => bbox), [
+      [6, 6, 10, 10],
+      [21, 16, 27, 24],
+    ]);
+  });
+
+  it("interprets YOLOv5 confidence and coordinates", async () => {
+    const [detection] = await detectObjects(squareRaster, bytes(V5_MODEL_BASE64), {
+      inputSize: INPUT,
+      confidenceThreshold: 0.5,
+    });
+    assert.equal(detection.classIndex, 1);
+    assert.deepEqual(detection.bbox, [17, 8, 23, 12]);
+    assert.ok(Math.abs(detection.score - 0.765) < 1e-6);
+  });
+
+  it("suppresses redundant same-class boxes without merging classes", async () => {
+    const detections = await detectObjects(squareRaster, bytes(V8_OVERLAP_MODEL_BASE64), {
