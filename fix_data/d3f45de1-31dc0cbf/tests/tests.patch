+const squareRaster: RasterData = {
+  bands: [
+    new Float32Array(INPUT * INPUT).fill(0.3),
+    new Float32Array(INPUT * INPUT).fill(0.6),
+    new Float32Array(INPUT * INPUT).fill(0.9),
+  ],
+  width: INPUT,
+  height: INPUT,
+  originX: 0,
+  originY: 0,
+  resX: 1,
+  resY: 1,
+  nodata: null,
+  geoKeys: {},
