@@ -0,0 +1,8 @@
+export async function resolve(specifier, context, nextResolve) {
+  if (
+    /^(?:onnxruntime|onnxruntime-(?:web|node))(?:\/|$)/.test(specifier)
+  ) {
+    throw new Error("ONNX runtime loaded during package import");
+  }
+  return nextResolve(specifier, context);
+}
