+def test_macos_state_decoder_accepts_missing_and_present_cluster_rdma_state(
+    tmp_path: Path,
+) -> None:
+    _symbols()
+    declarations = []
+    for path in (ROOT / "app/EXO/EXO").rglob("*.swift"):
+        if re.search(r"\bstruct\s+ClusterState\s*:\s*(?:Decodable|Codable)\b", _active_swift_source(path)):
+            declarations.append(path)
+    assert len(declarations) == 1
+    source = declarations[0]
+    driver = tmp_path / "main.swift"
+    driver.write_text(
+        textwrap.dedent(
+            r'''
+            import Foundation
+
+            struct ModelOption {}
+
+            func decoded(_ json: String) throws -> ClusterState {
+                try JSONDecoder().decode(ClusterState.self, from: Data(json.utf8))
+            }
+
+            let present = try decoded(#"{"instances":{},"runners":{},"nodeRdmaCtl":{"alpha":{"enabled":true},"beta":{"enabled":false}}}"#)
+            guard present.nodeRdmaCtl["alpha"]?.enabled == true else { fatalError("enabled state lost") }
+            guard present.nodeRdmaCtl["beta"]?.enabled == false else { fatalError("disabled state lost") }
+            let missing = try decoded(#"{"instances":{},"runners":{}}"#)
+            guard missing.nodeRdmaCtl.isEmpty else { fatalError("missing state was not compatible") }
+            '''
+        ),
+        encoding="utf-8",
+    )
+    executable = tmp_path / "cluster-state-contract"
+    compile_result = subprocess.run(
+        ["swiftc", str(source), str(driver), "-o", str(executable)],
+        text=True,
+        capture_output=True,
+        timeout=60,
+        check=False,
+    )
+    assert compile_result.returncode == 0, compile_result.stdout + "\n" + compile_result.stderr
+    run_result = subprocess.run(
+        [str(executable)], text=True, capture_output=True, timeout=10, check=False
+    )
+    assert run_result.returncode == 0, run_result.stdout + "\n" + run_result.stderr
