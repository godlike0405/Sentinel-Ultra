+def _node_case(case: str) -> subprocess.CompletedProcess[str]:
+    script = textwrap.dedent(
+        r'''
+        import assert from "node:assert/strict";
+        import { createRequire } from "node:module";
+        import { pathToFileURL } from "node:url";
+        import path from "node:path";
+
+        const root = process.argv[2];
+        const scenario = process.argv[3];
+        const dashboard = path.join(root, "dashboard");
+        const requireFromDashboard = createRequire(path.join(dashboard, "package.json"));
+        const vitePath = requireFromDashboard.resolve("vite");
+        const { createServer } = await import(pathToFileURL(vitePath));
+        const server = await createServer({ root: dashboard, logLevel: "silent", server: { middlewareMode: true }, appType: "custom" });
+        const state = {
+          topology: {
+            nodes: ["alpha", "beta"],
+            connections: {
+              alpha: { beta: [{ sourceRdmaIface: "rdma_en2", sinkRdmaIface: "rdma_en3" }] },
+              beta: { alpha: [{ sourceRdmaIface: "rdma_en3", sinkRdmaIface: "rdma_en2" }] }
+            }
+          },
+          nodeIdentities: {
+            alpha: { friendlyName: "Alpha", modelId: "Mac", chipId: "M4" },
+            beta: { friendlyName: "Beta", modelId: "Mac", chipId: "M4" }
+          },
+          nodeMemory: {
+            alpha: { ramTotal: { inBytes: 68719476736 }, ramAvailable: { inBytes: 34359738368 } },
+            beta: { ramTotal: { inBytes: 68719476736 }, ramAvailable: { inBytes: 34359738368 } }
+          },
+          nodeSystem: {}, nodeNetwork: {}, instances: {}, runners: {}, downloads: {},
+          nodeThunderbolt: {
+            alpha: { interfaces: [{ rdmaInterface: "rdma_en2", domainUuid: "a", linkSpeed: "80 Gb/s" }] },
+            beta: { interfaces: [{ rdmaInterface: "rdma_en3", domainUuid: "b", linkSpeed: "80 Gb/s" }] }
+          },
+          nodeRdmaCtl: { alpha: { enabled: true }, beta: { enabled: false } },
+          nodeThunderboltBridge: {}, thunderboltBridgeCycles: []
+        };
+        globalThis.fetch = async () => ({ ok: true, json: async () => state });
+        globalThis.localStorage = { getItem: () => null, setItem: () => {}, removeItem: () => {} };
+        try {
+          const store = await server.ssrLoadModule("/src/lib/stores/app.svelte.ts");
+          await store.refreshState();
+          if (scenario === "store") {
+            assert.deepEqual(store.nodeRdmaCtl(), state.nodeRdmaCtl);
+            assert.deepEqual(store.nodeThunderbolt(), state.nodeThunderbolt);
+            const edges = store.topologyData().edges;
+            assert.equal(edges[0].sourceRdmaIface, "rdma_en2");
+            assert.equal(edges[0].sinkRdmaIface, "rdma_en3");
+          } else if (scenario === "model-card") {
+            store.setDebugMode(true);
+            const { render } = await server.ssrLoadModule("svelte/server");
+            const component = (await server.ssrLoadModule("/src/lib/components/ModelCard.svelte")).default;
+            const body = render(component, { props: {
+              model: { id: "example/model" }, nodes: store.topologyData().nodes,
+              runtime: "MlxIbv", apiPreview: { error: null, memory_delta_by_node: { alpha: 1024, beta: 1024 } }
+            }}).body;
+            assert.match(body, /rdma_en2/);
+            assert.match(body, /rdma_en3/);
+          } else if (scenario === "prompt") {
+            const { render } = await server.ssrLoadModule("svelte/server");
+            const page = (await server.ssrLoadModule("/src/routes/+page.svelte")).default;
+            const first = render(page).body;
+            assert.match(first, /RDMA AVAILABLE/);
+            state.nodeRdmaCtl = { alpha: { enabled: true }, beta: { enabled: true } };
+            await store.refreshState();
+            const second = render(page).body;
+            assert.doesNotMatch(second, /RDMA AVAILABLE/);
+          } else if (scenario === "topology") {
+            await server.ssrLoadModule("/src/lib/components/TopologyGraph.svelte");
+          }
+        } finally {
+          await server.close();
+        }
+        '''
+    )
+    script_path = ROOT / ".sentinel-rdma-dashboard.mjs"
+    script_path.write_text(script, encoding="utf-8")
+    try:
+        return subprocess.run(
+            ["node", str(script_path), str(ROOT), case],
+            cwd=ROOT / "dashboard",
+            text=True,
+            capture_output=True,
+            timeout=90,
+            check=False,
+        )
+    finally:
+        script_path.unlink(missing_ok=True)
+
+
+def _assert_node_case(case: str) -> None:
+    result = _node_case(case)
+    assert result.returncode == 0, result.stdout + "\n" + result.stderr
+
