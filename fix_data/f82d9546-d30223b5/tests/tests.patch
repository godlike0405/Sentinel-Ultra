+def test_gather_parses_enabled_disabled_and_unknown_statuses() -> None:
+    symbols = _symbols()
+    status = symbols["RdmaCtlStatus"]
+    cases = [
+        (b"RDMA is ENABLED\n", True),
+        (b"  rdma disabled  \n", False),
+        (b"status unavailable\n", None),
+    ]
+    for stdout, expected in cases:
+        with (
+            patch("exo.utils.info_gatherer.info_gatherer.IS_DARWIN", True),
+            patch("exo.utils.info_gatherer.info_gatherer.shutil.which", return_value="/usr/bin/rdma_ctl"),
+            patch("exo.utils.info_gatherer.info_gatherer.anyio.run_process", new=AsyncMock(return_value=_proc(stdout))),
+        ):
+            result = _run(status.gather())
+        assert (None if result is None else result.enabled) is expected
+
