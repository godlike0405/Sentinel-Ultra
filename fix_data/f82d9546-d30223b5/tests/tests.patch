+def test_gather_applies_the_five_second_deadline_and_swallows_timeout() -> None:
+    symbols = _symbols()
+    seen: list[float] = []
+
+    class Deadline(AbstractContextManager[None]):
+        def __enter__(self) -> None:
+            raise TimeoutError("deadline")
+
+        def __exit__(self, *args: object) -> bool:
+            return False
+
+    def fail_after(seconds: float) -> Deadline:
+        seen.append(seconds)
+        return Deadline()
+
+    with (
+        patch("exo.utils.info_gatherer.info_gatherer.IS_DARWIN", True),
+        patch("exo.utils.info_gatherer.info_gatherer.shutil.which", return_value="/usr/bin/rdma_ctl"),
+        patch("exo.utils.info_gatherer.info_gatherer.anyio.fail_after", side_effect=fail_after),
+    ):
+        assert _run(symbols["RdmaCtlStatus"].gather()) is None
+    assert seen == [5]
+
