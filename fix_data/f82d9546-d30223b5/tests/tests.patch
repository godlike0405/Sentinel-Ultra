+def _run(coro: Any) -> Any:
+    return asyncio.run(coro)
+
+
+def _proc(stdout: bytes, returncode: int = 0) -> SimpleNamespace:
+    return SimpleNamespace(stdout=stdout, stderr=b"", returncode=returncode)
+
