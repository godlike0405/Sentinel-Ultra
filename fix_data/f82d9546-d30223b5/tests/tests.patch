+def _fast_status_gatherer(symbols: dict[str, Any], sender: Any) -> Any:
+    """Disable base monitors and accelerate any feature-added public setting."""
+    cls = symbols["InfoGatherer"]
+    kwargs: dict[str, Any] = {
+        "interface_watcher_interval": None,
+        "misc_poll_interval": None,
+        "system_profiler_interval": None,
+        "memory_poll_rate": None,
+        "macmon_interval": None,
+        "thunderbolt_bridge_poll_interval": None,
+    }
+    base_fields = {"info_sender", "_tg", *kwargs}
+    for name in cls.__dataclass_fields__:
+        if name not in base_fields and not name.startswith("_"):
+            kwargs[name] = 0
+    return cls(cast(Any, sender), **kwargs)
+
+
+def _wire(state: Any) -> dict[str, Any]:
+    return json.loads(state.model_dump_json(by_alias=True))
+
