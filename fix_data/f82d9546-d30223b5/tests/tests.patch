+def _compile_swift_module(
+    source: Path, module_name: str, output_dir: Path
+) -> None:
+    result = subprocess.run(
+        [
+            "swiftc",
+            "-emit-library",
+            "-emit-module",
+            "-module-name",
+            module_name,
+            str(source),
+            "-o",
+            str(output_dir / f"lib{module_name}.so"),
+        ],
+        text=True,
+        capture_output=True,
+        timeout=60,
+        check=False,
+    )
+    assert result.returncode == 0, result.stdout + "\n" + result.stderr
+
