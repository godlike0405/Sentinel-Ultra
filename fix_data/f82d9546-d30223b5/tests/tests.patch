+def test_macos_keeps_local_devices_and_ports_without_local_rdma_ctl_status(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _symbols()
+    _run_network_status_contract(tmp_path, monkeypatch)
+    scenarios = _run_swift_ui_contract(tmp_path / "view")
+    baseline = scenarios["baseline"]
+    assert any("mlx5_0" in line for line in baseline)
+    assert baseline != scenarios["device-toggle"]
