+def _run_swift_ui_contract(tmp_path: Path) -> dict[str, list[str]]:
+    tmp_path.mkdir(parents=True, exist_ok=True)
+    swiftui = tmp_path / "SwiftUI.swift"
+    swiftui.write_text(
+        textwrap.dedent(
+            r'''
+            public protocol View {}
+
+            public enum RenderLog {
+                nonisolated(unsafe) public static var lines: [String] = []
+            }
+
+            public struct RenderedView: View {
+                public init() {}
+            }
+
+            @resultBuilder
+            public enum ViewBuilder {
+                public static func buildBlock(_ components: RenderedView...) -> RenderedView {
+                    RenderedView()
+                }
+                public static func buildExpression<V: View>(_ expression: V) -> RenderedView {
+                    RenderedView()
+                }
+                public static func buildOptional(_ component: RenderedView?) -> RenderedView {
+                    RenderedView()
+                }
+                public static func buildEither(first component: RenderedView) -> RenderedView {
+                    RenderedView()
+                }
+                public static func buildEither(second component: RenderedView) -> RenderedView {
+                    RenderedView()
+                }
+                public static func buildArray(_ components: [RenderedView]) -> RenderedView {
+                    RenderedView()
+                }
+            }
+
+            public struct HorizontalAlignment {
+                public static let leading = HorizontalAlignment()
+                public init() {}
+            }
+
+            public struct Font {
+                public static let caption2 = Font()
+                public init() {}
+            }
+
+            public struct Color {
+                public static let secondary = Color()
+                public static let green = Color()
+                public static let orange = Color()
+                public init() {}
+            }
+
+            public struct VStack: View {
+                public init(
+                    alignment: HorizontalAlignment,
+                    spacing: Double? = nil,
+                    @ViewBuilder content: () -> RenderedView
+                ) {
+                    _ = content()
+                }
+            }
+
+            public struct Text: View {
+                public init(_ value: String) {
+                    RenderLog.lines.append(value)
+                }
+            }
+
+            public struct ForEach<Data: RandomAccessCollection, ID: Hashable>: View {
+                public init(
+                    _ data: Data,
+                    id: KeyPath<Data.Element, ID>,
+                    @ViewBuilder content: (Data.Element) -> RenderedView
+                ) {
+                    for element in data {
+                        _ = content(element)
+                    }
+                }
+            }
+
+            extension View {
+                public func font(_ value: Font?) -> Self { self }
+                public func foregroundColor(_ value: Color?) -> Self { self }
+            }
+            '''
+        ),
+        encoding="utf-8",
+    )
+    _compile_swift_module(swiftui, "SwiftUI", tmp_path)
+
+    content_declarations = []
+    for path in (ROOT / "app/EXO/EXO").rglob("*.swift"):
+        if re.search(r"\bstruct\s+ContentView\s*:\s*View\b", path.read_text(encoding="utf-8")):
+            content_declarations.append(path)
+    assert len(content_declarations) == 1, "the app must have one ContentView implementation"
+    content_path = content_declarations[0]
+    _swift_parse(content_path)
+    content = _active_swift_source(content_path)
+    properties = _swift_view_properties(content)
+    reachable = _reachable_view_properties(properties)
+    environment_objects = dict(
+        re.findall(
+            r"@EnvironmentObject\s+(?:private\s+)?var\s+([A-Za-z_]\w*)\s*:\s*([A-Za-z_]\w*)",
+            content,
+        )
+    )
+    state_names = [name for name, kind in environment_objects.items() if kind == "ClusterStateService"]
+    network_names = [name for name, kind in environment_objects.items() if kind == "NetworkStatusService"]
+    assert len(state_names) == 1 and len(network_names) == 1
+    state_name, network_name = state_names[0], network_names[0]
+    def dependencies(block: str) -> tuple[list[Path], str]:
+        paths: list[Path] = []
+        unresolved = block
+        changed = True
+        while changed:
+            changed = False
+            for path in (ROOT / "app/EXO/EXO").rglob("*.swift"):
+                if path == content_path or path in paths:
+                    continue
+                source = _active_swift_source(path)
+                declarations = re.findall(
+                    r"\b(?:struct|class|enum)\s+([A-Za-z_]\w*)\b", source
+                )
+                if any(
+                    re.search(rf"\b{re.escape(name)}\s*\(", unresolved)
+                    for name in declarations
+                ):
+                    paths.append(path)
+                    unresolved += "\n" + source
+                    changed = True
+        return paths, unresolved
+
+    candidates: dict[str, tuple[str, list[Path]]] = {}
+    for name in reachable:
+        if name not in properties:
+            continue
+        paths, source = dependencies(properties[name])
+        if re.search(r"rdma", source, re.IGNORECASE):
+            candidates[name] = (properties[name], paths)
+    leaves = [
+        name
+        for name, (block, _) in candidates.items()
+        if not any(
+            other != name and re.search(rf"\b{re.escape(other)}\b", block)
+            for other in candidates
+        )
+    ]
+    assert leaves, "a root-reachable view must render RDMA diagnostics"
+    panels = [candidates[name][0] for name in leaves]
+    component_paths = sorted(
+        {path for name in leaves for path in candidates[name][1]}, key=str
+    )
+    panel_properties = "\n".join(
+        f"var sentinelPanel{index}: some View {{\n{panel}\n}}"
+        for index, panel in enumerate(panels)
+    )
+    panel_evaluations = "\n".join(
+        f"_ = view.sentinelPanel{index}" for index in range(len(panels))
+    )
+
+    driver = tmp_path / "main.swift"
+    driver_source = (
+        textwrap.dedent(
+            r'''
+            import Foundation
+            import SwiftUI
+
+            struct NodeRdmaCtlStatus {
+                let enabled: Bool
+            }
+            struct NodeProfile {
+                let friendlyName: String?
+            }
+            typealias NodeIdentity = NodeProfile
+            struct RDMAPort: Equatable {
+                let device: String
+                let port: String
+                let state: String
+            }
+            struct RDMAStatus {
+                let rdmaCtlEnabled: Bool?
+                let devices: [String]
+                let activePorts: [RDMAPort]
+            }
+            struct NetworkStatus {
+                let rdmaStatus: RDMAStatus
+                let localRdmaDevices: [String]
+                let localRdmaActivePorts: [RDMAPort]
+            }
+            struct NetworkStatusService {
+                let status: NetworkStatus
+            }
+            struct Snapshot {
+                let nodeRdmaCtl: [String: NodeRdmaCtlStatus]
+                let nodeProfiles: [String: NodeProfile]
+                let nodeIdentities: [String: NodeIdentity]
+            }
+            struct ClusterStateService {
+                let latestSnapshot: Snapshot?
+                let localNodeId: String?
+            }
+
+            struct SentinelRdmaHarness: View {
+                let __STATE_SERVICE__: ClusterStateService
+                let __NETWORK_SERVICE__: NetworkStatusService
+            '''
+        )
+        + panel_properties
+        + textwrap.dedent(
+            r'''
+            }
+
+            let profiles = [
+                "alpha": NodeProfile(friendlyName: "Alpha"),
+                "beta": NodeProfile(friendlyName: "Beta"),
+            ]
+            func render(
+                _ scenario: String,
+                alphaEnabled: Bool,
+                betaEnabled: Bool,
+                localNodeId: String,
+                device: String,
+                portNumber: String
+            ) {
+                RenderLog.lines = []
+                let port = RDMAPort(device: device, port: portNumber, state: "ACTIVE")
+                let view = SentinelRdmaHarness(
+                    __STATE_SERVICE__: ClusterStateService(
+                        latestSnapshot: Snapshot(
+                            nodeRdmaCtl: [
+                                "alpha": NodeRdmaCtlStatus(enabled: alphaEnabled),
+                                "beta": NodeRdmaCtlStatus(enabled: betaEnabled),
+                            ],
+                            nodeProfiles: profiles,
+                            nodeIdentities: profiles
+                        ),
+                        localNodeId: localNodeId
+                    ),
+                    __NETWORK_SERVICE__: NetworkStatusService(
+                        status: NetworkStatus(
+                            rdmaStatus: RDMAStatus(
+                                rdmaCtlEnabled: nil,
+                                devices: [device],
+                                activePorts: [port]
+                            ),
+                            localRdmaDevices: [device],
+                            localRdmaActivePorts: [port]
+                        )
+                    )
+                )
+                __PANEL_EVALUATIONS__
+                print("SCENARIO:\(scenario)")
+                for line in RenderLog.lines {
+                    print(line)
+                }
+                print("ENDSCENARIO")
+            }
+
+            render("baseline", alphaEnabled: true, betaEnabled: false,
+                   localNodeId: "alpha", device: "mlx5_0", portNumber: "1")
+            render("local-toggle", alphaEnabled: true, betaEnabled: false,
+                   localNodeId: "beta", device: "mlx5_0", portNumber: "1")
+            render("status-toggle", alphaEnabled: false, betaEnabled: true,
+                   localNodeId: "alpha", device: "mlx5_0", portNumber: "1")
+            render("device-toggle", alphaEnabled: true, betaEnabled: false,
+                   localNodeId: "alpha", device: "mlx5_7", portNumber: "1")
+            render("port-toggle", alphaEnabled: true, betaEnabled: false,
+                   localNodeId: "alpha", device: "mlx5_0", portNumber: "9")
+            '''
+        )
+    )
+    driver.write_text(
+        driver_source.replace("__STATE_SERVICE__", state_name)
+        .replace("__NETWORK_SERVICE__", network_name)
+        .replace("__PANEL_EVALUATIONS__", panel_evaluations),
+        encoding="utf-8",
+    )
+    executable = tmp_path / "rdma-view-contract"
+    compile_result = subprocess.run(
+        [
+            "swiftc",
+            "-I",
+            str(tmp_path),
+            "-L",
+            str(tmp_path),
+            "-lSwiftUI",
+            *map(str, component_paths),
+            str(driver),
+            "-o",
+            str(executable),
+        ],
+        text=True,
+        capture_output=True,
+        timeout=90,
+        check=False,
+    )
+    assert compile_result.returncode == 0, compile_result.stdout + "\n" + compile_result.stderr
+    env = os.environ.copy()
+    env["LD_LIBRARY_PATH"] = str(tmp_path)
+    run_result = subprocess.run(
+        [str(executable)],
+        text=True,
+        capture_output=True,
+        timeout=10,
+        check=False,
+        env=env,
+    )
+    assert run_result.returncode == 0, run_result.stdout + "\n" + run_result.stderr
+    scenarios: dict[str, list[str]] = {}
+    active: str | None = None
+    for line in run_result.stdout.splitlines():
+        if line.startswith("SCENARIO:"):
+            active = line.removeprefix("SCENARIO:")
+            scenarios[active] = []
+        elif line == "ENDSCENARIO":
+            active = None
+        elif active is not None:
+            scenarios[active].append(line)
+    assert set(scenarios) == {
+        "baseline",
+        "local-toggle",
+        "status-toggle",
+        "device-toggle",
+        "port-toggle",
+    }
+    return scenarios
+
