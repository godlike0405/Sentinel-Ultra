+def test_macos_run_polls_repeatedly_and_publishes_non_none_statuses() -> None:
+    symbols = _symbols()
+    sent: list[Any] = []
+    complete = anyio.Event()
+
+    class Sender:
+        async def send(self, value: Any) -> None:
+            sent.append(value)
+            if sum(isinstance(item, symbols["RdmaCtlStatus"]) for item in sent) >= 2:
+                complete.set()
+
+    sequence = iter(
+        [
+            RuntimeError("temporary failure"),
+            symbols["RdmaCtlStatus"](enabled=True),
+            None,
+            symbols["RdmaCtlStatus"](enabled=False),
+        ]
+    )
+
+    async def gather() -> Any:
+        value = next(sequence)
+        if isinstance(value, Exception):
+            raise value
+        return value
+
+    async def scenario() -> None:
+        gatherer = _fast_status_gatherer(symbols, Sender())
+        with (
+            patch("exo.utils.info_gatherer.info_gatherer.IS_DARWIN", True),
+            patch.object(symbols["RdmaCtlStatus"], "gather", new=gather),
+            patch("exo.utils.info_gatherer.info_gatherer.NodeConfig.gather", new=AsyncMock(return_value=None)),
+            patch("exo.utils.info_gatherer.info_gatherer.StaticNodeInformation.gather", new=AsyncMock(return_value=SimpleNamespace())),
+            patch("exo.utils.info_gatherer.info_gatherer.shutil.which", return_value=None),
+        ):
+            async with anyio.create_task_group() as tg:
+                tg.start_soon(gatherer.run)
+                await asyncio.wait_for(complete.wait(), timeout=1)
+                gatherer.shutdown()
+
+    anyio.run(scenario)
+    values = [item.enabled for item in sent if isinstance(item, symbols["RdmaCtlStatus"])]
+    assert values == [True, False]
+
