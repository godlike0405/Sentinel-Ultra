+def _active_swift_source(path: Path) -> str:
+    source = path.read_text(encoding="utf-8")
+    output: list[str] = []
+    index = 0
+    block_depth = 0
+    in_string = False
+    while index < len(source):
+        pair = source[index : index + 2]
+        if block_depth:
+            if pair == "/*":
+                block_depth += 1
+                index += 2
+            elif pair == "*/":
+                block_depth -= 1
+                index += 2
+            else:
+                index += 1
+            continue
+        if not in_string and pair == "//":
+            newline = source.find("\n", index)
+            index = len(source) if newline < 0 else newline
+            continue
+        if not in_string and pair == "/*":
+            block_depth = 1
+            index += 2
+            continue
+        char = source[index]
+        output.append(char)
+        if char == '"' and (index == 0 or source[index - 1] != "\\"):
+            in_string = not in_string
+        index += 1
+    return "".join(output)
+
