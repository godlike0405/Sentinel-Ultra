+def _run_network_status_contract(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    appkit = tmp_path / "AppKit.swift"
+    appkit.write_text(
+        textwrap.dedent(
+            r'''
+            public protocol ObservableObject: AnyObject {}
+
+            @propertyWrapper
+            public struct Published<Value> {
+                public var wrappedValue: Value
+                public init(wrappedValue: Value) {
+                    self.wrappedValue = wrappedValue
+                }
+            }
+            '''
+        ),
+        encoding="utf-8",
+    )
+    _compile_swift_module(appkit, "AppKit", tmp_path)
+
+    commands = tmp_path / "commands"
+    commands.mkdir()
+    marker = tmp_path / "rdma-ctl-was-called"
+    scripts = {
+        "ibv_devices": "#!/bin/sh\nprintf '%s\\n' 'device node GUID' '----------------' 'mlx5_0 0123'\n",
+        "ibv_devinfo": "#!/bin/sh\nprintf '%s\\n' 'hca_id: mlx5_0' 'port: 1' 'state: PORT_ACTIVE (4)'\n",
+        "ifconfig": "#!/bin/sh\nprintf '%s\\n' 'inet 10.0.0.2' 'status: active'\n",
+        "rdma_ctl": "#!/bin/sh\n: > \"$RDMA_CTL_MARKER\"\nexit 99\n",
+    }
+    for name, script in scripts.items():
+        path = commands / name
+        path.write_text(script, encoding="utf-8")
+        path.chmod(0o755)
+    monkeypatch.setenv("PATH", f"{commands}{os.pathsep}{os.environ.get('PATH', '')}")
+    monkeypatch.setenv("RDMA_CTL_MARKER", str(marker))
+
+    driver = tmp_path / "NetworkStatusDriver.swift"
+    driver.write_text(
+        textwrap.dedent(
+            r'''
+            import Foundation
+
+            enum ThunderboltBridgeDetector {
+                static func findThunderboltBridgeServiceName() -> String? { nil }
+                static func isServiceEnabled(serviceName: String) -> Bool? { nil }
+            }
+
+            func diagnostics(in value: Any, depth: Int = 0) -> ([String], [RDMAPort]) {
+                if depth > 6 { return ([], []) }
+                var devices = value as? [String] ?? []
+                var ports = value as? [RDMAPort] ?? []
+                for child in Mirror(reflecting: value).children {
+                    let nested = diagnostics(in: child.value, depth: depth + 1)
+                    devices.append(contentsOf: nested.0)
+                    ports.append(contentsOf: nested.1)
+                }
+                return (devices, ports)
+            }
+
+            @main
+            struct ContractMain {
+                @MainActor
+                static func main() async {
+                    let service = NetworkStatusService()
+                    await service.refresh()
+                    let (devices, ports) = diagnostics(in: service.status)
+                    guard devices.contains("mlx5_0") else {
+                        fatalError("local RDMA devices were not preserved")
+                    }
+                    guard ports.contains(where: {
+                        $0.device == "mlx5_0" && $0.port == "1" && $0.state.contains("ACTIVE")
+                    }) else {
+                        fatalError("local active RDMA ports were not preserved")
+                    }
+                }
+            }
+            '''
+        ),
+        encoding="utf-8",
+    )
+    executable = tmp_path / "network-status-contract"
+    service_declarations = []
+    for path in (ROOT / "app/EXO/EXO").rglob("*.swift"):
+        if re.search(
+            r"\b(?:final\s+)?class\s+NetworkStatusService\b",
+            _active_swift_source(path),
+        ):
+            service_declarations.append(path)
+    assert len(service_declarations) == 1
+    compile_result = subprocess.run(
+        [
+            "swiftc",
+            "-parse-as-library",
+            "-I",
+            str(tmp_path),
+            "-L",
+            str(tmp_path),
+            "-lAppKit",
+            str(service_declarations[0]),
+            str(driver),
+            "-o",
+            str(executable),
+        ],
+        text=True,
+        capture_output=True,
+        timeout=90,
+        check=False,
+    )
+    assert compile_result.returncode == 0, compile_result.stdout + "\n" + compile_result.stderr
+    env = os.environ.copy()
+    env["LD_LIBRARY_PATH"] = str(tmp_path)
+    run_result = subprocess.run(
+        [str(executable)],
+        text=True,
+        capture_output=True,
+        timeout=20,
+        check=False,
+        env=env,
+    )
+    assert run_result.returncode == 0, run_result.stdout + "\n" + run_result.stderr
+    assert not marker.exists(), "the redundant local rdma_ctl status process still ran"
+
