+def test_macos_debug_view_uses_cluster_status_and_marks_the_local_node(
+    tmp_path: Path,
+) -> None:
+    _symbols()
+    scenarios = _run_swift_ui_contract(tmp_path)
+    baseline = scenarios["baseline"]
+    assert any("Alpha" in line for line in baseline)
+    assert any("Beta" in line for line in baseline)
+    assert [line for line in baseline if "Alpha" in line or "Beta" in line] != [
+        line
+        for line in scenarios["status-toggle"]
+        if "Alpha" in line or "Beta" in line
+    ]
+    assert [line for line in baseline if "Alpha" in line or "Beta" in line] != [
+        line
+        for line in scenarios["local-toggle"]
+        if "Alpha" in line or "Beta" in line
+    ]
