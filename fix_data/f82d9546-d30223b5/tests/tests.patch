+def test_gather_parses_enabled_disabled_and_unknown_statuses(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    symbols = _symbols()
+    status = symbols["RdmaCtlStatus"]
+    cases = [
+        ("RDMA is ENABLED\n", True),
+        ("  rdma disabled  \n", False),
+        ("status unavailable\n", None),
+    ]
+    for stdout, expected in cases:
+        _install_rdma_ctl(tmp_path, monkeypatch, output=stdout)
+        with patch("exo.utils.info_gatherer.info_gatherer.IS_DARWIN", True):
+            result = _run(status.gather())
+        assert (None if result is None else result.enabled) is expected
+
