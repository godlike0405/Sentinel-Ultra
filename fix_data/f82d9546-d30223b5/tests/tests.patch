+def test_apply_is_idempotent_by_overwrite_and_preserves_other_nodes() -> None:
+    symbols = _symbols()
+    apply_info = symbols["apply_node_gathered_info"]
+    state = symbols["State"]()
+    state = apply_info(_gathered(symbols, "alpha", True), state)
+    state = apply_info(_gathered(symbols, "beta", True), state)
+    state = apply_info(_gathered(symbols, "alpha", False), state)
+    assert state.node_rdma_ctl[symbols["NodeId"]("alpha")].enabled is False
+    assert state.node_rdma_ctl[symbols["NodeId"]("beta")].enabled is True
