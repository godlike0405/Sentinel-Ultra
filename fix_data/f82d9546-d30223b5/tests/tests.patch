+def _install_rdma_ctl(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+    *,
+    output: str = "enabled",
+    exit_code: int = 0,
+    delay: int = 0,
+) -> Path:
+    executable = tmp_path / "rdma_ctl"
+    executable.write_text(
+        "#!/bin/sh\n"
+        'printf "%s\\n" "$@" > "$RDMA_CTL_ARGS_FILE"\n'
+        'if [ "$RDMA_CTL_DELAY" -gt 0 ]; then exec sleep "$RDMA_CTL_DELAY"; fi\n'
+        'printf "%s" "$RDMA_CTL_OUTPUT"\n'
+        'exit "$RDMA_CTL_EXIT"\n',
+        encoding="utf-8",
+    )
+    executable.chmod(0o755)
+    args_file = tmp_path / "args.txt"
+    monkeypatch.setenv("PATH", f"{tmp_path}{os.pathsep}{os.environ.get('PATH', '')}")
+    monkeypatch.setenv("RDMA_CTL_ARGS_FILE", str(args_file))
+    monkeypatch.setenv("RDMA_CTL_OUTPUT", output)
+    monkeypatch.setenv("RDMA_CTL_EXIT", str(exit_code))
+    monkeypatch.setenv("RDMA_CTL_DELAY", str(delay))
+    return args_file
+
