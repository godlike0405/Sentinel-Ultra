+def _gathered(symbols: dict[str, Any], node: str, enabled: bool) -> Any:
+    return symbols["NodeGatheredInfo"](
+        node_id=symbols["NodeId"](node),
+        when="2026-02-10T12:00:00+00:00",
+        info=symbols["RdmaCtlStatus"](enabled=enabled),
+    )
+
