+@pytest.mark.asyncio
+async def test_message_span_has_contract_attributes_and_current_parent(tracing) -> None:
+    tracer, exporter = tracing
+    middleware = telemetry.OpenTelemetryMiddleware()
+
+    async def call_next(context: Any) -> str:
+        return "pong"
+
+    with tracer.start_as_current_span("transport") as parent:
+        parent_id = parent.get_span_context().span_id
+        result = await middleware.on_message(
+            make_context(method="notifications/tools/list_changed"), call_next
+        )
