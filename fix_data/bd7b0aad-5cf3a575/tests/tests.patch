+@pytest.mark.asyncio
+async def test_disabled_telemetry_hooks_are_transparent(
+    tracing,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _, exporter = tracing
+    monkeypatch.setattr(instrumentation, "_provider", None)
+    middleware = telemetry.OpenTelemetryMiddleware()
+    calls: list[str] = []
+
+    async def call_next(context: Any) -> Any:
+        calls.append(context.method)
+        return context.message
+
+    contexts = [
+        make_context(method="tools/call"),
+        make_context(method="resources/read"),
+        make_context(method="prompts/get"),
+        make_context(method="ping"),
+    ]
+    hooks = (
+        middleware.on_call_tool,
+        middleware.on_read_resource,
+        middleware.on_get_prompt,
+        middleware.on_message,
+    )
+    for hook, context in zip(hooks, contexts, strict=True):
+        assert await hook(context, call_next) is context.message
+
+    assert calls == [context.method for context in contexts]
+    assert exporter.get_finished_spans() == ()
+
