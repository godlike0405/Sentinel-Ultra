+@pytest.fixture
+def tracing(monkeypatch: pytest.MonkeyPatch):
+    """Use a fresh in-memory provider while exercising the public middleware."""
+    provider = TracerProvider()
+    exporter = InMemorySpanExporter()
+    provider.add_span_processor(SimpleSpanProcessor(exporter))
+    tracer = provider.get_tracer("golf-verifier")
+
+    monkeypatch.setattr(instrumentation, "_provider", provider)
+    monkeypatch.setattr(instrumentation, "_tracer", tracer)
+    instrumentation.set_detailed_tracing(True)
+    yield tracer, exporter
+    instrumentation.set_detailed_tracing(False)
+
+
+def make_context(
+    *,
+    method: str = "tools/call",
+    name: str = "adder",
+    uri: str = "resource://weather",
+) -> SimpleNamespace:
+    message = SimpleNamespace(name=name, uri=uri, arguments={"a": 1, "b": 2})
+    request_context = SimpleNamespace(
+        request_id="req-7",
+        session_id="session-3",
+        client_id="client-2",
+        user_id="user-9",
+        tenant_id="tenant-4",
+    )
+    return SimpleNamespace(
+        message=message,
+        method=method,
+        type="request",
+        source="client",
+        fastmcp_context=request_context,
+    )
+
+
+def finished_span(exporter: InMemorySpanExporter, name: str):
+    matches = [span for span in exporter.get_finished_spans() if span.name == name]
+    assert len(matches) == 1, f"expected one {name!r} span, got {len(matches)}"
+    return matches[0]
+
+
+class MetricsRecorder:
+    def __init__(self) -> None:
+        self.executions: list[tuple[str, str]] = []
+        self.durations: list[tuple[str, float]] = []
+
+    def increment_tool_execution(self, name: str, outcome: str) -> None:
+        self.executions.append((name, outcome))
+
+    def record_tool_duration(self, name: str, duration: float) -> None:
+        self.durations.append((name, duration))
+
+
+class CompatibleResult:
+    """Unrelated result class implementing the documented field protocol."""
+
+    def __init__(self, *, structured_content: Any = None, content: Any = None) -> None:
+        self.structured_content = structured_content
+        self.content = content
+
+
+class HostileResult:
+    @property
+    def structured_content(self) -> Any:
+        raise RuntimeError("payload access failed")
+
+    @property
+    def content(self) -> Any:
+        raise RuntimeError("payload access failed")
+
+
+def test_public_exports_and_provider_accessor(monkeypatch: pytest.MonkeyPatch) -> None:
+    for name in _REQUIRED_EXPORTS:
+        assert name in telemetry.__all__
+
+    sentinel = object()
+    monkeypatch.setattr(instrumentation, "_provider", sentinel)
+    assert telemetry.get_provider() is sentinel
+
+    monkeypatch.setattr(instrumentation, "_provider", None)
+    assert telemetry.get_provider() is None
+
