+@pytest.mark.asyncio
+async def test_mcp_result_serialization_prefers_real_content(
+    tracing,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from fastmcp.tools.tool import ToolResult
+    from mcp.types import TextContent
+    import golf.metrics as metrics
+
+    _, exporter = tracing
+    recorder = MetricsRecorder()
+    monkeypatch.setattr(metrics, "get_metrics_collector", lambda: recorder)
+    middleware = telemetry.OpenTelemetryMiddleware()
+
+    cases = (
+        (
+            "structured",
+            ToolResult(structured_content={"answer": 42}),
+            {"answer": 42},
+            "ToolResult",
+        ),
+        (
+            "blocks",
+            ToolResult(
+                content=[
+                    TextContent(type="text", text="first"),
+                    TextContent(type="text", text="second"),
+                ]
+            ),
+            ["first", "second"],
+            "ToolResult",
+        ),
+        (
+            "compatible-structured",
+            CompatibleResult(structured_content={"answer": 43}),
+            {"answer": 43},
+            "CompatibleResult",
+        ),
+        (
+            "compatible-blocks",
+            CompatibleResult(
+                content=[SimpleNamespace(text="third"), SimpleNamespace(text="fourth")]
+            ),
+            ["third", "fourth"],
+            "CompatibleResult",
+        ),
+    )
+    for name, result, expected, result_type in cases:
+        async def call_next(context: Any, value: Any = result) -> Any:
+            return value
+
+        returned = await middleware.on_call_tool(make_context(name=name), call_next)
+        assert returned is result
+        span = finished_span(exporter, f"mcp.tool.{name}.execute")
+        output = span.attributes["mcp.tool.output"]
+        assert json.loads(output) == expected
+        assert span.attributes["mcp.tool.result.type"] == result_type
+        assert result_type not in output and "TextContent" not in output
+
