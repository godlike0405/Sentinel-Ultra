+@pytest.mark.asyncio
+async def test_non_http_asgi_scope_passes_through_without_http_parent(tracing) -> None:
+    _, exporter = tracing
+    middleware = telemetry.OpenTelemetryMiddleware()
+    seen: list[tuple[Any, Any, Any]] = []
+
+    async def call_next(context: Any) -> str:
+        return "ok"
+
+    async def app(scope: Any, receive: Any, send: Any) -> None:
+        seen.append((scope, receive, send))
+        await middleware.on_message(make_context(method="websocket/message"), call_next)
+
+    asgi = telemetry.OTelContextCapturingMiddleware(app)
+    scope = {"type": "websocket"}
+    receive, send = object(), object()
+    await asgi(scope, receive, send)
+    assert seen == [(scope, receive, send)]
+    span = finished_span(exporter, "mcp.request.websocket.message")
+    assert span.parent is None
