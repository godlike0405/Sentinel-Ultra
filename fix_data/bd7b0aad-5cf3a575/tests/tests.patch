+import pytest
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import SimpleSpanProcessor
+from opentelemetry.sdk.trace.export.in_memory_span_exporter import InMemorySpanExporter
+from opentelemetry.trace import StatusCode
+
+import golf
+import golf.telemetry as telemetry
+from golf.telemetry import instrumentation
+
+
+_REQUIRED_EXPORTS = (
+    "get_provider",
+    "OpenTelemetryMiddleware",
+    "OTelContextCapturingMiddleware",
+)
+_MISSING_EXPORTS = [name for name in _REQUIRED_EXPORTS if not hasattr(telemetry, name)]
+
+
+@pytest.fixture(autouse=True)
+def require_mcp_telemetry_api() -> None:
+    """Fail each selected test clearly on a base tree lacking the feature."""
+    if _MISSING_EXPORTS:
+        pytest.fail("missing MCP telemetry API: " + ", ".join(_MISSING_EXPORTS))
+
