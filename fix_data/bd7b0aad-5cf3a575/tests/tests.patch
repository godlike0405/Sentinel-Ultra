+        if entered == 2:
+            both_entered.set()
+        await both_entered.wait()
+        await middleware.on_message(
+            make_context(method=f"concurrent/{scope['request_name']}"), call_next
+        )
+
+    asgi = telemetry.OTelContextCapturingMiddleware(app)
+
+    async def run_request(name: str) -> tuple[str, int]:
+        with tracer.start_as_current_span(f"http.{name}") as parent:
+            parent_id = parent.get_span_context().span_id
+            await asgi({"type": "http", "request_name": name}, object(), object())
+        return name, parent_id
+
+    parents = dict(await asyncio.gather(run_request("one"), run_request("two")))
+    for name, parent_id in parents.items():
+        span = finished_span(exporter, f"mcp.request.concurrent.{name}")
+        assert span.parent is not None and span.parent.span_id == parent_id
+
+
+@pytest.mark.asyncio
+async def test_nested_http_capture_restores_outer_parent_after_cancellation(tracing) -> None:
+    tracer, exporter = tracing
+    middleware = telemetry.OpenTelemetryMiddleware()
+    cancellation = asyncio.CancelledError("inner request cancelled")
+
+    async def call_next(context: Any) -> str:
+        return context.method
+
+    async def inner_app(scope: Any, receive: Any, send: Any) -> None:
+        raise cancellation
+
+    inner = telemetry.OTelContextCapturingMiddleware(inner_app)
+
+    async def outer_app(scope: Any, receive: Any, send: Any) -> None:
+        await middleware.on_message(make_context(method="outer/before"), call_next)
+        with tracer.start_as_current_span("http.inner"):
+            with pytest.raises(asyncio.CancelledError) as caught:
+                await inner({"type": "http"}, receive, send)
+            assert caught.value is cancellation
+        await middleware.on_message(make_context(method="outer/after"), call_next)
+
+    outer = telemetry.OTelContextCapturingMiddleware(outer_app)
+    with tracer.start_as_current_span("http.outer") as parent:
+        outer_id = parent.get_span_context().span_id
+        await outer({"type": "http"}, object(), object())
+
+    for name in ("mcp.request.outer.before", "mcp.request.outer.after"):
+        span = finished_span(exporter, name)
+        assert span.parent is not None and span.parent.span_id == outer_id
+
+
+def write_project(project: Path) -> None:
+    (project / "tools").mkdir(parents=True)
+    (project / "resources").mkdir()
+    (project / "prompts").mkdir()
+    (project / "golf.json").write_text(
+        json.dumps(
+            {
+                "name": "otel-build-contract",
+                "transport": "stdio",
+                "opentelemetry_enabled": True,
+                "detailed_tracing": True,
+            }
+        )
+    )
+    (project / "tools" / "adder.py").write_text(
+        '"""Adder tool."""\n\n'
+        'def adder(a: int, b: int) -> int:\n    """Add values."""\n    return a + b\n\n'
+        'export = adder\n'
+    )
+    (project / "resources" / "status.py").write_text(
+        '"""Status resource."""\n\nresource_uri = "status://current"\n\n'
+        'def read_status() -> str:\n    """Read status."""\n    return "ok"\n\n'
+        'export = read_status\n'
+    )
+    (project / "prompts" / "welcome.py").write_text(
+        '"""Welcome prompt."""\n\n'
+        'def welcome(name: str) -> list:\n    """Welcome a user."""\n'
+        '    return [{"role": "user", "content": f"Hello {name}"}]\n\n'
+        'export = welcome\n'
+    )
+    (project / "middleware.py").write_text(
+        "from fastmcp.server.middleware import Middleware\n"
+        "class CustomMiddleware(Middleware):\n"
+        "    async def on_message(self, context, call_next):\n"
+        "        return await call_next(context)\n"
+    )
+
+
+def assert_generated_runtime(
+    output: Path,
+    project: Path,
+    build_env: dict[str, str],
+    *,
+    expect_otel: bool,
+) -> None:
+    probe = r'''
+import asyncio
+import importlib
+import importlib.util
+import sys
+
+output, project, expected = sys.argv[1:]
+sys.path[:0] = [output, project]
+spec = importlib.util.spec_from_file_location("generated_server", output + "/server.py")
+server = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(server)
+
+from golf.telemetry import OpenTelemetryMiddleware
+from middleware import CustomMiddleware
+
+otel = [i for i, item in enumerate(server.mcp.middleware) if isinstance(item, OpenTelemetryMiddleware)]
+custom = [i for i, item in enumerate(server.mcp.middleware) if isinstance(item, CustomMiddleware)]
+assert len(custom) == 1
+if expected == "enabled":
+    assert len(otel) == 1 and otel[0] < custom[0]
+else:
+    assert not otel
+
+objects = (
+    asyncio.run(server.mcp.get_tool("adder")),
+    asyncio.run(server.mcp.get_resource("status://current")),
+    asyncio.run(server.mcp.get_prompt("welcome")),
+)
+for component in objects:
+    function = component.fn
+    owner = importlib.import_module(function.__module__)
+    assert getattr(owner, function.__name__) is function
+'''
+    completed = subprocess.run(
+        [
+            sys.executable,
+            "-c",
+            probe,
+            str(output),
+            str(project),
+            "enabled" if expect_otel else "disabled",
+        ],
+        cwd=project,
+        env=build_env,
+        text=True,
+        capture_output=True,
+        timeout=90,
+        check=False,
+    )
+    assert completed.returncode == 0, completed.stdout + completed.stderr
+
+
+def test_public_build_uses_one_mcp_boundary_and_original_components(tmp_path: Path) -> None:
+    project = tmp_path / "project"
+    output = tmp_path / "dist"
+    write_project(project)
+
+    build_env = {
+        **os.environ,
+        "PYTHONPATH": os.pathsep.join(
+            filter(
+                None,
+                (
+                    str(Path(golf.__file__).resolve().parents[1]),
+                    os.environ.get("PYTHONPATH"),
+                ),
+            )
+        ),
+    }
+    completed = subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "golf.commands.build",
+            "--project-path",
+            str(project),
+            "--output-dir",
+            str(output),
+        ],
+        cwd=project,
+        env=build_env,
+        text=True,
+        capture_output=True,
+        timeout=90,
+        check=False,
+    )
+    assert completed.returncode == 0, completed.stdout + completed.stderr
+
+    server_path = output / "server.py"
+    server = server_path.read_text()
+    compile(server, str(server_path), "exec")
+    assert_generated_runtime(output, project, build_env, expect_otel=True)
+
+    (project / "golf.json").write_text(
+        json.dumps(
+            {
+                "name": "otel-build-contract",
+                "transport": "stdio",
+                "opentelemetry_enabled": False,
+            }
+        )
+    )
+    disabled_output = tmp_path / "disabled-dist"
+    disabled = subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "golf.commands.build",
+            "--project-path",
+            str(project),
+            "--output-dir",
+            str(disabled_output),
+        ],
+        cwd=project,
+        env=build_env,
+        text=True,
+        capture_output=True,
+        timeout=90,
+        check=False,
+    )
+    assert disabled.returncode == 0, disabled.stdout + disabled.stderr
+    disabled_server_path = disabled_output / "server.py"
+    disabled_server = disabled_server_path.read_text()
+    compile(disabled_server, str(disabled_server_path), "exec")
+    assert_generated_runtime(disabled_output, project, build_env, expect_otel=False)
