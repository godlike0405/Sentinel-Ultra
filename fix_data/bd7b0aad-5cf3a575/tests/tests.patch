+@pytest.mark.asyncio
+async def test_http_context_is_captured_for_mcp_then_restored(tracing) -> None:
+    tracer, exporter = tracing
+    middleware = telemetry.OpenTelemetryMiddleware()
+    calls = 0
+
+    async def call_next(context: Any) -> str:
+        return "ok"
+
+    async def app(scope: Any, receive: Any, send: Any) -> None:
+        nonlocal calls
+        calls += 1
+        await middleware.on_message(make_context(method="tools/call"), call_next)
+
+    asgi = telemetry.OTelContextCapturingMiddleware(app)
+    with tracer.start_as_current_span("http.request") as http_span:
+        http_id = http_span.get_span_context().span_id
+        await asgi({"type": "http"}, object(), object())
+
+    await middleware.on_message(make_context(method="ping"), call_next)
+    assert calls == 1
+
+    captured = finished_span(exporter, "mcp.request.tools.call")
+    assert captured.parent is not None and captured.parent.span_id == http_id
+    after = finished_span(exporter, "mcp.request.ping")
+    assert after.parent is None
+
