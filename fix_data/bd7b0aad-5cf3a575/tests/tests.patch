+@pytest.mark.asyncio
+async def test_tool_span_preserves_parent_payload_context_and_metrics(
+    tracing,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from fastmcp.tools.tool import ToolResult
+
+    tracer, exporter = tracing
+    recorder = MetricsRecorder()
+    import golf.metrics as metrics
+
+    monkeypatch.setattr(metrics, "get_metrics_collector", lambda: recorder)
+    middleware = telemetry.OpenTelemetryMiddleware()
+    result = ToolResult(structured_content={"answer": 3})
+
+    async def call_next(context: Any) -> Any:
+        return result
+
+    with tracer.start_as_current_span("http.request") as parent:
+        parent_id = parent.get_span_context().span_id
+        assert await middleware.on_call_tool(make_context(), call_next) is result
+
+    span = finished_span(exporter, "mcp.tool.adder.execute")
+    assert span.parent is not None and span.parent.span_id == parent_id
+    assert span.attributes["mcp.component.type"] == "tool"
+    assert span.attributes["mcp.tool.name"] == "adder"
+    assert span.attributes["mcp.method"] == "tools/call"
+    assert json.loads(span.attributes["mcp.tool.input"]) == {"a": 1, "b": 2}
+    assert json.loads(span.attributes["mcp.tool.output"]) == {"answer": 3}
+    assert span.attributes["mcp.tool.result.type"] == "ToolResult"
+    for key, value in {
+        "request_id": "req-7",
+        "session_id": "session-3",
+        "client_id": "client-2",
+        "user_id": "user-9",
+        "tenant_id": "tenant-4",
+    }.items():
+        assert span.attributes[f"mcp.context.{key}"] == value
+    assert recorder.executions == [("adder", "success")]
+    assert len(recorder.durations) == 1
+    assert recorder.durations[0][0] == "adder"
+    assert recorder.durations[0][1] >= 0
+
