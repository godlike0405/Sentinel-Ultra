+@pytest.mark.asyncio
+async def test_message_span_has_contract_attributes_and_current_parent(tracing) -> None:
+    tracer, exporter = tracing
+    middleware = telemetry.OpenTelemetryMiddleware()
+
+    async def call_next(context: Any) -> str:
+        return "pong"
+
+    with tracer.start_as_current_span("transport") as parent:
+        parent_id = parent.get_span_context().span_id
+        result = await middleware.on_message(
+            make_context(method="notifications/tools/list_changed"), call_next
+        )
+    assert result == "pong"
+
+    span = finished_span(exporter, "mcp.request.notifications.tools.list_changed")
+    assert span.parent is not None and span.parent.span_id == parent_id
+    assert span.attributes["mcp.method"] == "notifications/tools/list_changed"
+    assert span.attributes["mcp.message.type"] == "request"
+    assert span.attributes["mcp.message.source"] == "client"
+
+    failure = RuntimeError("message exploded")
+
+    async def fail_next(context: Any) -> Any:
+        raise failure
+
+    with pytest.raises(RuntimeError) as caught:
+        await middleware.on_message(make_context(method="message/failure"), fail_next)
+    assert caught.value is failure
+    failed = finished_span(exporter, "mcp.request.message.failure")
+    assert failed.status.status_code is StatusCode.ERROR
+    assert any(event.name == "exception" for event in failed.events)
+
