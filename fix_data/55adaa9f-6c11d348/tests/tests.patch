+        Primitive::u64,
+        Primitive::i128,
+        Primitive::u128,
+    ] {
+        let expression = TransformPlan::analyze(primitive.into(), &Types::default()).map("input");
+        assert_eq!(
+            evaluate_javascript("", json!("18446744073709551616"), &expression),
+            json!({ "$bigint": "18446744073709551616" })
+        );
+    }
+    for primitive in [Primitive::u32, Primitive::bool, Primitive::str] {
+        assert_eq!(
+            TransformPlan::analyze(primitive.into(), &Types::default()).map("input"),
+            "input"
+        );
+    }
+});
