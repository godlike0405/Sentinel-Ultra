+contract_test!(v2_named_matcher_matrix_contract, {
+    let cases = [
+        ("std::time", "SystemTime"),
+        ("toml::value", "Datetime"),
+        ("chrono", "NaiveDateTime"),
+        ("chrono", "NaiveDate"),
+        ("chrono", "Date"),
+        ("chrono", "DateTime"),
+        ("time", "PrimitiveDateTime"),
+        ("time", "OffsetDateTime"),
+        ("time", "Date"),
+        ("jiff", "Timestamp"),
+        ("jiff", "Zoned"),
+        ("jiff::civil", "Date"),
+        ("jiff::civil", "DateTime"),
+        ("bson", "DateTime"),
+        ("bytes", "Bytes"),
+        ("bytes", "BytesMut"),
+    ];
+    for (module, name) in cases {
+        let (dt, types) = named_type(module, name);
+        let expression = TransformPlan::analyze(dt, &types).map("input");
+        let (input, expected) = if module == "bytes" {
+            (json!([7, 8]), json!({ "$bytes": [7, 8] }))
+        } else {
+            (
+                json!("2026-08-09T10:11:12Z"),
+                json!({ "$date": "2026-08-09T10:11:12.000Z" }),
+            )
+        };
+        assert_eq!(evaluate_javascript("", input, &expression), expected);
+    }
+
+    let (unrelated, types) = named_type("other", "DateTime");
+    assert_eq!(
+        TransformPlan::analyze(unrelated, &types).map("input"),
+        "input"
+    );
+});
