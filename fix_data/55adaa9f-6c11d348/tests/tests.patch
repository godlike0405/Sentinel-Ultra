+fn record_completion(name: &str) {
+    let Ok(path) = std::env::var("SENTINEL_COMPLETION_PATH") else {
+        return;
+    };
+    let expected = std::env::var("SENTINEL_EXPECTED_TEST").expect("missing expected test name");
+    let token = std::env::var("SENTINEL_COMPLETION_TOKEN").expect("missing completion token");
+    assert_eq!(name, expected, "the verifier selected a different test");
+    std::fs::write(path, format!("{name}:{token}")).expect("write completion token");
+}
+
+macro_rules! contract_test {
+    ($name:ident, $body:block) => {
+        #[test]
+        fn $name() {
+            $body
+            record_completion(stringify!($name));
+        }
+    };
+}
+
+fn named_type(module_path: &str, name: &str) -> (DataType, Types) {
+    let mut types = Types::default();
+    let mut named = NamedDataType::new(name.to_owned(), vec![], Primitive::str.into());
+    *named.module_path_mut() = Cow::Owned(module_path.to_owned());
+    let dt = named.reference(vec![]).into();
+    named.register(&mut types);
+    (dt, types)
+}
+
+const NORMALIZE_JS: &str = r#"
+const normalize = (value) => {
+    if (typeof value === "bigint") return { "$bigint": value.toString() };
+    if (value instanceof Date) return { "$date": value.toISOString() };
+    if (value instanceof Uint8Array) return { "$bytes": Array.from(value) };
+    if (Array.isArray(value)) return value.map(normalize);
+    if (value !== null && typeof value === "object") {
+        return Object.fromEntries(
+            Object.entries(value).map(([key, item]) => [key, normalize(item)]),
+        );
+    }
+    return value;
+};
+"#;
+
+fn run_javascript(source: &str) -> Value {
+    let node = std::env::var("SENTINEL_NODE").unwrap_or_else(|_| "node".into());
+    let output = Command::new(node)
+        .args(["--input-type=commonjs", "--eval", source])
+        .output()
+        .expect("run the JavaScript behavior check with Node.js");
+    assert!(
+        output.status.success(),
+        "JavaScript execution failed:\n{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    serde_json::from_slice(&output.stdout).expect("JavaScript must print one JSON value")
+}
+
+fn evaluate_javascript(runtime: &str, input: Value, expression: &str) -> Value {
+    run_javascript(&format!(
+        "{runtime}\nconst input = {};\nconst result = ({expression});\n{NORMALIZE_JS}\nprocess.stdout.write(JSON.stringify(normalize(result)));",
+        serde_json::to_string(&input).unwrap()
+    ))
+}
+
+fn run_typescript(runtime: &str, body: &str) -> Value {
+    let tsc = std::env::var("SENTINEL_TSC").unwrap_or_else(|_| "tsc".into());
+    let node = std::env::var("SENTINEL_NODE").unwrap_or_else(|_| "node".into());
+    let root = std::env::temp_dir().join(format!("specta-tags-typescript-{}", std::process::id()));
+    if root.exists() {
+        fs::remove_dir_all(&root).expect("clear stale TypeScript output");
+    }
+    let output_dir = root.join("out");
+    fs::create_dir_all(&output_dir).expect("create TypeScript output directory");
+    let source_path = root.join("runtime.ts");
+    fs::write(&source_path, format!("{runtime}\n{body}\n")).expect("write TypeScript source");
+
+    let compiled = Command::new(tsc)
+        .args([
+            "--strict", "--target", "ES2020", "--module", "commonjs", "--pretty", "false",
+            "--outDir",
+        ])
+        .arg(&output_dir)
+        .arg(&source_path)
+        .output()
+        .expect("compile the generated TypeScript runtime");
+    assert!(
+        compiled.status.success(),
+        "TypeScript compilation failed:\n{}",
+        String::from_utf8_lossy(&compiled.stdout)
+    );
+
+    let executed = Command::new(node)
+        .arg(output_dir.join("runtime.js"))
+        .output()
+        .expect("execute the compiled TypeScript runtime");
+    assert!(
+        executed.status.success(),
+        "compiled TypeScript execution failed:\n{}",
+        String::from_utf8_lossy(&executed.stderr)
+    );
+    let value = serde_json::from_slice(&executed.stdout)
+        .expect("compiled TypeScript must print one JSON value");
+    fs::remove_dir_all(root).expect("remove TypeScript output directory");
+    value
+}
