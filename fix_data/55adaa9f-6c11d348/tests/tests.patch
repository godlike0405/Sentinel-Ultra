+contract_test!(v2_nested_object_key_and_variable_contract, {
+    let mut types = Types::default();
+    let plan = TransformPlan::analyze(Root::definition(&mut types), &types);
+    let behavior = plan.map("input");
+    assert_eq!(
+        evaluate_javascript(
+            "",
+            json!({
+                "bigint": "21",
+                "date": "2026-01-02T03:04:05Z",
+                "bytes": [1, 2],
+                "nested": {
+                    "bigint": "22",
+                    "date": "2025-02-03T04:05:06Z",
+                    "bytes": [3, 4],
+                    "plain": "unchanged"
+                },
+                "list": ["23", "24"]
+            }),
+            &behavior
+        ),
+        json!({
+            "bigint": { "$bigint": "21" },
+            "date": { "$date": "2026-01-02T03:04:05.000Z" },
+            "bytes": { "$bytes": [1, 2] },
+            "nested": {
+                "bigint": { "$bigint": "22" },
+                "date": { "$date": "2025-02-03T04:05:06.000Z" },
+                "bytes": { "$bytes": [3, 4] },
+                "plain": "unchanged"
+            },
+            "list": [{ "$bigint": "23" }, { "$bigint": "24" }]
+        })
+    );
+
+    let mut plain_types = Types::default();
+    let plain = TransformPlan::analyze(Plain::definition(&mut plain_types), &plain_types);
+    assert_eq!(plain.map("payload"), "payload");
+    assert_eq!(plain.map("another"), "another");
+});
