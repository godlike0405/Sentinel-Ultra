+    let helper_only_source = format!(
+        "{helper_only}\nPromise.all([\n  __TS_transformResult(Promise.resolve({{ status: 'ok', data: 'plain' }}), 0, 0),\n  __TS_transformResult(Promise.resolve({{ status: 'error', error: 'problem' }}), 0, 0),\n]).then((result) => process.stdout.write(JSON.stringify(result)));"
+    );
