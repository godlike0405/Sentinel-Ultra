+    bytes: bytes::Bytes,
+    b: B,
+}
+
+#[derive(Type)]
+pub struct B {
+    bigint: u128,
+    date: chrono::DateTime<chrono::Utc>,
+    bytes: bytes::Bytes,
+}
+
+fn main() {
+    let mut types = Types::default();
+    let dt = A::definition(&mut types);
+
+    let tags = specta_tags::v2::TransformPlan::analyze(dt, &types);
