+class TestSessionStoreOptionsValidation:
+
+
+    @pytest.mark.asyncio
+    async def test_options_validation_contract(self) -> None:
+        """Every option combination the SDK has to police, in one place.
+
+        Validation happens before the subprocess is spawned, so each of these
+        is observable at the connect boundary.
+        """
+        # Continuing has to find the most-recent session, which a store that
+        # cannot enumerate can never supply — fail fast rather than silently
+        # starting a fresh conversation.
+        with pytest.raises(Exception) as excinfo:
+            await _connect(
+                ClaudeAgentOptions(
+                    session_store=_RequiredOnlyStore(), continue_conversation=True
+                )
+            )
+        assert not isinstance(
+            excinfo.value, (AttributeError, NameError, ImportError)
+        ), f"refusal must be deliberate, got {excinfo.value!r}"
+
+        # A store that can enumerate is fine.
+        await _connect(
+            ClaudeAgentOptions(
+                session_store=InMemorySessionStore(), continue_conversation=True
+            )
+        )
+
+        # An explicit resume id wins over continue, so enumeration is provably
+        # never needed — the combination must be accepted even without it.
+        await _connect(
+            ClaudeAgentOptions(
+                session_store=_RequiredOnlyStore(),
+                continue_conversation=True,
+                resume="00000000-0000-4000-8000-000000000000",
+            )
+        )
+
+        # A store and file-based checkpointing are two competing sources of
+        # truth for the transcript; the combination must be refused.
+        with pytest.raises(Exception) as combo:
+            await _connect(
+                ClaudeAgentOptions(
+                    session_store=InMemorySessionStore(),
+                    enable_file_checkpointing=True,
+                )
+            )
+        assert not isinstance(
+            combo.value, (AttributeError, NameError, ImportError)
+        ), f"rejection must be deliberate, got {combo.value!r}"
+        # Positive control: neither half is rejected on its own, so the
+        # refusal above is attributable to the combination.
+        await _connect(ClaudeAgentOptions(enable_file_checkpointing=True))
+        await _connect(ClaudeAgentOptions(session_store=InMemorySessionStore()))
+
+        # The documented defaults hold: no store unless one is supplied, and
+        # a 60-second read budget.
+        defaults = ClaudeAgentOptions()
+        assert defaults.session_store is None
+        assert defaults.load_timeout_ms == 60_000
+
+        # No store at all is always valid, whatever else is set.
+        await _connect(
+            ClaudeAgentOptions(
+                continue_conversation=True, enable_file_checkpointing=True
+            )
+        )
+        await _connect(ClaudeAgentOptions(session_store=InMemorySessionStore()))
+
