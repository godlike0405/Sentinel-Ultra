+"""Tests for the ``*_from_store`` / ``*_via_store`` async session helpers.
+
+Exercises the SessionStore-backed code paths in
+``_internal/sessions.py`` and ``_internal/session_mutations.py`` using
+``InMemorySessionStore``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import uuid as uuid_mod
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+
+
+# ---------------------------------------------------------------------------
+# Base-compilable import guard
+#
+# The symbols below exist only once the feature is implemented. Importing them
+# at module scope makes this file fail during *collection* on a tree that lacks
+# them, which reports one opaque error for the whole file instead of a result
+# per test. Binding them defensively keeps the module importable, so each test
+# fails on its own with a clear message.
+# ---------------------------------------------------------------------------
+InMemorySessionStore: Any = None
+delete_session_via_store: Any = None
+fork_session_via_store: Any = None
+get_session_info_from_store: Any = None
+get_session_messages_from_store: Any = None
+get_subagent_messages_from_store: Any = None
+list_sessions_from_store: Any = None
+list_subagents_from_store: Any = None
+project_key_for_directory: Any = None
+rename_session_via_store: Any = None
+tag_session_via_store: Any = None
+SessionStore: Any = None
+
+SessionKey: Any = None
+
+_SESSION_STORE_API_ERROR: Any = None
+try:
+    from claude_agent_sdk import (
+        InMemorySessionStore,
+        delete_session_via_store,
+        fork_session_via_store,
+        get_session_info_from_store,
+        get_session_messages_from_store,
+        get_subagent_messages_from_store,
+        list_sessions_from_store,
+        list_subagents_from_store,
+        project_key_for_directory,
+        rename_session_via_store,
+        tag_session_via_store,
+    )
+    from claude_agent_sdk.types import (
+        SessionKey,
+        SessionStore,
+    )
+except ImportError as exc:  # pragma: no cover - only on an unsolved tree
+    _SESSION_STORE_API_ERROR = exc
+
+
+@pytest.fixture(autouse=True)
+def _require_session_store_api() -> None:
+    """Fail each test individually when the session-store API is absent."""
+    if _SESSION_STORE_API_ERROR is not None:
+        pytest.fail(
+            "claude_agent_sdk does not provide the session-store API yet: "
+            + str(_SESSION_STORE_API_ERROR)
+        )
+
+
+pytestmark = pytest.mark.asyncio
+
+
+# ---------------------------------------------------------------------------
+# Fixtures and helpers
+# ---------------------------------------------------------------------------
+
+DIR = "/workspace/project"
+PROJECT_KEY = project_key_for_directory(DIR) if project_key_for_directory else ""
+
+
+def _user(text: str, uid: str, parent: str | None, sid: str) -> dict[str, Any]:
+    return {
+        "type": "user",
+        "uuid": uid,
+        "parentUuid": parent,
+        "sessionId": sid,
+        "timestamp": "2024-01-01T00:00:00.000Z",
+        "message": {"role": "user", "content": text},
+    }
+
+
+def _assistant(text: str, uid: str, parent: str, sid: str) -> dict[str, Any]:
+    return {
+        "type": "assistant",
+        "uuid": uid,
+        "parentUuid": parent,
+        "sessionId": sid,
+        "timestamp": "2024-01-01T00:00:01.000Z",
+        "message": {"role": "assistant", "content": [{"type": "text", "text": text}]},
+    }
+
+
+async def _seed_chain(store: InMemorySessionStore, sid: str, n: int = 2) -> list[str]:
+    """Append ``n`` user/assistant pairs and return their UUIDs in order."""
+    key: SessionKey = {"project_key": PROJECT_KEY, "session_id": sid}
+    uuids: list[str] = []
+    parent: str | None = None
+    entries: list[dict[str, Any]] = []
+    for i in range(n):
+        u = str(uuid_mod.uuid4())
+        a = str(uuid_mod.uuid4())
+        entries.append(_user(f"prompt {i}", u, parent, sid))
+        entries.append(_assistant(f"reply {i}", a, u, sid))
+        uuids.extend([u, a])
+        parent = a
+    await store.append(key, entries)  # type: ignore[arg-type]
+    return uuids
+
+
+class _MinimalStore(SessionStore or object):
+    """Duck-typed store implementing only the required ``append``/``load``."""
+
+    def __init__(self) -> None:
+        self._data: dict[str, list] = {}
+
+    async def append(self, key: SessionKey, entries: list) -> None:
+        k = f"{key['project_key']}/{key['session_id']}/{key.get('subpath', '')}"
+        self._data.setdefault(k, []).extend(entries)
+
+    async def load(self, key: SessionKey) -> list | None:
+        k = f"{key['project_key']}/{key['session_id']}/{key.get('subpath', '')}"
+        return self._data.get(k)
+
+
+# ---------------------------------------------------------------------------
+# Read helpers — list_sessions / get_session_info / get_session_messages
+# ---------------------------------------------------------------------------
+
+
+class TestListSessionsFromStore:
+    async def test_listing_contract(self) -> None:
+        """One graded test for the whole listing contract: real sessions are
+        returned most-recent-first with summaries, sidechains are dropped,
+        pagination applies to what survives that filter, and a store that
+        cannot enumerate is refused rather than reported as empty."""
+        store = InMemorySessionStore()
+        real: list[str] = []
+        for _ in range(5):
+            sid = str(uuid_mod.uuid4())
+            await _seed_chain(store, sid, n=1)
+            real.append(sid)
+        sidechains: list[str] = []
+        for _ in range(3):
+            sc = str(uuid_mod.uuid4())
+            entry = _user("internal", str(uuid_mod.uuid4()), None, sc)
+            entry["isSidechain"] = True
+            await store.append(
+                {"project_key": PROJECT_KEY, "session_id": sc},
+                [entry],  # type: ignore[arg-type]
+            )
+            sidechains.append(sc)
+
+        sessions = await list_sessions_from_store(store, directory=DIR)
+        ids = [s.session_id for s in sessions]
+        assert set(ids) == set(real), "sidechains must not surface"
+        assert not any(sc in ids for sc in sidechains)
+        assert all(s.summary == "prompt 0" for s in sessions)
+        mtimes = [s.last_modified for s in sessions]
+        assert mtimes == sorted(mtimes, reverse=True), "most recent first"
+
+        # Pagination applies after the sidechain filter, so a full page is
+        # returned rather than one padded out by dropped rows.
+        page = await list_sessions_from_store(store, directory=DIR, limit=3, offset=1)
+        assert [s.session_id for s in page] == ids[1:4]
+
+        # A store that cannot enumerate must be refused deliberately, not
+        # crash on a missing attribute and not silently report nothing.
+        with pytest.raises(Exception) as excinfo:
+            await list_sessions_from_store(_MinimalStore(), directory=DIR)
+        assert not isinstance(
+            excinfo.value, (AttributeError, NameError, ImportError)
+        ), f"refusal must be deliberate, got {excinfo.value!r}"
+
+        # A listing must not fan out unboundedly across the adapter: a large
+        # project would otherwise open one connection per session and exhaust
+        # the adapter's pool. The bound itself is the implementation's choice;
+        # what matters is that one exists and holds for the whole run.
+        in_flight = 0
+        peak = 0
+        gate = asyncio.Event()
+
+        class SlowStore(InMemorySessionStore):
+            async def load(self, key):
+                nonlocal in_flight, peak
+                in_flight += 1
+                peak = max(peak, in_flight)
+                await gate.wait()
+                in_flight -= 1
+                return await super().load(key)
+
+        slow = SlowStore()
+        n = 96
+        for i in range(n):
+            await InMemorySessionStore.append(
+                slow,
+                {"project_key": PROJECT_KEY, "session_id": str(uuid_mod.uuid4())},
+                [{"type": "user", "uuid": f"u{i}"}],
+            )
+        task = asyncio.create_task(list_sessions_from_store(slow, directory=DIR))
+        for _ in range(5):  # let the scheduler saturate whatever bound exists
+            await asyncio.sleep(0)
+        assert peak > 0, "loads should have started"
+        assert peak < n, f"unbounded: {peak} concurrent loads for {n} sessions"
+        saturated = peak
+        gate.set()
+        await task
+        # A ceiling that is exceeded later is not a ceiling.
+        assert peak == saturated
+
+        # One bad row must not take down the whole listing.
+        good = str(uuid_mod.uuid4())
+        bad = str(uuid_mod.uuid4())
+
+        class FlakyStore(InMemorySessionStore):
+            async def load(self, key):
+                if key.get("session_id") == bad:
+                    raise OSError("adapter blew up on this row")
+                return await super().load(key)
+
+        flaky = FlakyStore()
+        await _seed_chain(flaky, good, n=1)
+        await _seed_chain(flaky, bad, n=1)
+        rows = await list_sessions_from_store(flaky, directory=DIR)
+        by_id = {r.session_id: r for r in rows}
+        assert good in by_id, "a healthy row must still be listed"
+        assert by_id[good].summary == "prompt 0"
+        if bad in by_id:
+            assert by_id[bad].summary == "", "a broken row degrades rather than lies"
+
+        # And the adapter's own list must not be mutated by the read.
+        returned: list[Any] = []
+
+        class WatchingStore(InMemorySessionStore):
+            async def list_sessions(self, project_key):
+                rows = await super().list_sessions(project_key)
+                returned.append(rows)
+                return rows
+
+        watching = WatchingStore()
+        await _seed_chain(watching, str(uuid_mod.uuid4()), n=1)
+        before = [list(r) for r in returned]
+        await list_sessions_from_store(watching, directory=DIR)
+        assert [list(r) for r in returned][: len(before)] == before
+        assert returned and all(isinstance(r, list) for r in returned)
+
+
+class TestGetSessionInfoFromStore:
+
+
+    async def test_reflects_custom_title(self) -> None:
+        store = InMemorySessionStore()
+        sid = str(uuid_mod.uuid4())
+        await _seed_chain(store, sid)
+        await rename_session_via_store(store, sid, "My Title", directory=DIR)
+
+        info = await get_session_info_from_store(store, sid, directory=DIR)
+        assert info is not None
+        assert info.custom_title == "My Title"
+        assert info.summary == "My Title"
+        assert info.session_id == sid
+
+        # An unknown session is reported as absent, not invented.
+        assert (
+            await get_session_info_from_store(
+                store, str(uuid_mod.uuid4()), directory=DIR
+            )
+            is None
+        )
+
+        # When entries carry no cwd, the requested directory is the fallback.
+        plain = InMemorySessionStore()
+        psid = str(uuid_mod.uuid4())
+        await _seed_chain(plain, psid)
+        pinfo = await get_session_info_from_store(plain, psid, directory=DIR)
+        assert pinfo is not None and pinfo.cwd is not None
+        assert Path(pinfo.cwd).name == Path(DIR).name
+        listed = await list_sessions_from_store(plain, directory=DIR)
+        assert listed and listed[0].cwd == pinfo.cwd
+
+
+class TestGetSessionMessagesFromStore:
+    async def test_returns_chain_in_order(self) -> None:
+        store = InMemorySessionStore()
+        sid = str(uuid_mod.uuid4())
+        uuids = await _seed_chain(store, sid, n=2)
+
+        msgs = await get_session_messages_from_store(store, sid, directory=DIR)
+        assert len(msgs) == 4
+        assert [m.uuid for m in msgs] == uuids
+        assert msgs[0].type == "user"
+        assert msgs[1].type == "assistant"
+
+        page = await get_session_messages_from_store(
+            store, sid, directory=DIR, limit=2, offset=1
+        )
+        assert [m.uuid for m in page] == uuids[1:3]
+
+        # Metadata (non-message) entries are not messages.
+        meta_sid = str(uuid_mod.uuid4())
+        mu = str(uuid_mod.uuid4())
+        await store.append(
+            {"project_key": PROJECT_KEY, "session_id": meta_sid},
+            [
+                {"type": "custom-title", "customTitle": "T", "sessionId": meta_sid},
+                _user("hi", mu, None, meta_sid),
+            ],  # type: ignore[arg-type]
+        )
+        assert [
+            m.type
+            for m in await get_session_messages_from_store(
+                store, meta_sid, directory=DIR
+            )
+        ] == ["user"]
+
+        # An unknown session has no messages.
+        assert (
+            await get_session_messages_from_store(
+                store, str(uuid_mod.uuid4()), directory=DIR
+            )
+            == []
+        )
+
+
+# ---------------------------------------------------------------------------
+# Subagent helpers — list_subagents / get_subagent_messages
+# ---------------------------------------------------------------------------
+
+
+class TestSubagentsFromStore:
+    async def test_subagent_listing_and_messages_contract(self) -> None:
+        """The whole subagent contract in one graded test: an agent is listed
+        once however many subpaths it appears under, nested subpaths work,
+        metadata entries are not messages, a non-UUID session is refused, and
+        a store that cannot enumerate subkeys is refused rather than silently
+        reporting nothing."""
+        store = InMemorySessionStore()
+        sid = str(uuid_mod.uuid4())
+        await _seed_chain(store, sid)
+
+        # Same agent under a direct and a nested subpath -> listed once.
+        for sp in ("subagents/agent-abc", "subagents/workflows/run-1/agent-abc"):
+            await store.append(
+                {"project_key": PROJECT_KEY, "session_id": sid, "subpath": sp},
+                [_user("x", str(uuid_mod.uuid4()), None, sid)],  # type: ignore[arg-type]
+            )
+        # A second, distinct agent reached only through a nested subpath.
+        u_nested = str(uuid_mod.uuid4())
+        await store.append(
+            {
+                "project_key": PROJECT_KEY,
+                "session_id": sid,
+                "subpath": "subagents/workflows/run-2/agent-nested",
+            },
+            [
+                {"type": "agent_metadata", "name": "nested"},
+                _user("hi", u_nested, None, sid),
+            ],  # type: ignore[arg-type]
+        )
+
+        assert sorted(await list_subagents_from_store(store, sid, directory=DIR)) == [
+            "abc",
+            "nested",
+        ]
+
+        # Metadata entries are filtered out of the message stream.
+        msgs = await get_subagent_messages_from_store(
+            store, sid, "nested", directory=DIR
+        )
+        assert [m.type for m in msgs] == ["user"]
+
+        # A non-UUID session id yields nothing rather than raising.
+        assert await list_subagents_from_store(store, "not-a-uuid", directory=DIR) == []
+        assert (
+            await get_subagent_messages_from_store(
+                store, "not-a-uuid", "abc", directory=DIR
+            )
+            == []
+        )
+
+        # Enumeration genuinely needs list_subkeys — refuse rather than
+        # silently reporting an empty agent list.
+        minimal = _MinimalStore()
+        with pytest.raises(Exception) as excinfo:
+            await list_subagents_from_store(minimal, sid, directory=DIR)
+        assert not isinstance(
+            excinfo.value, (AttributeError, NameError, ImportError)
+        ), f"refusal must be deliberate, got {excinfo.value!r}"
+
+        # ...but fetching one known agent does not need it.
+        u_direct = str(uuid_mod.uuid4())
+        await minimal.append(
+            {
+                "project_key": PROJECT_KEY,
+                "session_id": sid,
+                "subpath": "subagents/agent-direct",
+            },
+            [_user("hi", u_direct, None, sid)],  # type: ignore[arg-type]
+        )
+        direct = await get_subagent_messages_from_store(
+            minimal, sid, "direct", directory=DIR
+        )
+        assert [m.type for m in direct] == ["user"]
+
+
+# ---------------------------------------------------------------------------
+# Mutation helpers — rename / tag / delete / fork
+# ---------------------------------------------------------------------------
+
+
+class TestTagSessionViaStore:
+
+
+    async def test_tag_reflected_in_session_info(self) -> None:
+        store = InMemorySessionStore()
+        sid = str(uuid_mod.uuid4())
+        await _seed_chain(store, sid)
+        await tag_session_via_store(store, sid, "exp", directory=DIR)
+
+        info = await get_session_info_from_store(store, sid, directory=DIR)
+        assert info is not None
+        assert info.tag == "exp"
+
+        # Passing None clears the tag again.
+        await tag_session_via_store(store, sid, None, directory=DIR)
+        cleared = await get_session_info_from_store(store, sid, directory=DIR)
+        assert cleared is not None and not cleared.tag
+
+        # An adapter that round-trips entries with their keys reordered (a
+        # JSONB column, say) must not change what the tag reads back as.
+        class ReorderingStore(InMemorySessionStore):
+            async def load(self, key):
+                got = await super().load(key)
+                if got is None:
+                    return None
+                return [dict(reversed(list(e.items()))) for e in got]
+
+        reordered = ReorderingStore()
+        rsid = str(uuid_mod.uuid4())
+        await _seed_chain(reordered, rsid)
+        await tag_session_via_store(reordered, rsid, "kept", directory=DIR)
+        rinfo = await get_session_info_from_store(reordered, rsid, directory=DIR)
+        assert rinfo is not None and rinfo.tag == "kept"
+
+
+class TestDeleteSessionViaStore:
+    async def test_delete_contract(self) -> None:
+        """Deleting must actually remove the session, tolerate a store that
+        cannot delete, and refuse a session id it cannot validate — without
+        writing anything to the store on the refusal path."""
+        store = InMemorySessionStore()
+        sid = str(uuid_mod.uuid4())
+        other = str(uuid_mod.uuid4())
+        await _seed_chain(store, sid)
+        await _seed_chain(store, other)
+        assert store.size == 2
+
+        await delete_session_via_store(store, sid, directory=DIR)
+        assert await store.load({"project_key": PROJECT_KEY, "session_id": sid}) is None
+        # Only the requested session went away.
+        assert (
+            await store.load({"project_key": PROJECT_KEY, "session_id": other})
+            is not None
+        )
+        assert store.size == 1
+        assert sid not in [
+            s.session_id for s in await list_sessions_from_store(store, directory=DIR)
+        ]
+
+        # A store without delete() is a documented no-op, not an error.
+        await delete_session_via_store(_MinimalStore(), other, directory=DIR)
+
+        # A non-UUID id is refused and must not mutate the store.
+        appended = False
+
+        class SpyStore(InMemorySessionStore):
+            async def append(self, key, entries):
+                nonlocal appended
+                appended = True
+                await super().append(key, entries)
+
+        spy = SpyStore()
+        with pytest.raises(Exception) as bad_id:
+            await delete_session_via_store(spy, "not-a-uuid", directory=DIR)
+        assert not isinstance(
+            bad_id.value, (AttributeError, NameError, ImportError)
+        ), f"rejection must be deliberate, got {bad_id.value!r}"
+        assert appended is False
+
+
+class TestForkSessionViaStore:
+    async def test_fork_contract(self) -> None:
+        """One graded test for the whole fork contract: a new independent
+        session, message identity not shared with the original, the chain
+        preserved, slicing at a given message, a title derived from the
+        original, and non-UUID inputs refused."""
+        store = InMemorySessionStore()
+        sid = str(uuid_mod.uuid4())
+        src_uuids = await _seed_chain(store, sid, n=3)
+        await store.append(
+            {"project_key": PROJECT_KEY, "session_id": sid},
+            [{"type": "custom-title", "customTitle": "Original", "sessionId": sid}],  # type: ignore[list-item]
+        )
+
+        result = await fork_session_via_store(store, sid, directory=DIR)
+        assert result.session_id != sid
+
+        forked = store.get_entries(
+            {"project_key": PROJECT_KEY, "session_id": result.session_id}
+        )
+        msgs = [e for e in forked if e["type"] in ("user", "assistant")]
+        assert len(msgs) == 6
+
+        # Independent identity: no message uuid is shared with the original,
+        # so later history in one session can never be confused with the other.
+        assert all(e["uuid"] not in src_uuids for e in msgs)
+        assert all(e["sessionId"] == result.session_id for e in msgs)
+
+        # Chain preserved.
+        assert msgs[0]["parentUuid"] is None
+        for prev, cur in zip(msgs, msgs[1:], strict=False):
+            assert cur["parentUuid"] == prev["uuid"]
+
+        # Title derived from the original rather than left empty.
+        trailer = forked[-1]
+        assert trailer["type"] == "custom-title"
+        assert "Original" in trailer["customTitle"]
+        assert isinstance(trailer["uuid"], str) and trailer["uuid"]
+        assert isinstance(trailer["timestamp"], str) and trailer["timestamp"]
+
+        # Slicing at a message ends the fork there.
+        sliced = await fork_session_via_store(
+            store, sid, directory=DIR, up_to_message_id=src_uuids[1]
+        )
+        sliced_msgs = [
+            e
+            for e in store.get_entries(
+                {"project_key": PROJECT_KEY, "session_id": sliced.session_id}
+            )
+            if e["type"] in ("user", "assistant")
+        ]
+        assert len(sliced_msgs) == 2
+
+        # The fork is readable back through the ordinary read path.
+        read_back = await get_session_messages_from_store(
+            store, result.session_id, directory=DIR
+        )
+        assert len(read_back) == 6
+
+        # With no custom title the fork falls back to the session's own
+        # generated title rather than shipping an empty one.
+        ai = InMemorySessionStore()
+        asid = str(uuid_mod.uuid4())
+        await _seed_chain(ai, asid, n=1)
+        await ai.append(
+            {"project_key": PROJECT_KEY, "session_id": asid},
+            [{"type": "summary", "summary": "Generated Title", "sessionId": asid}],  # type: ignore[list-item]
+        )
+        aresult = await fork_session_via_store(ai, asid, directory=DIR)
+        aentries = ai.get_entries(
+            {"project_key": PROJECT_KEY, "session_id": aresult.session_id}
+        )
+        assert aentries[-1]["type"] == "custom-title"
+        assert aentries[-1]["customTitle"], "a fork must carry a non-empty title"
+
+        # Every entry the fork synthesises is as well-formed as the ones it
+        # copies, so an adapter can dedupe on uuid/timestamp.
+        for e in aentries:
+            assert isinstance(e.get("uuid"), str) and e["uuid"]
+            assert isinstance(e.get("timestamp"), str) and e["timestamp"]
+
+        # Forking a session that does not exist is an error, not an empty fork.
+        with pytest.raises(Exception) as nf:
+            await fork_session_via_store(store, str(uuid_mod.uuid4()), directory=DIR)
+        assert not isinstance(nf.value, (AttributeError, NameError, ImportError))
+
+        # Non-UUID inputs are refused.
+        with pytest.raises(Exception) as bad_session:
+            await fork_session_via_store(store, "not-a-uuid", directory=DIR)
+        assert not isinstance(
+            bad_session.value, (AttributeError, NameError, ImportError)
+        ), f"rejection must be deliberate, got {bad_session.value!r}"
+        with pytest.raises(Exception) as bad_upto:
+            await fork_session_via_store(
+                store, sid, directory=DIR, up_to_message_id="not-a-uuid"
+            )
+        assert not isinstance(
+            bad_upto.value, (AttributeError, NameError, ImportError)
+        ), f"rejection must be deliberate, got {bad_upto.value!r}"
