+class TestTranscriptMirrorBatching:
+    @pytest.mark.asyncio
+    async def test_delivery_contract(self, tmp_path: Path) -> None:
+        """One graded test for the whole delivery contract: path→key mapping
+        for main and subagent transcripts, per-transcript coalescing in order,
+        distinct keys for distinct transcripts, no phantom key for an empty
+        batch, mirroring invisible to the application, a modest backlog held
+        until the result, a backlog past the entry-count bound delivered
+        without waiting, and everything persisted before the result surfaces.
+        """
+        s = _Session(tmp_path)
+        main = s.path("proj", "sess.jsonl")
+        sub = s.path("proj", "sess", "subagents", "agent-x.jsonl")
+        other = s.path("proj", "other.jsonl")
+
+        at_assistant: list[int] = []
+        at_result: list[int] = []
+
+        def watch(m: Any) -> None:
+            if isinstance(m, AssistantMessage):
+                at_assistant.append(len(s.store.append_calls))
+            if isinstance(m, ResultMessage):
+                at_result.append(len(s.store.append_calls))
+
+        seen = await s.run(
+            [
+                _mirror(main, [{"type": "user", "n": 1}]),
+                _mirror(other, []),  # empty batch -> no phantom key
+                _mirror(sub, [{"type": "user", "n": 100}]),
+                _ASSISTANT_MSG,
+                _mirror(main, [{"type": "assistant", "n": 2}]),
+                _RESULT_MSG,
+            ],
+            on_message=watch,
+        )
+
+        # Mirroring is invisible to the application.
+        assert [type(m) for m in seen] == [AssistantMessage, ResultMessage]
+
+        # A modest backlog is still buffered when the assistant message lands.
+        assert at_assistant == [0]
+        # ...and everything pending is persisted before the result surfaces.
+        assert at_result and at_result[0] >= 1
+
+        by_key: dict[tuple, list[int]] = {}
+        for key, entries in s.store.append_calls:
+            by_key.setdefault(
+                (key["project_key"], key["session_id"], key.get("subpath")), []
+            ).extend(e["n"] for e in entries)
+
+        assert by_key == {
+            ("proj", "sess", None): [1, 2],
+            ("proj", "sess", "subagents/agent-x"): [100],
+        }, "coalesced per transcript, in order, with no phantom empty key"
+
+        # And the backlog must not grow without bound: past the entry-count
+        # bound and past the byte bound, delivery starts before anything asks
+        # for a flush — otherwise a long conversation buffers the whole
+        # transcript in memory and loses it if the process dies.
+        for label, entries in (
+            ("entry count", [{"type": "user", "n": i} for i in range(600)]),
+            ("byte size", [{"type": "user", "blob": "a" * (2 << 20)}]),
+        ):
+            big = _Session(tmp_path / label.replace(" ", "-"))
+            eager: list[int] = []
+            await big.run(
+                [
+                    _mirror(big.path("proj", "sess.jsonl"), entries),
+                    _ASSISTANT_MSG,
+                    _RESULT_MSG,
+                ],
+                on_message=lambda m: eager.append(len(big.store.append_calls))
+                if isinstance(m, AssistantMessage)
+                else None,
+            )
+            assert eager and eager[0] >= 1, (
+                f"backlog past the {label} bound should already be delivering"
+            )
+            delivered = [e for _, batch in big.store.append_calls for e in batch]
+            assert len(delivered) == len(entries), "and nothing may be lost"
+
