+class TestAdapterFailures:
+    @pytest.mark.asyncio
+    async def test_adapter_failure_and_timeout_surface_mirror_errors(
+        self, tmp_path: Path
+    ) -> None:
+        """A store is third-party code. Whether it raises or simply never
+        returns, the mirror must neither crash the stream nor silently drop
+        data: the conversation completes and the caller is told persistence
+        failed."""
+
+        class FailingStore(InMemorySessionStore):
+            async def append(self, key, entries):  # type: ignore[override]
+                raise RuntimeError("boom")
+
+        s = _Session(tmp_path / "raises", store=FailingStore())
+        seen = await s.run(
+            [
+                _mirror(s.path("proj", "sess.jsonl"), [{"type": "user"}]),
+                _ASSISTANT_MSG,
+                _RESULT_MSG,
+            ]
+        )
+        errors = [m for m in seen if isinstance(m, MirrorErrorMessage)]
+        assert len(errors) == 1
+        assert errors[0].subtype == "mirror_error"
+        assert errors[0].key == {"project_key": "proj", "session_id": "sess"}
+        assert "boom" in errors[0].error
+        assert any(isinstance(m, ResultMessage) for m in seen)
+
+        # A store that never returns must be bounded rather than stalling the
+        # conversation forever; the outer wait_for only catches a regression.
+        class HangingStore(InMemorySessionStore):
+            async def append(self, key, entries):  # type: ignore[override]
+                await asyncio.sleep(3600)
+
+        hung = _Session(tmp_path / "hangs", store=HangingStore())
+        task = asyncio.ensure_future(
+            hung.run(
+                [
+                    _mirror(hung.path("proj", "sess.jsonl"), [{"type": "user"}]),
+                    _RESULT_MSG,
+                ]
+            )
+        )
+        # asyncio.wait leaves the task alone on timeout, so this returns
+        # promptly whether or not the implementation bounds the append. A
+        # conversation that never finishes is the failure being tested for;
+        # it must not be able to stall the whole verifier run.
+        _done, pending = await asyncio.wait({task}, timeout=90)
+        if pending:
+            task.cancel()
+            pytest.fail(
+                "a hanging store.append must be bounded and reported; the "
+                "conversation never completed"
+            )
+        seen = task.result()
+        assert any(isinstance(m, MirrorErrorMessage) for m in seen), (
+            "a hanging append must time out and be reported, not stall silently"
+        )
+        assert any(isinstance(m, ResultMessage) for m in seen)
+
