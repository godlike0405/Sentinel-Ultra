+class _StagingWatcher:
+    """Detects staged directories left behind, without assuming how they are
+    named or created.
+
+    Two independent observations, both from the published surface:
+      * the directory the subprocess is pointed at, read off ``CLAUDE_CONFIG_DIR``
+        in the options handed to the transport; and
+      * anything new appearing directly under the system temp root.
+
+    Nothing here depends on a particular prefix, module or temp-dir helper, so
+    any disposable-staging implementation is accepted.
+    """
+
+    def __init__(self) -> None:
+        self._root = Path(tempfile.gettempdir())
+        self._before = set(self._root.iterdir())
+        self.config_dirs: list[Path] = []
+
+    def note(self, options: Any) -> None:
+        """Record the config dir handed to a transport, if one was staged."""
+        value = getattr(options, "env", {}).get("CLAUDE_CONFIG_DIR")
+        if value:
+            path = Path(value)
+            if path not in self.config_dirs:
+                self.config_dirs.append(path)
+
+    def leaks(self) -> list[Path]:
+        surviving = [d for d in self.config_dirs if d.exists()]
+        new_temp_entries = [
+            d for d in set(self._root.iterdir()) - self._before if d.exists()
+        ]
+        return surviving + new_temp_entries
+
+
+class _FixedMtimeStore(InMemorySessionStore or object):
+    """Store whose listing reports caller-chosen mtimes.
+
+    ``list_sessions`` is part of the store protocol, so an adapter deciding
+    what "most recent" means is ordinary published behaviour — no internal
+    state is touched.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.mtimes: dict[str, int] = {}
+
+    async def list_sessions(self, project_key):  # type: ignore[override]
+        rows = await super().list_sessions(project_key)
+        return [
+            {**row, "mtime": self.mtimes.get(row["session_id"], row["mtime"])}
+            for row in rows
+        ]
+
