+class TestTimeoutsAndErrors:
+    @pytest.mark.asyncio
+    async def test_store_read_timeout_contract(
+        self, cwd: Path, project_key: str, isolated_home: Path
+    ) -> None:
+        """``load_timeout_ms`` bounds *every* store read taken during resume,
+        not just the transcript load. A store that hangs in any of them must
+        make the connection fail instead of hanging the caller forever — and a
+        hang after staging has begun must not leak the staged directory."""
+
+        # 1. A hanging load().
+        class HangingLoad(SessionStore):
+            async def append(self, key, entries):  # type: ignore[override]
+                pass
+
+            async def load(self, key):  # type: ignore[override]
+                await asyncio.sleep(3600)
+                return None
+
+        await _assert_bounded_failure(
+            ClaudeAgentOptions(
+                cwd=cwd,
+                session_store=HangingLoad(),
+                resume=SESSION_ID,
+                load_timeout_ms=50,
+            )
+        )
+
+        # 2. A hanging list_sessions() on the continue path.
+        class HangingList(SessionStore):
+            async def append(self, key, entries):  # type: ignore[override]
+                pass
+
+            async def load(self, key):  # type: ignore[override]
+                return None
+
+            async def list_sessions(self, project_key):  # type: ignore[override]
+                await asyncio.sleep(3600)
+                return []
+
+        await _assert_bounded_failure(
+            ClaudeAgentOptions(
+                cwd=cwd,
+                session_store=HangingList(),
+                continue_conversation=True,
+                load_timeout_ms=50,
+            )
+        )
+
+        # 3. A hanging list_subkeys(), which happens *after* staging has
+        #    started — the staged directory must still be removed.
+        class HangingSubkeys(InMemorySessionStore):
+            async def list_subkeys(self, key):  # type: ignore[override]
+                await asyncio.sleep(3600)
+                return []
+
+        store = HangingSubkeys()
+        await store.append(
+            {"project_key": project_key, "session_id": SESSION_ID},
+            [{"type": "user", "uuid": "u1"}],
+        )
+        watcher = _StagingWatcher()
+        await _assert_bounded_failure(
+            ClaudeAgentOptions(
+                cwd=cwd,
+                session_store=store,
+                resume=SESSION_ID,
+                load_timeout_ms=50,
+            )
+        )
+        assert not watcher.leaks(), (
+            f"a timeout after staging began leaked state: {watcher.leaks()}"
+        )
+
+        # 4. An error raised inside load() must surface clearly rather than as
+        #    a bare adapter exception with no context.
+        class BrokenLoad(SessionStore):
+            async def append(self, key, entries):  # type: ignore[override]
+                pass
+
+            async def load(self, key):  # type: ignore[override]
+                raise OSError("network down")
+
+        with pytest.raises(Exception) as excinfo:
+            await _stage(
+                ClaudeAgentOptions(
+                    cwd=cwd, session_store=BrokenLoad(), resume=SESSION_ID
+                )
+            )
+        _assert_deliberate_failure(excinfo)
+        assert "network down" in str(excinfo.value), (
+            "the adapter's own message must survive into the surfaced error"
+        )
+
+        # 5. An entry that cannot be serialised must surface a clear error and
+        #    must not leave the staged directory behind.
+        class UnserialisableStore(SessionStore):
+            async def append(self, key, entries):  # type: ignore[override]
+                pass
+
+            async def load(self, key):  # type: ignore[override]
+                return [{"type": "user", "uuid": "u1", "blob": {1, 2, 3}}]
+
+        watcher2 = _StagingWatcher()
+        with pytest.raises(Exception) as excinfo:
+            await _stage(
+                ClaudeAgentOptions(
+                    cwd=cwd, session_store=UnserialisableStore(), resume=SESSION_ID
+                )
+            )
+        assert not isinstance(excinfo.value, (AttributeError, NameError, ImportError))
+        assert not watcher2.leaks(), (
+            f"an unserialisable entry leaked staged state: {watcher2.leaks()}"
+        )
+
+
+# ---------------------------------------------------------------------------
+# Integration: ClaudeSDKClient.connect() wiring
+# ---------------------------------------------------------------------------
+
+
+def _make_mock_transport() -> Any:
+    mock_transport = AsyncMock()
+
+    async def mock_receive():
+        return
+        yield  # pragma: no cover
+
+    mock_transport.read_messages = mock_receive
+    mock_transport.connect = AsyncMock()
+    mock_transport.close = AsyncMock()
+    mock_transport.end_input = AsyncMock()
+    mock_transport.write = AsyncMock()
+    mock_transport.is_ready = Mock(return_value=True)
+    return mock_transport
+
+
+class TestClientIntegration:
+    @pytest.mark.asyncio
+    async def test_connect_passes_config_dir_resume_and_suppresses_continue(
+        self, cwd: Path, project_key: str, isolated_home: Path
+    ) -> None:
+        store = InMemorySessionStore()
+        await store.append(
+            {"project_key": project_key, "session_id": SESSION_ID},
+            [{"type": "user", "uuid": "u1"}],
+        )
+
+        captured: dict[str, Any] = {}
+        mock_transport = _make_mock_transport()
+
+        def capture_transport(*, prompt, options):
+            captured["options"] = options
+            return mock_transport
+
+        opts = ClaudeAgentOptions(
+            cwd=cwd,
+            session_store=store,
+            continue_conversation=True,
+            cli_path="/usr/bin/claude",
+        )
+        client = ClaudeSDKClient(options=opts)
+
+        with (
+            patch(
+                "claude_agent_sdk._internal.transport.subprocess_cli."
+                "SubprocessCLITransport",
+                side_effect=capture_transport,
+            ),
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            await client.connect()
+
+        # The options passed to the transport carry the materialized
+        # overrides.
+        transport_opts: ClaudeAgentOptions = captured["options"]
+        assert transport_opts.resume == SESSION_ID
+        assert transport_opts.continue_conversation is False
+        config_dir = transport_opts.env["CLAUDE_CONFIG_DIR"]
+        assert Path(config_dir).is_dir()
+        assert (
+            Path(config_dir) / "projects" / project_key / f"{SESSION_ID}.jsonl"
+        ).is_file()
+
+        # Build the actual CLI command (real class, outside the patch) to
+        # assert exact flag behavior.
+        cmd = SubprocessCLITransport(
+            prompt="x", options=transport_opts
+        )._build_command()
+        assert "--resume" in cmd
+        assert cmd[cmd.index("--resume") + 1] == SESSION_ID
+        assert "--continue" not in cmd
+
+        # The mirror follows the subprocess into the staged config dir --
+        # asserted behaviourally in test_transcript_mirror.py
+        # (test_mirror_follows_staged_config_dir_on_resume).
+
+        # Original options object untouched.
+        assert opts.continue_conversation is True
+        assert opts.resume is None
+        assert "CLAUDE_CONFIG_DIR" not in opts.env
+
+        await client.disconnect()
+
+        # Cleanup removed the temp dir.
+        assert not Path(config_dir).exists()
+
+        # A custom transport bypasses the CLI subprocess, so nothing may be
+        # read from the store and no credential file may be written.
+        class SpyStore(InMemorySessionStore):
+            loads = 0
+
+            async def load(self, key):  # type: ignore[override]
+                SpyStore.loads += 1
+                return await super().load(key)
+
+        spy_store = SpyStore()
+        await spy_store.append(
+            {"project_key": project_key, "session_id": SESSION_ID},
+            [{"type": "user", "uuid": "u1"}],
+        )
+        # A custom transport must produce no staged state at all. Detected by
+        # watching the temp root rather than by any naming convention, so an
+        # implementation free to stage however it likes is still checked.
+        watcher = _StagingWatcher()
+        if True:
+            custom_client = ClaudeSDKClient(
+                options=ClaudeAgentOptions(
+                    cwd=cwd, session_store=spy_store, resume=SESSION_ID
+                ),
+                transport=_make_mock_transport(),
+            )
+            with patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
