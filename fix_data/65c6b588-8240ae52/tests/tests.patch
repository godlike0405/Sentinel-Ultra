+class TestSubagentsFromStore:
+    async def test_subagent_listing_and_messages_contract(self) -> None:
+        """The whole subagent contract in one graded test: an agent is listed
+        once however many subpaths it appears under, nested subpaths work,
+        metadata entries are not messages, a non-UUID session is refused, and
+        a store that cannot enumerate subkeys is refused rather than silently
+        reporting nothing."""
+        store = InMemorySessionStore()
+        sid = str(uuid_mod.uuid4())
+        await _seed_chain(store, sid)
+
+        # Same agent under a direct and a nested subpath -> listed once.
+        for sp in ("subagents/agent-abc", "subagents/workflows/run-1/agent-abc"):
+            await store.append(
+                {"project_key": PROJECT_KEY, "session_id": sid, "subpath": sp},
+                [_user("x", str(uuid_mod.uuid4()), None, sid)],  # type: ignore[arg-type]
+            )
+        # A second, distinct agent reached only through a nested subpath.
+        u_nested = str(uuid_mod.uuid4())
+        await store.append(
+            {
+                "project_key": PROJECT_KEY,
+                "session_id": sid,
+                "subpath": "subagents/workflows/run-2/agent-nested",
+            },
+            [
+                {"type": "agent_metadata", "name": "nested"},
+                _user("hi", u_nested, None, sid),
+            ],  # type: ignore[arg-type]
+        )
+
+        assert sorted(await list_subagents_from_store(store, sid, directory=DIR)) == [
+            "abc",
+            "nested",
+        ]
+
+        # Metadata entries are filtered out of the message stream.
+        msgs = await get_subagent_messages_from_store(
+            store, sid, "nested", directory=DIR
+        )
+        assert [m.type for m in msgs] == ["user"]
+
+        # A non-UUID session id yields nothing rather than raising.
+        assert await list_subagents_from_store(store, "not-a-uuid", directory=DIR) == []
+        assert (
+            await get_subagent_messages_from_store(
+                store, "not-a-uuid", "abc", directory=DIR
+            )
+            == []
+        )
+
+        # Enumeration genuinely needs list_subkeys — refuse rather than
+        # silently reporting an empty agent list.
+        minimal = _MinimalStore()
+        with pytest.raises(Exception) as excinfo:
+            await list_subagents_from_store(minimal, sid, directory=DIR)
+        assert not isinstance(
+            excinfo.value, (AttributeError, NameError, ImportError)
+        ), f"refusal must be deliberate, got {excinfo.value!r}"
+
+        # ...but fetching one known agent does not need it.
+        u_direct = str(uuid_mod.uuid4())
+        await minimal.append(
+            {
+                "project_key": PROJECT_KEY,
+                "session_id": sid,
+                "subpath": "subagents/agent-direct",
+            },
+            [_user("hi", u_direct, None, sid)],  # type: ignore[arg-type]
+        )
+        direct = await get_subagent_messages_from_store(
+            minimal, sid, "direct", directory=DIR
+        )
+        assert [m.type for m in direct] == ["user"]
+
