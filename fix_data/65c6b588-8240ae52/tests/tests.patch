+
+class _Staged:
+    """What the SDK prepared for the CLI subprocess, as the subprocess sees it.
+
+    Observed purely from the options handed to the transport: the config
+    directory the subprocess is pointed at and the session id it is told to
+    resume. ``cleanup()`` ends the session the same way an application would.
+    """
+
+    def __init__(self, client: ClaudeSDKClient, transport_options: Any) -> None:
+        self._client = client
+        self.options = transport_options
+        self.config_dir = Path(transport_options.env["CLAUDE_CONFIG_DIR"])
+        self.resume_session_id = transport_options.resume
+
+    async def cleanup(self) -> None:
+        await self._client.disconnect()
+
+
+async def _stage(options: ClaudeAgentOptions) -> _Staged | None:
+    """Connect with the subprocess stubbed out and report what was staged.
+
+    Returns ``None`` when the SDK staged nothing — i.e. the options that
+    reached the transport still point at the caller's own configuration.
+    """
+    captured: dict[str, Any] = {}
+    transport = _make_mock_transport()
+
+    def capture(*, prompt: Any, options: Any) -> Any:
+        captured["options"] = options
+        return transport
+
+    client = ClaudeSDKClient(options=options)
+    with (
+        patch(
+            "claude_agent_sdk._internal.transport.subprocess_cli."
+            "SubprocessCLITransport",
+            side_effect=capture,
+        ),
+        patch(
+            "claude_agent_sdk._internal.query.Query.initialize",
+            new_callable=AsyncMock,
+        ),
+    ):
+        await client.connect()
+
+    transport_options = captured["options"]
+    staged_dir = transport_options.env.get("CLAUDE_CONFIG_DIR")
+    if staged_dir is None or staged_dir == options.env.get("CLAUDE_CONFIG_DIR"):
+        await client.disconnect()
+        return None
+    return _Staged(client, transport_options)
+
+
+def _assert_deliberate_failure(excinfo: Any) -> None:
+    """The read must fail because the budget was exceeded, not because the
+    code blew up. The exception type and wording are the implementation's
+    choice; a programming error is not an acceptable way to satisfy it."""
+    exc = excinfo.value
+    assert not isinstance(
+        exc, (TypeError, AttributeError, NameError, ImportError, KeyError, IndexError)
+    ), f"failed with a programming error rather than a timeout: {exc!r}"
+
+
+async def _assert_bounded_failure(options: ClaudeAgentOptions, budget_s: float = 10.0) -> None:
+    """Staging must fail *promptly* because the configured read budget was
+    exceeded — not hang until some outer guard gives up, and not blow up with
+    a programming error. The exception type and wording are the
+    implementation's choice; the timeliness is the contract.
+    """
+    loop = asyncio.get_running_loop()
+    started = loop.time()
+    with pytest.raises(Exception) as excinfo:
+        await asyncio.wait_for(_stage(options), timeout=budget_s * 6)
+    elapsed = loop.time() - started
+    _assert_deliberate_failure(excinfo)
+    assert elapsed < budget_s, (
+        f"read was not bounded: failed only after {elapsed:.1f}s "
+        f"(load_timeout_ms should have fired almost immediately)"
+    )
+
+
+class _FixedMtimeStore(InMemorySessionStore):
+    """Store whose listing reports caller-chosen mtimes.
+
+    ``list_sessions`` is part of the store protocol, so an adapter deciding
+    what "most recent" means is ordinary published behaviour — no internal
+    state is touched.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.mtimes: dict[str, int] = {}
+
+    async def list_sessions(self, project_key):  # type: ignore[override]
+        rows = await super().list_sessions(project_key)
+        return [
+            {**row, "mtime": self.mtimes.get(row["session_id"], row["mtime"])}
+            for row in rows
+        ]
+
