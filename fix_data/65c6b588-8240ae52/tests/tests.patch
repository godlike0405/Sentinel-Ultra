+class TestSpawnFailureCleanup:
+    """The materialized temp dir contains a .credentials.json copy. It must be
+    removed even when transport.connect() raises before any try/finally that
+    normally guards cleanup."""
+
+    @pytest.mark.asyncio
+    async def test_temp_dir_never_leaks_on_any_failure_path(
+        self,
+        cwd: Path,
+        project_key: str,
+        isolated_home: Path,
+        track_resume_dirs: list[Path],
+    ) -> None:
+        """The staged directory holds a usable credential for the lifetime of
+        the session, so it must be removed on *every* route out — not just the
+        happy one. Each scenario below stages a directory and then fails at a
+        different point; none may leave one behind.
+        """
+
+        async def _seeded_store() -> InMemorySessionStore:
+            store = InMemorySessionStore()
+            await store.append(
+                {"project_key": project_key, "session_id": SESSION_ID},
+                [{"type": "user", "uuid": "u1"}],
+            )
+            return store
+
+        def _opts(store: Any) -> ClaudeAgentOptions:
+            return ClaudeAgentOptions(cwd=cwd, session_store=store, resume=SESSION_ID)
+
+        transport_path = (
+            "claude_agent_sdk._internal.transport.subprocess_cli.SubprocessCLITransport"
+        )
+        # The one-shot query() path constructs the transport through the
+        # internal client module, so that binding needs patching too.
+        query_transport_path = (
+            "claude_agent_sdk._internal.client.SubprocessCLITransport"
+        )
+
+        # 1. Normal completion still cleans up.
+        client = ClaudeSDKClient(options=_opts(await _seeded_store()))
+        with (
+            patch(transport_path, return_value=_make_mock_transport()),
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            await client.connect()
+        await client.disconnect()
+
+        # 2. The subprocess fails to spawn.
+        failing = _make_mock_transport()
+        failing.connect = AsyncMock(side_effect=OSError("spawn failed"))
+        client = ClaudeSDKClient(options=_opts(await _seeded_store()))
+        with (
+            patch(transport_path, return_value=failing),
+            pytest.raises(OSError, match="spawn failed"),
+        ):
+            await client.connect()
+
+        # 3. `async with` fails.
+        failing2 = _make_mock_transport()
+        failing2.connect = AsyncMock(side_effect=OSError("aenter failed"))
+        with (
+            patch(transport_path, return_value=failing2),
+            pytest.raises(OSError, match="aenter failed"),
+        ):
+            async with ClaudeSDKClient(options=_opts(await _seeded_store())):
+                pass  # pragma: no cover
+
+        # 4. Initialization fails after the subprocess exists — the transport
+        #    must be closed before the directory it points at is removed.
+        spawned = _make_mock_transport()
+        client = ClaudeSDKClient(options=_opts(await _seeded_store()))
+        with (
+            patch(transport_path, return_value=spawned),
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+                side_effect=RuntimeError("init failed"),
+            ),
+            pytest.raises(RuntimeError, match="init failed"),
+        ):
+            await client.connect()
+        spawned.close.assert_awaited()
+
+        # 5. Cancelled before the subprocess is spawned.
+        async def _hang(*a: Any, **kw: Any) -> Any:
+            await asyncio.sleep(3600)
+
+        slow = _make_mock_transport()
+        slow.connect = AsyncMock(side_effect=_hang)
+        client = ClaudeSDKClient(options=_opts(await _seeded_store()))
+        with patch(transport_path, return_value=slow):
+            task = asyncio.create_task(client.connect())
+            for _ in range(50):
+                await asyncio.sleep(0)
+                if track_resume_dirs:
+                    break
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+
+        # 6. One-shot query whose transport fails.
+        broken = _make_mock_transport()
+        broken.connect = AsyncMock(side_effect=OSError("query spawn failed"))
+        with (
+            patch(query_transport_path, return_value=broken),
+            pytest.raises(OSError, match="query spawn failed"),
+        ):
+            async for _ in query(prompt="hi", options=_opts(await _seeded_store())):
+                pass  # pragma: no cover
+
+        # 7. One-shot query whose consumer breaks out early.
+        early = _make_mock_transport()
+        with (
+            patch(query_transport_path, return_value=early),
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            async for _ in query(prompt="hi", options=_opts(await _seeded_store())):
+                break
+
+        assert len(track_resume_dirs) >= 7, (
+            f"expected every scenario to stage a directory, saw "
+            f"{len(track_resume_dirs)}"
+        )
+        leaked = [d for d in track_resume_dirs if d.exists()]
+        assert not leaked, f"leaked staged directories: {leaked}"
