+class TestSessionMirrorFlag:
+    @pytest.mark.asyncio
+    async def test_no_store_means_no_mirroring(self, tmp_path: Path) -> None:
+        """With no store there is nothing to mirror into: the SDK must not ask
+        the CLI for the traffic, and any that arrives anyway must be discarded
+        rather than stored or surfaced as an application message."""
+        mirror_frame = _mirror(
+            str(tmp_path / "projects" / "proj" / "sess.jsonl"), [{"type": "user"}]
+        )
+        with (
+            patch("claude_agent_sdk._internal.client.SubprocessCLITransport") as cls,
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            cls.return_value = _mock_transport(
+                [mirror_frame, _ASSISTANT_MSG, _RESULT_MSG]
+            )
+            seen = [m async for m in query(prompt="Hello")]
+        assert [type(m) for m in seen] == [AssistantMessage, ResultMessage], (
+            "mirror frames must never surface as application messages"
+        )
+
+        # And the flag is present exactly when a store is configured.
+        with_store = SubprocessCLITransport(
+            prompt="hi",
+            options=ClaudeAgentOptions(
+                cli_path="/usr/bin/claude", session_store=InMemorySessionStore()
+            ),
+        )._build_command()
+        without_store = SubprocessCLITransport(
+            prompt="hi",
+            options=ClaudeAgentOptions(cli_path="/usr/bin/claude"),
+        )._build_command()
+        assert "--session-mirror" in with_store
+        assert "--session-mirror" not in without_store
+
+    def test_flag_tracks_session_store_option(self) -> None:
+        """The CLI only emits mirroring traffic when asked, so the flag must
+        be present exactly when a store is configured — asking for it with no
+        store wastes a stream, and omitting it with a store silently mirrors
+        nothing."""
+        with_store = SubprocessCLITransport(
+            prompt="hi",
+            options=ClaudeAgentOptions(
+                cli_path="/usr/bin/claude", session_store=InMemorySessionStore()
+            ),
+        )._build_command()
+        without_store = SubprocessCLITransport(
+            prompt="hi",
+            options=ClaudeAgentOptions(cli_path="/usr/bin/claude"),
+        )._build_command()
+
+        assert "--session-mirror" in with_store
+        assert "--session-mirror" not in without_store
+
+    def test_flag_present_when_session_store_set(self) -> None:
+        cmd = SubprocessCLITransport(
+            prompt="hi",
+            options=ClaudeAgentOptions(
+                cli_path="/usr/bin/claude", session_store=InMemorySessionStore()
+            ),
+        )._build_command()
+        assert "--session-mirror" in cmd
+
+    def test_flag_absent_when_session_store_unset(self) -> None:
+        cmd = SubprocessCLITransport(
+            prompt="hi",
+            options=ClaudeAgentOptions(cli_path="/usr/bin/claude"),
+        )._build_command()
+        assert "--session-mirror" not in cmd
