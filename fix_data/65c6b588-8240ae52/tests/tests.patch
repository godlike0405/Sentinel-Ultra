+"""Exercises the shipped :func:`run_session_store_conformance` harness against
+:class:`InMemorySessionStore`, plus options validation and project-key
+derivation.
+
+Everything here goes through the published package surface: the harness itself
+(``claude_agent_sdk.testing``), the store protocol, the public sync session
+readers, and ``ClaudeSDKClient``. Nothing imports a private module, so any
+implementation that satisfies the documented behaviour passes regardless of how
+it is decomposed internally.
+"""
+
+from __future__ import annotations
+
+import json
+import unicodedata
+import uuid as uuid_mod
+from pathlib import Path
+from typing import Any
+from unittest.mock import AsyncMock, Mock, patch
+
+import pytest
+
+from claude_agent_sdk import (
+    ClaudeAgentOptions,
+    ClaudeSDKClient,
+    list_sessions,
+)
+
+
+# ---------------------------------------------------------------------------
+# Base-compilable import guard
+#
+# The symbols below exist only once the feature is implemented. Importing them
+# at module scope makes this file fail during *collection* on a tree that lacks
+# them, which reports one opaque error for the whole file instead of a result
+# per test. Binding them defensively keeps the module importable, so each test
+# fails on its own with a clear message.
+# ---------------------------------------------------------------------------
+InMemorySessionStore: Any = None
+SessionStore: Any = None
+project_key_for_directory: Any = None
+run_session_store_conformance: Any = None
+
+SessionKey: Any = None
+SessionListSubkeysKey: Any = None
+SessionStoreListEntry: Any = None
+_TypesSessionKey: Any = None
+_TypesSessionStore: Any = None
+_TypesSessionStoreEntry: Any = None
+
+_SESSION_STORE_API_ERROR: Any = None
+try:
+    from claude_agent_sdk import (
+        SessionKey,
+        InMemorySessionStore,
+        SessionListSubkeysKey,
+        SessionStore,
+        SessionStoreListEntry,
+        project_key_for_directory,
+    )
+    from claude_agent_sdk.types import (
+        SessionKey as _TypesSessionKey,
+        SessionStore as _TypesSessionStore,
+        SessionStoreEntry as _TypesSessionStoreEntry,
+    )
+    from claude_agent_sdk.testing import (
+        run_session_store_conformance,
+    )
+except ImportError as exc:  # pragma: no cover - only on an unsolved tree
+    _SESSION_STORE_API_ERROR = exc
+
+
+@pytest.fixture(autouse=True)
+def _require_session_store_api() -> None:
+    """Fail each test individually when the session-store API is absent."""
+    if _SESSION_STORE_API_ERROR is not None:
+        pytest.fail(
+            "claude_agent_sdk does not provide the session-store API yet: "
+            + str(_SESSION_STORE_API_ERROR)
+        )
+
+
+_KEY: SessionKey = {"project_key": "proj", "session_id": "sess"}
+
+
+def _mock_transport() -> Any:
+    transport = AsyncMock()
+
+    async def receive():
+        return
+        yield  # pragma: no cover
+
+    transport.read_messages = receive
+    transport.connect = AsyncMock()
+    transport.close = AsyncMock()
+    transport.end_input = AsyncMock()
+    transport.write = AsyncMock()
+    transport.is_ready = Mock(return_value=True)
+    return transport
+
+
+async def _connect(options: ClaudeAgentOptions) -> None:
+    """Drive a real connect() with the subprocess stubbed out.
+
+    Option validation is part of establishing a connection, so this is the
+    boundary an application actually hits.
+    """
+    client = ClaudeSDKClient(options=options)
+    with (
+        patch(
+            "claude_agent_sdk._internal.transport.subprocess_cli."
+            "SubprocessCLITransport",
+            side_effect=lambda **kw: _mock_transport(),
+        ),
+        patch(
+            "claude_agent_sdk._internal.query.Query.initialize",
+            new_callable=AsyncMock,
+        ),
+    ):
+        await client.connect()
+    await client.disconnect()
+
+
+class _RequiredOnlyStore(SessionStore or object):
+    """Implements only the two required protocol methods."""
+
+    async def append(self, key, entries):  # type: ignore[override]
+        pass
+
+    async def load(self, key):  # type: ignore[override]
+        return None
+
+
+# ---------------------------------------------------------------------------
+# InMemorySessionStore
+# ---------------------------------------------------------------------------
+
+
+class TestInMemorySessionStore:
+    @pytest.mark.asyncio
+    async def test_conformance(self) -> None:
+        """The harness must accept a correct store *and* reject broken ones.
+
+        Passing only the positive half would be satisfied by a harness that
+        checks nothing, which is useless to the adapter authors it is published
+        for — so each violation below must be caught.
+        """
+        await run_session_store_conformance(InMemorySessionStore)
+
+        # The published supporting types are usable as declared: a listing row
+        # and a subkey-listing key type-check and carry the documented fields.
+        row: SessionStoreListEntry = {"session_id": "s", "mtime": 123}
+        assert row["session_id"] == "s" and row["mtime"] == 123
+        subkeys_key: SessionListSubkeysKey = {"project_key": "p", "session_id": "s"}
+        assert subkeys_key["project_key"] == "p" and subkeys_key["session_id"] == "s"
+        # And the three types re-exported from claude_agent_sdk.types are the
+        # same objects as the top-level exports.
+        assert _TypesSessionStore is SessionStore
+        assert _TypesSessionKey is not None and _TypesSessionStoreEntry is not None
+
+        # list_sessions rows produced by the reference store honour the
+        # SessionStoreListEntry shape.
+        seeded = InMemorySessionStore()
+        await seeded.append({"project_key": "p", "session_id": "s"}, [{"type": "user"}])
+        rows = await seeded.list_sessions("p")
+        assert rows and all(
+            isinstance(r["session_id"], str) and isinstance(r["mtime"], int)
+            for r in rows
+        )
+
+        class DropsEntries(InMemorySessionStore):
+            """append() silently discards everything."""
+
+            async def append(self, key, entries):  # type: ignore[override]
+                pass
+
+        class ForgetsSubkeys(InMemorySessionStore):
+            async def list_subkeys(self, key):  # type: ignore[override]
+                return []
+
+        class NeverDeletes(InMemorySessionStore):
+            async def delete(self, key):  # type: ignore[override]
+                pass
+
+        class ListsNothing(InMemorySessionStore):
+            async def list_sessions(self, project_key):  # type: ignore[override]
+                return []
+
+        for broken in (DropsEntries, ForgetsSubkeys, NeverDeletes, ListsNothing):
+            with pytest.raises(Exception) as excinfo:
+                await run_session_store_conformance(broken)
+            assert not isinstance(excinfo.value, (SyntaxError, ImportError, NameError))
+
+        # The harness must accept an async factory as well as a sync one.
+        async def make() -> SessionStore:
+            return InMemorySessionStore()
+
+        await run_session_store_conformance(make)
+
+        # A store implementing only the required methods passes when the
+        # optional contracts are suppressed by the caller...
+        class MinimalDuck:
+            def __init__(self) -> None:
+                self._data: dict[str, list] = {}
+
+            async def append(self, key: SessionKey, entries: list) -> None:
+                k = f"{key['project_key']}/{key['session_id']}/{key.get('subpath') or ''}"
+                self._data.setdefault(k, []).extend(entries)
+
+            async def load(self, key: SessionKey) -> list | None:
+                k = f"{key['project_key']}/{key['session_id']}/{key.get('subpath') or ''}"
+                return self._data.get(k)
+
+        await run_session_store_conformance(
+            MinimalDuck,
+            skip_optional=frozenset({"list_sessions", "delete", "list_subkeys"}),
+        )
+
+        # ...and also when nothing is passed, because the harness detects the
+        # missing optionals itself.
+        class MinimalDeclared(MinimalDuck, SessionStore):  # type: ignore[misc]
+            pass
+
+        await run_session_store_conformance(MinimalDeclared)
+
+        # Optional-method support must be detectable at runtime: the SDK has to
+        # reach opposite conclusions for a full store and a required-only one.
+        from claude_agent_sdk import list_sessions_from_store
+
+        full = InMemorySessionStore()
+        await full.append(
+            {"project_key": project_key_for_directory("/w/p"), "session_id": "s"},
+            [{"type": "user", "uuid": "u"}],
+        )
+        await list_sessions_from_store(full, directory="/w/p")
+        with pytest.raises(Exception) as probe:
+            await list_sessions_from_store(_RequiredOnlyStore(), directory="/w/p")
+        assert not isinstance(probe.value, (AttributeError, NameError, ImportError))
+
+        # The reference store's documented test conveniences.
+        store = InMemorySessionStore()
+        assert store.size == 0
+        assert store.get_entries(_KEY) == []
+        await store.append(_KEY, [{"n": 1}, {"n": 2}])
+        await store.append({"project_key": "p", "session_id": "b"}, [{"n": 1}])
+        await store.append({**_KEY, "subpath": "sub/x"}, [{"n": 1}])
+        assert store.get_entries(_KEY) == [{"n": 1}, {"n": 2}]
+        store.get_entries(_KEY).append({"n": 999})
+        assert store.get_entries(_KEY) == [{"n": 1}, {"n": 2}], "get_entries copies"
+        assert store.size == 2, "size counts main transcripts, not subagent subkeys"
+
+        loaded = await store.load(_KEY)
+        assert loaded is not None
+        loaded.append({"n": 999})
+        assert await store.load(_KEY) == [{"n": 1}, {"n": 2}], (
+            "mutating the returned list must not change what the store holds"
+        )
+
+        store.clear()
+        assert store.size == 0
+        assert await store.load(_KEY) is None
+        assert await store.list_sessions("proj") == []
