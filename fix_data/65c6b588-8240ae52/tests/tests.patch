+                )[1],
+            ),
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            plain_client = ClaudeSDKClient(
+                options=ClaudeAgentOptions(
+                    cwd=cwd, resume=SESSION_ID, cli_path="/usr/bin/claude"
+                )
+            )
+            await plain_client.connect()
+            assert "CLAUDE_CONFIG_DIR" not in plain["options"].env
+            assert plain["options"].resume == SESSION_ID
+            await plain_client.disconnect()
+
+
+# ---------------------------------------------------------------------------
+# Temp-dir leak on spawn failure
+# ---------------------------------------------------------------------------
+
+
+@pytest.fixture
+def staging() -> Any:
+    """Watch for staged directories that outlive the session."""
+    return _StagingWatcher()
+
+
+class TestSpawnFailureCleanup:
+    """The materialized temp dir contains a .credentials.json copy. It must be
+    removed even when transport.connect() raises before any try/finally that
+    normally guards cleanup."""
+
+    @pytest.mark.asyncio
+    async def test_temp_dir_never_leaks_on_any_failure_path(
+        self,
+        cwd: Path,
+        project_key: str,
+        isolated_home: Path,
+        staging: Any,
+        monkeypatch: pytest.MonkeyPatch,
+    ) -> None:
+        """The staged directory holds a usable credential for the lifetime of
+        the session, so it must be removed on *every* route out — not just the
+        happy one. Each scenario below stages a directory and then fails at a
+        different point; none may leave one behind.
+        """
+
+        async def _seeded_store() -> InMemorySessionStore:
+            store = InMemorySessionStore()
+            await store.append(
+                {"project_key": project_key, "session_id": SESSION_ID},
+                [{"type": "user", "uuid": "u1"}],
+            )
+            return store
+
+        def _opts(store: Any) -> ClaudeAgentOptions:
+            return ClaudeAgentOptions(cwd=cwd, session_store=store, resume=SESSION_ID)
+
+        transport_path = (
+            "claude_agent_sdk._internal.transport.subprocess_cli.SubprocessCLITransport"
+        )
+
+        spawns = {"n": 0}
+
+        def watched(transport: Any) -> Any:
+            """Hand back `transport`, recording what the SDK staged for it."""
+
+            def factory(*, prompt: Any, options: Any) -> Any:
+                spawns["n"] += 1
+                staging.note(options)
+                return transport
+
+            return factory
+        # The one-shot query() path constructs the transport through the
+        # internal client module, so that binding needs patching too.
+        query_transport_path = (
+            "claude_agent_sdk._internal.client.SubprocessCLITransport"
+        )
+
+        # 1. Normal completion still cleans up.
+        client = ClaudeSDKClient(options=_opts(await _seeded_store()))
+        with (
+            patch(transport_path, side_effect=watched(_make_mock_transport())),
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            await client.connect()
+        await client.disconnect()
+
+        # 2. The subprocess fails to spawn.
+        failing = _make_mock_transport()
+        failing.connect = AsyncMock(side_effect=OSError("spawn failed"))
+        client = ClaudeSDKClient(options=_opts(await _seeded_store()))
+        with (
+            patch(transport_path, side_effect=watched(failing)),
+            pytest.raises(OSError, match="spawn failed"),
+        ):
+            await client.connect()
+
+        # 3. `async with` fails.
+        failing2 = _make_mock_transport()
+        failing2.connect = AsyncMock(side_effect=OSError("aenter failed"))
+        with (
+            patch(transport_path, return_value=failing2),
+            pytest.raises(OSError, match="aenter failed"),
+        ):
+            async with ClaudeSDKClient(options=_opts(await _seeded_store())):
+                pass  # pragma: no cover
+
+        # 4. Initialization fails after the subprocess exists — the transport
+        #    must be closed before the directory it points at is removed.
+        spawned = _make_mock_transport()
+        client = ClaudeSDKClient(options=_opts(await _seeded_store()))
+        with (
+            patch(transport_path, side_effect=watched(spawned)),
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+                side_effect=RuntimeError("init failed"),
+            ),
+            pytest.raises(RuntimeError, match="init failed"),
+        ):
+            await client.connect()
+        spawned.close.assert_awaited()
+
+        # 5. Cancelled before the subprocess is spawned.
+        async def _hang(*a: Any, **kw: Any) -> Any:
+            await asyncio.sleep(3600)
+
+        slow = _make_mock_transport()
+        slow.connect = AsyncMock(side_effect=_hang)
+        client = ClaudeSDKClient(options=_opts(await _seeded_store()))
+        with patch(transport_path, side_effect=watched(slow)):
+            before_cancel = len(staging.config_dirs)
+            task = asyncio.create_task(client.connect())
+            for _ in range(50):
+                await asyncio.sleep(0)
+                if len(staging.config_dirs) > before_cancel:
+                    break
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await task
+
+        # 6. One-shot query whose transport fails.
+        broken = _make_mock_transport()
+        broken.connect = AsyncMock(side_effect=OSError("query spawn failed"))
+        with (
+            patch(query_transport_path, side_effect=watched(broken)),
+            pytest.raises(OSError, match="query spawn failed"),
+        ):
+            async for _ in query(prompt="hi", options=_opts(await _seeded_store())):
+                pass  # pragma: no cover
+
+        # 7. One-shot query whose consumer breaks out early.
+        early = _make_mock_transport()
+        with (
+            patch(query_transport_path, side_effect=watched(early)),
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            async for _ in query(prompt="hi", options=_opts(await _seeded_store())):
+                break
+
+        # Every session that got as far as spawning staged its own directory
+        # (no reuse across sessions), and nothing survived any route out. The
+        # cancellation scenario may be torn down before a transport is built,
+        # so it is covered by the temp-root half of the leak check rather than
+        # by a config-dir observation.
+        assert len(staging.config_dirs) == spawns["n"], (
+            f"{spawns['n']} sessions spawned but "
+            f"{len(staging.config_dirs)} staged dirs observed"
+        )
+        assert len(set(staging.config_dirs)) == len(staging.config_dirs), (
+            "staged directories must be per-session, not shared"
+        )
+        assert not staging.leaks(), f"staged state outlived the session: {staging.leaks()}"
+
+        # 8. Cleanup must survive a filesystem that refuses the first removal
+        #    attempts for transient reasons rather than leaking the directory.
+        retry_client = ClaudeSDKClient(options=_opts(await _seeded_store()))
+        with (
+            patch(transport_path, side_effect=watched(_make_mock_transport())),
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            await retry_client.connect()
+        staged = staging.config_dirs[-1]
+        assert staged.exists()
+
+        calls: list[Any] = []
+        real_rmtree = shutil.rmtree
+
+        def flaky_rmtree(target: Any, **kw: Any) -> None:
+            calls.append(target)
+            if len(calls) <= 2 and not kw.get("ignore_errors"):
+                raise PermissionError(errno.EPERM, "held by another process")
+            if Path(target).exists():
+                real_rmtree(target, **kw)
+
+        monkeypatch.setattr(shutil, "rmtree", flaky_rmtree)
+        await retry_client.disconnect()
+        monkeypatch.undo()
+        assert not staged.exists(), "cleanup gave up on a transient error"
+        assert len(calls) >= 2, "removal was not retried"
+        assert not staging.leaks(), f"staged state outlived the session: {staging.leaks()}"
