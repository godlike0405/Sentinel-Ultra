+        )
+        assert first is not None
+        first_id = first.resume_session_id
+        await first.cleanup()
+        second = await _stage(
+            ClaudeAgentOptions(cwd=cwd, session_store=tie, continue_conversation=True)
+        )
+        assert second is not None and second.resume_session_id == first_id
+        await second.cleanup()
