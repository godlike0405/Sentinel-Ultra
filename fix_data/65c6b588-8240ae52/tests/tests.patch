+"""Tests for the SessionStore write path.
+
+Everything is driven through the published surface: a conversation is run with
+``query()`` over a stubbed transport that emits the CLI's transcript-mirror
+frames, and the store is observed through the store protocol. Nothing here
+imports the buffering layer or the path-mapping helper directly, so any
+implementation that delivers the documented behaviour passes regardless of how
+it is factored.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+from pathlib import Path
+from typing import Any
+from unittest.mock import AsyncMock, Mock, patch
+
+import pytest
+
+from claude_agent_sdk import (
+    AssistantMessage,
+    ClaudeAgentOptions,
+    ResultMessage,
+    query,
+)
+from claude_agent_sdk._internal.transport.subprocess_cli import SubprocessCLITransport
+
+
+# ---------------------------------------------------------------------------
+# Base-compilable import guard
+#
+# The symbols below exist only once the feature is implemented. Importing them
+# at module scope makes this file fail during *collection* on a tree that lacks
+# them, which reports one opaque error for the whole file instead of a result
+# per test. Binding them defensively keeps the module importable, so each test
+# fails on its own with a clear message.
+# ---------------------------------------------------------------------------
+InMemorySessionStore: Any = None
+MirrorErrorMessage: Any = None
+
+SessionKey: Any = None
+
+_SESSION_STORE_API_ERROR: Any = None
+try:
+    from claude_agent_sdk import (
+        SessionKey,
+        InMemorySessionStore,
+        MirrorErrorMessage,
+    )
+except ImportError as exc:  # pragma: no cover - only on an unsolved tree
+    _SESSION_STORE_API_ERROR = exc
+
+
+@pytest.fixture(autouse=True)
+def _require_session_store_api() -> None:
+    """Fail each test individually when the session-store API is absent."""
+    if _SESSION_STORE_API_ERROR is not None:
+        pytest.fail(
+            "claude_agent_sdk does not provide the session-store API yet: "
+            + str(_SESSION_STORE_API_ERROR)
+        )
+
+
+# ---------------------------------------------------------------------------
+# Harness
+# ---------------------------------------------------------------------------
+
+_ASSISTANT_MSG = {
+    "type": "assistant",
+    "message": {
+        "role": "assistant",
+        "content": [{"type": "text", "text": "Hi"}],
+        "model": "claude-3-5-sonnet-20241022",
+    },
+}
+
+_RESULT_MSG = {
+    "type": "result",
+    "subtype": "success",
+    "duration_ms": 100,
+    "duration_api_ms": 80,
+    "is_error": False,
+    "num_turns": 1,
+    "session_id": "test",
+    "total_cost_usd": 0.001,
+}
+
+
+class _RecordingStore(InMemorySessionStore or object):
+    """Records each ``append`` call separately, in arrival order."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.append_calls: list[tuple[SessionKey, list[Any]]] = []
+
+    async def append(self, key: SessionKey, entries: list[Any]) -> None:
+        self.append_calls.append((key, list(entries)))
+        await super().append(key, entries)
+
+
+def _mock_transport(messages: list[dict[str, Any]]) -> Any:
+    transport = AsyncMock()
+
+    async def receive():
+        for msg in messages:
+            yield msg
+
+    transport.read_messages = receive
+    transport.connect = AsyncMock()
+    transport.close = AsyncMock()
+    transport.end_input = AsyncMock()
+    transport.write = AsyncMock()
+    transport.is_ready = Mock(return_value=True)
+    return transport
+
+
+def _mirror(file_path: str, entries: list[dict[str, Any]]) -> dict[str, Any]:
+    """A transcript-mirror frame as the CLI emits it."""
+    return {"type": "transcript_mirror", "filePath": file_path, "entries": entries}
+
+
+class _Session:
+    """One conversation over a stubbed CLI, with the mirror pointed at a
+    caller-controlled config directory."""
+
+    def __init__(self, tmp_path: Path, store: Any = None) -> None:
+        tmp_path.mkdir(parents=True, exist_ok=True)
+        self.config_dir = tmp_path / "cfg"
+        self.projects_dir = self.config_dir / "projects"
+        self.projects_dir.mkdir(parents=True, exist_ok=True)
+        self.store = store if store is not None else _RecordingStore()
+
+    def path(self, *parts: str) -> str:
+        """A transcript path under the mirror's projects directory."""
+        return str(Path(self.projects_dir, *parts))
+
+    async def run(
+        self,
+        messages: list[dict[str, Any]],
+        *,
+        env: dict[str, str] | None = None,
+        on_message: Any = None,
+    ) -> list[Any]:
+        """Run the conversation and return the messages the application saw."""
+        options = ClaudeAgentOptions(
+            session_store=self.store,
+            env={"CLAUDE_CONFIG_DIR": str(self.config_dir)} if env is None else env,
+        )
+        seen: list[Any] = []
+        with (
+            patch("claude_agent_sdk._internal.client.SubprocessCLITransport") as cls,
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            cls.return_value = _mock_transport(messages)
+            async for msg in query(prompt="Hello", options=options):
+                seen.append(msg)
+                if on_message is not None:
+                    on_message(msg)
+        return seen
+
+
+# ---------------------------------------------------------------------------
+# Transcript path -> session key
+# ---------------------------------------------------------------------------
+
+
+# ---------------------------------------------------------------------------
+# Delivery to the adapter
+# ---------------------------------------------------------------------------
+
+
+class TestTranscriptMirrorBatching:
+    @pytest.mark.asyncio
+    async def test_delivery_contract(self, tmp_path: Path) -> None:
+        """One graded test for the whole delivery contract: path→key mapping
+        for main and subagent transcripts, per-transcript coalescing in order,
+        distinct keys for distinct transcripts, no phantom key for an empty
+        batch, mirroring invisible to the application, a modest backlog held
+        until the result, a backlog past the entry-count bound delivered
+        without waiting, and everything persisted before the result surfaces.
+        """
+        s = _Session(tmp_path)
+        main = s.path("proj", "sess.jsonl")
+        sub = s.path("proj", "sess", "subagents", "agent-x.jsonl")
+        other = s.path("proj", "other.jsonl")
+
+        at_assistant: list[int] = []
+        at_result: list[int] = []
+
+        def watch(m: Any) -> None:
+            if isinstance(m, AssistantMessage):
+                at_assistant.append(len(s.store.append_calls))
+            if isinstance(m, ResultMessage):
+                at_result.append(len(s.store.append_calls))
+
+        seen = await s.run(
+            [
+                _mirror(main, [{"type": "user", "n": 1}]),
+                _mirror(other, []),  # empty batch -> no phantom key
+                _mirror(sub, [{"type": "user", "n": 100}]),
+                _ASSISTANT_MSG,
+                _mirror(main, [{"type": "assistant", "n": 2}]),
+                _RESULT_MSG,
+            ],
+            on_message=watch,
+        )
+
+        # Mirroring is invisible to the application.
+        assert [type(m) for m in seen] == [AssistantMessage, ResultMessage]
+
+        # A modest backlog is still buffered when the assistant message lands.
+        assert at_assistant == [0]
+        # ...and everything pending is persisted before the result surfaces.
+        assert at_result and at_result[0] >= 1
+
+        # One append per transcript — not merely the right entries spread
+        # over however many calls the adapter happened to receive.
+        calls = [
+            ((key["project_key"], key["session_id"], key.get("subpath")),
+             [e["n"] for e in entries])
+            for key, entries in s.store.append_calls
+        ]
+        assert sorted(calls, key=lambda c: (c[0][0], c[0][1], c[0][2] or "")) == [
+            (("proj", "sess", None), [1, 2]),
+            (("proj", "sess", "subagents/agent-x"), [100]),
+        ], (
+            "expected exactly one append per transcript, coalesced in order "
+            f"with no phantom empty key; adapter saw {calls}"
+        )
+
+        # Paths that do not unambiguously match a transcript shape must be
+        # dropped rather than mapped to a guessed key — and must never make
+        # the mirror raise into the conversation.
+        for label, path in (
+            ("too few parts", s.path("proj-only.jsonl")),
+            ("ambiguous shape", s.path("proj", "sess", "weird.jsonl")),
+            ("not a transcript", s.path("proj", "sess.txt")),
+            ("outside the projects dir", str(tmp_path / "elsewhere" / "p" / "s.jsonl")),
+            ("unrelativizable", "D:\\cfg\\p\\s.jsonl"),
+        ):
+            bad = _Session(tmp_path / f"bad-{label.replace(' ', '-')}")
+            leftover = await bad.run(
+                [_mirror(path, [{"type": "user"}]), _RESULT_MSG]
+            )
+            assert bad.store.append_calls == [], f"{label} should not map to a key"
+            assert [type(m) for m in leftover] == [ResultMessage], (
+                f"{label} must not disturb the message stream"
+            )
+
+        # The mirror must write under the same configuration directory the
+        # subprocess does: an override on options.env wins over the ambient
+        # environment, and an empty override is not a directory so it must be
+        # ignored rather than silently retargeting every path.
+        chosen = _Session(tmp_path / "override")
+        ambient = tmp_path / "ambient"
+        (ambient / "projects").mkdir(parents=True, exist_ok=True)
+        with patch.dict(os.environ, {"CLAUDE_CONFIG_DIR": str(ambient)}):
+            await chosen.run(
+                [
+                    _mirror(chosen.path("proj", "sess.jsonl"), [{"type": "user"}]),
+                    _RESULT_MSG,
+                ]
+            )
+        assert [k for k, _ in chosen.store.append_calls] == [
+            {"project_key": "proj", "session_id": "sess"}
+        ], "options.env override must win over the ambient environment"
+
+        # Mirror traffic that arrives after the result must still reach the
+        # store: the SDK must keep draining rather than stopping at the result.
+        late = _Session(tmp_path / "late")
+        lp = late.path("proj", "sess.jsonl")
+        await late.run(
+            [
+                _mirror(lp, [{"type": "user", "n": 1}]),
+                _RESULT_MSG,
+                _mirror(lp, [{"type": "user", "n": 2}]),
+            ]
+        )
+        assert [e["n"] for _, b in late.store.append_calls for e in b] == [1, 2], (
+            "frames after the result must still be persisted before close"
+        )
+
+        # A trailing separator on the configured directory names the same
+        # directory and must not change the derived key.
+        trail = _Session(tmp_path / "trailing")
+        await trail.run(
+            [
+                _mirror(trail.path("proj", "sess.jsonl"), [{"type": "user"}]),
+                _mirror(
+                    trail.path("proj", "sess", "subagents", "a.jsonl"),
+                    [{"type": "user"}],
+                ),
+                _RESULT_MSG,
+            ],
+            env={"CLAUDE_CONFIG_DIR": str(trail.config_dir) + os.sep},
+        )
+        assert [k for k, _ in trail.store.append_calls] == [
+            {"project_key": "proj", "session_id": "sess"},
+            {"project_key": "proj", "session_id": "sess", "subpath": "subagents/a"},
+        ], "a trailing separator must not change the derived key"
+
+        # The mirror must follow the subprocess into a staged config dir on
+        # resume; covered end-to-end in test_session_resume.py.
+        for label, env in (("absent", {}), ("empty string", {"CLAUDE_CONFIG_DIR": ""})):
+            fallback = _Session(tmp_path / f"fallback-{label.replace(' ', '-')}")
+            amb = fallback.config_dir  # used as the *ambient* dir this time
+            with patch.dict(os.environ, {"CLAUDE_CONFIG_DIR": str(amb)}):
+                await fallback.run(
+                    [
+                        _mirror(
+                            str(amb / "projects" / "proj" / "sess.jsonl"),
+                            [{"type": "user"}],
+                        ),
+                        _RESULT_MSG,
+                    ],
+                    env=env,
+                )
+            assert [k for k, _ in fallback.store.append_calls] == [
+                {"project_key": "proj", "session_id": "sess"}
+            ], f"an {label} override must fall back to the ambient environment"
+
+        # And the backlog must not grow without bound: past the entry-count
+        # bound and past the byte bound, delivery starts before anything asks
+        # for a flush — otherwise a long conversation buffers the whole
+        # transcript in memory and loses it if the process dies.
+        for label, entries in (
+            ("entry count", [{"type": "user", "n": i} for i in range(600)]),
+            ("byte size", [{"type": "user", "blob": "a" * (2 << 20)}]),
+        ):
+            big = _Session(tmp_path / label.replace(" ", "-"))
+            eager: list[int] = []
+            await big.run(
+                [
+                    _mirror(big.path("proj", "sess.jsonl"), entries),
+                    _ASSISTANT_MSG,
+                    _RESULT_MSG,
+                ],
+                on_message=lambda m: eager.append(len(big.store.append_calls))
+                if isinstance(m, AssistantMessage)
+                else None,
+            )
+            assert eager and eager[0] >= 1, (
+                f"backlog past the {label} bound should already be delivering"
+            )
+            delivered = [e for _, batch in big.store.append_calls for e in batch]
+            assert len(delivered) == len(entries), "and nothing may be lost"
+
+
+class TestAdapterFailures:
+    @pytest.mark.asyncio
+    async def test_adapter_failure_and_timeout_surface_mirror_errors(
+        self, tmp_path: Path
+    ) -> None:
+        """A store is third-party code. Whether it raises or simply never
+        returns, the mirror must neither crash the stream nor silently drop
+        data: the conversation completes and the caller is told persistence
+        failed."""
+
+        class FailingStore(InMemorySessionStore):
+            async def append(self, key, entries):  # type: ignore[override]
+                raise RuntimeError("boom")
+
+        s = _Session(tmp_path / "raises", store=FailingStore())
+        seen = await s.run(
+            [
+                _mirror(s.path("proj", "sess.jsonl"), [{"type": "user"}]),
+                _ASSISTANT_MSG,
+                _RESULT_MSG,
+            ]
+        )
+        errors = [m for m in seen if isinstance(m, MirrorErrorMessage)]
+        assert len(errors) == 1
+        assert errors[0].subtype == "mirror_error"
+        assert errors[0].key == {"project_key": "proj", "session_id": "sess"}
+        assert "boom" in errors[0].error
+        assert any(isinstance(m, ResultMessage) for m in seen)
+
+        # A store that never returns must be bounded rather than stalling the
+        # conversation forever; the outer wait_for only catches a regression.
+        class HangingStore(InMemorySessionStore):
+            async def append(self, key, entries):  # type: ignore[override]
+                await asyncio.sleep(3600)
+
+        hung = _Session(tmp_path / "hangs", store=HangingStore())
+        task = asyncio.ensure_future(
+            hung.run(
+                [
+                    _mirror(hung.path("proj", "sess.jsonl"), [{"type": "user"}]),
+                    _RESULT_MSG,
+                ]
+            )
+        )
+        # asyncio.wait leaves the task alone on timeout, so this returns
+        # promptly whether or not the implementation bounds the append. A
+        # conversation that never finishes is the failure being tested for;
+        # it must not be able to stall the whole verifier run.
+        _done, pending = await asyncio.wait({task}, timeout=90)
+        if pending:
+            task.cancel()
+            pytest.fail(
+                "a hanging store.append must be bounded and reported; the "
+                "conversation never completed"
+            )
+        seen = task.result()
+        assert any(isinstance(m, MirrorErrorMessage) for m in seen), (
+            "a hanging append must time out and be reported, not stall silently"
+        )
+        assert any(isinstance(m, ResultMessage) for m in seen)
+
+
+# ---------------------------------------------------------------------------
+# CLI wiring
+# ---------------------------------------------------------------------------
+
+
+class TestSessionMirrorFlag:
+    @pytest.mark.asyncio
+    async def test_no_store_means_no_mirroring(self, tmp_path: Path) -> None:
+        """With no store there is nothing to mirror into: the SDK must not ask
+        the CLI for the traffic, and any that arrives anyway must be discarded
+        rather than stored or surfaced as an application message."""
+        mirror_frame = _mirror(
+            str(tmp_path / "projects" / "proj" / "sess.jsonl"), [{"type": "user"}]
+        )
+        with (
+            patch("claude_agent_sdk._internal.client.SubprocessCLITransport") as cls,
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            cls.return_value = _mock_transport(
+                [mirror_frame, _ASSISTANT_MSG, _RESULT_MSG]
+            )
+            seen = [m async for m in query(prompt="Hello")]
+        assert [type(m) for m in seen] == [AssistantMessage, ResultMessage], (
+            "mirror frames must never surface as application messages"
+        )
+
+        # And the flag is present exactly when a store is configured.
+        with_store = SubprocessCLITransport(
