+"""Tests for the SessionStore write path.
+
+Everything is driven through the published surface: a conversation is run with
+``query()`` over a stubbed transport that emits the CLI's transcript-mirror
+frames, and the store is observed through the store protocol. Nothing here
+imports the buffering layer or the path-mapping helper directly, so any
+implementation that delivers the documented behaviour passes regardless of how
+it is factored.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+from pathlib import Path
+from typing import Any
+from unittest.mock import AsyncMock, Mock, patch
+
+import pytest
+
+from claude_agent_sdk import (
+    AssistantMessage,
+    ClaudeAgentOptions,
+    InMemorySessionStore,
+    MirrorErrorMessage,
+    ResultMessage,
+    SessionKey,
+    query,
+)
+from claude_agent_sdk._internal.transport.subprocess_cli import SubprocessCLITransport
+
+# ---------------------------------------------------------------------------
+# Harness
+# ---------------------------------------------------------------------------
+
+_ASSISTANT_MSG = {
+    "type": "assistant",
+    "message": {
+        "role": "assistant",
+        "content": [{"type": "text", "text": "Hi"}],
+        "model": "claude-3-5-sonnet-20241022",
+    },
+}
+
+_RESULT_MSG = {
+    "type": "result",
+    "subtype": "success",
+    "duration_ms": 100,
+    "duration_api_ms": 80,
+    "is_error": False,
+    "num_turns": 1,
+    "session_id": "test",
+    "total_cost_usd": 0.001,
+}
+
+
+class _RecordingStore(InMemorySessionStore):
+    """Records each ``append`` call separately, in arrival order."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.append_calls: list[tuple[SessionKey, list[Any]]] = []
+
+    async def append(self, key: SessionKey, entries: list[Any]) -> None:
+        self.append_calls.append((key, list(entries)))
+        await super().append(key, entries)
+
+
+def _mock_transport(messages: list[dict[str, Any]]) -> Any:
+    transport = AsyncMock()
+
+    async def receive():
+        for msg in messages:
+            yield msg
+
+    transport.read_messages = receive
+    transport.connect = AsyncMock()
+    transport.close = AsyncMock()
+    transport.end_input = AsyncMock()
+    transport.write = AsyncMock()
+    transport.is_ready = Mock(return_value=True)
+    return transport
+
+
+def _mirror(file_path: str, entries: list[dict[str, Any]]) -> dict[str, Any]:
+    """A transcript-mirror frame as the CLI emits it."""
+    return {"type": "transcript_mirror", "filePath": file_path, "entries": entries}
+
+
+class _Session:
+    """One conversation over a stubbed CLI, with the mirror pointed at a
+    caller-controlled config directory."""
+
+    def __init__(self, tmp_path: Path, store: Any = None) -> None:
+        tmp_path.mkdir(parents=True, exist_ok=True)
+        self.config_dir = tmp_path / "cfg"
+        self.projects_dir = self.config_dir / "projects"
+        self.projects_dir.mkdir(parents=True, exist_ok=True)
+        self.store = store if store is not None else _RecordingStore()
+
+    def path(self, *parts: str) -> str:
+        """A transcript path under the mirror's projects directory."""
+        return str(Path(self.projects_dir, *parts))
+
+    async def run(
+        self,
+        messages: list[dict[str, Any]],
+        *,
+        env: dict[str, str] | None = None,
+        on_message: Any = None,
+    ) -> list[Any]:
+        """Run the conversation and return the messages the application saw."""
+        options = ClaudeAgentOptions(
+            session_store=self.store,
+            env={"CLAUDE_CONFIG_DIR": str(self.config_dir)} if env is None else env,
+        )
+        seen: list[Any] = []
+        with (
+            patch("claude_agent_sdk._internal.client.SubprocessCLITransport") as cls,
+            patch(
+                "claude_agent_sdk._internal.query.Query.initialize",
+                new_callable=AsyncMock,
+            ),
+        ):
+            cls.return_value = _mock_transport(messages)
+            async for msg in query(prompt="Hello", options=options):
+                seen.append(msg)
+                if on_message is not None:
+                    on_message(msg)
+        return seen
+
