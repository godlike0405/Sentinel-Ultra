+"""Exercises the shipped :func:`run_session_store_conformance` harness against
+:class:`InMemorySessionStore`, plus options validation and project-key
+derivation.
+
+Everything here goes through the published package surface: the harness itself
+(``claude_agent_sdk.testing``), the store protocol, the public sync session
+readers, and ``ClaudeSDKClient``. Nothing imports a private module, so any
+implementation that satisfies the documented behaviour passes regardless of how
+it is decomposed internally.
+"""
+
+from __future__ import annotations
+
+import json
+import unicodedata
+import uuid as uuid_mod
+from pathlib import Path
+from typing import Any
+from unittest.mock import AsyncMock, Mock, patch
+
+import pytest
+
+from claude_agent_sdk import (
+    ClaudeAgentOptions,
+    ClaudeSDKClient,
+    InMemorySessionStore,
+    SessionKey,
+    SessionStore,
+    list_sessions,
+    project_key_for_directory,
+)
+from claude_agent_sdk.testing import run_session_store_conformance
+
+_KEY: SessionKey = {"project_key": "proj", "session_id": "sess"}
+
+
+def _mock_transport() -> Any:
+    transport = AsyncMock()
+
+    async def receive():
+        return
+        yield  # pragma: no cover
+
+    transport.read_messages = receive
+    transport.connect = AsyncMock()
+    transport.close = AsyncMock()
+    transport.end_input = AsyncMock()
+    transport.write = AsyncMock()
+    transport.is_ready = Mock(return_value=True)
+    return transport
+
+
+async def _connect(options: ClaudeAgentOptions) -> None:
+    """Drive a real connect() with the subprocess stubbed out.
+
+    Option validation is part of establishing a connection, so this is the
+    boundary an application actually hits.
+    """
+    client = ClaudeSDKClient(options=options)
+    with (
+        patch(
+            "claude_agent_sdk._internal.transport.subprocess_cli."
+            "SubprocessCLITransport",
+            side_effect=lambda **kw: _mock_transport(),
+        ),
+        patch(
+            "claude_agent_sdk._internal.query.Query.initialize",
+            new_callable=AsyncMock,
+        ),
+    ):
+        await client.connect()
+    await client.disconnect()
+
+
+class _RequiredOnlyStore(SessionStore):
+    """Implements only the two required protocol methods."""
+
+    async def append(self, key, entries):  # type: ignore[override]
+        pass
+
+    async def load(self, key):  # type: ignore[override]
+        return None
+
+
+# ---------------------------------------------------------------------------
+# InMemorySessionStore
+# ---------------------------------------------------------------------------
+
+
+class TestInMemorySessionStore:
+    @pytest.mark.asyncio
+    async def test_conformance(self) -> None:
+        """The harness must accept a correct store *and* reject broken ones.
+
+        Passing only the positive half would be satisfied by a harness that
+        checks nothing, which is useless to the adapter authors it is published
+        for — so each violation below must be caught.
+        """
+        await run_session_store_conformance(InMemorySessionStore)
+
+        class DropsEntries(InMemorySessionStore):
+            """append() silently discards everything."""
+
+            async def append(self, key, entries):  # type: ignore[override]
+                pass
+
+        class ForgetsSubkeys(InMemorySessionStore):
+            async def list_subkeys(self, key):  # type: ignore[override]
+                return []
+
+        class NeverDeletes(InMemorySessionStore):
+            async def delete(self, key):  # type: ignore[override]
+                pass
+
+        class ListsNothing(InMemorySessionStore):
+            async def list_sessions(self, project_key):  # type: ignore[override]
+                return []
+
+        for broken in (DropsEntries, ForgetsSubkeys, NeverDeletes, ListsNothing):
+            with pytest.raises(Exception) as excinfo:
+                await run_session_store_conformance(broken)
+            assert not isinstance(excinfo.value, (SyntaxError, ImportError, NameError))
+
+    @pytest.mark.asyncio
+    async def test_conformance_with_async_factory(self) -> None:
+        async def make() -> SessionStore:
+            return InMemorySessionStore()
+
+        await run_session_store_conformance(make)
+
+    @pytest.mark.asyncio
+    async def test_skip_optional_suppresses_contracts(self) -> None:
+        """A store implementing only required methods passes when optionals are skipped."""
+
+        class MinimalStore:
+            def __init__(self) -> None:
+                self._data: dict[str, list] = {}
+
+            async def append(self, key: SessionKey, entries: list) -> None:
+                k = f"{key['project_key']}/{key['session_id']}/{key.get('subpath') or ''}"
+                self._data.setdefault(k, []).extend(entries)
+
+            async def load(self, key: SessionKey) -> list | None:
+                k = f"{key['project_key']}/{key['session_id']}/{key.get('subpath') or ''}"
+                return self._data.get(k)
+
+        await run_session_store_conformance(
+            MinimalStore,
+            skip_optional=frozenset({"list_sessions", "delete", "list_subkeys"}),
+        )
+
+    @pytest.mark.asyncio
+    async def test_auto_skips_unimplemented_optionals(self) -> None:
+        """Optional contracts auto-skip when the store doesn't implement them."""
+
+        class MinimalStore(SessionStore):
+            def __init__(self) -> None:
+                self._data: dict[str, list] = {}
+
+            async def append(self, key: SessionKey, entries: list) -> None:
+                k = f"{key['project_key']}/{key['session_id']}/{key.get('subpath') or ''}"
+                self._data.setdefault(k, []).extend(entries)
+
+            async def load(self, key: SessionKey) -> list | None:
+                k = f"{key['project_key']}/{key['session_id']}/{key.get('subpath') or ''}"
+                return self._data.get(k)
+
+        # No skip_optional passed — the harness must detect the missing
+        # optionals on its own.
+        await run_session_store_conformance(MinimalStore)
+
+    @pytest.mark.asyncio
+    async def test_get_entries_helper(self) -> None:
+        store = InMemorySessionStore()
+        assert store.get_entries(_KEY) == []
+        await store.append(_KEY, [{"n": 1}, {"n": 2}])
+        assert store.get_entries(_KEY) == [{"n": 1}, {"n": 2}]
+        # Returns a copy — mutating the result must not affect the store.
+        store.get_entries(_KEY).append({"n": 999})
+        assert store.get_entries(_KEY) == [{"n": 1}, {"n": 2}]
+
+    @pytest.mark.asyncio
+    async def test_size_helper_counts_main_transcripts_only(self) -> None:
+        store = InMemorySessionStore()
+        assert store.size == 0
+        await store.append({"project_key": "p", "session_id": "a"}, [{"n": 1}])
+        await store.append({"project_key": "p", "session_id": "b"}, [{"n": 1}])
+        await store.append(
+            {"project_key": "p", "session_id": "a", "subpath": "sub/x"}, [{"n": 1}]
+        )
+        assert store.size == 2
+
+    @pytest.mark.asyncio
+    async def test_clear_helper(self) -> None:
+        store = InMemorySessionStore()
+        await store.append(_KEY, [{"n": 1}])
+        await store.append({**_KEY, "subpath": "sub/x"}, [{"n": 1}])
+        store.clear()
+        assert store.size == 0
+        assert await store.load(_KEY) is None
+        assert await store.list_sessions("proj") == []
+
+    @pytest.mark.asyncio
+    async def test_load_returns_copy(self) -> None:
+        store = InMemorySessionStore()
+        await store.append(_KEY, [{"n": 1}])
+        loaded = await store.load(_KEY)
+        assert loaded is not None
+        loaded.append({"n": 999})
+        assert await store.load(_KEY) == [{"n": 1}]
+
+    @pytest.mark.asyncio
+    async def test_optional_capabilities_are_detectable_at_runtime(self) -> None:
+        """The SDK must be able to tell whether a store implements an optional
+        method, and must reach opposite conclusions for a full store and a
+        required-only store. Observed through the behaviour that depends on it:
+        listing sessions requires ``list_sessions``.
+        """
+        from claude_agent_sdk import list_sessions_from_store
+
+        full = InMemorySessionStore()
+        await full.append(
+            {"project_key": project_key_for_directory("/w/p"), "session_id": "s"},
+            [{"type": "user", "uuid": "u"}],
+        )
+        # Implemented → usable.
+        await list_sessions_from_store(full, directory="/w/p")
+
+        # Not implemented → refused rather than silently returning nothing.
+        with pytest.raises((NotImplementedError, ValueError, TypeError, AttributeError)):
+            await list_sessions_from_store(_RequiredOnlyStore(), directory="/w/p")
+
+
+# ---------------------------------------------------------------------------
+# Options validation, observed at the connect boundary
+# ---------------------------------------------------------------------------
+
+
+class TestSessionStoreOptionsValidation:
+    @pytest.mark.asyncio
+    async def test_no_store_is_always_valid(self) -> None:
+        await _connect(
+            ClaudeAgentOptions(continue_conversation=True, enable_file_checkpointing=True)
+        )
+
+    @pytest.mark.asyncio
+    async def test_valid_store_passes(self) -> None:
+        await _connect(ClaudeAgentOptions(session_store=InMemorySessionStore()))
+
+    @pytest.mark.asyncio
+    async def test_continue_conversation_requires_list_sessions(self) -> None:
+        """Continuing has to find the most-recent session, which a store that
+        cannot enumerate sessions can never supply — that must fail fast rather
+        than silently starting a fresh conversation."""
+        with pytest.raises(ValueError, match="list_sessions"):
+            await _connect(
+                ClaudeAgentOptions(
+                    session_store=_RequiredOnlyStore(), continue_conversation=True
+                )
+            )
+
+    @pytest.mark.asyncio
+    async def test_continue_conversation_ok_when_store_implements_list_sessions(
+        self,
+    ) -> None:
+        await _connect(
+            ClaudeAgentOptions(
+                session_store=InMemorySessionStore(), continue_conversation=True
+            )
+        )
+
+    @pytest.mark.asyncio
+    async def test_continue_with_resume_and_store_lacking_list_sessions(self) -> None:
+        """An explicit resume id wins over continue, so enumeration is never
+        needed and the combination must be accepted."""
+        await _connect(
+            ClaudeAgentOptions(
+                session_store=_RequiredOnlyStore(),
+                continue_conversation=True,
+                resume="00000000-0000-4000-8000-000000000000",
+            )
+        )
+
+    @pytest.mark.asyncio
+    async def test_rejects_file_checkpointing_combo(self) -> None:
+        with pytest.raises(ValueError, match="enable_file_checkpointing"):
+            await _connect(
+                ClaudeAgentOptions(
+                    session_store=InMemorySessionStore(),
+                    enable_file_checkpointing=True,
+                )
+            )
+
+
+# ---------------------------------------------------------------------------
+# project_key_for_directory
+# ---------------------------------------------------------------------------
+
+
+class TestProjectKeyForDirectory:
+    def test_defaults_to_cwd(self) -> None:
+        assert project_key_for_directory() == project_key_for_directory(Path.cwd())
+
+    def test_sanitizes_path(self) -> None:
+        key = project_key_for_directory("/tmp/my project!")
+        assert "/" not in key
+        assert " " not in key
+        assert "!" not in key
+
+    def test_stable_for_same_path(self) -> None:
+        assert project_key_for_directory("/a/b/c") == project_key_for_directory(
+            "/a/b/c"
+        )
+
+    def test_distinct_directories_get_distinct_keys(self) -> None:
+        assert project_key_for_directory("/a/b/c") != project_key_for_directory(
+            "/a/b/d"
+        )
+
+    def test_key_derivation_contract(
+        self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        """The whole derivation contract in one place: a relative directory
+        resolves to its absolute form, equivalent spellings collapse, distinct
+        directories stay distinct, over-long paths still yield a usable key,
+        and the result is the directory name the CLI actually reads from."""
+        # Relative resolves to absolute — the subprocess only sees absolute
+        # paths, so a key derived from the literal '.' would miss every lookup.
+        assert project_key_for_directory(".") == project_key_for_directory(
+            Path().resolve()
+        )
+        assert project_key_for_directory(".") != project_key_for_directory("/.")
+
+        # Equivalent Unicode spellings are one directory, so one key.
+        nfc = tmp_path / unicodedata.normalize("NFC", "café")
+        nfd = tmp_path / unicodedata.normalize("NFD", "café")
+        nfc.mkdir(exist_ok=True)
+        assert project_key_for_directory(str(nfc)) == project_key_for_directory(
+            str(nfd)
+        )
+
+        # Over-long paths remain deterministic, distinct and filesystem-safe.
+        base = "/" + "a" * 400
+        long_key = project_key_for_directory(base)
+        assert long_key == project_key_for_directory(base)
+        assert long_key != project_key_for_directory(base + "b")
+        assert "/" not in long_key and 0 < len(long_key) < len(base)
+
+        # And the key is the on-disk project directory the CLI uses: written
+        # through the key, found through the public reader.
+        config = tmp_path / "cfg"
+        monkeypatch.setenv("CLAUDE_CONFIG_DIR", str(config))
+        workdir = tmp_path / "work"
+        workdir.mkdir()
+        session_id = str(uuid_mod.uuid4())
+        project_dir = config / "projects" / project_key_for_directory(str(workdir))
+        project_dir.mkdir(parents=True)
+        (project_dir / f"{session_id}.jsonl").write_text(
+            json.dumps(
+                {
+                    "type": "user",
+                    "uuid": "u1",
+                    "sessionId": session_id,
+                    "cwd": str(workdir),
+                    "timestamp": "2024-01-01T00:00:00.000Z",
+                    "message": {"role": "user", "content": "hello"},
+                }
+            )
+            + "\n"
+        )
+        assert [s.session_id for s in list_sessions(directory=str(workdir))] == [
+            session_id
+        ]
+
+    def test_equivalent_unicode_spellings_agree(self, tmp_path: Path) -> None:
+        """The same directory name written in composed and decomposed form is
+        one directory, so it must be one key; otherwise a store lookup made by
+        the parent misses what the subprocess wrote."""
+        nfc = tmp_path / unicodedata.normalize("NFC", "café")
+        nfd = tmp_path / unicodedata.normalize("NFD", "café")
+        nfc.mkdir(exist_ok=True)
+        assert project_key_for_directory(str(nfc)) == project_key_for_directory(
+            str(nfd)
+        )
+
+    def test_very_long_path_key_is_deterministic_and_distinct(self) -> None:
+        """Paths too long to use verbatim must still produce a stable,
+        filesystem-safe key that distinguishes neighbouring directories."""
+        base = "/" + "a" * 400
+        key = project_key_for_directory(base)
+        assert key == project_key_for_directory(base)
+        assert key != project_key_for_directory(base + "b")
+        assert "/" not in key
+        assert 0 < len(key) < len(base)
+
+    def test_key_matches_the_on_disk_project_directory(
+        self, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+    ) -> None:
+        """The derived key must be the directory name the CLI actually uses.
+        Written through the key and read back through the public session
+        reader, so any divergence shows up as a session that cannot be found.
+        """
+        config = tmp_path / "cfg"
+        monkeypatch.setenv("CLAUDE_CONFIG_DIR", str(config))
+        workdir = tmp_path / "work"
+        workdir.mkdir()
+
+        session_id = str(uuid_mod.uuid4())
+        project_dir = config / "projects" / project_key_for_directory(str(workdir))
+        project_dir.mkdir(parents=True)
+        (project_dir / f"{session_id}.jsonl").write_text(
+            json.dumps(
+                {
+                    "type": "user",
+                    "uuid": "u1",
+                    "sessionId": session_id,
+                    "cwd": str(workdir),
+                    "timestamp": "2024-01-01T00:00:00.000Z",
+                    "message": {"role": "user", "content": "hello"},
+                }
+            )
+            + "\n"
+        )
+
+        found = list_sessions(directory=str(workdir))
+        assert [s.session_id for s in found] == [session_id]
