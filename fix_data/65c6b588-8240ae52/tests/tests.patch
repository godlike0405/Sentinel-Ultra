+"""Tests for the ``*_from_store`` / ``*_via_store`` async session helpers.
+
+Exercises the SessionStore-backed code paths in
+``_internal/sessions.py`` and ``_internal/session_mutations.py`` using
+``InMemorySessionStore``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import uuid as uuid_mod
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from claude_agent_sdk import (
+    InMemorySessionStore,
+    delete_session_via_store,
+    fork_session_via_store,
+    get_session_info_from_store,
+    get_session_messages_from_store,
+    get_subagent_messages_from_store,
+    list_sessions_from_store,
+    list_subagents_from_store,
+    project_key_for_directory,
+    rename_session_via_store,
+    tag_session_via_store,
+)
+from claude_agent_sdk.types import SessionKey, SessionStore
+
+pytestmark = pytest.mark.asyncio
+
+
+# ---------------------------------------------------------------------------
+# Fixtures and helpers
+# ---------------------------------------------------------------------------
+
+DIR = "/workspace/project"
+PROJECT_KEY = project_key_for_directory(DIR)
+
+
+def _user(text: str, uid: str, parent: str | None, sid: str) -> dict[str, Any]:
+    return {
+        "type": "user",
+        "uuid": uid,
+        "parentUuid": parent,
+        "sessionId": sid,
+        "timestamp": "2024-01-01T00:00:00.000Z",
+        "message": {"role": "user", "content": text},
+    }
+
+
+def _assistant(text: str, uid: str, parent: str, sid: str) -> dict[str, Any]:
+    return {
+        "type": "assistant",
+        "uuid": uid,
+        "parentUuid": parent,
+        "sessionId": sid,
+        "timestamp": "2024-01-01T00:00:01.000Z",
+        "message": {"role": "assistant", "content": [{"type": "text", "text": text}]},
+    }
+
+
+async def _seed_chain(store: InMemorySessionStore, sid: str, n: int = 2) -> list[str]:
+    """Append ``n`` user/assistant pairs and return their UUIDs in order."""
+    key: SessionKey = {"project_key": PROJECT_KEY, "session_id": sid}
+    uuids: list[str] = []
+    parent: str | None = None
+    entries: list[dict[str, Any]] = []
+    for i in range(n):
+        u = str(uuid_mod.uuid4())
+        a = str(uuid_mod.uuid4())
+        entries.append(_user(f"prompt {i}", u, parent, sid))
+        entries.append(_assistant(f"reply {i}", a, u, sid))
+        uuids.extend([u, a])
+        parent = a
+    await store.append(key, entries)  # type: ignore[arg-type]
+    return uuids
+
+
+class _MinimalStore(SessionStore):
+    """Duck-typed store implementing only the required ``append``/``load``."""
+
+    def __init__(self) -> None:
+        self._data: dict[str, list] = {}
+
+    async def append(self, key: SessionKey, entries: list) -> None:
+        k = f"{key['project_key']}/{key['session_id']}/{key.get('subpath', '')}"
+        self._data.setdefault(k, []).extend(entries)
+
+    async def load(self, key: SessionKey) -> list | None:
+        k = f"{key['project_key']}/{key['session_id']}/{key.get('subpath', '')}"
+        return self._data.get(k)
+
+
+# ---------------------------------------------------------------------------
+# Read helpers — list_sessions / get_session_info / get_session_messages
+# ---------------------------------------------------------------------------
+
+
+class TestListSessionsFromStore:
+    async def test_listing_contract(self) -> None:
+        """One graded test for the whole listing contract: real sessions are
+        returned most-recent-first with summaries, sidechains are dropped,
+        pagination applies to what survives that filter, and a store that
+        cannot enumerate is refused rather than reported as empty."""
+        store = InMemorySessionStore()
+        real: list[str] = []
+        for _ in range(5):
+            sid = str(uuid_mod.uuid4())
+            await _seed_chain(store, sid, n=1)
+            real.append(sid)
+        sidechains: list[str] = []
+        for _ in range(3):
+            sc = str(uuid_mod.uuid4())
+            entry = _user("internal", str(uuid_mod.uuid4()), None, sc)
+            entry["isSidechain"] = True
+            await store.append(
+                {"project_key": PROJECT_KEY, "session_id": sc},
+                [entry],  # type: ignore[arg-type]
+            )
+            sidechains.append(sc)
+
+        sessions = await list_sessions_from_store(store, directory=DIR)
+        ids = [s.session_id for s in sessions]
+        assert set(ids) == set(real), "sidechains must not surface"
+        assert not any(sc in ids for sc in sidechains)
+        assert all(s.summary == "prompt 0" for s in sessions)
+        mtimes = [s.last_modified for s in sessions]
+        assert mtimes == sorted(mtimes, reverse=True), "most recent first"
+
+        # Pagination applies after the sidechain filter, so a full page is
+        # returned rather than one padded out by dropped rows.
+        page = await list_sessions_from_store(store, directory=DIR, limit=3, offset=1)
+        assert [s.session_id for s in page] == ids[1:4]
+
+        # A store that cannot enumerate must be refused deliberately, not
+        # crash on a missing attribute and not silently report nothing.
+        with pytest.raises(Exception) as excinfo:
+            await list_sessions_from_store(_MinimalStore(), directory=DIR)
+        assert not isinstance(
+            excinfo.value, (AttributeError, NameError, ImportError)
+        ), f"refusal must be deliberate, got {excinfo.value!r}"
+
+        # A listing must not fan out unboundedly across the adapter: a large
+        # project would otherwise open one connection per session and exhaust
+        # the adapter's pool. The bound itself is the implementation's choice;
+        # what matters is that one exists and holds for the whole run.
+        in_flight = 0
+        peak = 0
+        gate = asyncio.Event()
+
+        class SlowStore(InMemorySessionStore):
+            async def load(self, key):
+                nonlocal in_flight, peak
+                in_flight += 1
+                peak = max(peak, in_flight)
+                await gate.wait()
+                in_flight -= 1
+                return await super().load(key)
+
+        slow = SlowStore()
+        n = 96
+        for i in range(n):
+            await InMemorySessionStore.append(
+                slow,
+                {"project_key": PROJECT_KEY, "session_id": str(uuid_mod.uuid4())},
+                [{"type": "user", "uuid": f"u{i}"}],
+            )
+        task = asyncio.create_task(list_sessions_from_store(slow, directory=DIR))
+        for _ in range(5):  # let the scheduler saturate whatever bound exists
+            await asyncio.sleep(0)
+        assert peak > 0, "loads should have started"
+        assert peak < n, f"unbounded: {peak} concurrent loads for {n} sessions"
+        saturated = peak
+        gate.set()
+        await task
+        # A ceiling that is exceeded later is not a ceiling.
+        assert peak == saturated
+
+        # And the adapter's own list must not be mutated by the read.
+        returned: list[Any] = []
+
+        class WatchingStore(InMemorySessionStore):
+            async def list_sessions(self, project_key):
+                rows = await super().list_sessions(project_key)
+                returned.append(rows)
+                return rows
+
+        watching = WatchingStore()
+        await _seed_chain(watching, str(uuid_mod.uuid4()), n=1)
+        before = [list(r) for r in returned]
+        await list_sessions_from_store(watching, directory=DIR)
+        assert [list(r) for r in returned][: len(before)] == before
+        assert returned and all(isinstance(r, list) for r in returned)
+
+    async def test_lists_seeded_sessions_sorted_by_mtime(self) -> None:
+        store = InMemorySessionStore()
+        sid_a = str(uuid_mod.uuid4())
+        sid_b = str(uuid_mod.uuid4())
+        await _seed_chain(store, sid_a)
+        await _seed_chain(store, sid_b)
+
+        sessions = await list_sessions_from_store(store, directory=DIR)
+        ids = {s.session_id for s in sessions}
+        assert ids == {sid_a, sid_b}
+        # Summary derived from first prompt via the same lite-parse as disk.
+        for s in sessions:
+            assert s.summary == "prompt 0"
+            assert s.first_prompt == "prompt 0"
+        # Sorted by mtime descending (non-increasing).
+        mtimes = [s.last_modified for s in sessions]
+        assert mtimes == sorted(mtimes, reverse=True)
+
+    async def test_limit_and_offset(self) -> None:
+        store = InMemorySessionStore()
+        for _ in range(3):
+            await _seed_chain(store, str(uuid_mod.uuid4()))
+        page = await list_sessions_from_store(store, directory=DIR, limit=2, offset=1)
+        assert len(page) == 2
