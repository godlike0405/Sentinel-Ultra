+    @pytest.mark.asyncio
+    async def test_continue_picks_most_recent(
+        self, cwd: Path, project_key: str, isolated_home: Path
+    ) -> None:
+        store = _FixedMtimeStore()
+        # Older session first.
+        await store.append(
+            {"project_key": project_key, "session_id": SESSION_ID},
+            [{"type": "user", "uuid": "old"}],
+        )
+        store.mtimes[SESSION_ID] = 1000
+        await store.append(
+            {"project_key": project_key, "session_id": SESSION_ID_2},
+            [{"type": "user", "uuid": "new"}],
+        )
+        store.mtimes[SESSION_ID_2] = 2000
+
+        opts = ClaudeAgentOptions(
+            cwd=cwd, session_store=store, continue_conversation=True
+        )
+        m = await _stage(opts)
+        assert m is not None
+        assert m.resume_session_id == SESSION_ID_2
+        await m.cleanup()
+
+        # A sidechain is not a conversation to continue, even when it is the
+        # most recently touched thing in the project.
+        sc_store = _FixedMtimeStore()
+        sidechain = str(uuid.uuid4())
+        await sc_store.append(
+            {"project_key": project_key, "session_id": SESSION_ID},
+            [{"type": "user", "uuid": "main"}],
+        )
+        sc_store.mtimes[SESSION_ID] = 1000
+        await sc_store.append(
+            {"project_key": project_key, "session_id": sidechain},
+            [{"type": "user", "uuid": "sc", "isSidechain": True}],
+        )
+        sc_store.mtimes[sidechain] = 2000
+        sm = await _stage(
+            ClaudeAgentOptions(
+                cwd=cwd, session_store=sc_store, continue_conversation=True
+            )
+        )
+        assert sm is not None and sm.resume_session_id == SESSION_ID
+        await sm.cleanup()
+
+        # With nothing but sidechains there is nothing to resume.
+        only_sc = InMemorySessionStore()
+        await only_sc.append(
+            {"project_key": project_key, "session_id": str(uuid.uuid4())},
+            [{"type": "user", "isSidechain": True}],
+        )
+        assert (
+            await _stage(
+                ClaudeAgentOptions(
+                    cwd=cwd, session_store=only_sc, continue_conversation=True
+                )
+            )
+            is None
+        )
+
+        # The choice is deterministic for a given set of stored sessions.
+        tie = _FixedMtimeStore()
+        for sid in (SESSION_ID, SESSION_ID_2):
+            await tie.append(
+                {"project_key": project_key, "session_id": sid},
+                [{"type": "user", "uuid": f"u-{sid}"}],
+            )
