@@ -0,0 +1,154 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using System.Threading.Tasks;
+
+namespace SeqCli.Tests.Ingestion
+{
+    sealed class IngestionTestServer : IDisposable
+    {
+        readonly TcpListener _listener;
+        readonly Queue<Response> _responses;
+        readonly Task _acceptLoop;
+        readonly object _requestsSync = new object();
+        bool _disposed;
+
+        public IngestionTestServer(params Response[] responses)
+        {
+            _responses = new Queue<Response>(responses ?? new Response[0]);
+            _listener = new TcpListener(IPAddress.Loopback, 0);
+            _listener.Start();
+            var endpoint = (IPEndPoint)_listener.LocalEndpoint;
+            Url = $"http://127.0.0.1:{endpoint.Port}/";
+            _acceptLoop = AcceptLoopAsync();
+        }
+
+        public string Url { get; }
+        readonly List<string> _requestBodies = new List<string>();
+        readonly List<string> _requestPaths = new List<string>();
+
+        public string[] RequestBodies
+        {
+            get
+            {
+                lock (_requestsSync)
+                    return _requestBodies.ToArray();
+            }
+        }
+
+        public string[] RequestPaths
+        {
+            get
+            {
+                lock (_requestsSync)
+                    return _requestPaths.ToArray();
+            }
+        }
+
+        public int RequestCount
+        {
+            get
+            {
+                lock (_requestsSync)
+                    return _requestBodies.Count;
+            }
+        }
+
+        async Task AcceptLoopAsync()
+        {
+            try
+            {
+                while (!_disposed)
+                {
+                    var client = await _listener.AcceptTcpClientAsync();
+                    await HandleAsync(client);
+                }
+            }
+            catch (ObjectDisposedException)
+            {
+            }
+            catch (SocketException)
+            {
+                if (!_disposed)
+                    throw;
+            }
+        }
+
+        async Task HandleAsync(TcpClient client)
+        {
+            using (client)
+            using (var stream = client.GetStream())
+            using (var reader = new StreamReader(stream, Encoding.UTF8, false, 1024, true))
+            {
+                var requestLine = await reader.ReadLineAsync();
+                if (requestLine == null)
+                    return;
+
+                var requestParts = requestLine.Split(' ');
+                lock (_requestsSync)
+                    _requestPaths.Add(requestParts.Length > 1 ? requestParts[1] : requestLine);
+
+                var contentLength = 0;
+                string header;
+                while (!string.IsNullOrEmpty(header = await reader.ReadLineAsync()))
+                {
+                    const string contentLengthHeader = "Content-Length:";
+                    if (header.StartsWith(contentLengthHeader, StringComparison.OrdinalIgnoreCase))
+                        contentLength = int.Parse(header.Substring(contentLengthHeader.Length).Trim());
+                }
+
+                var body = new char[contentLength];
+                var offset = 0;
+                while (offset < body.Length)
+                {
+                    var read = await reader.ReadAsync(body, offset, body.Length - offset);
+                    if (read == 0)
+                        break;
+                    offset += read;
+                }
+
+                lock (_requestsSync)
+                    _requestBodies.Add(new string(body, 0, offset));
+
+                var response = _responses.Count == 0 ? Response.Success : _responses.Dequeue();
+                var responseBody = Encoding.UTF8.GetBytes(response.Body ?? "");
+                var reason = response.StatusCode >= 200 && response.StatusCode < 300 ? "Created" : "Error";
+                var responseHeaders = Encoding.ASCII.GetBytes(
+                    $"HTTP/1.1 {response.StatusCode} {reason}\r\n" +
+                    "Content-Type: application/json\r\n" +
+                    $"Content-Length: {responseBody.Length}\r\n" +
+                    "Connection: close\r\n\r\n");
+
+                await stream.WriteAsync(responseHeaders, 0, responseHeaders.Length);
+                await stream.WriteAsync(responseBody, 0, responseBody.Length);
+                await stream.FlushAsync();
+            }
+        }
+
+        public void Dispose()
+        {
+            if (_disposed)
+                return;
+
+            _disposed = true;
+            _listener.Stop();
+        }
+
+        public sealed class Response
+        {
+            public static readonly Response Success = new Response(201, "");
+
+            public Response(int statusCode, string body)
+            {
+                StatusCode = statusCode;
+                Body = body;
+            }
+
+            public int StatusCode { get; }
+            public string Body { get; }
+        }
+    }
+}
