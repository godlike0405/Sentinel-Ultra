+func TestFailedSpecBuildIsAtomicAcrossStages(t *testing.T) {
+	tests := []struct {
+		name  string
+		setup func(*Container, *SpecWrapper)
+	}{
+		{
+			name: "process validation",
+			setup: func(c *Container, _ *SpecWrapper) {
+				c.HostConfig.CapAdd = []string{"NOT_A_CAPABILITY"}
+			},
+		},
+		{
+			name: "mount validation",
+			setup: func(c *Container, _ *SpecWrapper) {
+				c.Mounts = []*types.MountPoint{
+					{Source: "/one", Destination: "/duplicate", RW: true},
+					{Source: "/two", Destination: "/duplicate", RW: true},
+				}
+			},
+		},
+		{
+			name: "plugin hook validation",
+			setup: func(_ *Container, wrapper *SpecWrapper) {
+				wrapper.prioArr = []int{20, 10}
+				wrapper.argsArr = [][]string{{"/hook/only-one"}}
+			},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			previous := &specs.Spec{
+				Hostname:    "previous-success",
+				Annotations: map[string]string{"generation": "previous"},
+			}
+			wrapper := &SpecWrapper{s: previous}
+			container := containerForProfileTest("failed-profile", &types.HostConfig{})
+			test.setup(container, wrapper)
+
+			before, err := json.Marshal(previous)
+			if err != nil {
+				t.Fatal(err)
+			}
+			buildErr, panicValue := tryCreateSpecForProfileTest(container, wrapper)
+			if panicValue != nil {
+				t.Fatalf("createSpec panicked for invalid input: %v", panicValue)
+			}
+			if buildErr == nil {
+				t.Fatal("createSpec accepted invalid input")
+			}
+			if wrapper.s != previous {
+				t.Fatal("failed build replaced the previously published specification")
+			}
+			after, err := json.Marshal(previous)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(after, before) {
+				t.Errorf("failed build mutated the previous specification:\nbefore %s\nafter  %s", before, after)
+			}
+		})
+	}
+}
