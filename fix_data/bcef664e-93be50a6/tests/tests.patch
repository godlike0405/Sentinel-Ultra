+func TestSpecWrapperRecoversAfterFailedBuild(t *testing.T) {
+	container := containerForProfileTest("retry-after-failure", &types.HostConfig{
+		CapAdd: []string{"NOT_A_CAPABILITY"},
+	})
+	wrapper := &SpecWrapper{}
+	if err, panicValue := tryCreateSpecForProfileTest(container, wrapper); panicValue != nil || err == nil {
+		t.Fatalf("invalid first attempt returned err=%v panic=%v", err, panicValue)
+	}
+	if wrapper.s != nil {
+		t.Fatal("failed first attempt published a partial specification")
+	}
+
+	container.HostConfig.CapAdd = []string{"SYS_TIME"}
+	if err, panicValue := tryCreateSpecForProfileTest(container, wrapper); panicValue != nil || err != nil {
+		t.Fatalf("corrected attempt returned err=%v panic=%v", err, panicValue)
+	}
+	if wrapper.s == nil || wrapper.s.Process == nil || wrapper.s.Process.Capabilities == nil {
+		t.Fatal("corrected attempt did not publish a complete specification")
+	}
+	if !containsStringForProfileTest(wrapper.s.Process.Capabilities.Effective, "CAP_SYS_TIME") {
+		t.Errorf("corrected capability was not applied: %v", wrapper.s.Process.Capabilities.Effective)
+	}
+}
