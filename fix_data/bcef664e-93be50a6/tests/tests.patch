+func TestConcurrentFailuresDoNotDisturbOtherBuilds(t *testing.T) {
+	const count = 16
+	results := make([]*specs.Spec, count)
+	errs := make([]error, count)
+	containers := make([]*Container, count)
+	var wait sync.WaitGroup
+	for index := 0; index < count; index++ {
+		requested := int64(index+1) * 1048576
+		c := containerForProfileTest(fmt.Sprintf("mixed-%d", index), &types.HostConfig{
+			ShmSize: &requested,
+			Sysctls: map[string]string{"sentinel.profile": fmt.Sprintf("%d", index)},
+		})
+		hostConfigWithMountsForProfileTest(c,
+			&types.MountPoint{Source: fmt.Sprintf("/custom/hosts-%d", index), Destination: "/etc/hosts", RW: true},
+		)
+		if index%2 == 1 {
+			c.HostConfig.CapAdd = []string{"NOT_A_CAPABILITY"}
+		}
+		containers[index] = c
+	}
+	for index := 0; index < count; index++ {
+		wait.Add(1)
+		go func(index int) {
+			defer wait.Done()
+			wrapper := &SpecWrapper{}
+			errs[index] = createSpec(context.Background(), containers[index], wrapper)
+			results[index] = wrapper.s
+		}(index)
+	}
+	wait.Wait()
+	for index := 0; index < count; index++ {
+		c := containers[index]
+		if index%2 == 1 {
+			if errs[index] == nil || results[index] != nil {
+				t.Errorf("invalid container %d: err=%v published=%v", index, errs[index], results[index] != nil)
+			}
+			if c.HostsPath != "" {
+				t.Errorf("failed container %d recorded network files: %q", index, c.HostsPath)
+			}
+			continue
+		}
+		if errs[index] != nil || results[index] == nil {
+			t.Errorf("valid container %d: err=%v published=%v", index, errs[index], results[index] != nil)
+			continue
+		}
+		s := results[index]
+		wantedSize := fmt.Sprintf("size=%d", int64(index+1)*1048576)
+		if got := sizeOptionsForProfileTest(mountForProfileTest(t, s.Mounts, "/dev/shm").Options); !reflect.DeepEqual(got, []string{wantedSize}) {
+			t.Errorf("container %d shared-memory options = %v", index, got)
+		}
+		if got := s.Linux.Sysctl["sentinel.profile"]; got != fmt.Sprintf("%d", index) {
+			t.Errorf("container %d sysctl marker = %q", index, got)
+		}
+		if want := fmt.Sprintf("/custom/hosts-%d", index); c.HostsPath != want {
+			t.Errorf("container %d hosts path = %q, want %q", index, c.HostsPath, want)
+		}
+	}
