+func TestFailedSpecBuildLeavesContainerUntouched(t *testing.T) {
+	tests := []struct {
+		name  string
+		setup func(*Container, *SpecWrapper)
+	}{
+		{
+			name: "mount stage failure after a network file mount",
+			setup: func(c *Container, _ *SpecWrapper) {
+				hostConfigWithMountsForProfileTest(c,
+					&types.MountPoint{Source: "/custom/hosts", Destination: "/etc/hosts", RW: true},
+					&types.MountPoint{Source: "/one", Destination: "/duplicate", RW: true},
+					&types.MountPoint{Source: "/two", Destination: "/duplicate", RW: true},
+				)
+			},
+		},
+		{
+			name: "hook stage failure after a network file mount",
+			setup: func(c *Container, wrapper *SpecWrapper) {
+				hostConfigWithMountsForProfileTest(c,
+					&types.MountPoint{Source: "/custom/resolv.conf", Destination: "/etc/resolv.conf", RW: true},
+				)
+				wrapper.prioArr = []int{20, 10}
+				wrapper.argsArr = [][]string{{"/hook/only-one"}}
+			},
+		},
+		{
+			name: "device stage failure after a network file mount",
+			setup: func(c *Container, _ *SpecWrapper) {
+				hostConfigWithMountsForProfileTest(c,
+					&types.MountPoint{Source: "/custom/hostname", Destination: "/etc/hostname", RW: true},
+				)
+				c.HostConfig.Devices = []*types.DeviceMapping{{
+					PathOnHost: "/dev/null", PathInContainer: "/dev/null", CgroupPermissions: "xyz",
+				}}
+			},
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			c := containerForProfileTest("container-untouched", &types.HostConfig{})
+			c.HostnamePath = "/var/lib/pouch/hostname"
+			c.HostsPath = "/var/lib/pouch/hosts"
+			c.ResolvConfPath = "/var/lib/pouch/resolv.conf"
+			wrapper := &SpecWrapper{}
+			test.setup(c, wrapper)
+			before, err := json.Marshal(c)
+			if err != nil {
+				t.Fatal(err)
+			}
+			buildErr, panicValue := tryCreateSpecForProfileTest(c, wrapper)
+			if panicValue != nil {
+				t.Fatalf("createSpec panicked for invalid input: %v", panicValue)
+			}
+			if buildErr == nil {
+				t.Fatal("createSpec accepted invalid input")
+			}
+			if wrapper.s != nil {
+				t.Error("failed build published a specification")
+			}
+			after, err := json.Marshal(c)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(after, before) {
+				t.Errorf("failed build changed the container:\nbefore %s\nafter  %s", before, after)
+			}
+		})
+	}
+}
