+func TestCreateSpecDoesNotUseContainerdProfileDefaults(t *testing.T) {
+	original := containerdDefaultEnvironment
+	marker := "SENTINEL_CONTAINERD_PROFILE_WAS_USED=1"
+	containerdDefaultEnvironment = []string{marker}
+	defer func() { containerdDefaultEnvironment = original }()
+
+	s := createSpecForProfileTest(t, containerForProfileTest("profile-ownership", &types.HostConfig{}))
+	for _, entry := range s.Process.Env {
+		if entry == marker {
+			t.Fatal("normal container creation inherited containerd's starting profile")
+		}
+	}
+}
+
+func containsStringForProfileTest(values []string, wanted string) bool {
+	for _, value := range values {
+		if value == wanted {
+			return true
+		}
+	}
+	return false
+}
