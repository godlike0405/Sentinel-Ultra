+func TestFinalHooksOwnPluginArguments(t *testing.T) {
+	high := []string{"/hook/high", "--mode", "strict"}
+	low := []string{"/hook/low", "--mode", "compat"}
+	wrapper := &SpecWrapper{
+		prioArr: []int{100, 10},
+		argsArr: [][]string{high, low},
+	}
+	container := containerForProfileTest("hook-snapshot", &types.HostConfig{})
+	if err := createSpec(context.Background(), container, wrapper); err != nil {
+		t.Fatalf("createSpec returned error: %v", err)
+	}
+	if wrapper.s == nil || wrapper.s.Hooks == nil || len(wrapper.s.Hooks.Prestart) != 2 {
+		t.Fatalf("final plugin hooks = %+v", wrapper.s)
+	}
+	if got := wrapper.s.Hooks.Prestart[0]; got.Path != "/hook/high" || !reflect.DeepEqual(got.Args, []string{"--mode", "strict"}) {
+		t.Fatalf("high-priority hook = %+v", got)
+	}
+	if got := wrapper.s.Hooks.Prestart[1]; got.Path != "/hook/low" || !reflect.DeepEqual(got.Args, []string{"--mode", "compat"}) {
+		t.Fatalf("low-priority hook = %+v", got)
+	}
+
+	high[2] = "changed-at-source"
+	if got := wrapper.s.Hooks.Prestart[0].Args[1]; got != "strict" {
+		t.Errorf("source mutation changed final hook argument to %q", got)
+	}
+	wrapper.s.Hooks.Prestart[1].Args[1] = "changed-in-spec"
+	if low[2] != "compat" {
+		t.Errorf("final hook mutation changed source argument to %q", low[2])
+	}
+}
