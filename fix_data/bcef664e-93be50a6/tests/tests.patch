+		&types.MountPoint{Source: "/custom/resolv.conf", Destination: "/etc/resolv.conf", RW: false},
+		&types.MountPoint{Source: "/one", Destination: "/duplicate", RW: true},
+		&types.MountPoint{Source: "/two", Destination: "/duplicate", RW: true},
+	)
+	wrapper := &SpecWrapper{}
+	if err, panicValue := tryCreateSpecForProfileTest(c, wrapper); err == nil || panicValue != nil {
+		t.Fatalf("invalid first attempt returned err=%v panic=%v", err, panicValue)
+	}
+	if c.HostsPath != "/var/lib/pouch/hosts" || c.ResolvConfPath != "/var/lib/pouch/resolv.conf" || c.HostnamePath != "/var/lib/pouch/hostname" {
+		t.Fatalf("failed attempt recorded network files on the container: %q %q %q", c.HostnamePath, c.HostsPath, c.ResolvConfPath)
+	}
+
+	c.Mounts = c.Mounts[:2]
+	if err, panicValue := tryCreateSpecForProfileTest(c, wrapper); err != nil || panicValue != nil {
+		t.Fatalf("corrected attempt returned err=%v panic=%v", err, panicValue)
+	}
+	if wrapper.s == nil {
+		t.Fatal("corrected attempt did not publish a specification")
+	}
+	if c.HostsPath != "/custom/hosts" || c.ResolvConfPath != "/custom/resolv.conf" {
+		t.Errorf("successful build did not record custom network files: hosts=%q resolv=%q", c.HostsPath, c.ResolvConfPath)
+	}
+	if c.HostnamePath != "/var/lib/pouch/hostname" {
+		t.Errorf("successful build changed an unrelated network file path to %q", c.HostnamePath)
+	}
+	for _, destination := range []string{"/etc/hosts", "/etc/resolv.conf"} {
+		if count := mountCountForProfileTest(wrapper.s.Mounts, destination); count != 0 {
+			t.Errorf("%s user mount was duplicated into the mount set with network files disabled: %d", destination, count)
+		}
+	}
+}
