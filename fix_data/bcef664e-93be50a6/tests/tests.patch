+func TestConcurrentContainerProfilesRemainIsolated(t *testing.T) {
+	const count = 12
+	results := make([]*specs.Spec, count)
+	errors := make(chan error, count)
+	var wait sync.WaitGroup
+	for index := 0; index < count; index++ {
+		wait.Add(1)
+		go func(index int) {
+			defer wait.Done()
+			requested := int64(index+1) * 1048576
+			id := fmt.Sprintf("concurrent-%d", index)
+			c := containerForProfileTest(id, &types.HostConfig{
+				ShmSize:   &requested,
+				Resources: types.Resources{CgroupParent: fmt.Sprintf("team/%d", index)},
+				Sysctls:   map[string]string{"sentinel.profile": fmt.Sprintf("%d", index)},
+			})
+			c.Config.Entrypoint = []string{fmt.Sprintf("entry-%d", index)}
+			c.Config.Cmd = []string{fmt.Sprintf("argument-%d", index)}
+			wrapper := &SpecWrapper{}
+			if err := createSpec(context.Background(), c, wrapper); err != nil {
+				errors <- fmt.Errorf("container %d: %v", index, err)
+				return
+			}
+			results[index] = wrapper.s
+		}(index)
+	}
+	wait.Wait()
+	close(errors)
+	for err := range errors {
+		t.Error(err)
+	}
+	if t.Failed() {
+		return
+	}
+	for index, s := range results {
+		wantedSize := fmt.Sprintf("size=%d", int64(index+1)*1048576)
+		if got := sizeOptionsForProfileTest(mountForProfileTest(t, s.Mounts, "/dev/shm").Options); !reflect.DeepEqual(got, []string{wantedSize}) {
+			t.Errorf("container %d shared-memory options = %v", index, got)
+		}
+		if got := s.Linux.CgroupsPath; got != fmt.Sprintf("/team/%d/concurrent-%d", index, index) {
+			t.Errorf("container %d cgroup path = %q", index, got)
+		}
+		if got := s.Linux.Sysctl["sentinel.profile"]; got != fmt.Sprintf("%d", index) {
+			t.Errorf("container %d sysctl marker = %q", index, got)
+		}
+		if want := []string{fmt.Sprintf("entry-%d", index), fmt.Sprintf("argument-%d", index)}; !reflect.DeepEqual(s.Process.Args, want) {
+			t.Errorf("container %d arguments = %v, want %v", index, s.Process.Args, want)
+		}
+		if mountCountForProfileTest(s.Mounts, "/run") != 0 {
+			t.Errorf("container %d inherited the containerd mount profile", index)
+		}
+	}
+}
