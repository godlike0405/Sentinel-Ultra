+func TestCreateSpecPreservesFuseDenial(t *testing.T) {
+	s := createSpecForProfileTest(t, containerForProfileTest("fuse-policy", &types.HostConfig{}))
+	for _, rule := range s.Linux.Resources.Devices {
+		if !rule.Allow && rule.Type == "c" && rule.Major != nil && rule.Minor != nil &&
+			*rule.Major == 10 && *rule.Minor == 229 && rule.Access == "rwm" {
+			return
+		}
+	}
+	t.Error("FUSE denial is missing from the final device policy")
+}
