+func TestFinalSpecOwnsProcessArguments(t *testing.T) {
+	entrypoint := make([]string, 1, 4)
+	entrypoint[0] = "entry"
+	c := containerForProfileTest("argument-snapshot", &types.HostConfig{})
+	c.Config.Entrypoint = entrypoint
+	c.Config.Cmd = []string{"argument"}
+	s := createSpecForProfileTest(t, c)
+	if !reflect.DeepEqual(s.Process.Args, []string{"entry", "argument"}) {
+		t.Fatalf("final arguments = %v", s.Process.Args)
+	}
+	s.Process.Args[0] = "changed-in-spec"
+	if c.Config.Entrypoint[0] != "entry" {
+		t.Errorf("editing final arguments changed container entrypoint to %q", c.Config.Entrypoint[0])
+	}
+	c.Config.Cmd[0] = "changed-in-config"
+	if s.Process.Args[1] != "argument" {
+		t.Errorf("editing container command changed final arguments to %v", s.Process.Args)
+	}
+}
