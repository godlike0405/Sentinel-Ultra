+func TestFinalCapabilitySetsRemainIndependent(t *testing.T) {
+	for changed := 0; changed < 4; changed++ {
+		c := containerForProfileTest(fmt.Sprintf("capability-snapshot-%d", changed), &types.HostConfig{
+			CapAdd: []string{"SYS_TIME"}, CapDrop: []string{"NET_RAW"},
+		})
+		s := createSpecForProfileTest(t, c)
+		capabilities := s.Process.Capabilities
+		sets := [][]string{capabilities.Bounding, capabilities.Permitted, capabilities.Inheritable, capabilities.Effective}
+		before := make([]string, len(sets))
+		for index, set := range sets {
+			if containsStringForProfileTest(set, "CAP_NET_RAW") || !containsStringForProfileTest(set, "CAP_SYS_TIME") {
+				t.Fatalf("capability adjustments were not applied to set %d: %v", index, set)
+			}
+			before[index] = set[0]
+		}
+		sets[changed][0] = "CHANGED"
+		for other := range sets {
+			if other != changed && sets[other][0] != before[other] {
+				t.Errorf("editing capability set %d changed set %d", changed, other)
+			}
+		}
+	}
+}
