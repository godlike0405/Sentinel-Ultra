+func TestSuccessfulSpecBuildRecordsNetworkFiles(t *testing.T) {
+	c := containerForProfileTest("network-files", &types.HostConfig{})
+	c.HostnamePath = "/var/lib/pouch/hostname"
+	c.HostsPath = "/var/lib/pouch/hosts"
+	c.ResolvConfPath = "/var/lib/pouch/resolv.conf"
