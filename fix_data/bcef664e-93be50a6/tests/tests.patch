+func TestCreateSpecResultsRemainIndependent(t *testing.T) {
+	requested := int64(1048576)
+	first := createSpecForProfileTest(t, containerForProfileTest("first-created", &types.HostConfig{ShmSize: &requested}))
+	second := createSpecForProfileTest(t, containerForProfileTest("second-created", &types.HostConfig{}))
+	if got := sizeOptionsForProfileTest(mountForProfileTest(t, first.Mounts, "/dev/shm").Options); !reflect.DeepEqual(got, []string{"size=1048576"}) {
+		t.Fatalf("first container's effective shared-memory size = %v", got)
+	}
+	before, err := json.Marshal(second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	first.Mounts[0].Destination = "/changed"
+	first.Mounts[0].Options[0] = "changed"
+	first.Process.Capabilities.Bounding[0] = "CHANGED_BOUNDING"
+	first.Process.Capabilities.Permitted[0] = "CHANGED_PERMITTED"
+	first.Process.Capabilities.Inheritable[0] = "CHANGED_INHERITABLE"
+	first.Process.Capabilities.Effective[0] = "CHANGED_EFFECTIVE"
+	first.Linux.MaskedPaths[0] = "/changed/masked"
+	first.Linux.ReadonlyPaths[0] = "/changed/readonly"
+	first.Linux.Namespaces[0].Type = specs.UserNamespace
+	first.Linux.Namespaces[0].Path = "/changed/namespace"
+	first.Linux.Resources.Devices[1].Allow = false
+	first.Linux.Resources.Devices[1].Access = "m"
+	*first.Linux.Resources.Devices[1].Major = 999
+	*first.Linux.Resources.Devices[1].Minor = 999
+	after, err := json.Marshal(second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(after, before) {
+		t.Errorf("modifying one final container spec changed another:\nbefore %s\nafter  %s", before, after)
+	}
+	if got := sizeOptionsForProfileTest(mountForProfileTest(t, second.Mounts, "/dev/shm").Options); !reflect.DeepEqual(got, []string{"size=65536k"}) {
+		t.Errorf("second container inherited the first container's size: %v", got)
+	}
+}
