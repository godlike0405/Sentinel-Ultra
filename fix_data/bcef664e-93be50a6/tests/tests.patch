+func containerForProfileTest(id string, hostConfig *types.HostConfig) *Container {
+	return &Container{
+		ID: id,
+		Config: &types.ContainerConfig{
+			DisableNetworkFiles: true,
+			NetworkDisabled:     true,
+		},
+		HostConfig:      hostConfig,
+		Snapshotter:     &types.SnapshotterData{Data: map[string]string{}},
+		NetworkSettings: &types.NetworkSettings{},
+	}
+}
+
+func createSpecForProfileTest(t *testing.T, c *Container) *specs.Spec {
+	t.Helper()
+	wrapper := &SpecWrapper{}
+	if err := createSpec(context.Background(), c, wrapper); err != nil {
+		t.Fatalf("createSpec returned error: %v", err)
+	}
+	if wrapper.s == nil {
+		t.Fatal("createSpec produced no runtime spec")
+	}
+	return wrapper.s
+}
+
+func tryCreateSpecForProfileTest(c *Container, wrapper *SpecWrapper) (err error, panicValue interface{}) {
+	defer func() {
+		panicValue = recover()
+	}()
+	err = createSpec(context.Background(), c, wrapper)
+	return err, nil
+}
+
+func mountForProfileTest(t *testing.T, mounts []specs.Mount, destination string) specs.Mount {
+	t.Helper()
+	for _, mount := range mounts {
+		if mount.Destination == destination {
+			return mount
+		}
+	}
+	t.Fatalf("%s mount is missing", destination)
+	return specs.Mount{}
+}
+
+func mountCountForProfileTest(mounts []specs.Mount, destination string) int {
+	count := 0
+	for _, mount := range mounts {
+		if mount.Destination == destination {
+			count++
+		}
+	}
+	return count
+}
+
+func sizeOptionsForProfileTest(options []string) []string {
+	var sizes []string
+	for _, option := range options {
+		if strings.HasPrefix(option, "size=") {
+			sizes = append(sizes, option)
+		}
+	}
+	return sizes
+}
+
+func hasOptionForProfileTest(options []string, wanted string) bool {
+	for _, option := range options {
+		if option == wanted {
+			return true
+		}
+	}
+	return false
+}
+
+func sortedStringsForProfileTest(in []string) []string {
+	out := append([]string(nil), in...)
+	sort.Strings(out)
+	return out
+}
+
+func assertStringSetForProfileTest(t *testing.T, label string, got, want []string) {
+	t.Helper()
+	if !reflect.DeepEqual(sortedStringsForProfileTest(got), sortedStringsForProfileTest(want)) {
+		t.Fatalf("%s = %v, want %v", label, got, want)
+	}
+}
