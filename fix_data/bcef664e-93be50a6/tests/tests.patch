+// containerdDefaultEnvironment lets this test make containerd's profile
+// observably different without constraining Pouch's replacement API.
+//go:linkname containerdDefaultEnvironment github.com/alibaba/pouch/vendor/github.com/containerd/containerd/oci.defaultEnv
+var containerdDefaultEnvironment []string
