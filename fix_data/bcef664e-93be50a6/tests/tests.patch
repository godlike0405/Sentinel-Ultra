+func TestCreateSpecUsesPouchMountSet(t *testing.T) {
+	s := createSpecForProfileTest(t, containerForProfileTest("mount-profile", &types.HostConfig{}))
+	var destinations []string
+	for _, mount := range s.Mounts {
+		destinations = append(destinations, mount.Destination)
