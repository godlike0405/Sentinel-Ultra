+// containerdProfileProbeMarker is the panic message installed by the verifier
+// in place of containerd's OCI profile generator while this ownership test
+// runs. Any code path that still asks containerd to generate the starting
+// specification trips it, regardless of which fields are overwritten later.
+const containerdProfileProbeMarker = "verifier-owned containerd profile generator was called"
+
+func containerdProfileGeneratorIsProbed() (probed bool) {
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			probed = strings.Contains(fmt.Sprint(recovered), containerdProfileProbeMarker)
+		}
+	}()
+	// Without the verifier probe this call returns a spec or an error and never
+	// panics, so a passing result below can only come from a probed generator.
+	_, _ = containerdoci.GenerateSpec(context.Background(), nil, &containers.Container{ID: "profile-probe"})
+	return false
+}
+
+func TestCreateSpecDoesNotUseContainerdProfileDefaults(t *testing.T) {
+	// Fail closed: the assertion below is only meaningful while the dependency
+	// boundary is instrumented, so refuse to pass vacuously if it is not.
+	if !containerdProfileGeneratorIsProbed() {
+		t.Fatal("containerd profile generator is not instrumented; ownership cannot be verified")
+	}
+
+	c := containerForProfileTest("profile-ownership", &types.HostConfig{})
+	wrapper := &SpecWrapper{}
+	err, panicValue := tryCreateSpecForProfileTest(c, wrapper)
+	if panicValue != nil {
+		if strings.Contains(fmt.Sprint(panicValue), containerdProfileProbeMarker) {
+			t.Fatal("ordinary container creation still asked containerd to generate the starting specification")
+		}
+		t.Fatalf("createSpec panicked: %v", panicValue)
+	}
+	if err != nil {
+		t.Fatalf("createSpec returned error: %v", err)
+	}
+	if wrapper.s == nil || wrapper.s.Process == nil || wrapper.s.Linux == nil {
+		t.Fatalf("Pouch-owned profile was not published: %+v", wrapper.s)
+	}
+}
