+func TestFinalSpecOwnsResourceDeviceSettings(t *testing.T) {
+	swappiness := int64(30)
+	c := containerForProfileTest("resource-snapshot", &types.HostConfig{Resources: types.Resources{
+		BlkioWeight:       400,
+		BlkioWeightDevice: []*types.WeightDevice{{Path: "/dev/null", Weight: 300}},
+		MemorySwappiness:  &swappiness,
+	}})
+	s := createSpecForProfileTest(t, c)
+	blockIO := s.Linux.Resources.BlockIO
+	if blockIO == nil || len(blockIO.WeightDevice) != 1 || blockIO.WeightDevice[0].Weight == nil || *blockIO.WeightDevice[0].Weight != 300 {
+		t.Fatalf("block IO weight devices = %+v", blockIO)
+	}
+	if blockIO.Weight == nil || *blockIO.Weight != 400 {
+		t.Fatalf("block IO weight = %+v", blockIO.Weight)
+	}
+	if s.Linux.Resources.Memory == nil || s.Linux.Resources.Memory.Swappiness == nil || *s.Linux.Resources.Memory.Swappiness != 30 {
+		t.Fatalf("memory swappiness = %+v", s.Linux.Resources.Memory)
+	}
+
+	*blockIO.WeightDevice[0].Weight = 999
+	*blockIO.Weight = 998
+	*s.Linux.Resources.Memory.Swappiness = 997
+	if got := c.HostConfig.Resources.BlkioWeightDevice[0].Weight; got != 300 {
+		t.Errorf("editing the final weight device changed the container weight to %d", got)
+	}
+	if got := c.HostConfig.Resources.BlkioWeight; got != 400 {
+		t.Errorf("editing the final block IO weight changed the container weight to %d", got)
+	}
+	if got := *c.HostConfig.Resources.MemorySwappiness; got != 30 {
+		t.Errorf("editing the final swappiness changed the container value to %d", got)
+	}
+
+	c.HostConfig.Resources.BlkioWeightDevice[0].Weight = 100
+	swappiness = 10
+	if got := *blockIO.WeightDevice[0].Weight; got != 999 {
+		t.Errorf("editing the container weight device changed the final value to %d", got)
+	}
+	if got := *s.Linux.Resources.Memory.Swappiness; got != 997 {
+		t.Errorf("editing the container swappiness changed the final value to %d", got)
+	}
+}
