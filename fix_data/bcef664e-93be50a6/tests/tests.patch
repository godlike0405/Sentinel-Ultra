+	assertStringSetForProfileTest(t, "mount destinations", destinations, []string{
+		"/proc", "/dev", "/dev/pts", "/sys", "/dev/mqueue", "/dev/shm", "/sys/fs/cgroup",
+	})
+	for _, destination := range []string{"/dev/shm", "/sys/fs/cgroup"} {
+		if count := mountCountForProfileTest(s.Mounts, destination); count != 1 {
+			t.Errorf("%s mount count = %d, want 1", destination, count)
+		}
+	}
+	for _, contract := range []struct {
+		destination string
+		mountType   string
+		source      string
+		options     []string
+	}{
+		{"/dev", "tmpfs", "tmpfs", []string{"nosuid", "strictatime", "mode=755"}},
+		{"/dev/pts", "devpts", "devpts", []string{"nosuid", "noexec", "newinstance", "ptmxmode=0666", "mode=0620", "gid=5"}},
+		{"/sys", "sysfs", "sysfs", []string{"nosuid", "noexec", "nodev", "ro"}},
+		{"/dev/mqueue", "mqueue", "mqueue", []string{"nosuid", "noexec", "nodev"}},
+		{"/dev/shm", "tmpfs", "shm", []string{"nosuid", "noexec", "nodev", "mode=1777", "size=65536k"}},
+		{"/sys/fs/cgroup", "cgroup", "cgroup", []string{"ro", "nosuid", "noexec", "nodev"}},
+	} {
+		mount := mountForProfileTest(t, s.Mounts, contract.destination)
+		if mount.Type != contract.mountType || mount.Source != contract.source {
+			t.Errorf("%s mount type/source = %q/%q, want %q/%q", contract.destination, mount.Type, mount.Source, contract.mountType, contract.source)
+		}
+		assertStringSetForProfileTest(t, contract.destination+" options", mount.Options, contract.options)
+	}
+}
