+func TestFinalSpecOwnsEnvironment(t *testing.T) {
+	env := make([]string, 1, 8)
+	env[0] = "SENTINEL_ONE=1"
+	c := containerForProfileTest("environment-snapshot", &types.HostConfig{})
+	c.Config.Env = env
+	c.Config.Tty = true
+	c.Config.Rich = true
+	s := createSpecForProfileTest(t, c)
+	if !containsStringForProfileTest(s.Process.Env, "SENTINEL_ONE=1") || !containsStringForProfileTest(s.Process.Env, "TERM=xterm") ||
+		len(s.Process.Env) < 3 {
+		t.Fatalf("final environment = %v", s.Process.Env)
+	}
+	if got := len(c.Config.Env); got != 1 {
+		t.Fatalf("container environment length changed to %d: %v", got, c.Config.Env)
+	}
+	// Growth of the final environment must not spill into the container's
+	// backing storage beyond the values it actually holds.
+	if leaked := env[:cap(env)][1]; leaked != "" {
+		t.Errorf("final environment growth wrote %q into the container's spare environment storage", leaked)
+	}
+	s.Process.Env[0] = "SENTINEL_ONE=changed-in-spec"
+	if c.Config.Env[0] != "SENTINEL_ONE=1" {
+		t.Errorf("editing the final environment changed the container environment to %v", c.Config.Env)
+	}
+	c.Config.Env[0] = "SENTINEL_ONE=changed-in-config"
+	if s.Process.Env[0] != "SENTINEL_ONE=changed-in-spec" {
+		t.Errorf("editing the container environment changed the final environment to %v", s.Process.Env)
+	}
+}
