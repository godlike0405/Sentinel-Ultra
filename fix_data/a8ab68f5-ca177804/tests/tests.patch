+"""Behavioral and ABI checks for the RPX newlib heap integration."""
+import functools
+import glob
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(os.environ.get("SENTINEL_WORKSPACE", Path(__file__).resolve().parent.parent))
+MACHDEP = ["-DESPRESSO", "-mcpu=750", "-meabi", "-mhard-float"]
+INCLUDES = [
+    "-Iinclude",
+    "-Ilibraries/libwhb/include",
+    "-Ilibraries/libgfd/include",
+    "-I.",
+]
+CFLAGS = MACHDEP + ["-D__WIIU__", "-D__WUT__"] + INCLUDES + [
+    "-ffunction-sections",
+    "-fdata-sections",
+    "-Wall",
+    "-O2",
+    "-std=gnu11",
+]
+
+
+def tool(name):
+    found = shutil.which(name)
+    if found:
+        return found
+    dkppc = os.environ.get("DEVKITPPC", "/opt/devkitpro/devkitPPC")
+    candidate = os.path.join(dkppc, "bin", name)
+    assert os.path.exists(candidate), f"required tool is unavailable: {name}"
+    return candidate
+
+
+def run(command, *, cwd=ROOT, timeout=120):
+    return subprocess.run(
+        command,
+        cwd=cwd,
+        capture_output=True,
+        text=True,
+        timeout=timeout,
+    )
+
+
+@functools.lru_cache(maxsize=None)
+def compile_object(rel_src):
+    source = ROOT / rel_src
+    assert source.exists(), f"missing source: {rel_src}"
+    out_dir = Path(tempfile.gettempdir()) / "wut_heap_eval_objects"
+    out_dir.mkdir(exist_ok=True)
+    output = out_dir / (rel_src.replace("/", "_") + ".o")
+    proc = run([tool("powerpc-eabi-gcc"), "-c", rel_src, "-o", str(output)] + CFLAGS)
+    assert proc.returncode == 0, f"{rel_src} failed to compile:\n{proc.stderr}"
+    return output
+
+
+@functools.lru_cache(maxsize=None)
+def symbols_for_source(rel_src):
+    proc = run([tool("powerpc-eabi-nm"), str(compile_object(rel_src))])
+    assert proc.returncode == 0, proc.stderr
+    table = {}
+    for line in proc.stdout.splitlines():
+        parts = line.split()
+        if len(parts) == 2:
+            kind, name = parts
+        elif len(parts) == 3:
+            _, kind, name = parts
+        else:
+            continue
+        table[name] = kind
+    return table
+
+
+def defined_symbols(rel_src):
+    return {
+        name for name, kind in symbols_for_source(rel_src).items()
+        if kind in {"T", "W", "D", "B", "R"}
+    }
+
+
+def undefined_symbols(rel_src):
+    return {
+        name for name, kind in symbols_for_source(rel_src).items() if kind == "U"
+    }
+
+
+def library_sources():
+    return sorted(
+        str(path.relative_to(ROOT))
+        for path in (ROOT / "libraries").glob("**/*.c")
+    )
+
+
+@functools.lru_cache(maxsize=None)
+def default_heap_source():
+    required = {
+        "MEMAllocFromDefaultHeap",
+        "MEMAllocFromDefaultHeapEx",
+        "MEMFreeToDefaultHeap",
+        "malloc",
+        "memalign",
+        "free",
+    }
+    for source in library_sources():
+        text = (ROOT / source).read_text(encoding="utf-8", errors="ignore")
+        if not {"MEMAllocFromDefaultHeap", "MEMFreeToDefaultHeap"} <= set(re.findall(r"[A-Za-z_][A-Za-z0-9_]*", text)):
+            continue
+        if required <= undefined_symbols(source):
+            return source
+    return None
+
+
+@functools.lru_cache(maxsize=None)
+def newlib_source():
+    required = {"__syscall_sbrk_r", "__syscall_malloc_lock", "__syscall_malloc_unlock"}
+    for source in library_sources():
+        if required <= defined_symbols(source):
+            return source
+    return None
+
+
+@functools.lru_cache(maxsize=None)
+def sbrk_source():
+    source = newlib_source()
+    assert source, "newlib allocation syscall implementation was not found"
+    refs = undefined_symbols(source)
+    candidates = [item for item in library_sources() if refs & defined_symbols(item)]
+    for item in candidates:
+        if "__wut_sbrk_r" in defined_symbols(item):
+            return item
+    return None
+
+
+@functools.lru_cache(maxsize=None)
+def malloc_lock_source():
+    source = newlib_source()
+    assert source
+    lock_targets = wrapper_targets("__syscall_malloc_lock")
+    unlock_targets = wrapper_targets("__syscall_malloc_unlock")
+    for item in library_sources():
+        definitions = defined_symbols(item)
+        if definitions & lock_targets and definitions & unlock_targets:
+            return item
+    return None
+
+
+@functools.lru_cache(maxsize=None)
+def preinit_source():
+    for source in library_sources():
+        text = (ROOT / source).read_text(encoding="utf-8", errors="ignore")
+        if "__preinit_user" not in text:
+            continue
+        if symbols_for_source(source).get("__preinit_user") == "W":
+            return source
+    return None
+
+
+def component_entry_symbols(component_source):
+    preinit = preinit_source()
+    assert preinit, "weak RPX pre-initialization implementation was not found"
+    if component_source == preinit:
+        return set()
+    linked = undefined_symbols(preinit) & defined_symbols(component_source)
+    return linked
+
+
+def wrapper_targets(public_symbol):
+    source = newlib_source()
+    assert source
+    proc = run([tool("powerpc-eabi-objdump"), "-dr", str(compile_object(source))])
+    assert proc.returncode == 0, proc.stderr
+    match = re.search(
+        r"<%s>:(.*?)(?=\n[0-9a-f]+ <|\Z)" % re.escape(public_symbol),
+        proc.stdout,
+        re.S,
+    )
+    assert match, f"missing public wrapper {public_symbol}"
+    return set(re.findall(r"R_PPC_REL24\s+([A-Za-z_][A-Za-z0-9_]*)", match.group(1)))
+
+
+def wrapper_target(public_symbol, component_source):
+    linked = wrapper_targets(public_symbol) & defined_symbols(component_source)
+    assert len(linked) == 1, (public_symbol, sorted(linked))
+    return next(iter(linked))
+
+
+@functools.lru_cache(maxsize=None)
+def function_call_targets(rel_src, symbol):
+    proc = run([tool("powerpc-eabi-objdump"), "-dr", str(compile_object(rel_src))])
+    assert proc.returncode == 0, proc.stderr
+    if Path(rel_src).suffix.lower() == ".s":
+        return set(re.findall(r"R_PPC_REL24\s+([A-Za-z_][A-Za-z0-9_.$]*)", proc.stdout))
+    match = re.search(
+        r"<%s>:(.*?)(?=\n[0-9a-f]+ <|\Z)" % re.escape(symbol),
+        proc.stdout,
+        re.S,
+    )
+    assert match, f"missing function {symbol} in {rel_src}"
+    return set(re.findall(r"R_PPC_REL24\s+([A-Za-z_][A-Za-z0-9_.$]*)", match.group(1)))
+
+
+@functools.lru_cache(maxsize=None)
+def source_defining(symbol):
+    for source in library_sources():
+        if symbol in defined_symbols(source):
+            return source
+    return None
+
+
+def transitive_calls(start_source, start_symbol):
+    pending = [(start_source, start_symbol)]
+    visited = set()
+    reached = set()
+    while pending:
+        source, symbol = pending.pop()
+        if (source, symbol) in visited:
+            continue
+        visited.add((source, symbol))
+        for target in function_call_targets(source, symbol):
+            reached.add(target)
+            target_source = source if target in defined_symbols(source) else source_defining(target)
+            if target_source:
+                pending.append((target_source, target))
+    return reached
+
+
+def assert_rpx_setup_is_unreachable(start_source, start_symbol):
+    default_source = default_heap_source()
+    assert default_source, "RPX default-heap integration was not found"
+    forbidden = defined_symbols(default_source) | {"__preinit_user"}
+    overlap = forbidden & transitive_calls(start_source, start_symbol)
+    assert not overlap, (
+        f"{start_symbol} transitively reaches RPX-only setup: {sorted(overlap)}"
+    )
+
+
+def write_mock(path, content):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(content, encoding="utf-8")
+
+
+@functools.lru_cache(maxsize=None)
+def built_library():
+    build = run(["make", "-j2"], timeout=720)
+    assert build.returncode == 0, build.stdout + build.stderr
+    archive = ROOT / "lib/libwut.a"
+    assert archive.is_file(), "make did not create libwut.a"
+    destination = Path(tempfile.mkdtemp(prefix="wut_install_"))
+    install = run(["make", "install", f"DESTDIR={destination}"], timeout=180)
+    assert install.returncode == 0, install.stdout + install.stderr
+    assert list(destination.glob("**/libwut.a")), "make install did not install libwut.a"
+    return archive
+
+
+@functools.lru_cache(maxsize=None)
+def default_heap_harness():
+    source = default_heap_source()
+    assert source, "no compiled component routes the default heap to newlib"
+    preinit = preinit_source()
+    assert preinit, "weak RPX pre-initialization implementation was not found"
+    stub_entries = set()
+    for component in (sbrk_source(), malloc_lock_source()):
+        if component:
+            stub_entries.update(component_entry_symbols(component))
+    work = Path(tempfile.mkdtemp(prefix="wut_defaultheap_runtime_"))
+    include = work / "include"
+    write_mock(include / "coreinit/memdefaultheap.h", r'''
+#pragma once
+#include <stdint.h>
+typedef void *MEMHeapHandle;
+typedef void *(*MEMAllocFromDefaultHeapFn)(uint32_t);
+typedef void *(*MEMAllocFromDefaultHeapExFn)(uint32_t, int32_t);
+typedef void (*MEMFreeToDefaultHeapFn)(void *);
+extern MEMAllocFromDefaultHeapFn MEMAllocFromDefaultHeap;
+extern MEMAllocFromDefaultHeapExFn MEMAllocFromDefaultHeapEx;
+extern MEMFreeToDefaultHeapFn MEMFreeToDefaultHeap;
+''')
+    write_mock(include / "malloc.h", r'''
+#pragma once
+#include <stddef.h>
+void *malloc(size_t size);
+void *memalign(size_t alignment, size_t size);
+void free(void *ptr);
+''')
+    harness = r'''
+#include <coreinit/memdefaultheap.h>
+#include <stdint.h>
+#include <string.h>
+
+MEMAllocFromDefaultHeapFn MEMAllocFromDefaultHeap;
+MEMAllocFromDefaultHeapExFn MEMAllocFromDefaultHeapEx;
+MEMFreeToDefaultHeapFn MEMFreeToDefaultHeap;
+static uint32_t seen_size;
+static uint32_t seen_alignment;
+static void *seen_free;
+static unsigned char token;
+
+void *tracked_malloc(size_t size) { seen_size = (uint32_t)size; return &token; }
+void *tracked_memalign(size_t alignment, size_t size) {
+    seen_alignment = (uint32_t)alignment;
+    seen_size = (uint32_t)size;
+    return &token;
+}
+void tracked_free(void *ptr) { seen_free = ptr; }
+%s
+extern void __preinit_user(MEMHeapHandle *, MEMHeapHandle *, MEMHeapHandle *);
+
+int main(int argc, char **argv) {
+    MEMHeapHandle mem1 = 0, foreground = 0, mem2 = 0;
+    if (argc != 2) return 90;
+    __preinit_user(&mem1, &foreground, &mem2);
+    if (!MEMAllocFromDefaultHeap || !MEMAllocFromDefaultHeapEx || !MEMFreeToDefaultHeap) return 91;
+    if (!strcmp(argv[1], "alloc")) {
+        return MEMAllocFromDefaultHeap(37) == &token && seen_size == 37 ? 0 : 1;
+    }
+    if (!strcmp(argv[1], "align")) {
+        return MEMAllocFromDefaultHeapEx(33, 64) == &token &&
+               seen_size == 33 && seen_alignment == 64 ? 0 : 2;
+    }
+    if (!strcmp(argv[1], "free")) {
+        MEMFreeToDefaultHeap(&token);
+        return seen_free == &token ? 0 : 3;
+    }
+    return 92;
+}
+''' % "\n".join(f"void {name}(void) {{}}" for name in sorted(stub_entries))
+    write_mock(work / "harness.c", harness)
+    source_obj = work / "component.o"
+    proc = run([
+        tool("gcc"), "-std=gnu11", "-Wall", "-Werror", "-I", str(include),
+        "-Dmalloc=tracked_malloc", "-Dmemalign=tracked_memalign",
+        "-Dfree=tracked_free", "-c", str(ROOT / source), "-o", str(source_obj),
+    ])
+    assert proc.returncode == 0, proc.stderr
+    objects = [source_obj]
+    if preinit != source:
+        preinit_obj = work / "preinit.o"
+        proc = run([
+            tool("gcc"), "-std=gnu11", "-Wall", "-Werror", "-I", str(include),
+            "-c", str(ROOT / preinit), "-o", str(preinit_obj),
+        ])
+        assert proc.returncode == 0, proc.stderr
+        objects.append(preinit_obj)
+    executable = work / "defaultheap_harness"
+    proc = run([
+        tool("gcc"), "-std=gnu11", "-Wall", "-Werror", "-I", str(include),
+        str(work / "harness.c"), *map(str, objects), "-o", str(executable),
+    ])
+    assert proc.returncode == 0, proc.stderr
+    return executable
+
+
+@functools.lru_cache(maxsize=None)
+def sbrk_harness():
+    source = sbrk_source()
+    assert source, "newlib heap storage implementation was not found"
+    preinit = preinit_source()
+    assert preinit
+    other_entries = set()
+    for component in (default_heap_source(), malloc_lock_source()):
+        if component:
+            other_entries.update(component_entry_symbols(component))
+    work = Path(tempfile.mkdtemp(prefix="wut_sbrk_runtime_"))
+    include = work / "include"
+    mock = r'''
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <errno.h>
+typedef int BOOL;
+typedef void *MEMHeapHandle;
+struct _reent { int _errno; };
+BOOL OSCompareAndSwapAtomic(volatile uint32_t *, uint32_t, uint32_t);
+uint32_t MEMGetAllocatableSizeForExpHeapEx(MEMHeapHandle, int32_t);
+void *MEMAllocFromExpHeapEx(MEMHeapHandle, uint32_t, int32_t);
+void MEMFreeToExpHeap(MEMHeapHandle, void *);
+'''
+    write_mock(include / "mock_runtime.h", mock)
+    for header in ("atomic.h", "memheap.h", "memdefaultheap.h", "memexpheap.h"):
+        write_mock(include / "coreinit" / header, "#pragma once\n")
+    harness = r'''
+#include "mock_runtime.h"
+#include <stdint.h>
+
+    enum { CAPACITY = 192 * 1024 };
+    static unsigned char arena[CAPACITY + 16];
+static uint32_t requested_size;
+static MEMHeapHandle requested_heap;
+static void *freed_ptr;
+static MEMHeapHandle freed_heap;
+
+BOOL OSCompareAndSwapAtomic(volatile uint32_t *ptr, uint32_t old, uint32_t value) {
+    if (*ptr != old) return 0;
+    *ptr = value;
+    return 1;
+}
+uint32_t MEMGetAllocatableSizeForExpHeapEx(MEMHeapHandle heap, int32_t align) {
+    requested_heap = heap;
+        return align == 4 ? CAPACITY : 0;
+}
+void *MEMAllocFromExpHeapEx(MEMHeapHandle heap, uint32_t size, int32_t align) {
+    requested_heap = heap;
+    requested_size = size;
+    return align == 4 ? arena : 0;
+}
+void MEMFreeToExpHeap(MEMHeapHandle heap, void *ptr) {
+    freed_heap = heap;
+    freed_ptr = ptr;
+}
+    %s
+    extern void __preinit_user(MEMHeapHandle *, MEMHeapHandle *, MEMHeapHandle *);
+extern void *__wut_sbrk_r(struct _reent *, ptrdiff_t);
+extern void __fini_wut_sbrk_heap(void);
+
+int main(void) {
+    MEMHeapHandle heap = (MEMHeapHandle)(uintptr_t)0x1234;
+    struct _reent state = {0};
+        MEMHeapHandle mem1 = 0, foreground = 0, mem2 = heap;
+        __preinit_user(&mem1, &foreground, &mem2);
+        if (requested_heap != heap || requested_size != CAPACITY) return 1;
+        if (__wut_sbrk_r(&state, CAPACITY / 2) != arena) return 2;
+        if (__wut_sbrk_r(&state, CAPACITY / 2) != arena + CAPACITY / 2) return 3;
+    if (__wut_sbrk_r(&state, 1) != (void *)-1 || state._errno != ENOMEM) return 4;
+    __fini_wut_sbrk_heap();
+    if (freed_heap != heap || freed_ptr != arena) return 5;
+    return 0;
+}
+    ''' % "\n".join(f"void {name}(void) {{}}" for name in sorted(other_entries))
+    write_mock(work / "harness.c", harness)
+    source_obj = work / "sbrk.o"
+    proc = run([
+        tool("gcc"), "-std=gnu11", "-Wall", "-Werror", "-D__WUT_NEWLIB_H",
+        "-include", str(include / "mock_runtime.h"), "-I", str(include),
+        "-c", str(ROOT / source), "-o", str(source_obj),
+    ])
+    assert proc.returncode == 0, proc.stderr
+    preinit_obj = work / "preinit.o"
+    proc = run([
+        tool("gcc"), "-std=gnu11", "-Wall", "-Werror", "-D__WUT_NEWLIB_H",
+        "-include", str(include / "mock_runtime.h"), "-I", str(include),
+        "-c", str(ROOT / preinit), "-o", str(preinit_obj),
