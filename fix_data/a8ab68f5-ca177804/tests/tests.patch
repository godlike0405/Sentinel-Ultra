+#pragma once
+#include <pthread.h>
+#include <signal.h>
+#include <stdint.h>
+typedef int BOOL;
+typedef void *MEMHeapHandle;
+struct _reent { int unused; };
+typedef struct { pthread_mutex_t value; } OSSpinLock;
+typedef struct { pthread_mutex_t value; } OSFastMutex;
+typedef struct { pthread_mutex_t value; } OSMutex;
+static _Thread_local sigset_t saved_interrupt_mask;
+static inline void block_test_interrupt(void) {
+    sigset_t set;
+    sigemptyset(&set);
+    sigaddset(&set, SIGUSR1);
+    pthread_sigmask(SIG_BLOCK, &set, &saved_interrupt_mask);
+}
+static inline void restore_test_interrupt(void) {
+    pthread_sigmask(SIG_SETMASK, &saved_interrupt_mask, 0);
+}
+static inline void OSInitSpinLock(OSSpinLock *lock) { pthread_mutex_init(&lock->value, 0); }
+static inline BOOL OSAcquireSpinLock(OSSpinLock *lock) { return pthread_mutex_lock(&lock->value) == 0; }
+static inline BOOL OSReleaseSpinLock(OSSpinLock *lock) { return pthread_mutex_unlock(&lock->value) == 0; }
+static inline BOOL OSUninterruptibleSpinLock_Acquire(OSSpinLock *lock) {
+    block_test_interrupt();
+    return pthread_mutex_lock(&lock->value) == 0;
+}
+static inline BOOL OSUninterruptibleSpinLock_Release(OSSpinLock *lock) {
+    BOOL ok = pthread_mutex_unlock(&lock->value) == 0;
+    restore_test_interrupt();
+    return ok;
+}
+static inline void OSFastMutex_Init(OSFastMutex *lock, const char *name) {
+    (void)name; pthread_mutex_init(&lock->value, 0);
+}
+static inline void OSFastMutex_Lock(OSFastMutex *lock) { pthread_mutex_lock(&lock->value); }
+static inline void OSFastMutex_Unlock(OSFastMutex *lock) { pthread_mutex_unlock(&lock->value); }
+static inline void OSInitMutex(OSMutex *lock) { pthread_mutex_init(&lock->value, 0); }
+static inline void OSLockMutex(OSMutex *lock) { pthread_mutex_lock(&lock->value); }
+static inline void OSUnlockMutex(OSMutex *lock) { pthread_mutex_unlock(&lock->value); }
+static inline BOOL OSCompareAndSwapAtomic(volatile uint32_t *ptr, uint32_t old, uint32_t value) {
+    return __sync_bool_compare_and_swap(ptr, old, value);
+}
+static inline BOOL OSDisableInterrupts(void) { block_test_interrupt(); return 1; }
+static inline BOOL OSRestoreInterrupts(BOOL enabled) {
+    (void)enabled; restore_test_interrupt(); return 1;
+}
+'''
+    write_mock(include / "mock_lock_runtime.h", mock)
+    for header in ("spinlock.h", "fastmutex.h", "mutex.h", "atomic.h", "interrupts.h"):
+        write_mock(include / "coreinit" / header, '#include "../mock_lock_runtime.h"\n')
+    write_mock(include / "coreinit/memdefaultheap.h", '#include "../mock_lock_runtime.h"\n')
+    harness = r'''
+#include "mock_lock_runtime.h"
+#include <sched.h>
+#include <signal.h>
+#include <stdlib.h>
+
+%s
+extern void __preinit_user(MEMHeapHandle *, MEMHeapHandle *, MEMHeapHandle *);
+extern void %s(struct _reent *);
+extern void %s(struct _reent *);
+static struct _reent state;
+static volatile long counter;
+static volatile sig_atomic_t interrupt_seen;
+
+static void *worker(void *unused) {
+    int i;
+    (void)unused;
+    for (i = 0; i < 2000; ++i) {
+        long value;
+        %s(&state);
+        value = counter;
+        sched_yield();
+        counter = value + 1;
+        %s(&state);
+    }
+    return 0;
+}
+
+static void interrupt_handler(int signal_number) {
+    (void)signal_number;
+    %s(&state);
+    ++interrupt_seen;
+    %s(&state);
+}
+
+int main(void) {
+    pthread_t threads[6];
+    MEMHeapHandle mem1 = 0, foreground = 0, mem2 = 0;
+    int i;
+    __preinit_user(&mem1, &foreground, &mem2);
+    for (i = 0; i < 6; ++i) if (pthread_create(&threads[i], 0, worker, 0)) return 1;
+    for (i = 0; i < 6; ++i) if (pthread_join(threads[i], 0)) return 2;
+    if (counter != 12000) return 3;
+    signal(SIGUSR1, interrupt_handler);
+    %s(&state);
+    raise(SIGUSR1);
+    if (interrupt_seen) return 4;
+    %s(&state);
+    for (i = 0; i < 10000 && !interrupt_seen; ++i) sched_yield();
+    return interrupt_seen == 1 ? 0 : 5;
+}
+''' % (
+        "\n".join(f"void {name}(void) {{}}" for name in sorted(stub_entries)),
+        lock_symbol, unlock_symbol,
+        lock_symbol, unlock_symbol, lock_symbol, unlock_symbol,
+        lock_symbol, unlock_symbol,
+    )
+    write_mock(work / "harness.c", harness)
+    source_obj = work / "lock.o"
+    proc = run([
+        tool("gcc"), "-std=gnu11", "-Wall", "-Werror", "-pthread",
+        "-D__WUT_NEWLIB_H", "-include", str(include / "mock_lock_runtime.h"),
+        "-I", str(include), "-c", str(ROOT / source), "-o", str(source_obj),
+    ])
+    assert proc.returncode == 0, proc.stderr
+    objects = [source_obj]
+    if preinit != source:
+        preinit_obj = work / "preinit.o"
+        proc = run([
+            tool("gcc"), "-std=gnu11", "-Wall", "-Werror", "-pthread",
+            "-D__WUT_NEWLIB_H", "-include", str(include / "mock_lock_runtime.h"),
+            "-I", str(include), "-c", str(ROOT / preinit), "-o", str(preinit_obj),
+        ])
+        assert proc.returncode == 0, proc.stderr
+        objects.append(preinit_obj)
+    executable = work / "malloc_lock_harness"
+    proc = run([
+        tool("gcc"), "-std=gnu11", "-Wall", "-Werror", "-pthread",
+        "-I", str(include), str(work / "harness.c"), *map(str, objects),
