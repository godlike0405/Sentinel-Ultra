+func TestParallelAPIOutputKeepsInputOrderAndIsolation(t *testing.T) {
+	prepareConcurrentRunTest(t)
+	slowEntered := make(chan struct{})
+	slowRelease := make(chan struct{})
+	fastServed := make(chan struct{})
+
+	slow := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		close(slowEntered)
+		<-slowRelease
+		w.Header().Set("X-Target", "slow")
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer slow.Close()
+	fast := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("X-Target", "fast")
+		w.WriteHeader(http.StatusOK)
+		close(fastServed)
+	}))
+	defer fast.Close()
+
+	settings := &config.Settings{
+		URLs:        []string{slow.URL, fast.URL},
+		ApiMode:     true,
+		Concurrency: 2,
+		Headers:     true,
+		NoScan:      true,
+		Dirlist:     "none",
+		Dnslist:     "none",
+		Ports:       "none",
+		Threads:     1,
+		Timeout:     2 * time.Second,
+	}
+	app, err := New(settings)
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("pipe: %v", err)
+	}
+	oldStdout := os.Stdout
+	os.Stdout = writer
+	done := make(chan error, 1)
+	go func() { done <- app.Run() }()
+
+	waitSignal(t, slowEntered, "slow target")
+	waitSignal(t, fastServed, "fast target")
+	time.Sleep(50 * time.Millisecond)
+	close(slowRelease)
+	runErr := <-done
+	_ = writer.Close()
+	os.Stdout = oldStdout
+	data, readErr := io.ReadAll(reader)
+	_ = reader.Close()
+	if runErr != nil {
+		t.Fatalf("Run: %v", runErr)
+	}
+	if readErr != nil {
+		t.Fatalf("read stdout: %v", readErr)
+	}
+
+	lines := strings.FieldsFunc(strings.TrimSpace(string(data)), func(r rune) bool { return r == '\n' })
+	if len(lines) != 2 {
+		t.Fatalf("API lines = %d, want 2; output=%q", len(lines), data)
+	}
+	wantURLs := []string{slow.URL, fast.URL}
+	for i, line := range lines {
+		var result UrlResult
+		if err := json.Unmarshal([]byte(line), &result); err != nil {
+			t.Fatalf("line %d is not JSON: %v; line=%q", i, err, line)
+		}
+		if result.Url != wantURLs[i] {
+			t.Fatalf("line %d target = %q, want %q", i, result.Url, wantURLs[i])
+		}
+		if len(result.Results) != 1 || result.Results[0].Id != "headers" {
+			t.Fatalf("line %d results = %+v, want one isolated headers result", i, result.Results)
+		}
+	}
+}
