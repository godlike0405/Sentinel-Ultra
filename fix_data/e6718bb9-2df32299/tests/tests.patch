+func parseConcurrencyFlag(t *testing.T, args ...string) int {
+	t.Helper()
+	goflags.DisableAutoConfigMigration = true
+	settings := &Settings{}
+	flags := registerFlags(settings)
+	if err := flags.Parse(args...); err != nil {
+		t.Fatalf("parse flags: %v", err)
+	}
+	return settings.Concurrency
+}
+
+func TestConcurrencyFlagDefaultsToOne(t *testing.T) {
+	settings := &Settings{}
+	registerFlags(settings)
+	if got := settings.Concurrency; got != 1 {
+		t.Fatalf("default concurrency = %d, want 1", got)
+	}
+}
+
+func TestConcurrencyFlagAcceptsExplicitValue(t *testing.T) {
+	if got := parseConcurrencyFlag(t, "-concurrency", "7"); got != 7 {
+		t.Fatalf("explicit concurrency = %d, want 7", got)
+	}
+}
