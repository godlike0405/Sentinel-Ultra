+func TestOverlappingParallelRunsKeepConsoleSafeUntilBothFinish(t *testing.T) {
+	prepareConcurrentRunTest(t)
+	savedTTY := output.IsTTY
+	output.IsTTY = true
+	t.Cleanup(func() { output.IsTTY = savedTTY })
+
+	longEntered := make(chan struct{}, 2)
+	releaseLong := make(chan struct{})
+	installBehaviorModule(t, behaviorModule{
+		id: "overlap-console",
+		execute: func(target string) (*modules.Result, error) {
+			if strings.Contains(target, "long-") {
+				longEntered <- struct{}{}
+				<-releaseLong
+			}
+			if target == "http://short-failure" {
+				panic("overlapping run failed")
+			}
+			if strings.Contains(target, "progress") {
+				output.Info("OVERLAP-PROGRESS-BEGIN")
+				progress := output.NewProgress(2, "overlap progress")
+				progress.Increment("first")
+				progress.Done()
+				output.Info("OVERLAP-PROGRESS-END")
+			}
+			return &modules.Result{ModuleID: "overlap-console", Target: target}, nil
+		},
+	})
+
+	got, runErr := captureRunOutput(t, func() error {
+		longRun := idleApp([]string{"http://long-progress", "http://long-helper"}, 2)
+		longRun.settings.Modules = "overlap-console"
+		longDone := make(chan error, 1)
+		go func() { longDone <- longRun.Run() }()
+		if !waitSignal(t, longEntered, "first long-running target") || !waitSignal(t, longEntered, "second long-running target") {
+			close(releaseLong)
+			return <-longDone
+		}
+
+		shortRun := idleApp([]string{"http://short-one", "http://short-two"}, 2)
+		shortRun.settings.Modules = "overlap-console"
+		if err := shortRun.Run(); err != nil {
+			close(releaseLong)
+			<-longDone
+			return err
+		}
+
+		failingRun := idleApp([]string{"http://short-failure", "http://short-failure-helper"}, 2)
+		failingRun.settings.Modules = "overlap-console"
+		if err := failingRun.Run(); err == nil {
+			close(releaseLong)
+			<-longDone
+			return errors.New("overlapping failing run returned nil")
+		}
+		close(releaseLong)
+		if err := <-longDone; err != nil {
+			return err
+		}
+
+		sequential := idleApp([]string{"http://sequential-progress"}, 1)
+		sequential.settings.Modules = "overlap-console"
+		return sequential.Run()
+	})
+	if runErr != nil {
+		t.Fatalf("Run: %v", runErr)
+	}
+
+	overlapStart := strings.Index(got, "OVERLAP-PROGRESS-BEGIN")
+	overlapEnd := strings.Index(got, "OVERLAP-PROGRESS-END")
+	if overlapStart < 0 || overlapEnd <= overlapStart {
+		t.Fatalf("missing overlap progress markers: %q", got)
+	}
+	overlapOutput := got[overlapStart:overlapEnd]
+	if strings.Contains(overlapOutput, "\033[2K") || strings.Contains(overlapOutput, "\r") {
+		t.Fatalf("one completed run re-enabled shared cursor updates during another parallel run: %q", overlapOutput)
+	}
+
+	sequentialStart := strings.LastIndex(got, "OVERLAP-PROGRESS-BEGIN")
+	sequentialEnd := strings.LastIndex(got, "OVERLAP-PROGRESS-END")
+	if sequentialStart <= overlapStart || sequentialEnd <= sequentialStart {
+		t.Fatalf("missing later sequential progress output: %q", got)
+	}
+	sequentialOutput := got[sequentialStart:sequentialEnd]
+	if !strings.Contains(sequentialOutput, "\033[2K") || !strings.Contains(sequentialOutput, "\r") {
+		t.Fatalf("normal live output was not restored after parallel runs ended: %q", sequentialOutput)
+	}
+}
