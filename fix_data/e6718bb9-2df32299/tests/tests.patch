+func TestParallelConsoleOutputKeepsTargetLinesIntact(t *testing.T) {
+	prepareConcurrentRunTest(t)
+	targets := []string{"http://one", "http://two", "http://three", "http://four"}
+	release := make(chan struct{})
+	var entered atomic.Int32
+	expected := make(map[string]string, len(targets))
+	for _, target := range targets {
+		label := strings.TrimPrefix(target, "http://")
+		expected[target] = "console-probe|" + target + "|" + strings.Repeat(label+"-", 2048) + "|console-probe-end"
+	}
+	installBehaviorModule(t, behaviorModule{
+		id: "console-integrity",
+		execute: func(target string) (*modules.Result, error) {
+			if entered.Add(1) == int32(len(targets)) {
+				close(release)
+			}
+			select {
+			case <-release:
+			case <-time.After(2 * time.Second):
+				return nil, context.DeadlineExceeded
+			}
+			output.Info("%s", expected[target])
+			return &modules.Result{ModuleID: "console-integrity", Target: target}, nil
+		},
+	})
+
+	app := idleApp(targets, len(targets))
+	app.settings.Modules = "console-integrity"
+	got, runErr := captureRunOutput(t, app.Run)
+	if runErr != nil {
+		t.Fatalf("Run: %v", runErr)
+	}
+	var probeLines []string
+	for _, line := range strings.Split(got, "\n") {
+		if strings.Contains(line, "console-probe|") {
+			probeLines = append(probeLines, line)
+		}
+	}
+	if len(probeLines) != len(targets) {
+		t.Fatalf("probe lines = %d, want %d complete target lines", len(probeLines), len(targets))
+	}
+	for _, target := range targets {
+		want := expected[target]
+		if count := strings.Count(got, want); count != 1 {
+			t.Fatalf("complete output record for %q occurs %d times, want 1", target, count)
+		}
+	}
+	for _, line := range probeLines {
+		if strings.Count(line, "console-probe|") != 1 || strings.Count(line, "|console-probe-end") != 1 {
+			t.Fatalf("target output records were combined or corrupted: %q", line)
+		}
+	}
+}
