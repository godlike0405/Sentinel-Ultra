+func prepareConcurrentRunTest(t *testing.T) {
+	t.Helper()
+	output.SetAPIMode(false)
+	output.SetSilent(false)
+	t.Cleanup(func() {
+		output.SetAPIMode(false)
+		output.SetSilent(false)
+	})
+}
+
+func headersApp(targets []string, concurrency int) *App {
+	return &App{
+		targets: targets,
+		settings: &config.Settings{
+			Concurrency: concurrency,
+			Headers:     true,
+			NoScan:      true,
+			Dirlist:     "none",
+			Dnslist:     "none",
+			Ports:       "none",
+			Threads:     1,
+			Timeout:     2 * time.Second,
+		},
+	}
+}
+
+func idleApp(targets []string, concurrency int) *App {
+	app := headersApp(targets, concurrency)
+	app.settings.Headers = false
+	return app
+}
+
+func updateMaximum(maximum *atomic.Int32, value int32) {
+	for {
+		old := maximum.Load()
+		if value <= old || maximum.CompareAndSwap(old, value) {
+			return
+		}
+	}
+}
+
+func waitSignal(t *testing.T, ch <-chan struct{}, description string) bool {
+	t.Helper()
+	select {
+	case <-ch:
+		return true
+	case <-time.After(2 * time.Second):
+		t.Errorf("timed out waiting for %s", description)
+		return false
+	}
+}
+
+func captureRunOutput(t *testing.T, run func() error) (string, error) {
+	t.Helper()
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("pipe: %v", err)
+	}
+	oldStdout := os.Stdout
+	os.Stdout = writer
+	output.SetSilent(false)
+
+	type readResult struct {
+		data []byte
+		err  error
+	}
+	readDone := make(chan readResult, 1)
+	go func() {
+		data, readErr := io.ReadAll(reader)
+		readDone <- readResult{data: data, err: readErr}
+	}()
+
+	runErr := run()
+	_ = writer.Close()
+	os.Stdout = oldStdout
+	output.SetSilent(false)
+	result := <-readDone
+	_ = reader.Close()
+	if result.err != nil {
+		t.Fatalf("read stdout: %v", result.err)
+	}
+	return string(result.data), runErr
+}
+
+func TestSequentialConcurrencyPreservesTargetOrder(t *testing.T) {
+	prepareConcurrentRunTest(t)
+	var mu sync.Mutex
+	var visits []string
+
+	server := func(id string) *httptest.Server {
+		return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			mu.Lock()
+			visits = append(visits, id)
+			mu.Unlock()
+			w.WriteHeader(http.StatusOK)
+		}))
+	}
+	first, second := server("first"), server("second")
+	defer first.Close()
+	defer second.Close()
+
+	app := headersApp([]string{first.URL, second.URL}, 1)
+	if err := app.Run(); err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	mu.Lock()
+	got := append([]string(nil), visits...)
+	mu.Unlock()
+	if strings.Join(got, ",") != "first,second" {
+		t.Fatalf("visit order = %v, want [first second]", got)
+	}
+	if len(app.logFiles) != 0 {
+		t.Fatalf("log files = %v without a log directory", app.logFiles)
+	}
+}
