+func assertNonPositiveConcurrencyIsSequential(t *testing.T, concurrency int) {
+	t.Helper()
+	prepareConcurrentRunTest(t)
+	var active, maximum atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		current := active.Add(1)
+		updateMaximum(&maximum, current)
+		time.Sleep(15 * time.Millisecond)
+		active.Add(-1)
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	app := headersApp([]string{server.URL, server.URL, server.URL}, concurrency)
+	if err := app.Run(); err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if got := maximum.Load(); got != 1 {
+		t.Fatalf("maximum active scans = %d, want sequential execution", got)
+	}
+}
+
+func TestZeroConcurrencyRunsSequentially(t *testing.T) {
+	assertNonPositiveConcurrencyIsSequential(t, 0)
+}
+
+func TestNegativeConcurrencyRunsSequentially(t *testing.T) {
+	assertNonPositiveConcurrencyIsSequential(t, -8)
+}
