+func TestParallelRunOverlapsAndHonorsWorkerBound(t *testing.T) {
+	prepareConcurrentRunTest(t)
+	const targetCount = 6
+	entered := make(chan struct{}, targetCount)
+	release := make(chan struct{})
+	var active, maximum atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		current := active.Add(1)
+		updateMaximum(&maximum, current)
+		entered <- struct{}{}
+		<-release
+		active.Add(-1)
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+
+	app := headersApp([]string{server.URL, server.URL, server.URL, server.URL, server.URL, server.URL}, 2)
+	done := make(chan error, 1)
+	go func() { done <- app.Run() }()
+
+	first := waitSignal(t, entered, "first worker")
+	second := waitSignal(t, entered, "second worker")
+	thirdStarted := false
+	if first && second {
+		select {
+		case <-entered:
+			thirdStarted = true
+		case <-time.After(75 * time.Millisecond):
+		}
+	}
+	close(release)
+	if err := <-done; err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if !first || !second {
+		t.Fatal("two targets did not overlap")
+	}
+	if thirdStarted || maximum.Load() > 2 {
+		t.Fatalf("worker bound exceeded: thirdStarted=%v maximum=%d", thirdStarted, maximum.Load())
+	}
+}
