+func TestParallelBestEffortModuleErrorLogsAndContinues(t *testing.T) {
+	prepareConcurrentRunTest(t)
+	targets := []string{"http://first", "http://stage-fails", "http://last"}
+	processed := make(map[string]int, len(targets))
+	var processedMu sync.Mutex
+	installBehaviorModule(t, behaviorModule{
+		id: "best-effort-stage",
+		execute: func(target string) (*modules.Result, error) {
+			processedMu.Lock()
+			processed[target]++
+			processedMu.Unlock()
+			if strings.Contains(target, "fails") {
+				return nil, errors.New("expected stage failure")
+			}
+			return &modules.Result{ModuleID: "best-effort-stage", Target: target}, nil
+		},
+	})
+
+	app := idleApp(targets, len(targets))
+	app.settings.Modules = "best-effort-stage"
+	got, runErr := captureRunOutput(t, app.Run)
+	if runErr != nil {
+		t.Fatalf("best-effort module error aborted Run: %v", runErr)
+	}
+	processedMu.Lock()
+	defer processedMu.Unlock()
+	for _, target := range targets {
+		if processed[target] != 1 {
+			t.Fatalf("target %q processed %d times, want 1", target, processed[target])
+		}
+	}
+	if !strings.Contains(got, "best-effort-stage") || !strings.Contains(got, "expected stage failure") {
+		t.Fatalf("best-effort module failure was not logged: %q", got)
+	}
+}
