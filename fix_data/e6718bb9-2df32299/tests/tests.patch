+func TestParallelRunMergesFindingsInInputOrder(t *testing.T) {
+	prepareConcurrentRunTest(t)
+	first := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		time.Sleep(40 * time.Millisecond)
+		w.Header().Set("X-Merge-Probe", "first")
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer first.Close()
+	second := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("X-Merge-Probe", "second")
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer second.Close()
+
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("pipe: %v", err)
+	}
+	oldStdout := os.Stdout
+	os.Stdout = writer
+	output.SetSilent(true)
+	app := headersApp([]string{first.URL, second.URL}, 2)
+	app.settings.Silent = true
+	runErr := app.Run()
+	_ = writer.Close()
+	os.Stdout = oldStdout
+	data, readErr := io.ReadAll(reader)
+	_ = reader.Close()
+	if runErr != nil {
+		t.Fatalf("Run: %v", runErr)
+	}
+	if readErr != nil {
+		t.Fatalf("read stdout: %v", readErr)
+	}
+
+	var findingTargets []string
+	for _, line := range strings.Split(strings.TrimSpace(string(data)), "\n") {
+		if !strings.Contains(line, " headers X-Merge-Probe") {
+			continue
+		}
+		switch {
+		case strings.Contains(line, first.URL):
+			findingTargets = append(findingTargets, first.URL)
+		case strings.Contains(line, second.URL):
+			findingTargets = append(findingTargets, second.URL)
+		}
+	}
+	want := []string{first.URL, second.URL}
+	if strings.Join(findingTargets, "\n") != strings.Join(want, "\n") {
+		t.Fatalf("probe findings = %v, want each target exactly once in input order; output=%q", findingTargets, data)
+	}
+}
