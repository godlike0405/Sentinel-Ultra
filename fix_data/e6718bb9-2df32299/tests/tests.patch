+func TestParallelRunMergesScanLabelsAndLogSummary(t *testing.T) {
+	prepareConcurrentRunTest(t)
+	servers := make([]*httptest.Server, 3)
+	targets := make([]string, len(servers))
+	for i := range servers {
+		delay := time.Duration(len(servers)-i-1) * 20 * time.Millisecond
+		servers[i] = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			time.Sleep(delay)
+			w.WriteHeader(http.StatusOK)
+		}))
+		targets[i] = servers[i].URL
+		defer servers[i].Close()
+	}
+
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("pipe: %v", err)
+	}
+	oldStderr := os.Stderr
+	os.Stderr = writer
+	output.SetSilent(true)
+	app := headersApp(targets, len(targets))
+	app.settings.LogDir = t.TempDir()
+	runErr := app.Run()
+	_ = writer.Close()
+	os.Stderr = oldStderr
+	data, readErr := io.ReadAll(reader)
+	_ = reader.Close()
+	if runErr != nil {
+		t.Fatalf("Run: %v", runErr)
+	}
+	if readErr != nil {
+		t.Fatalf("read stderr: %v", readErr)
+	}
+
+	var scansLine, outputLine string
+	for _, line := range strings.Split(string(data), "\n") {
+		switch {
+		case strings.Contains(line, "Scans:"):
+			scansLine = line
+		case strings.Contains(line, "Output:"):
+			outputLine = line
+		}
+	}
+	if count := strings.Count(scansLine, "HTTP Headers"); count != len(targets) {
+		t.Fatalf("scan-label count = %d, want %d; summary=%q", count, len(targets), scansLine)
+	}
+	last := -1
+	for _, path := range app.logFiles {
+		if count := strings.Count(outputLine, path); count != 1 {
+			t.Fatalf("log path %q occurs %d times in summary, want 1; summary=%q", path, count, outputLine)
+		}
+		index := strings.Index(outputLine, path)
+		if index <= last {
+			t.Fatalf("log summary is not in target order: %q", outputLine)
+		}
+		last = index
+	}
+}
