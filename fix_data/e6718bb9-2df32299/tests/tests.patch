+func TestParallelRunMergesReportsAndLogsInInputOrder(t *testing.T) {
+	prepareConcurrentRunTest(t)
+	delays := []time.Duration{60 * time.Millisecond, 30 * time.Millisecond, 0}
+	servers := make([]*httptest.Server, len(delays))
+	targets := make([]string, len(delays))
+	for i, delay := range delays {
+		delay := delay
+		servers[i] = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			time.Sleep(delay)
+			w.WriteHeader(http.StatusOK)
+		}))
+		targets[i] = servers[i].URL
+		defer servers[i].Close()
+	}
+
+	dir := t.TempDir()
+	app := headersApp(targets, 3)
+	app.settings.LogDir = dir
+	app.settings.Markdown = filepath.Join(dir, "report.md")
+	if err := app.Run(); err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+
+	reportData, err := os.ReadFile(app.settings.Markdown)
+	if err != nil {
+		t.Fatalf("read report: %v", err)
+	}
+	reportText := string(reportData)
+	last := -1
+	for _, target := range targets {
+		header := "## " + target + "\n"
+		if count := strings.Count(reportText, header); count != 1 {
+			t.Fatalf("report section count for %q = %d, want 1\n%s", target, count, reportText)
+		}
+		index := strings.Index(reportText, header)
+		if index <= last {
+			t.Fatalf("report targets are not in input order; target=%q index=%d last=%d\n%s", target, index, last, reportText)
+		}
+		last = index
+	}
+	if count := strings.Count(reportText, "### headers\n"); count != len(targets) {
+		t.Fatalf("headers report section count = %d, want %d\n%s", count, len(targets), reportText)
+	}
+	if len(app.logFiles) != len(targets) {
+		t.Fatalf("log files = %v, want one per target", app.logFiles)
+	}
+	seenPaths := make(map[string]bool, len(app.logFiles))
+	for i, target := range targets {
+		path := app.logFiles[i]
+		if seenPaths[path] {
+			t.Fatalf("log file %q was merged more than once", path)
+		}
+		seenPaths[path] = true
+		logData, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatalf("read log file %d: %v", i, err)
+		}
+		marker := "sif log file for " + target
+		if count := strings.Count(string(logData), marker); count != 1 {
+			t.Fatalf("log file %d marker count for %q = %d, want 1", i, target, count)
+		}
+	}
+}
