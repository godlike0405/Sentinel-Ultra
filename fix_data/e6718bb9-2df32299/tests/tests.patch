+func TestParallelRunReportsStartedFailuresInInputOrderAndStopsQueuedTargets(t *testing.T) {
+	prepareConcurrentRunTest(t)
+	targets := []string{"http://first-failure", "http://second-failure", "http://queued-third", "http://queued-fourth"}
+	bothStarted := make(chan struct{})
+	secondFailed := make(chan struct{})
+	var started atomic.Int32
+	var visitsMu sync.Mutex
+	visits := make(map[string]int, len(targets))
+
+	installBehaviorModule(t, behaviorModule{
+		id: "ordered-failures",
+		execute: func(target string) (*modules.Result, error) {
+			visitsMu.Lock()
+			visits[target]++
+			visitsMu.Unlock()
+			if started.Add(1) == 2 {
+				close(bothStarted)
+			}
+			select {
+			case <-bothStarted:
+			case <-time.After(2 * time.Second):
+				return nil, errors.New("workers did not overlap")
+			}
+
+			switch target {
+			case targets[0]:
+				<-secondFailed
+				time.Sleep(20 * time.Millisecond)
+				panic("first underlying failure")
+			case targets[1]:
+				close(secondFailed)
+				panic("second underlying failure")
+			default:
+				return &modules.Result{ModuleID: "ordered-failures", Target: target}, nil
+			}
+		},
+	})
+
+	app := idleApp(targets, 2)
+	app.settings.Modules = "ordered-failures"
+	err := app.Run()
+	if err == nil {
+		t.Fatal("Run returned nil after two started targets failed")
+	}
+	message := err.Error()
+	firstTarget := strings.Index(message, targets[0])
+	firstCause := strings.Index(message, "first underlying failure")
+	secondTarget := strings.Index(message, targets[1])
+	secondCause := strings.Index(message, "second underlying failure")
+	if firstTarget < 0 || firstCause < 0 || secondTarget < 0 || secondCause < 0 {
+		t.Fatalf("run-level error does not identify both targets and causes: %q", message)
+	}
+	if !(firstTarget < firstCause && firstCause < secondTarget && secondTarget < secondCause) {
+		t.Fatalf("failures are not reported in target input order: %q", message)
+	}
+	for _, marker := range []string{targets[0], "first underlying failure", targets[1], "second underlying failure"} {
+		if count := strings.Count(message, marker); count != 1 {
+			t.Fatalf("error marker %q occurs %d times, want exactly once: %q", marker, count, message)
+		}
+	}
+
+	visitsMu.Lock()
+	defer visitsMu.Unlock()
+	if visits[targets[0]] != 1 || visits[targets[1]] != 1 {
+		t.Fatalf("started-target visits = %v, want first two exactly once", visits)
+	}
+	if visits[targets[2]] != 0 || visits[targets[3]] != 0 {
+		t.Fatalf("queued targets began after a fatal failure: %v", visits)
+	}
+}
