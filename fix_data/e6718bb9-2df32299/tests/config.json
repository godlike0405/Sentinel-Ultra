      "github.com/vmfunc/sif::TestParallelAPIOutputKeepsInputOrderAndIsolation",
      "github.com/vmfunc/sif::TestParallelRunMergesReportsAndLogsInInputOrder",
      "github.com/vmfunc/sif::TestParallelRunMergesScanLabelsAndLogSummary",
      "github.com/vmfunc/sif::TestParallelRunMergesFindingsInInputOrder",
      "github.com/vmfunc/sif::TestParallelConsoleOutputKeepsTargetLinesIntact",
      "github.com/vmfunc/sif::TestSequentialRunPreservesLiveConsoleOutput",
