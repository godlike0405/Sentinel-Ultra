+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const crypto = require('node:crypto');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const workspace = process.env.SENTINEL_WORKSPACE || path.join(__dirname, '..', '..');
+
+function contract(name, fn) {
+  if (process.env.SENTINEL_CASE && process.env.SENTINEL_CASE !== name) return;
+  test(name, async () => {
+    await fn();
+    const completion = process.env.SENTINEL_COMPLETION_FILE;
+    const token = process.env.SENTINEL_COMPLETION_TOKEN;
+    if (completion && token) fs.writeFileSync(completion, token, { encoding: 'utf8', mode: 0o600 });
+  });
+}
+
+function digest(file) {
+  return crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
+}
+
+contract('line comment anchor preserves side and scope', () => {
+  const renderer = require(path.join(workspace, 'web', 'crit-renderer.js'));
+  assert.deepEqual(renderer.anchorFromComment({
+    file_path: 'a.go', start_line: 1, end_line: 5, side: 'old', scope: 'line',
+  }), {
+    type: 'line', filePath: 'a.go', startLine: 1, endLine: 5, side: 'old', scope: 'line',
+  });
+});
+
+contract('file comment anchor preserves scope without a side', () => {
+  const renderer = require(path.join(workspace, 'web', 'crit-renderer.js'));
+  const anchor = renderer.anchorFromComment({
+    file_path: 'a.go', start_line: 0, end_line: 0, scope: 'file',
+  });
+  assert.equal(anchor.type, 'line');
+  assert.equal(anchor.filePath, 'a.go');
+  assert.equal(anchor.startLine, 0);
+  assert.equal(anchor.endLine, 0);
+  assert.equal(anchor.scope, 'file');
+  assert.equal(anchor.side, undefined);
+});
+
+contract('npm and Bun lockfiles select markdown-it 14.3.0 and mermaid 11.16.0', () => {
+  const npmLock = JSON.parse(fs.readFileSync(path.join(workspace, 'package-lock.json'), 'utf8'));
+  const bunLock = fs.readFileSync(path.join(workspace, 'bun.lock'), 'utf8');
+  const expected = { 'markdown-it': '14.3.0', mermaid: '11.16.0' };
+  for (const [dependency, version] of Object.entries(expected)) {
+    assert.equal(npmLock.packages[`node_modules/${dependency}`].version, version);
+    assert.ok(bunLock.includes(`"${dependency}": ["${dependency}@${version}"`));
+  }
+});
+
+contract('embedded markdown runtime matches markdown-it 14.3.0', () => {
+  const expected = process.env.SENTINEL_MARKDOWN_EXPECTED;
+  assert.ok(expected, 'verifier must provide the markdown-it 14.3.0 distribution artifact');
+  assert.equal(digest(path.join(workspace, 'web', 'markdown-it.min.js')), digest(expected));
+});
+
+contract('embedded diagram runtime matches mermaid 11.16.0', () => {
+  const expected = process.env.SENTINEL_MERMAID_EXPECTED;
+  assert.ok(expected, 'verifier must provide the mermaid 11.16.0 distribution artifact');
+  assert.equal(digest(path.join(workspace, 'web', 'mermaid.min.js')), digest(expected));
+});
