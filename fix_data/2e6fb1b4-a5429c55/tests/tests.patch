+import { defineConfig } from '@playwright/test';
+
+const port = process.env.CRIT_TEST_PORT || '3323';
+
+export default defineConfig({
+  testDir: './tests',
+  fullyParallel: false,
+  retries: 0,
+  workers: 1,
+  reporter: 'list',
+  timeout: 45_000,
+  globalTimeout: 180_000,
+  use: {
+    browserName: 'chromium',
+    baseURL: `http://localhost:${port}`,
+    screenshot: 'off',
+    trace: 'off',
+    video: 'off',
+  },
+  webServer: {
+    command: `bash setup-fixtures.sh ${port}`,
+    url: `http://localhost:${port}/api/session`,
+    reuseExistingServer: false,
+    timeout: 60_000,
+    stdout: 'pipe',
+  },
+});
diff --git a/test/e2e/tests/sentinel-story-navigation.spec.ts b/test/e2e/tests/sentinel-story-navigation.spec.ts
