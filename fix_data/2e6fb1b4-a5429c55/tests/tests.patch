--- /dev/null
+++ b/test/e2e/tests/sentinel-story-navigation.spec.ts
@@ -0,0 +1,297 @@
+import { test, expect, type APIRequestContext, type Page } from '@playwright/test';
+import { execFileSync } from 'child_process';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { clearAllComments, loadPage } from './helpers';
+import { stateFilePath } from './state-file';
+
+type FixtureState = { critBin: string; fixtureDir: string; fakeHome: string };
+
+function readFixtureState(): FixtureState {
+  const raw = fs.readFileSync(stateFilePath(process.env.CRIT_TEST_PORT || '3323'), 'utf8');
+  const values: Record<string, string> = {};
+  for (const line of raw.trim().split('\n')) {
+    const at = line.indexOf('=');
+    if (at >= 0) values[line.slice(0, at)] = line.slice(at + 1);
+  }
+  if (!values.CRIT_BIN || !values.CRIT_FIXTURE_DIR || !values.FAKE_HOME) {
+    throw new Error('fixture state is incomplete');
+  }
+  return { critBin: values.CRIT_BIN, fixtureDir: values.CRIT_FIXTURE_DIR, fakeHome: values.FAKE_HOME };
+}
+
+function story(chapters: object[], supportRefs: object[]) {
+  return {
+    version: 1,
+    agent: 'sentinel-e2e',
+    prologue: {
+      title: 'Coordinate navigation',
+      overview: 'Navigation must retain the coordinate side and raw hunk owner.',
+      key_changes: ['Exercise comments and renderer anchors through the browser.'],
+      risks: ['Merged visual hunks must not merge chapter ownership.'],
+    },
+    chapters,
+    support: [{ hunk_refs: supportRefs, reason: 'Supporting changes' }],
+  };
+}
+
+const SERVER_STORY = story([
+  { id: 'imports', title: 'Imports', summary: 'First server hunk.', hunk_refs: [{ file_path: 'server.go', old_start: 2 }] },
+  { id: 'middleware', title: 'Middleware', summary: 'Second server hunk.', hunk_refs: [{ file_path: 'server.go', old_start: 17 }] },
+], [
+  { file_path: 'server.go', old_start: 39 },
+  { file_path: 'routes.go', old_start: 1 },
+  { file_path: 'routes.go', old_start: 48 },
+  { file_path: 'plan.md', old_start: 0 },
+]);
+
+const ROUTES_STORY = story([
+  { id: 'routes-top', title: 'Route imports', summary: 'First routes hunk.', hunk_refs: [{ file_path: 'routes.go', old_start: 1 }] },
+  { id: 'routes-bottom', title: 'Analytics route', summary: 'Second routes hunk.', hunk_refs: [{ file_path: 'routes.go', old_start: 48 }] },
+], [
+  { file_path: 'server.go', old_start: 2 },
+  { file_path: 'server.go', old_start: 17 },
+  { file_path: 'server.go', old_start: 39 },
+  { file_path: 'plan.md', old_start: 0 },
+]);
+
+const LEGACY_STORY = story([
+  { id: 'legacy', title: 'Legacy replacement', summary: 'Deletion-heavy hunk.', hunk_refs: [{ file_path: 'legacy.go', old_start: 5 }] },
+], [
+  { file_path: 'server.go', old_start: 2 },
+  { file_path: 'server.go', old_start: 17 },
+  { file_path: 'server.go', old_start: 39 },
+  { file_path: 'routes.go', old_start: 1 },
+  { file_path: 'routes.go', old_start: 48 },
+]);
+
+async function ingestStory(state: FixtureState, value: object) {
+  const file = path.join(os.tmpdir(), `sentinel-story-${process.pid}-${Date.now()}.json`);
+  fs.writeFileSync(file, JSON.stringify(value));
+  try {
+    execFileSync(state.critBin, ['story', '--story-file', file], {
+      cwd: state.fixtureDir,
+      timeout: 10_000,
+      env: { ...process.env, HOME: state.fakeHome, USERPROFILE: state.fakeHome },
+      stdio: 'pipe',
+    });
+  } finally {
+    fs.rmSync(file, { force: true });
+  }
+}
+
+async function clearStory(request: APIRequestContext) {
+  await request.delete('/api/story');
+}
+
+async function addComment(request: APIRequestContext, file: string, body: string, options: { line?: number; side?: 'old' | 'new'; scope?: 'file' } = {}) {
+  const data: Record<string, unknown> = { body };
+  if (options.scope === 'file') {
+    data.scope = 'file';
+  } else {
+    data.start_line = options.line;
+    data.end_line = options.line;
+    if (options.side) data.side = options.side;
+  }
+  const response = await request.post(`/api/file/comments?path=${encodeURIComponent(file)}`, { data });
+  expect(response.ok()).toBeTruthy();
+  return response.json();
+}
+
+async function openCommentFromPanel(page: Page, body: string) {
+  await page.keyboard.press('Shift+C');
+  const card = page.locator('#commentsPanel .comment-card', { hasText: body });
+  await expect(card).toBeVisible();
+  await card.click();
+}
+
+async function waitForRenderer(page: Page) {
+  await expect.poll(() => page.evaluate(() => !!(window as any).crit?.renderer?.current())).toBe(true);
+}
+
+async function installScrollProbe(page: Page) {
+  await page.addInitScript(() => {
+    (window as any).__sentinelScrolled = null;
+    Element.prototype.scrollIntoView = function () {
+      const element = this as HTMLElement;
+      (window as any).__sentinelScrolled = {
+        file: element.dataset.diffFilePath || element.dataset.filePath || '',
+        line: element.dataset.diffLineNum || element.dataset.endLine || '',
+        side: element.dataset.diffSide || '',
+        classes: element.className || '',
+      };
+    };
+  });
+}
+
+async function invokeRenderer(page: Page, anchor: object) {
+  await page.evaluate(async value => {
+    (window as any).__sentinelScrolled = null;
+    await (window as any).crit.renderer.current().scrollToAnchor(value);
+  }, anchor);
+}
+
+test.describe('coordinate-safe Story navigation', () => {
+  let state: FixtureState;
+
+  test.beforeAll(async () => {
+    state = readFixtureState();
+  });
+  test.beforeEach(async ({ request }) => {
+    await clearAllComments(request);
+    await clearStory(request);
+  });
+  test.afterEach(async ({ request }) => {
+    await clearAllComments(request);
+    await clearStory(request);
+  });
+
+  const mergedCases = [
+    { title: 'automatic merge routes a new-side line to the second chapter', line: 24, side: 'new' as const, page: 'middleware' },
+    { title: 'automatic merge routes an old-side line to the second chapter', line: 21, side: 'old' as const, page: 'middleware' },
+  ];
+
+  for (const scenario of mergedCases) {
+    test(scenario.title, async ({ page, request }) => {
+      if (scenario.side === 'old') await installScrollProbe(page);
+      await ingestStory(state, SERVER_STORY);
+      const body = `${scenario.side} line ${scenario.line}`;
+      if (scenario.side === 'new') {
+        await addComment(request, 'server.go', body, { line: scenario.line, side: scenario.side });
+      }
+      await loadPage(page);
+      if (scenario.side === 'old') {
+        await waitForRenderer(page);
+        await invokeRenderer(page, {
+          type: 'line', filePath: 'server.go', startLine: scenario.line,
+          endLine: scenario.line, side: scenario.side, scope: 'line',
+        });
+      } else {
+        await openCommentFromPanel(page, body);
+      }
+      await expect(page).toHaveURL(new RegExp(`#story/${scenario.page}$`));
+    });
+  }
+
+  test('renderer honors an old-side collision and scrolls the deleted row', async ({ page }) => {
+    await installScrollProbe(page);
+    await ingestStory(state, SERVER_STORY);
+    await loadPage(page);
+    await waitForRenderer(page);
+    await invokeRenderer(page, { type: 'line', filePath: 'server.go', startLine: 42, endLine: 42, side: 'old', scope: 'line' });
+    await expect(page).toHaveURL(/#story\/support$/);
+    await expect.poll(() => page.evaluate(() => (window as any).__sentinelScrolled)).toMatchObject({
+      file: 'server.go', line: '42', side: 'old',
+    });
+  });
+
+  test('renderer keeps a colliding new-side line in the second chapter', async ({ page }) => {
+    await installScrollProbe(page);
+    await ingestStory(state, SERVER_STORY);
+    await loadPage(page);
+    await waitForRenderer(page);
+    await invokeRenderer(page, { type: 'line', filePath: 'server.go', startLine: 42, endLine: 42, side: 'new', scope: 'line' });
+    await expect(page).toHaveURL(/#story\/middleware$/);
+    await expect.poll(() => page.evaluate(() => (window as any).__sentinelScrolled)).toMatchObject({
+      file: 'server.go', line: '42', side: '',
+    });
+  });
+
+  test('renderer explicit new-side miss stays on the current Story page', async ({ page }) => {
+    await installScrollProbe(page);
+    await ingestStory(state, LEGACY_STORY);
+    await loadPage(page);
+    await waitForRenderer(page);
+    await invokeRenderer(page, { type: 'line', filePath: 'legacy.go', startLine: 17, endLine: 17, side: 'new', scope: 'line' });
+    await expect(page.locator('#crit-story-view-overview')).toBeVisible();
+    expect(await page.evaluate(() => (window as any).__sentinelScrolled)).toBeNull();
+  });
+
+  test('renderer keeps a colliding new-side row on the rendered new side', async ({ page }) => {
+    await installScrollProbe(page);
+    await ingestStory(state, LEGACY_STORY);
+    await loadPage(page);
+    await waitForRenderer(page);
+    await invokeRenderer(page, { type: 'line', filePath: 'legacy.go', startLine: 13, endLine: 13, side: 'new', scope: 'line' });
+    await expect(page).toHaveURL(/#story\/legacy$/);
+    await expect.poll(() => page.evaluate(() => (window as any).__sentinelScrolled)).toMatchObject({
+      file: 'legacy.go', line: '13', side: '',
+    });
+  });
+
+  test('renderer maps unified old context to the displayed new-side row', async ({ page }) => {
+    await installScrollProbe(page);
+    await ingestStory(state, LEGACY_STORY);
+    await loadPage(page);
+    await page.locator('#diffModeToggle .toggle-btn[data-mode="unified"]').click();
+    await waitForRenderer(page);
+    await invokeRenderer(page, { type: 'line', filePath: 'legacy.go', startLine: 21, endLine: 21, side: 'old', scope: 'line' });
+    await expect(page).toHaveURL(/#story\/legacy$/);
+    await expect.poll(() => page.evaluate(() => (window as any).__sentinelScrolled)).toMatchObject({
+      file: 'legacy.go', line: '13', side: '',
+    });
+  });
+
+  test('scope reload replaces same-hash Story clones', async ({ page }) => {
+    let replacement = false;
+    await page.route('**/api/file/diff?**', async route => {
+      const url = new URL(route.request().url());
+      if (!replacement || url.searchParams.get('path') !== 'server.go') {
+        await route.continue();
+        return;
+      }
+      const response = await route.fetch();
+      const json = await response.json();
+      json.hunks = (json.hunks || []).filter((hunk: { OldStart: number }) => hunk.OldStart === 39);
+      await route.fulfill({ response, json });
+    });
+    await ingestStory(state, SERVER_STORY);
+    await loadPage(page);
+    await page.locator('.crit-story-row[data-story-target="imports"]').click();
+    const group = page.locator('#crit-story-view-imports .crit-story-file-group[data-story-file="server.go"]');
+    await expect(group).toContainText('respondJSON writes');
+    replacement = true;
+    await page.locator('#storyViewToggle .toggle-btn[data-story-view="diff"]').click();
+    await expect(page.locator('body')).toHaveClass(/crit-story-hidden/);
+    await page.locator('#storyViewToggle .toggle-btn[data-story-view="story"]').click();
+    await expect(page.locator('body')).toHaveClass(/crit-story-active/);
+    await page.locator('.crit-story-row[data-story-target="imports"]').click();
+    await expect(group.locator('.crit-story-file-group__empty')).toContainText('no longer in the diff');
+  });
+
+  test('file-scoped comment opens the first chapter containing its file', async ({ page, request }) => {
+    await ingestStory(state, ROUTES_STORY);
+    await addComment(request, 'routes.go', 'whole routes file', { scope: 'file' });
+    await loadPage(page);
+    await openCommentFromPanel(page, 'whole routes file');
+    await expect(page).toHaveURL(/#story\/routes-top$/);
+  });
+
+  test('file-scoped renderer anchor opens the first chapter containing its file', async ({ page }) => {
+    await ingestStory(state, ROUTES_STORY);
+    await loadPage(page);
+    await waitForRenderer(page);
+    await invokeRenderer(page, { type: 'line', filePath: 'routes.go', startLine: 0, endLine: 0, scope: 'file' });
+    await expect(page).toHaveURL(/#story\/routes-top$/);
+  });
+
+  test('split renderer preserves the old-side row', async ({ page }) => {
+    await installScrollProbe(page);
+    await ingestStory(state, LEGACY_STORY);
+    await loadPage(page);
+    await waitForRenderer(page);
+    await invokeRenderer(page, { type: 'line', filePath: 'legacy.go', startLine: 21, endLine: 21, side: 'old', scope: 'line' });
+    await expect.poll(() => page.evaluate(() => (window as any).__sentinelScrolled)).toMatchObject({
+      file: 'legacy.go', line: '21', side: 'old',
+    });
+  });
+
+  test('flat renderer navigation remains compatible', async ({ page }) => {
+    await loadPage(page);
+    await waitForRenderer(page);
+    await invokeRenderer(page, { type: 'line', filePath: 'server.go', startLine: 67, endLine: 67 });
+    await expect(page.locator('#file-section-server\\.go')).toHaveAttribute('open', '');
+    await expect(page.locator('body')).not.toHaveClass(/crit-story-active/);
+  });
+});
