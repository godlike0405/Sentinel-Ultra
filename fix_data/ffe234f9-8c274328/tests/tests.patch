+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.apache.commons.lang3.text;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+import java.io.Reader;
+import java.nio.CharBuffer;
+import java.nio.charset.StandardCharsets;
+
+import org.apache.commons.lang3.SerializationUtils;
+import org.junit.jupiter.api.Test;
+
+@SuppressWarnings("deprecation")
+class StrBuilderSetLengthSecurityTest {
+
+    private static final class HostileReadable implements Readable {
+
+        private boolean read;
+
+        @Override
+        public int read(final CharBuffer target) {
+            if (read) {
+                return -1;
+            }
+            read = true;
+            if (target.position() > 0) {
+                target.put(0, 'X');
+            }
+            target.put('!');
+            return 1;
+        }
+    }
+
+    private static final class HostileReader extends Reader {
+
+        private boolean read;
+
+        @Override
+        public void close() {
+            // Nothing to close.
+        }
+
+        @Override
+        public int read(final char[] target, final int offset, final int length) {
+            if (read) {
+                return -1;
+            }
+            read = true;
+            if (offset > 0) {
+                target[0] = 'X';
+            }
+            target[offset] = '!';
+            return 1;
+        }
+    }
+
+    private static boolean containsUtf16Be(final byte[] haystack, final String needle) {
+        final byte[] needleBytes = needle.getBytes(StandardCharsets.UTF_16BE);
+        outer: for (int index = 0; index <= haystack.length - needleBytes.length; index++) {
+            for (int offset = 0; offset < needleBytes.length; offset++) {
+                if (haystack[index + offset] != needleBytes[offset]) {
+                    continue outer;
+                }
+            }
+            return true;
+        }
+        return false;
+    }
+
+    private static String nuls(final int count) {
+        return new String(new char[count]);
+    }
+
+    private static void assertSerializedDoesNotContain(final StrBuilder builder, final String discarded) {
+        assertFalse(containsUtf16Be(SerializationUtils.serialize(builder), discarded),
+                "Serialized builder retained discarded content: " + discarded);
+    }
+
+    @Test
+    void testConsecutiveShrinksClearEntireDiscardedRegion() {
+        final StrBuilder builder = new StrBuilder("ABCDEFGHIJ");
+        builder.setLength(7);
+        builder.setLength(3);
+        assertEquals("ABC", builder.toString());
+        assertSerializedDoesNotContain(builder, "DEFGHIJ");
+        builder.setLength(10);
+        assertEquals("ABC" + nuls(7), builder.toString());
+    }
+
+    @Test
+    void testShrinkClearsEveryVacatedPosition() {
+        final String original = "CONFIDENTIAL_TOKEN_VALUE";
+        final StrBuilder builder = new StrBuilder(original);
+        assertSame(builder, builder.setLength(5));
+        assertEquals("CONFI", builder.toString());
+        assertSerializedDoesNotContain(builder, "DENTIAL_TOKEN_VALUE");
+        builder.setLength(original.length());
+        assertEquals("CONFI" + nuls(original.length() - 5), builder.toString());
+
+        final StrBuilder serializedShrink = new StrBuilder("prefix-password123-secret");
+        serializedShrink.setLength(6);
+        final byte[] serialized = SerializationUtils.serialize(serializedShrink);
+        assertFalse(containsUtf16Be(serialized, "password123-secret"));
+
+        final String wiped = "TOP_SECRET_KEY_MATERIAL";
+        final StrBuilder toZero = new StrBuilder(wiped);
+        toZero.setLength(0);
+        assertEquals(0, toZero.length());
+        assertEquals(0, toZero.size());
+        assertEquals("", toZero.toString());
+        assertSerializedDoesNotContain(toZero, wiped);
+        toZero.setLength(wiped.length());
+        assertEquals(nuls(wiped.length()), toZero.toString());
+    }
+
+    @Test
+    void testShrinkPreservesCapacityAndPrefix() {
+        final StrBuilder builder = new StrBuilder(64).append("keep-this-secret-tail");
+        final int capacity = builder.capacity();
+        builder.setLength(4);
+        assertEquals(capacity, builder.capacity());
+        assertEquals(4, builder.length());
+        assertEquals(4, builder.size());
+        assertEquals("keep", builder.toString());
+        assertEquals('k', builder.charAt(0));
+        assertEquals('e', builder.charAt(1));
+        assertEquals('e', builder.charAt(2));
+        assertEquals('p', builder.charAt(3));
+    }
+
+    @Test
+    void testShrinkThenPartialGrowDoesNotRevealOlderTail() {
+        final String original = "SECRET_MATERIAL";
+        final StrBuilder builder = new StrBuilder(original);
+        builder.setLength(3);
+        builder.setLength(8);
+        assertEquals("SEC\0\0\0\0\0", builder.toString());
+        assertSerializedDoesNotContain(builder, "ATERIAL");
+        builder.setLength(original.length());
+        assertEquals("SEC" + nuls(original.length() - 3), builder.toString());
+    }
+
+    @Test
+    void testHostileInputsCannotAccessReusableBuilderStorage() throws Exception {
+        final StrBuilder fromReadable = new StrBuilder(64).append("trusted:");
+        final HostileReadable readable = new HostileReadable();
+        assertEquals(1, fromReadable.readFrom(readable));
+        assertEquals("trusted:!", fromReadable.toString());
+
+        final StrBuilder fromReader = new StrBuilder(64).append("trusted:");
+        final HostileReader reader = new HostileReader();
+        assertEquals(1, fromReader.readFrom(reader));
+        assertEquals("trusted:!", fromReader.toString());
+    }
+
+    @Test
+    void testShrinkingReplacementClearsTailAcrossPublicVariants() {
+        final StrBuilder direct = new StrBuilder("prefix-SECRET");
+        final int directOldSize = direct.length();
+        direct.replace(7, direct.length(), "x");
+        assertEquals("prefix-x", direct.toString());
+        assertSerializedDoesNotContain(direct, "ECRET");
+        direct.setLength(directOldSize);
+        assertEquals("prefix-x" + nuls(directOldSize - 8), direct.toString());
+
+        final StrBuilder first = new StrBuilder("KEEP-SECRET");
+        final int firstOldSize = first.length();
+        first.replaceFirst("SECRET", "x");
+        assertEquals("KEEP-x", first.toString());
+        assertSerializedDoesNotContain(first, "ECRET");
+        first.setLength(firstOldSize);
+        assertEquals("KEEP-x" + nuls(firstOldSize - 6), first.toString());
+
+        final StrBuilder all = new StrBuilder("SECRET-one-ENDSECRET");
+        final int allOldSize = all.length();
+        all.replaceAll("SECRET", "x");
+        assertEquals("x-one-ENDx", all.toString());
+        assertSerializedDoesNotContain(all, "ECRET");
+        all.setLength(allOldSize);
+        assertEquals("x-one-ENDx" + nuls(allOldSize - 10), all.toString());
+
+        final StrBuilder matcher = new StrBuilder("SECRET-one-ENDSECRET");
+        final int matcherOldSize = matcher.length();
+        matcher.replaceAll(StrMatcher.stringMatcher("SECRET"), "x");
+        assertEquals("x-one-ENDx", matcher.toString());
+        assertSerializedDoesNotContain(matcher, "ECRET");
+        matcher.setLength(matcherOldSize);
+        assertEquals("x-one-ENDx" + nuls(matcherOldSize - 10), matcher.toString());
+    }
+
+    @Test
+    void testShrinkingReplacementDoesNotLeakThroughSerializationOrRegrowth() throws Exception {
+        final String secret = "TOP_SECRET_MATERIAL";
+        final StrBuilder builder = new StrBuilder("safe-prefix-" + secret);
+        final int oldSize = builder.length();
+        builder.replace(12, oldSize, "x");
+        assertEquals("safe-prefix-x", builder.toString());
+        assertSerializedDoesNotContain(builder, "OP_SECRET_MATERIAL");
+        builder.setLength(oldSize);
+        assertEquals("safe-prefix-x" + nuls(oldSize - 13), builder.toString());
+    }
+
+    @Test
+    void testExistingLengthAndReplacementContractsRemainCompatible() {
+        final StrBuilder builder = new StrBuilder("abc");
+        assertSame(builder, builder.setLength(builder.length()));
+        builder.setLength(5);
+        assertEquals("abc\0\0", builder.toString());
+        assertEquals(5, builder.length());
+        assertEquals(5, builder.size());
+
+        final StrBuilder direct = new StrBuilder("abc-def");
+        assertSame(direct, direct.replace(4, 7, "XYZ"));
+        assertEquals("abc-XYZ", direct.toString());
+
+        final StrBuilder first = new StrBuilder("one-one");
+        assertSame(first, first.replaceFirst("one", "two"));
+        assertEquals("two-one", first.toString());
+
+        final StrBuilder all = new StrBuilder("one-one");
+        assertSame(all, all.replaceAll("one", "two"));
+        assertEquals("two-two", all.toString());
+    }
+}
