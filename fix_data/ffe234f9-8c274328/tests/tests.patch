+ */
+package org.apache.commons.lang3;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.fail;
+
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.lang.reflect.Modifier;
+
+import org.junit.jupiter.api.Test;
+
+class ArrayFillRangeTest {
+
+    private static char[] clear(final char[] array, final int fromIndex, final int toIndex) {
+        return invoke("clear", new Class<?>[] {char[].class, int.class, int.class}, array, fromIndex, toIndex);
+    }
+
+    private static char[] fill(final char[] array, final int fromIndex, final int toIndex, final char value) {
+        return invoke("fill", new Class<?>[] {char[].class, int.class, int.class, char.class}, array, fromIndex, toIndex, value);
+    }
+
+    private static char[] invoke(final String name, final Class<?>[] parameterTypes, final Object... arguments) {
+        final Method method;
+        try {
+            method = ArrayFill.class.getMethod(name, parameterTypes);
+        } catch (final NoSuchMethodException exception) {
+            return fail("Missing documented public ArrayFill." + name + " range overload", exception);
+        }
+        assertTrue(Modifier.isPublic(method.getModifiers()));
+        assertTrue(Modifier.isStatic(method.getModifiers()));
+        try {
+            return (char[]) method.invoke(null, arguments);
+        } catch (final InvocationTargetException exception) {
+            final Throwable cause = exception.getCause();
+            if (cause instanceof RuntimeException) {
+                throw (RuntimeException) cause;
+            }
+            if (cause instanceof Error) {
+                throw (Error) cause;
+            }
+            return fail("Unexpected checked exception from ArrayFill." + name, cause);
+        } catch (final ReflectiveOperationException exception) {
+            return fail("Could not invoke documented ArrayFill." + name + " range overload", exception);
+        }
+    }
+
+    void testClearEmptyRangeIsNoOp() {
+        final char[] array = {'A', 'B', 'C'};
+        assertSame(array, clear(array, 1, 1));
+        assertArrayEquals(new char[] {'A', 'B', 'C'}, array);
+    }
+
+    void testClearFromGreaterThanToThrows() {
+        final char[] array = {'A', 'B', 'C'};
+        assertThrows(IllegalArgumentException.class, () -> clear(array, 2, 1));
+        assertThrows(ArrayIndexOutOfBoundsException.class, () -> clear(array, 0, 4));
+    }
+
+    void testClearFullArray() {
+        final char[] array = {'A', 'B', 'C'};
+        assertSame(array, clear(array, 0, array.length));
+        assertArrayEquals(new char[] {'\0', '\0', '\0'}, array);
+    }
+
+    void testClearNegativeFromThrows() {
+        final char[] array = {'A', 'B', 'C'};
+        assertThrows(ArrayIndexOutOfBoundsException.class, () -> clear(array, -1, 2));
+    }
+
+    void testClearNullArray() {
+        assertNull(clear(null, -100, 100));
+    }
+
+    void testClearRangeChangesOnlyRequestedSlice() {
+        final char[] array = {'A', 'B', 'C', 'D', 'E'};
+        assertSame(array, clear(array, 1, 4));
+        assertArrayEquals(new char[] {'A', '\0', '\0', '\0', 'E'}, array);
+    }
+
+    void testFillEmptyRangeIsNoOp() {
+        final char[] array = {'A', 'B', 'C'};
+        assertSame(array, fill(array, 2, 2, 'Z'));
+        assertArrayEquals(new char[] {'A', 'B', 'C'}, array);
+    }
+
+    void testFillFullArray() {
+        final char[] array = {'A', 'B', 'C'};
+        assertSame(array, fill(array, 0, array.length, 'Z'));
+        assertArrayEquals(new char[] {'Z', 'Z', 'Z'}, array);
+    }
+
+    void testFillNullArray() {
+        assertNull(fill(null, -100, 100, 'Z'));
+    }
+
+    void testFillPastEndThrows() {
+        final char[] array = {'A', 'B', 'C'};
+        assertThrows(ArrayIndexOutOfBoundsException.class, () -> fill(array, 1, 4, 'Z'));
+        assertThrows(ArrayIndexOutOfBoundsException.class, () -> fill(array, -1, 2, 'Z'));
+        assertThrows(IllegalArgumentException.class, () -> fill(array, 2, 1, 'Z'));
+    }
+
+    void testFillRangeChangesOnlyRequestedSlice() {
+        final char[] array = {'A', 'B', 'C', 'D', 'E'};
+        assertSame(array, fill(array, 1, 4, 'Z'));
+        assertArrayEquals(new char[] {'A', 'Z', 'Z', 'Z', 'E'}, array);
+    }
+
+    @Test
+    void testClearRangeContract() {
+        testClearEmptyRangeIsNoOp();
+        testClearFromGreaterThanToThrows();
+        testClearFullArray();
+        testClearNegativeFromThrows();
+        testClearNullArray();
+        testClearRangeChangesOnlyRequestedSlice();
+    }
+
+    @Test
+    void testFillRangeContract() {
+        testFillEmptyRangeIsNoOp();
+        testFillFullArray();
+        testFillNullArray();
+        testFillPastEndThrows();
+        testFillRangeChangesOnlyRequestedSlice();
+    }
+
+    @Test
+    void testExistingWholeArrayOperationsRemainCompatible() {
+        final char[] cleared = {'A', 'B', 'C'};
+        assertSame(cleared, ArrayFill.clear(cleared));
+        assertArrayEquals(new char[] {'\0', '\0', '\0'}, cleared);
+        assertNull(ArrayFill.clear((char[]) null));
+
+        final char[] filled = {'A', 'B', 'C'};
+        assertSame(filled, ArrayFill.fill(filled, 'Z'));
+        assertArrayEquals(new char[] {'Z', 'Z', 'Z'}, filled);
+        assertNull(ArrayFill.fill((char[]) null, 'Z'));
+    }
+}
