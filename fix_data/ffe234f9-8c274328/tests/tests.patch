+package org.apache.commons.lang3.text;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotSame;
+import static org.junit.jupiter.api.Assertions.assertSame;
+
+import java.io.StringReader;
+
+import org.apache.commons.lang3.SerializationUtils;
+import org.junit.jupiter.api.Test;
+
+@SuppressWarnings("deprecation")
+class StrBuilderStorageLifecycleTest {
+
+    private static final class ExposingStrBuilder extends StrBuilder {
+
+        private static final long serialVersionUID = 1L;
+
+        ExposingStrBuilder(final int initialCapacity) {
+            super(initialCapacity);
+        }
+
+        char[] storage() {
+            return buffer;
+        }
+    }
+
+    private static void assertScrubbed(final char[] abandoned) {
+        for (int index = 0; index < abandoned.length; index++) {
+            assertEquals('\0', abandoned[index],
+                    "Abandoned storage retained character data at index " + index);
+        }
+    }
+
+    private static String nuls(final int count) {
+        return new String(new char[count]);
+    }
+
+    @Test
+    void testCapacityGrowthScrubsAbandonedStorage() throws Exception {
+        final ExposingStrBuilder direct = new ExposingStrBuilder(8);
+        direct.append("SECRET42");
+        final char[] directOld = direct.storage();
+        direct.ensureCapacity(9);
+        assertNotSame(directOld, direct.storage());
+        assertScrubbed(directOld);
+        assertEquals("SECRET42", direct.toString());
+
+        final ExposingStrBuilder appended = new ExposingStrBuilder(4);
+        appended.append("KEY1");
+        final char[] appendedOld = appended.storage();
+        appended.append("MORE");
+        assertNotSame(appendedOld, appended.storage());
+        assertScrubbed(appendedOld);
+        assertEquals("KEY1MORE", appended.toString());
+
+        final ExposingStrBuilder inserted = new ExposingStrBuilder(4);
+        inserted.append("pin1");
+        final char[] insertedOld = inserted.storage();
+        inserted.insert(0, "XX");
+        assertNotSame(insertedOld, inserted.storage());
+        assertScrubbed(insertedOld);
+        assertEquals("XXpin1", inserted.toString());
+
+        final ExposingStrBuilder grown = new ExposingStrBuilder(3);
+        grown.append("abc");
+        final char[] grownOld = grown.storage();
+        grown.setLength(10);
+        assertNotSame(grownOld, grown.storage());
+        assertScrubbed(grownOld);
+        assertEquals("abc" + nuls(7), grown.toString());
+
+        final ExposingStrBuilder read = new ExposingStrBuilder(6);
+        read.append("token,");
+        final char[] readOld = read.storage();
+        assertEquals(10, read.readFrom(new StringReader("extra-data")));
+        assertNotSame(readOld, read.storage());
+        assertScrubbed(readOld);
+        assertEquals("token,extra-data", read.toString());
+
+        final ExposingStrBuilder untouched = new ExposingStrBuilder(32);
+        untouched.append("live");
+        final char[] kept = untouched.storage();
+        untouched.ensureCapacity(10);
+        assertSame(kept, untouched.storage());
+        assertEquals("live", untouched.toString());
+    }
+
+    @Test
+    void testMinimizeCapacityScrubsAbandonedStorage() {
+        final ExposingStrBuilder builder = new ExposingStrBuilder(64);
+        builder.append("token-XYZ");
+        final char[] old = builder.storage();
+        builder.minimizeCapacity();
+        assertNotSame(old, builder.storage());
+        assertScrubbed(old);
+        assertEquals("token-XYZ", builder.toString());
+        assertEquals(builder.length(), builder.capacity());
+
+        final char[] minimized = builder.storage();
+        builder.minimizeCapacity();
+        assertSame(minimized, builder.storage());
+        assertEquals("token-XYZ", builder.toString());
+    }
+
+    @Test
+    void testSerializedFormIsCapacityIndependent() {
+        final StrBuilder grownToFit = new StrBuilder(1).append("payload");
+        final StrBuilder oversized = new StrBuilder(512).append("payload");
+        final StrBuilder shrunk = new StrBuilder("payload-SECRETSUFFIX");
+        shrunk.setLength("payload".length());
+
+        final byte[] grownBytes = SerializationUtils.serialize(grownToFit);
+        assertArrayEquals(grownBytes, SerializationUtils.serialize(oversized));
+        assertArrayEquals(grownBytes, SerializationUtils.serialize(shrunk));
+
+        assertArrayEquals(SerializationUtils.serialize(new StrBuilder(128)),
+                SerializationUtils.serialize(new StrBuilder()));
+    }
+
+    @Test
+    void testDeserializedBuilderIsCompactAndFullyFunctional() throws Exception {
+        final StrBuilder original = new StrBuilder(256).append("credential-material");
+        final StrBuilder copy = SerializationUtils.clone(original);
+        assertEquals(original.toString(), copy.toString());
+        assertEquals(original.length(), copy.length());
+        assertEquals(copy.length(), copy.capacity());
+        assertArrayEquals(SerializationUtils.serialize(original), SerializationUtils.serialize(copy));
+
+        copy.append("-suffix");
+        assertEquals("credential-material-suffix", copy.toString());
+        copy.setLength("credential".length());
+        assertEquals("credential", copy.toString());
+        assertEquals(4, copy.readFrom(new StringReader("-abc")));
+        assertEquals("credential-abc", copy.toString());
+
+        final StrBuilder emptyCopy = SerializationUtils.clone(new StrBuilder(64));
+        assertEquals(0, emptyCopy.length());
+        assertEquals(0, emptyCopy.capacity());
+        emptyCopy.append('x');
+        assertEquals("x", emptyCopy.toString());
+    }
+}
