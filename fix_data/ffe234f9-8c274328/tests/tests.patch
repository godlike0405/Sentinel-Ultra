+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.apache.commons.lang3.text;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.junit.jupiter.api.Assertions.fail;
+
+import java.io.IOException;
+import java.io.Reader;
+import java.io.StringReader;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.nio.CharBuffer;
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+@SuppressWarnings("deprecation")
+class StrBuilderReadFromSecurityTest {
+
+    private static class CapturingReader extends Reader {
+
+        private final String content;
+        private final boolean failAfterContent;
+        private final List<char[]> received = new ArrayList<>();
+        private int offset;
+
+        CapturingReader(final String content, final boolean failAfterContent) {
+            this.content = content;
+            this.failAfterContent = failAfterContent;
+        }
+
+        @Override
+        public void close() {
+            // Nothing to close.
+        }
+
+        @Override
+        public int read(final char[] target, final int targetOffset, final int length) throws IOException {
+            received.add(target);
+            if (offset == content.length()) {
+                if (failAfterContent) {
+                    throw new IOException("deliberate failure");
+                }
+                return -1;
+            }
+            final int count = Math.min(length, content.length() - offset);
+            content.getChars(offset, offset + count, target, targetOffset);
+            offset += count;
+            return count;
+        }
+    }
+
+    private static class CapturingReadable implements Readable {
+
+        private final String content;
+        private final boolean failAfterContent;
+        private final boolean zeroFirst;
+        private final List<CharBuffer> received = new ArrayList<>();
+        private int offset;
+        private boolean returnedZero;
+
+        CapturingReadable(final String content, final boolean failAfterContent, final boolean zeroFirst) {
+            this.content = content;
+            this.failAfterContent = failAfterContent;
+            this.zeroFirst = zeroFirst;
+        }
+
+        @Override
+        public int read(final CharBuffer target) throws IOException {
+            received.add(target.duplicate());
+            if (zeroFirst && !returnedZero) {
+                returnedZero = true;
+                return 0;
+            }
+            if (offset == content.length()) {
+                if (failAfterContent) {
+                    throw new IOException("deliberate failure");
+                }
+                return -1;
+            }
+            final int count = Math.min(Math.min(2, target.remaining()), content.length() - offset);
+            target.put(content, offset, offset + count);
+            offset += count;
+            return count;
+        }
+    }
+
+    private static class RuntimeFailingReadable implements Readable {
+
+        private final List<CharBuffer> received = new ArrayList<>();
+        private boolean supplied;
+
+        @Override
+        public int read(final CharBuffer target) {
+            received.add(target.duplicate());
+            if (supplied) {
+                throw new IllegalStateException("deliberate failure");
+            }
+            supplied = true;
+            target.put("secret");
+            return 6;
+        }
+    }
+
+    private static void assertArraysCleared(final List<char[]> arrays) {
+        for (final char[] array : arrays) {
+            for (final char value : array) {
+                assertEquals('\0', value, "Temporary input storage retained character data");
+            }
+        }
+    }
+
+    private static void assertBuffersCleared(final List<CharBuffer> buffers) {
+        assertTrue(!buffers.isEmpty());
+        for (final CharBuffer buffer : buffers) {
+            for (int index = 0; index < buffer.limit(); index++) {
+                assertEquals('\0', buffer.get(index), "Input retained ingested character data");
+            }
+        }
+    }
+
+    private static int readBounded(final StrBuilder builder, final Readable readable, final int maxChars) throws IOException {
+        final Method method;
+        try {
+            method = StrBuilder.class.getMethod("readFrom", Readable.class, int.class);
+        } catch (final NoSuchMethodException exception) {
+            return fail("Missing public StrBuilder.readFrom(Readable, int)", exception);
+        }
+        try {
+            return (Integer) method.invoke(builder, readable, maxChars);
+        } catch (final InvocationTargetException exception) {
+            final Throwable cause = exception.getCause();
+            if (cause instanceof IOException) {
+                throw (IOException) cause;
+            }
+            if (cause instanceof RuntimeException) {
+                throw (RuntimeException) cause;
+            }
+            if (cause instanceof Error) {
+                throw (Error) cause;
+            }
+            return fail("Unexpected checked exception from bounded readFrom", cause);
+        } catch (final ReflectiveOperationException exception) {
+            return fail("Could not invoke public StrBuilder.readFrom(Readable, int)", exception);
+        }
+    }
+
+    @Test
+    void testBoundedReaderAcceptsExactLimitAndPreservesPrefix() throws Exception {
+        final StrBuilder builder = new StrBuilder("prefix:");
+        assertEquals(6, readBounded(builder, new StringReader("secret"), 6));
+        assertEquals("prefix:secret", builder.toString());
+
+        final StrBuilder zeroLimit = new StrBuilder("prefix:");
+        assertEquals(0, readBounded(zeroLimit, new StringReader(""), 0));
+        assertThrows(IOException.class, () -> readBounded(zeroLimit, new StringReader("x"), 0));
+        assertEquals("prefix:", zeroLimit.toString());
+    }
+
+    @Test
+    void testBoundedGenericReadableSupportsChunksAndZeroProgress() throws Exception {
+        final StrBuilder builder = new StrBuilder("prefix:");
+        assertEquals(6, readBounded(builder, new CapturingReadable("secret", false, true), 6));
+        assertEquals("prefix:secret", builder.toString());
+    }
+
+    @Test
+    void testBoundedCharBufferChecksLimitBeforeAdvancing() throws Exception {
+        final StrBuilder builder = new StrBuilder("prefix:");
+        final CharBuffer tooLong = CharBuffer.wrap("secret");
+        assertThrows(IOException.class, () -> readBounded(builder, tooLong, 5));
+        assertEquals("prefix:", builder.toString());
+
+        final CharBuffer exact = CharBuffer.wrap("secret");
+        assertEquals(6, readBounded(builder, exact, 6));
+        assertEquals(exact.limit(), exact.position());
+        assertEquals("prefix:secret", builder.toString());
+    }
+
+    @Test
+    void testBoundedReadRejectsInvalidArguments() {
+        final StrBuilder builder = new StrBuilder("prefix:");
+        assertThrows(IllegalArgumentException.class, () -> readBounded(builder, new StringReader(""), -1));
+        assertThrows(NullPointerException.class, () -> readBounded(builder, null, 1));
+        assertEquals("prefix:", builder.toString());
+    }
+
+    @Test
+    void testBoundedOverflowIsAtomicForReaderAndReadable() {
+        final StrBuilder readerBuilder = new StrBuilder("prefix:");
+        assertThrows(IOException.class, () -> readBounded(readerBuilder, new StringReader("secret"), 5));
+        assertEquals("prefix:", readerBuilder.toString());
+
+        final StrBuilder readableBuilder = new StrBuilder("prefix:");
+        assertThrows(IOException.class, () -> readBounded(readableBuilder, new CapturingReadable("secret", false, false), 5));
+        assertEquals("prefix:", readableBuilder.toString());
+    }
+
+    @Test
+    void testReadFailureIsAtomicForBoundedAndUnboundedOperations() {
+        final StrBuilder unbounded = new StrBuilder("prefix:");
+        assertThrows(IOException.class, () -> unbounded.readFrom(new CapturingReader("secret", true)));
+        assertEquals("prefix:", unbounded.toString());
+
+        final StrBuilder bounded = new StrBuilder("prefix:");
+        assertThrows(IOException.class, () -> readBounded(bounded, new CapturingReadable("secret", true, false), 20));
+        assertEquals("prefix:", bounded.toString());
+
+        final StrBuilder runtimeFailure = new StrBuilder("prefix:");
+        assertThrows(IllegalStateException.class, () -> runtimeFailure.readFrom(new RuntimeFailingReadable()));
+        assertEquals("prefix:", runtimeFailure.toString());
+    }
+
+    @Test
+    void testInvalidReadCountsAreRejectedAtomically() {
+        final Reader invalidReader = new Reader() {
+            @Override
+            public void close() {
+                // Nothing to close.
+            }
+
+            @Override
+            public int read(final char[] target, final int offset, final int length) {
+                return length + 1;
+            }
+        };
+        final StrBuilder readerBuilder = new StrBuilder("prefix:");
+        assertThrows(IOException.class, () -> readBounded(readerBuilder, invalidReader, 8));
+        assertEquals("prefix:", readerBuilder.toString());
+
+        final Readable invalidReadable = target -> {
+            target.put('x');
+            return 0;
+        };
+        final StrBuilder readableBuilder = new StrBuilder("prefix:");
+        assertThrows(IOException.class, () -> readableBuilder.readFrom(invalidReadable));
+        assertEquals("prefix:", readableBuilder.toString());
+
+        final Readable invalidEndOfInput = target -> {
+            target.put('x');
+            return -1;
+        };
+        assertThrows(IOException.class, () -> readBounded(new StrBuilder(), invalidEndOfInput, 1));
+    }
+
+    @Test
+    void testTemporaryInputStorageIsClearedOnSuccessAndFailure() throws Exception {
+        final CapturingReader successfulReader = new CapturingReader("secret", false);
+        assertEquals(6, new StrBuilder().readFrom(successfulReader));
+        assertTrue(!successfulReader.received.isEmpty());
+        assertArraysCleared(successfulReader.received);
+
+        final CapturingReader failingReader = new CapturingReader("secret", true);
+        assertThrows(IOException.class, () -> readBounded(new StrBuilder(), failingReader, 20));
+        assertTrue(!failingReader.received.isEmpty());
+        assertArraysCleared(failingReader.received);
+
+        final CapturingReadable successfulReadable = new CapturingReadable("secret", false, false);
+        assertEquals(6, readBounded(new StrBuilder(), successfulReadable, 6));
+        assertBuffersCleared(successfulReadable.received);
+
+        final CapturingReadable failingReadable = new CapturingReadable("secret", true, false);
+        assertThrows(IOException.class, () -> new StrBuilder().readFrom(failingReadable));
+        assertBuffersCleared(failingReadable.received);
+
+        final RuntimeFailingReadable runtimeFailingReadable = new RuntimeFailingReadable();
+        assertThrows(IllegalStateException.class, () -> new StrBuilder().readFrom(runtimeFailingReadable));
+        assertBuffersCleared(runtimeFailingReadable.received);
+    }
+
+    @Test
+    void testExistingUnboundedReadFromVariantsRemainCompatible() throws Exception {
+        final StrBuilder fromReader = new StrBuilder("prefix:");
+        assertEquals(2, fromReader.readFrom(new StringReader("ab")));
+        assertEquals("prefix:ab", fromReader.toString());
+
+        final StrBuilder fromReadable = new StrBuilder("prefix:");
+        assertEquals(2, fromReadable.readFrom(new CapturingReadable("cd", false, false)));
+        assertEquals("prefix:cd", fromReadable.toString());
+
+        final CharBuffer input = CharBuffer.wrap("ef");
+        final StrBuilder fromBuffer = new StrBuilder("prefix:");
+        assertEquals(2, fromBuffer.readFrom(input));
+        assertEquals(input.limit(), input.position());
+        assertEquals("prefix:ef", fromBuffer.toString());
+    }
+}
