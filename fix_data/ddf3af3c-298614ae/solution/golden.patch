+        private static int CompareNames(string left, string right)
+        {
+            if (left == null || right == null)
+            {
+                return string.Compare(left, right, StringComparison.OrdinalIgnoreCase);
+            }
+
+            int leftNumberStart = FindTrailingNumberStart(left);
+            int rightNumberStart = FindTrailingNumberStart(right);
+            bool leftHasNumber = leftNumberStart < left.Length;
+            bool rightHasNumber = rightNumberStart < right.Length;
+
+            if (leftHasNumber && rightHasNumber)
+            {
+                int prefix = left
+                    .AsSpan(0, leftNumberStart)
+                    .CompareTo(
+                        right.AsSpan(0, rightNumberStart),
+                        StringComparison.OrdinalIgnoreCase
+                    );
+                if (prefix != 0)
+                {
+                    return prefix;
+                }
+
+                return CompareTrailingNumbers(
+                    left,
+                    leftNumberStart,
+                    right,
+                    rightNumberStart
+                );
+            }
+
+            // A name without a trailing number sorts ahead of one that has it.
+            if (leftHasNumber)
+            {
+                return 1;
+            }
+
+            if (rightHasNumber)
+            {
+                return -1;
+            }
+
+            return string.Compare(left, right, StringComparison.OrdinalIgnoreCase);
+        }
+
+        private static int FindTrailingNumberStart(string value)
+        {
+            int start = value.Length;
+            while (0 < start)
+            {
+                char current = value[start - 1];
+                if (current < '0' || '9' < current)
+                {
+                    break;
+                }
+                --start;
+            }
+            return start;
+        }
+
+        private static int CompareTrailingNumbers(
+            string left,
+            int leftStart,
+            string right,
+            int rightStart
+        )
+        {
+            while (leftStart < left.Length && left[leftStart] == '0')
+            {
+                ++leftStart;
+            }
+
+            while (rightStart < right.Length && right[rightStart] == '0')
+            {
+                ++rightStart;
+            }
+
+            int leftLength = left.Length - leftStart;
+            int rightLength = right.Length - rightStart;
+            int comparison = leftLength.CompareTo(rightLength);
+            if (comparison != 0)
+            {
+                return comparison;
+            }
+
+            return string.Compare(
+                left,
+                leftStart,
+                right,
+                rightStart,
+                leftLength,
+                StringComparison.Ordinal
+            );
+        }
     }
