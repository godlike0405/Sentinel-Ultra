+        [Test]
+        public void CompareOrdersByTrailingNumberNaturally()
+        {
+            GameObject item2 = Create("Item2");
+            GameObject item10 = Create("Item10");
+
+            // Natural numeric ordering: 2 should come before 10.
+            Assert.Less(
+                UnityObjectNameComparer<GameObject>.Instance.Compare(item2, item10),
+                0
+            );
+            Assert.Greater(
+                UnityObjectNameComparer<GameObject>.Instance.Compare(item10, item2),
+                0
+            );
+        }
