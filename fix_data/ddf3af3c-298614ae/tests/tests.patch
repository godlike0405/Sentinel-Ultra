+        [Test]
+        public void CompareTracksMutationsAndIsConcurrentWithinThroughputTarget()
+        {
+            GameObject mutable = Create("Mutable2");
+            GameObject ten = Create("Mutable10");
+            UnityObjectNameComparer<GameObject> comparer =
+                UnityObjectNameComparer<GameObject>.Instance;
+
+            Assert.Less(comparer.Compare(mutable, ten), 0);
+            mutable.name = "Mutable20";
+            Assert.Greater(comparer.Compare(mutable, ten), 0);
+            mutable.name = "Mutable0002";
+            Assert.Less(comparer.Compare(mutable, ten), 0);
+
+            GameObject longThree = Create("VeryLongMutableName3");
+            GameObject longTwenty = Create("VeryLongMutableName20");
+
+            Parallel.For(
+                0,
+                256,
+                iteration =>
+                {
+                    GameObject lower = iteration % 2 == 0 ? mutable : longThree;
+                    GameObject higher = iteration % 2 == 0 ? ten : longTwenty;
+                    if (comparer.Compare(lower, higher) >= 0 || comparer.Compare(higher, lower) <= 0)
+                    {
+                        throw new AssertionException("Concurrent comparisons changed direction");
+                    }
+                }
+            );
+
+            GameObject alpha = Create("Alpha");
+            GameObject beta = Create("Beta");
+            GameObject laterPath = Create("Shared");
+            GameObject earlierPath = Create("Shared");
+            AssetDatabase.SetAssetOrScenePath(laterPath, "Assets/Z.asset");
+            AssetDatabase.SetAssetOrScenePath(earlierPath, "Assets/A.asset");
+
+            for (int i = 0; i < 512; ++i)
+            {
+                _ = comparer.Compare(mutable, ten);
+                _ = comparer.Compare(ten, mutable);
+                _ = comparer.Compare(alpha, beta);
+                _ = comparer.Compare(alpha, mutable);
+                _ = comparer.Compare(earlierPath, laterPath);
+                _ = comparer.Compare(mutable, mutable);
+                _ = string.Compare(mutable.name, ten.name, StringComparison.OrdinalIgnoreCase);
+                _ = string.Compare(ten.name, mutable.name, StringComparison.OrdinalIgnoreCase);
+                _ = string.Compare(alpha.name, beta.name, StringComparison.OrdinalIgnoreCase);
+                _ = string.Compare(alpha.name, mutable.name, StringComparison.OrdinalIgnoreCase);
+                _ = string.Compare(
+                    earlierPath.name,
+                    laterPath.name,
+                    StringComparison.OrdinalIgnoreCase
+                );
+                _ = string.Compare(mutable.name, mutable.name, StringComparison.OrdinalIgnoreCase);
+            }
+
+            Stopwatch baseline = Stopwatch.StartNew();
+            int baselineOrdered = 0;
+            for (int i = 0; i < 100000; ++i)
+            {
+                if (string.Compare(mutable.name, ten.name, StringComparison.OrdinalIgnoreCase) < 0)
+                {
+                    ++baselineOrdered;
+                }
+                if (string.Compare(ten.name, mutable.name, StringComparison.OrdinalIgnoreCase) > 0)
+                {
+                    ++baselineOrdered;
+                }
+                if (string.Compare(alpha.name, beta.name, StringComparison.OrdinalIgnoreCase) < 0)
+                {
+                    ++baselineOrdered;
+                }
+                if (string.Compare(alpha.name, mutable.name, StringComparison.OrdinalIgnoreCase) < 0)
+                {
+                    ++baselineOrdered;
+                }
+                if (
+                    string.Compare(
+                        earlierPath.name,
+                        laterPath.name,
+                        StringComparison.OrdinalIgnoreCase
+                    ) == 0
+                )
+                {
+                    ++baselineOrdered;
+                }
+                if (
+                    string.Compare(
+                        mutable.name,
+                        mutable.name,
+                        StringComparison.OrdinalIgnoreCase
+                    ) == 0
+                )
+                {
+                    ++baselineOrdered;
+                }
+            }
+            baseline.Stop();
+
+            Stopwatch comparisonBatch = Stopwatch.StartNew();
+            int correctlyOrdered = 0;
+            for (int i = 0; i < 100000; ++i)
+            {
+                if (comparer.Compare(mutable, ten) < 0)
+                {
+                    ++correctlyOrdered;
+                }
+                if (comparer.Compare(ten, mutable) > 0)
+                {
+                    ++correctlyOrdered;
+                }
+                if (comparer.Compare(alpha, beta) < 0)
+                {
+                    ++correctlyOrdered;
+                }
+                if (comparer.Compare(alpha, mutable) < 0)
+                {
+                    ++correctlyOrdered;
+                }
+                if (comparer.Compare(earlierPath, laterPath) < 0)
+                {
+                    ++correctlyOrdered;
+                }
+                if (comparer.Compare(mutable, mutable) == 0)
+                {
+                    ++correctlyOrdered;
+                }
+            }
+            comparisonBatch.Stop();
+
+            if (baselineOrdered != 600000 || correctlyOrdered != 600000)
+            {
+                throw new AssertionException("Repeated comparisons changed direction");
+            }
+            if (comparisonBatch.ElapsedTicks > baseline.ElapsedTicks * 15)
+            {
+                throw new AssertionException(
+                    $"Comparison batch took {comparisonBatch.Elapsed.TotalMilliseconds:F2} ms "
+                        + $"against a {baseline.Elapsed.TotalMilliseconds:F2} ms baseline"
+                );
+            }
+        }
+
+        [Test]
+        public void CompareEqualNamesUsesAssetPathBeforeInstanceId()
