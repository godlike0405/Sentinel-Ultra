+        [Test]
+        public void CompareInternalDigitsNotTreatedAsNaturalSort()
+        {
+            // Criterion 5: only TRAILING digits are subject to numeric comparison.
+            // Names whose digits appear in the middle (not at the end) have no trailing
+            // number and must compare as plain strings, case-insensitively.
+            // "Test123abc" vs "Test5def": both end in letters, so pure string comparison
+            // applies — '1' (from 123) < '5' in the fourth position → Test123abc comes first.
+            GameObject t123 = Create("Test123abc");
+            GameObject t5 = Create("Test5def");
+
+            Assert.Less(
+                UnityObjectNameComparer<GameObject>.Instance.Compare(t123, t5),
+                0
+            );
+        }
