+package tui
+
+import (
+	"testing"
+
+	tea "github.com/charmbracelet/bubbletea"
+	"github.com/usewhale/whale/internal/runtime/protocol"
+)
+
+func sentinelTUIModel() (model, *[]protocol.Intent) {
+	m := newModel(nil, "", "", "")
+	intents := []protocol.Intent{}
+	m.dispatch = func(intent protocol.Intent) {
+		intents = append(intents, intent)
+	}
+	return m, &intents
+}
+
+func sentinelTUIUpdate(t *testing.T, m model, msg tea.Msg) model {
+	t.Helper()
+	next, _ := m.Update(msg)
+	updated, ok := next.(model)
+	if !ok {
+		t.Fatalf("model update returned %T", next)
+	}
+	return updated
+}
+
+func TestSentinelBusyStopDispatchContract(t *testing.T) {
+	m, intents := sentinelTUIModel()
+	m.busy = true
+	m.submitPromptWhileBusy("/stop")
+	if len(*intents) != 1 || (*intents)[0].Kind != protocol.IntentSubmitLocal || (*intents)[0].Input != "/stop" {
+		t.Fatalf("busy /stop intents=%+v", *intents)
+	}
+}
+
+func TestSentinelStopSuggestionAutoRunContract(t *testing.T) {
+	m, intents := sentinelTUIModel()
+	m.input.SetValue("/sto")
+	m.updateSlashMatches()
+	found := false
+	for i, suggestion := range m.slash.matches {
+		if suggestion.Display == "/stop" {
+			m.slash.selected = i
+			found = true
+			break
+		}
+	}
+	if !found {
+		t.Fatalf("/stop suggestion missing: %+v", m.slash.matches)
+	}
+	m = sentinelTUIUpdate(t, m, tea.KeyMsg{Type: tea.KeyEnter})
+	if len(*intents) != 1 || (*intents)[0].Kind != protocol.IntentSubmitLocal || (*intents)[0].Input != "/stop" {
+		t.Fatalf("suggestion intents=%+v", *intents)
+	}
+	if got := m.input.Value(); got != "" {
+		t.Fatalf("input after auto-run=%q", got)
+	}
+	if m.hasSlashSuggestions() {
+		t.Fatalf("suggestions remain after auto-run: %+v", m.slash.matches)
+	}
+}
+
+func TestSentinelRunningShellSummaryContract(t *testing.T) {
+	cases := []struct {
+		raw  string
+		want string
+	}{
+		{raw: `{"success":true,"code":"ok","data":{"status":"running","metrics":{"duration_ms":15000},"payload":{"task_id":"task-123","command":"go test ./..."}}}`, want: "running · 15s"},
+		{raw: `{"success":true,"code":"ok","data":{"status":"running","metrics":{"duration_ms":15000},"payload":{"task_id":"task-123"},"diagnosis":{"reason":"build_test_long_running"}}}`, want: "build/test running · 15s"},
+	}
+	for _, tc := range cases {
+		role, got := summarizeToolResultForChat("shell_run", tc.raw)
+		if role != "result_running" || got != tc.want {
+			t.Fatalf("running summary role=%q text=%q, want %q", role, got, tc.want)
+		}
+	}
+}
