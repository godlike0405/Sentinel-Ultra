@@ -0,0 +1,43 @@
+package commands
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestSentinelStopClassificationContract(t *testing.T) {
+	valid := ClassifySubmit("/stop", CommandsHelp())
+	if valid.Line != "/stop" || valid.Class != SubmitLocalMutating {
+		t.Fatalf("/stop classification = %+v, want local-mutating", valid)
+	}
+	if !valid.BusyImmediate() {
+		t.Fatal("/stop must remain immediately dispatchable while busy")
+	}
+	for _, line := range []string{"/stop task-1", "/stop task-1 extra"} {
+		got := ClassifySubmit(line, CommandsHelp())
+		if got.Class != SubmitUsageError || got.BusyImmediate() {
+			t.Fatalf("%q classification = %+v, want usage error", line, got)
+		}
+	}
+}
+
+func TestSentinelStopCatalogContract(t *testing.T) {
+	var stop *SlashCommandSpec
+	for _, spec := range DefaultSlashCommands() {
+		if spec.Name == "/stop" {
+			copy := spec
+			stop = &copy
+			break
+		}
+	}
+	if stop == nil {
+		t.Fatal("/stop is missing from the slash-command catalog")
+	}
+	if stop.Description != "Stop all background shell tasks" || !stop.AutoRun || stop.ArgumentHint != "" {
+		t.Fatalf("unexpected /stop catalog entry: %+v", *stop)
+	}
+	help := CommandsHelp()
+	if !strings.Contains(", "+help+", ", ", /stop, ") || strings.Contains(help, "/stop <") {
+		t.Fatalf("help must list bare /stop, got %q", help)
+	}
+}
