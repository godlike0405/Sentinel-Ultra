+package app
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/usewhale/whale/internal/core"
+	whaletools "github.com/usewhale/whale/internal/tools"
+)
+
+func sentinelAppShellTool(t *testing.T, ts *whaletools.Toolset) core.Tool {
+	t.Helper()
+	for _, tool := range ts.Tools() {
+		if tool.Name() == "shell_run" {
+			return tool
+		}
+	}
+	t.Fatal("shell_run tool is unavailable")
+	return nil
+}
+
+func sentinelAppStartTask(t *testing.T, tool core.Tool, command string, timeoutMS int) string {
+	t.Helper()
+	input := map[string]any{"command": command, "background": true}
+	if timeoutMS > 0 {
+		input["timeout_ms"] = timeoutMS
+	}
+	raw, err := json.Marshal(input)
+	if err != nil {
+		t.Fatalf("marshal shell input: %v", err)
+	}
+	res, err := tool.Run(context.Background(), core.ToolCall{ID: "sentinel", Name: "shell_run", Input: string(raw)})
+	if err != nil || res.IsError {
+		t.Fatalf("start %q: err=%v result=%+v", command, err, res)
+	}
+	var envelope struct {
+		Data struct {
+			Payload struct {
+				TaskID string `json:"task_id"`
+			} `json:"payload"`
+		} `json:"data"`
+	}
+	if err := json.Unmarshal([]byte(res.Content), &envelope); err != nil {
+		t.Fatalf("decode shell result: %v", err)
+	}
+	if envelope.Data.Payload.TaskID == "" {
+		t.Fatalf("missing task id in %s", res.Content)
+	}
+	return envelope.Data.Payload.TaskID
+}
+
+func TestSentinelStopEmptyContract(t *testing.T) {
+	app := &App{ctx: context.Background()}
+	res, err := app.ExecuteLocalCommand("/stop")
+	if err != nil || !res.Handled || res.Text != "No background shell tasks running." {
+		t.Fatalf("empty /stop result=%+v err=%v", res, err)
+	}
+	_, err = app.ExecuteLocalCommand("/stop opaque-id")
+	if err == nil || !strings.Contains(err.Error(), "usage: /stop") {
+		t.Fatalf("/stop with argument error=%v", err)
+	}
+}
+
+func TestSentinelPSStopLifecycleContract(t *testing.T) {
+	ts, err := whaletools.NewToolset(t.TempDir())
+	if err != nil {
+		t.Fatalf("new toolset: %v", err)
+	}
+	app := &App{ctx: context.Background(), toolset: ts}
+	shell := sentinelAppShellTool(t, ts)
+	firstID := sentinelAppStartTask(t, shell, "sleep 30", 0)
+	time.Sleep(2 * time.Millisecond)
+	secondID := sentinelAppStartTask(t, shell, "sleep 31", 0)
+
+	_, listing, _, err := app.HandleLocalCommand("/ps")
+	if err != nil || !strings.Contains(listing, "sleep 30") || !strings.Contains(listing, "sleep 31") {
+		t.Fatalf("running /ps output=%q err=%v", listing, err)
+	}
+	if strings.Index(listing, "sleep 30") >= strings.Index(listing, "sleep 31") || strings.Contains(listing, firstID) || strings.Contains(listing, secondID) {
+		t.Fatalf("/ps order or identifier leak: %q", listing)
+	}
+
+	_, stopped, _, err := app.HandleLocalCommand("/stop")
+	if err != nil || !strings.HasPrefix(stopped, "Stopped 2 background shell tasks.\n") {
+		t.Fatalf("/stop output=%q err=%v", stopped, err)
+	}
+	for _, want := range []string{"sleep 30", "sleep 31", "status:", "cwd:"} {
+		if !strings.Contains(stopped, want) {
+			t.Fatalf("/stop output missing %q: %q", want, stopped)
+		}
+	}
+	if strings.Contains(stopped, firstID) || strings.Contains(stopped, secondID) {
+		t.Fatalf("/stop leaked task id: %q", stopped)
+	}
+	for _, task := range ts.BackgroundShellTasks() {
+		if task.Status == "running" {
+			t.Fatalf("/stop left a running task: %+v", task)
+		}
+	}
+	_, after, _, err := app.HandleLocalCommand("/ps")
+	if err != nil || !strings.Contains(after, "No background shell tasks running.") || strings.Contains(after, "sleep 30") || strings.Contains(after, "sleep 31") {
+		t.Fatalf("post-stop /ps output=%q err=%v", after, err)
+	}
+}
+
+func TestSentinelPSTimeoutExclusionContract(t *testing.T) {
+	ts, err := whaletools.NewToolset(t.TempDir())
+	if err != nil {
+		t.Fatalf("new toolset: %v", err)
+	}
+	app := &App{ctx: context.Background(), toolset: ts}
+	id := sentinelAppStartTask(t, sentinelAppShellTool(t, ts), "sleep 1", 1)
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		history := ts.BackgroundShellTasks()
+		if len(history) == 1 && history[0].ID == id && history[0].Status == "timeout" {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("timed-out task missing from history: %+v", history)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	res := app.executePSCommand()
+	if strings.Contains(res.Text, "sleep 1") || strings.Contains(res.Text, id) || !strings.Contains(res.Text, "No background shell tasks running.") {
+		t.Fatalf("timeout-only /ps result=%+v", res)
+	}
+	if res.LocalResult == nil || len(res.LocalResult.Fields) != 1 || res.LocalResult.Fields[0].Label != "running" || res.LocalResult.Fields[0].Value != "none" {
+		t.Fatalf("timeout-only local result=%+v", res.LocalResult)
+	}
+}
+
+func TestSentinelStopSingularCountContract(t *testing.T) {
+	ts, err := whaletools.NewToolset(t.TempDir())
+	if err != nil {
+		t.Fatalf("new toolset: %v", err)
+	}
+	app := &App{ctx: context.Background(), toolset: ts}
+	id := sentinelAppStartTask(t, sentinelAppShellTool(t, ts), "sleep 30", 0)
+	res, err := app.ExecuteLocalCommand("/stop")
+	if err != nil || !strings.HasPrefix(res.Text, "Stopped 1 background shell task.\n") {
+		t.Fatalf("singular /stop result=%+v err=%v", res, err)
+	}
+	if !strings.Contains(res.Text, "sleep 30") || !strings.Contains(res.Text, "status:") || strings.Contains(res.Text, id) {
+		t.Fatalf("singular /stop details=%q", res.Text)
+	}
+	again, err := app.ExecuteLocalCommand("/stop")
+	if err != nil || again.Text != "No background shell tasks running." {
+		t.Fatalf("second /stop result=%+v err=%v", again, err)
+	}
+}
