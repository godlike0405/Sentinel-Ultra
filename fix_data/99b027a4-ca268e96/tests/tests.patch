@@ -0,0 +1,172 @@
+package tools
+
+import (
+	"context"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/usewhale/whale/internal/core"
+)
+
+func sentinelRunningTasks(t *testing.T, ts *Toolset) []BackgroundShellTask {
+	t.Helper()
+	method := reflect.ValueOf(ts).MethodByName("RunningBackgroundShellTasks")
+	if !method.IsValid() {
+		t.Fatal("Toolset.RunningBackgroundShellTasks is unavailable")
+	}
+	values := method.Call(nil)
+	if len(values) != 1 {
+		t.Fatalf("RunningBackgroundShellTasks returned %d values", len(values))
+	}
+	tasks, ok := values[0].Interface().([]BackgroundShellTask)
+	if !ok {
+		t.Fatalf("RunningBackgroundShellTasks returned %T", values[0].Interface())
+	}
+	return tasks
+}
+
+func sentinelCancelAll(t *testing.T, ts *Toolset) ([]BackgroundShellTask, error) {
+	t.Helper()
+	method := reflect.ValueOf(ts).MethodByName("CancelAllBackgroundShellTasks")
+	if !method.IsValid() {
+		t.Fatal("Toolset.CancelAllBackgroundShellTasks is unavailable")
+	}
+	values := method.Call([]reflect.Value{reflect.ValueOf(context.Background())})
+	if len(values) != 2 {
+		t.Fatalf("CancelAllBackgroundShellTasks returned %d values", len(values))
+	}
+	tasks, ok := values[0].Interface().([]BackgroundShellTask)
+	if !ok && !values[0].IsNil() {
+		t.Fatalf("CancelAllBackgroundShellTasks returned %T", values[0].Interface())
+	}
+	var err error
+	if !values[1].IsNil() {
+		err, ok = values[1].Interface().(error)
+		if !ok {
+			t.Fatalf("CancelAllBackgroundShellTasks error result is %T", values[1].Interface())
+		}
+	}
+	return tasks, err
+}
+
+func sentinelStartBackgroundTask(t *testing.T, ts *Toolset, command string, timeoutMS int) string {
+	t.Helper()
+	input := map[string]any{"command": command, "background": true}
+	if timeoutMS > 0 {
+		input["timeout_ms"] = timeoutMS
+	}
+	raw, err := json.Marshal(input)
+	if err != nil {
+		t.Fatalf("marshal shell input: %v", err)
+	}
+	res, err := ts.shellRun(context.Background(), core.ToolCall{ID: "sentinel", Name: "shell_run", Input: string(raw)})
+	if err != nil || res.IsError {
+		t.Fatalf("start %q: err=%v result=%+v", command, err, res)
+	}
+	var envelope struct {
+		Data struct {
+			Payload struct {
+				TaskID string `json:"task_id"`
+			} `json:"payload"`
+		} `json:"data"`
+	}
+	if err := json.Unmarshal([]byte(res.Content), &envelope); err != nil {
+		t.Fatalf("decode shell result: %v", err)
+	}
+	if envelope.Data.Payload.TaskID == "" {
+		t.Fatalf("shell result has no task id: %s", res.Content)
+	}
+	return envelope.Data.Payload.TaskID
+}
+
+func sentinelWaitForTaskStatus(t *testing.T, ts *Toolset, id, want string) BackgroundShellTask {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		for _, task := range ts.BackgroundShellTasks() {
+			if task.ID == id && task.Status == want {
+				return task
+			}
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("task %s did not reach %q; history=%+v", id, want, ts.BackgroundShellTasks())
+	return BackgroundShellTask{}
+}
+
+func TestSentinelRunningViewAndSingleCancelContract(t *testing.T) {
+	ts, err := NewToolset(t.TempDir())
+	if err != nil {
+		t.Fatalf("new toolset: %v", err)
+	}
+	id := sentinelStartBackgroundTask(t, ts, "sleep 30", 0)
+	running := sentinelRunningTasks(t, ts)
+	if len(running) != 1 || running[0].ID != id || running[0].Status != "running" {
+		t.Fatalf("running view = %+v", running)
+	}
+	stopped, err := ts.CancelBackgroundShellTask(context.Background(), id)
+	if err != nil || stopped.ID != id || stopped.Status == "running" {
+		t.Fatalf("single cancel result=%+v err=%v", stopped, err)
+	}
+	if got := sentinelRunningTasks(t, ts); len(got) != 0 {
+		t.Fatalf("single-canceled task remains running: %+v", got)
+	}
+	history := ts.BackgroundShellTasks()
+	if len(history) != 1 || history[0].ID != id || history[0].Status == "running" {
+		t.Fatalf("single-canceled task missing from history: %+v", history)
+	}
+}
+
+func TestSentinelCancelAllContract(t *testing.T) {
+	ts, err := NewToolset(t.TempDir())
+	if err != nil {
+		t.Fatalf("new toolset: %v", err)
+	}
+	firstID := sentinelStartBackgroundTask(t, ts, "sleep 30", 0)
+	time.Sleep(2 * time.Millisecond)
+	secondID := sentinelStartBackgroundTask(t, ts, "sleep 31", 0)
+	started := time.Now()
+	stopped, err := sentinelCancelAll(t, ts)
+	if err != nil {
+		t.Fatalf("cancel all: %v", err)
+	}
+	if elapsed := time.Since(started); elapsed >= 5*time.Second {
+		t.Fatalf("cancel all took %s; cancellation must use a short bounded wait", elapsed)
+	}
+	if len(stopped) != 2 || stopped[0].ID != firstID || stopped[1].ID != secondID {
+		t.Fatalf("cancel-all order/result = %+v", stopped)
+	}
+	for _, task := range stopped {
+		if task.Status == "running" {
+			t.Fatalf("cancel-all returned a running task: %+v", task)
+		}
+	}
+	if got := sentinelRunningTasks(t, ts); len(got) != 0 {
+		t.Fatalf("cancel-all left running tasks: %+v", got)
+	}
+	if history := ts.BackgroundShellTasks(); len(history) != 2 {
+		t.Fatalf("cancel-all discarded history: %+v", history)
+	}
+	again, err := sentinelCancelAll(t, ts)
+	if err != nil || len(again) != 0 {
+		t.Fatalf("idempotent cancel-all = %+v, %v", again, err)
+	}
+}
+
+func TestSentinelRunningViewExcludesTimedOutContract(t *testing.T) {
+	ts, err := NewToolset(t.TempDir())
+	if err != nil {
+		t.Fatalf("new toolset: %v", err)
+	}
+	id := sentinelStartBackgroundTask(t, ts, "sleep 1", 1)
+	timedOut := sentinelWaitForTaskStatus(t, ts, id, "timeout")
+	if !strings.Contains(timedOut.Command, "sleep 1") {
+		t.Fatalf("unexpected timed-out history entry: %+v", timedOut)
+	}
+	if got := sentinelRunningTasks(t, ts); len(got) != 0 {
+		t.Fatalf("timed-out task appears in running view: %+v", got)
+	}
+}
