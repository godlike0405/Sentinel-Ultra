+	if len(tasks) == 1 {
+		b.WriteString("Stopped 1 background shell task.")
+	} else {
+		b.WriteString(fmt.Sprintf("Stopped %d background shell tasks.", len(tasks)))
+	}
+	for _, task := range tasks {
+		b.WriteString("\n\n")
