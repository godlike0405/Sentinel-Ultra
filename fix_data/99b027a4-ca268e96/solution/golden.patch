-	}, nil
+	}
+}
+
+func sortBackgroundShellTasks(tasks []BackgroundShellTask) {
+	sort.SliceStable(tasks, func(i, j int) bool {
+		return tasks[i].StartedAt.Before(tasks[j].StartedAt)
+	})
 }
